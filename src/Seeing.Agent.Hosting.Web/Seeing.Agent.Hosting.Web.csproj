    <RootNamespace>Seeing.Agent.Hosting.Web</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Web Host Shape: Blazor Circuit shell + BlazorPermissionChannel (no capability package refs)</Description>
