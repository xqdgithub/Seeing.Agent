  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seeing.Agent.Abstractions\Seeing.Agent.Abstractions.csproj" />
    <ProjectReference Include="..\Seeing.Agent.Core\Seeing.Agent.Core.csproj" />
  </ItemGroup>

</Project>
