<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Seeing.Agent.Cli</RootNamespace>
    <AssemblyName>seeing-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\hosting\Seeing.Agent.Hosting\Seeing.Agent.Hosting.csproj" />
    <ProjectReference Include="..\..\src\hosting\Seeing.Agent.Hosting.Headless\Seeing.Agent.Hosting.Headless.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Acp\Seeing.Agent.Acp.csproj" />
    <ProjectReference Include="..\..\src\gateway\Seeing.Agent.Gateway\Seeing.Agent.Gateway.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Scheduler\Seeing.Agent.Scheduler.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Memory\Seeing.Agent.Memory.csproj" />
    <ProjectReference Include="..\..\src\primitives\Seeing.Session\Seeing.Session.csproj" />
    <ProjectReference Include="..\..\src\spine\Seeing.Agent.Core\Seeing.Agent.Core.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Basic\Seeing.Agent.Tools.Basic.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.FileSystem\Seeing.Agent.Tools.FileSystem.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Shell\Seeing.Agent.Tools.Shell.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Web\Seeing.Agent.Tools.Web.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Git\Seeing.Agent.Tools.Git.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Session\Seeing.Agent.Tools.Session.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Question\Seeing.Agent.Tools.Question.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Skills\Seeing.Agent.Skills.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Mcp\Seeing.Agent.Mcp.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Llm.OpenAI\Seeing.Agent.Llm.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Llm.Anthropic\Seeing.Agent.Llm.Anthropic.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Agents.BuiltIn\Seeing.Agent.Agents.BuiltIn.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.IO.Local\Seeing.IO.Local.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    WebUI 解耦发布：
    1. Cli 不直接引用 WebUI 项目（无代码依赖），避免 WebUI 内容文件(appsettings.json)回流导致重复冲突。
    2. WebUI 先发布到每次全新创建的 staging 目录，再强制覆盖到 Cli 发布目录。
    3. 用独立 dotnet 进程发布 WebUI（而非嵌套 MSBuild Rebuild），绕开 VS 解决方案级 up-to-date 缓存：
       清理后 VS 会把 WebUI 独有依赖（Hosting.Web/Llm.ModelCapabilities/Llm.ModelCatalog.Builtin/TokenBudget，
       均不在 Cli 闭包内）误判为"最新"跳过，致其 ref 程序集缺失、WebUI 编译报 CS0006。
    4. 通过 manifest 删除上一次 WebUI 发布后已不存在的文件，避免旧 Provider 残留。
  -->
  <PropertyGroup>
    <WebUIPublishStagingDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\webui-publish</WebUIPublishStagingDir>
    <WebUIPublishManifest>$(PublishDir)\.seeing-webui-files.txt</WebUIPublishManifest>
  </PropertyGroup>

  <Target Name="PublishWebUIForCli" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <!-- 清理 staging，确保本次发布不继承任何旧 WebUI/Provider 文件。 -->
    <RemoveDir Directories="$(WebUIPublishStagingDir)" Condition="Exists('$(WebUIPublishStagingDir)')" />
    <MakeDir Directories="$(WebUIPublishStagingDir)" />

    <!-- 独立 dotnet 进程发布：全新评估 WebUI 依赖闭包，不受 VS 增量缓存影响。
         DOTNET_CLI_UI_LANGUAGE=en 强制子进程输出英文，避免 VS 输出窗口用 GBK 解码 UTF-8 中文产生乱码。 -->
    <Exec Command="set &quot;DOTNET_CLI_UI_LANGUAGE=en&quot; &amp;&amp; dotnet publish &quot;$(MSBuildThisFileDirectory)../Seeing.Agent.WebUI/Seeing.Agent.WebUI.csproj&quot; -c $(Configuration) -o &quot;$(WebUIPublishStagingDir)&quot; -p:SelfContained=false --nologo"
          StandardOutputImportance="high" />

    <ItemGroup>
      <WebUIPublishFiles Include="$(WebUIPublishStagingDir)\**\*" />
    </ItemGroup>

    <!-- 删除上一次 WebUI 发布产生、但本次已不再存在的文件。 -->
    <ReadLinesFromFile File="$(WebUIPublishManifest)" Condition="Exists('$(WebUIPublishManifest)')">
      <Output TaskParameter="Lines" ItemName="PreviousWebUIFiles" />
    </ReadLinesFromFile>
    <Delete Files="@(PreviousWebUIFiles->'$(PublishDir)%(Identity)')"
            Condition="@(PreviousWebUIFiles) != ''" />

    <!-- SkipUnchangedFiles=false + OverwriteReadOnlyFiles=true 确保新程序集覆盖旧程序集。 -->
    <Copy SourceFiles="@(WebUIPublishFiles)"
          DestinationFiles="@(WebUIPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />

    <WriteLinesToFile File="$(WebUIPublishManifest)"
                      Lines="@(WebUIPublishFiles->'%(RecursiveDir)%(Filename)%(Extension)')"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>

</Project>
