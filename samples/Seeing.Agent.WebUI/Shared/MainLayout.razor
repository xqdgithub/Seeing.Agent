@inherits LayoutComponentBase
@using AntDesign
@using Seeing.Agent.Core.Llm
@using Seeing.Agent.Llm
@using Seeing.Agent.WebUI.State
@using Seeing.Agent.WebUI.Models
@using Seeing.Agent.WebUI.Components
@using Seeing.Agent.WebUI.Services
@using Seeing.Session.Core
@using Seeing.Session.Management
@using Seeing.Agent.Hosting
@using Microsoft.JSInterop
@inject AppState AppState
@inject SessionState SessionState
@inject NavigationManager NavigationManager
@inject IMessageService MessageService
@inject IAgentRegistry AgentRegistry
@inject IModelConfigManager ModelManager
@inject IJSRuntime JSRuntime
@inject Seeing.Agent.WebUI.Services.HostRequestDispatcher HostDispatcher
@implements IAsyncDisposable

<Layout Class="app-layout"
        Style="@($"--sider-width:{AppSidebar.ExpandedWidth}px;--sider-collapsed-width:{AppSidebar.CollapsedWidth}px;min-height:100vh;")">
    @* 折叠态由 AppState 单一持有，AppSidebar 自己读写，不再经参数往返 *@
    <AppSidebar @ref="_sidebarRef" />

    @if (AppState.IsMobile && AppState.MobileSidebarOpen)
    {
        <div class="sidebar-overlay-mask visible"
             @onclick="CloseMobileSidebar"
             @onclick:stopPropagation="true" />
    }

    @if (AppState.IsMobile)
    {
        <Button Class="mobile-hamburger"
                Icon="@IconType.Outline.Menu"
                Shape="@ButtonShape.Circle"
                Size="@ButtonSize.Large"
                OnClick="ToggleMobileSidebar"
                OnClickStopPropagation="true" />
    }

    @* 移动端不再单独挂审批 FAB：审批中心已在汉堡侧栏菜单内（带角标），
       外挂按钮会让人以为「审批没进汉堡」，且与汉堡抢视线。 *@

    <Layout Class="@GetContentClass()">
        <Content Class="content-area">
            @Body
        </Content>
    </Layout>

    @* 工作区切换进度层：覆盖全页，避免切换期间像卡死 *@
    <WorkspaceSwitchOverlay />
</Layout>

@code {
    private bool _hasRendered;
    private AppSidebar? _sidebarRef;
    private DotNetObjectReference<MainLayout>? _layoutRef;

    protected override void OnInitialized()
    {
        // 急切解析 HostRequestDispatcher（Scoped，circuit 维度）：触发构造与 Inbox.Changed 订阅，
        // 否则宿主请求派发器直到首次注入才建立，早期请求可能落空。
        _ = HostDispatcher;
    }

    protected override async Task OnInitializedAsync()
    {
        // 重置移动端状态（AppState 为 Singleton，每次新电路连接需清零）
        AppState.IsMobile = false;
        AppState.MobileSidebarOpen = false;

        AppState.OnChange += OnAppStateChange;

        // 监听模型配置变更
        ModelManager.ModelConfigChanged += OnModelConfigChanged;

        // 只加载 Agent 和 Model 列表，不自动加载会话
        // 会话加载由 Session.razor 根据 URL 参数决定
        await LoadAgentsAndModelsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hasRendered = true;

            // JS Interop 仅在首次渲染后可用（避开预渲染）
            _layoutRef = DotNetObjectReference.Create(this);
            AppState.IsMobile = await JSRuntime.InvokeAsync<bool>("isMobileBrowser");
            try
            {
                await JSRuntime.InvokeVoidAsync("subscribeMobileLayoutChanged", _layoutRef);
            }
            catch
            {
                // 旧缓存 app.js 或缺函数时不拖垮 circuit
            }

            AppState.NotifyChange();
        }
    }

    /// <summary>视口跨过 768 边界时由 JS 回调；与首屏 isMobileBrowser 共用同一判定。</summary>
    [JSInvokable]
    public void OnMobileLayoutChanged(bool isMobile)
    {
        if (AppState.IsMobile == isMobile)
            return;

        AppState.IsMobile = isMobile;
        if (!isMobile)
            AppState.MobileSidebarOpen = false;

        AppState.NotifyChange();
    }

    private void OnAppStateChange()
    {
        RequestRender();
    }

    private void OnModelConfigChanged(object? sender, ModelConfigChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAgentsAndModelsAsync();
            StateHasChanged();
        });
    }

    private void RequestRender()
    {
        if (!_hasRendered)
            return;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadAgentsAndModelsAsync()
    {
        try
        {
            var primaryAgents = await AgentRegistry.GetPrimaryAgentsAsync();
            AppState.AvailableAgents = primaryAgents.Where(a => !string.IsNullOrEmpty(a.Name)).ToList();

            // 从 ModelConfigManager 获取模型列表
            AppState.AvailableModels = ModelManager.GetModelsByType();

            AppState.NotifyChange();
        }
        catch (Exception ex)
        {
            AppState.ErrorMessage = string.Format("加载失败: {0}", ex.Message);
        }
    }

    /// <summary>计算内容区 CSS class：移动端始终无 margin-left，桌面端根据折叠状态切换</summary>
    private string GetContentClass()
    {
        if (AppState.IsMobile)
            return "main-layout-content main-layout-content--mobile";
        return AppState.SidebarCollapsed ? "main-layout-content collapsed" : "main-layout-content";
    }

    private void ToggleMobileSidebar()
    {
        if (AppState.MobileSidebarOpen)
            _sidebarRef?.CloseMobileSidebar();
        else
            _sidebarRef?.OpenMobileSidebar();
    }

    private void CloseMobileSidebar()
        => _sidebarRef?.CloseMobileSidebar();

    public async ValueTask DisposeAsync()
    {
        AppState.OnChange -= OnAppStateChange;
        ModelManager.ModelConfigChanged -= OnModelConfigChanged;

        try
        {
            await JSRuntime.InvokeVoidAsync("unsubscribeMobileLayoutChanged");
        }
        catch
        {
            // circuit 可能已断开
        }

        _layoutRef?.Dispose();
        _layoutRef = null;
    }
}
