@namespace Seeing.Agent.WebUI.Components
@using Microsoft.AspNetCore.Components.Web
@using Seeing.Session.Core
@using Seeing.Agent.WebUI.Services

@* 顶部关系条只在存在交接链时渲染。
   交接链的链式顺序（前任 → 锚点）是它不可替代的价值；纯子会话/纯分叉已由右侧侧栏
   完整覆盖（成员卡片 + 卡片内操作），不再重复占用垂直空间，也不再提供抽屉入口。 *@
@if (Model is not null && Model.HasHandoffChain)
{
    <div class="session-relation-bar" data-testid="session-relation-bar">
        @if (Model.BarOverflow > 0)
        {
            <div role="button" tabindex="0"
                    class="relation-chip relation-chip--overflow"
                    title="查看更早的主线会话"
                    @onclick="OpenDrawerAsync">
                +@Model.BarOverflow 个更早
            </div>
        }
        @foreach (var node in Model.BarVisible)
        {
            <div role="button" tabindex="0"
                    class="relation-chip @(node.IsAnchor ? "relation-chip--anchor" : "") @(node.IsActive ? "relation-chip--active" : "")"
                    title="@node.Title"
                    @onclick="() => SelectAsync(node.SessionId)">
                @if (node.IsExecuting)
                {
                    <span class="relation-chip__pulse" aria-hidden="true"></span>
                }
                <span class="relation-chip__title">@node.Title</span>
                <span class="relation-chip__badge">@SessionRelationView.BadgeText(node.Relation, node.IsAnchor, node.Label, node.SuccessorTitle)</span>
            </div>
        }
        <div role="button" tabindex="0"
                class="relation-chip relation-chip--branches"
                title="查看关系树（分叉 / 子代理）"
                @onclick="OpenDrawerAsync">
            <span aria-hidden="true">⑂</span>@Model.DerivedCount<span class="relation-chip__sep">·</span><span aria-hidden="true">👤</span>@Model.ChildCount <span aria-hidden="true">▾</span>
        </div>
        <div class="session-relation-bar__spacer"></div>
        <div role="button" tabindex="0"
                class="relation-chip relation-chip--drawer"
                title="打开关系抽屉（交接链详情）"
                @onclick="OpenDrawerAsync">
            关系 ▸
        </div>
    </div>
}

@code {
    [Parameter] public RelationTreeModel? Model { get; set; }

    [Parameter] public EventCallback<string> OnSelect { get; set; }

    [Parameter] public EventCallback OnOpenDrawer { get; set; }

    private Task SelectAsync(string sessionId) => OnSelect.InvokeAsync(sessionId);

    private Task OpenDrawerAsync() => OnOpenDrawer.InvokeAsync();
}
