@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Seeing.Agent.WebUI.Models
@using Seeing.Agent.WebUI.Services
@using TimelineModel = Seeing.Agent.WebUI.Models.Timeline
@inject IJSRuntime JSRuntime
@inject MessageTimelineStore Timeline
@implements IAsyncDisposable

<div Class="message-list" @ref="@MessageListElement">
    <div Class="message-list-container" Id="@ContainerId">
        <div Class="message-list-content" Id="@ContentId">
            @if (Items.Count == 0)
            {
                <Empty Class="message-list-empty">
                    <DescriptionTemplate>
                        暂无消息，开始对话吧
                    </DescriptionTemplate>
                </Empty>
            }
            else
            {
                @if (_windowStart > 0)
                {
                    <div id="message-list-top-sentinel" class="message-list-top-sentinel">
                        以上还有 @_windowStart 条
                    </div>
                }

                @for (var i = _windowStart; i < Items.Count; i++)
                {
                    var item = Items[i];
                    <TimelineItemView @key="item.Key" Item="@item" OnToolClick="@OnToolClickHandler" />
                }
            }
        </div>

        <div Id="@ScrollAnchorId" Class="scroll-anchor"></div>
    </div>

    <ScrollToBottomButton />
</div>

@code {
    private ElementReference MessageListElement { get; set; }

    private const string ContainerId = "message-list-container";
    private const string ContentId = "message-list-content";
    private const string ScrollAnchorId = "message-list-scroll-anchor";

    private bool _scrollManagerInitialized;
    private int _windowStart;
    private int _lastCount;
    private string? _lastFirstKey;
    private int _lastGeneration = -1;
    private int _trackedRenderCount;
    private string? _trackedTailKey;
    private int _trackedTailRevision;
    private bool _loadMoreInProgress;
    private double? _pendingPrependHeight;
    private bool _pendingForcePin;
    private int _forcePinRetriesRemaining;
    private bool _subscribed;

    private IReadOnlyList<TimelineModel.TimelineItem> Items => Timeline.Items;

    [Parameter]
    public EventCallback<ToolCallViewModel> OnToolClick { get; set; }

    [Parameter]
    public bool AutoScroll { get; set; } = true;

    protected override void OnInitialized()
    {
        Timeline.Changed += OnTimelineChanged;
        Timeline.PinRequested += OnPinRequested;
        _subscribed = true;
        SyncWindowFromStore(forcePinOnGenerationBump: true);
    }

    private void OnTimelineChanged()
    {
        SyncWindowFromStore(forcePinOnGenerationBump: true);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPinRequested()
    {
        RequestForcePin(retries: 2);
        _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
        => SyncWindowFromStore(forcePinOnGenerationBump: false);

    /// <summary>
    /// Keep window start in sync when the store changes without parent re-rendering.
    /// Generation bumps (ResetFromSession) always re-tail the window and request force pin.
    /// TailHint drives incremental scroll/window updates without requiring per-key dirty sets.
    /// </summary>
    private void SyncWindowFromStore(bool forcePinOnGenerationBump)
    {
        var items = Items;
        var firstKey = items.Count > 0 ? items[0].Key : null;
        var generation = Timeline.Generation;
        var generationBumped = generation != _lastGeneration;
        var structuralReset = generationBumped
            || items.Count < _lastCount
            || (_lastFirstKey != null && firstKey != _lastFirstKey)
            || (_lastCount == 0 && items.Count > 0);

        if (structuralReset)
            _windowStart = MessageListWindow.ComputeInitialStart(items.Count);

        if (forcePinOnGenerationBump && generationBumped && items.Count > 0)
            RequestForcePin(retries: 2);

        _lastGeneration = generation;
        _lastCount = items.Count;
        _lastFirstKey = firstKey;
    }

    private void RequestForcePin(int retries)
    {
        _pendingForcePin = true;
        _forcePinRetriesRemaining = Math.Max(_forcePinRetriesRemaining, Math.Max(retries, 4));
    }

    private async Task OnToolClickHandler(ToolCallViewModel tool)
    {
        if (OnToolClick.HasDelegate)
            await OnToolClick.InvokeAsync(tool);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureScrollManagerAsync();

        if (!_scrollManagerInitialized)
            return;

        if (_pendingForcePin)
        {
            var atBottom = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("forceScrollToBottom");
                atBottom = Items.Count == 0
                    || await JSRuntime.InvokeAsync<bool>("isAtBottom");
            }
            catch
            {
                // ignore
            }

            if (atBottom || _forcePinRetriesRemaining <= 0)
            {
                _pendingForcePin = false;
                _forcePinRetriesRemaining = 0;
            }
            else
            {
                _forcePinRetriesRemaining--;
                _pendingForcePin = true;
                await Task.Yield();
                _ = InvokeAsync(StateHasChanged);
                return;
            }
        }

        if (_pendingPrependHeight is double prevHeight)
        {
            _pendingPrependHeight = null;
            try
            {
                await JSRuntime.InvokeVoidAsync("preserveScrollOnPrepend", prevHeight);
            }
            catch
            {
                // ignore
            }
            finally
            {
                _loadMoreInProgress = false;
            }
        }

        var items = Items;
        if (items.Count == 0)
        {
            _trackedRenderCount = 0;
            _trackedTailKey = null;
            _trackedTailRevision = 0;
            return;
        }

        var tailKey = Timeline.TailKey ?? items[^1].Key;
        var tailRevision = Timeline.TailKey != null ? Timeline.TailRevision : items[^1].Revision;

        var contentGrew = items.Count > _trackedRenderCount
            || tailKey != _trackedTailKey
            || tailRevision != _trackedTailRevision;

        _trackedRenderCount = items.Count;
        _trackedTailKey = tailKey;
        _trackedTailRevision = tailRevision;

        if (contentGrew)
        {
            try
            {
                var pinned = await JSRuntime.InvokeAsync<bool>("shouldAutoScroll");
                if (pinned)
                {
                    var slid = MessageListWindow.SlideWhilePinned(_windowStart, items.Count);
                    if (slid != _windowStart)
                    {
                        _windowStart = slid;
                        await InvokeAsync(StateHasChanged);
                    }
                }

                if (AutoScroll)
                    await JSRuntime.InvokeVoidAsync("notifyContentGrew");
            }
            catch
            {
                // ignore
            }
        }

        // Avoid load-more while force-pinning: near-top would expand upward and leave viewport at top.
        if (!_pendingForcePin)
            await TryLoadMoreAsync();
    }

    private async Task EnsureScrollManagerAsync()
    {
        if (_scrollManagerInitialized)
            return;

        try
        {
            var ok = await JSRuntime.InvokeAsync<bool>("initMessageListScroll", ContainerId, ScrollAnchorId, ContentId);
            _scrollManagerInitialized = ok;
        }
        catch
        {
            // JSInterop may not be ready yet — retry next render
        }
    }

    private async Task TryLoadMoreAsync()
    {
        if (_loadMoreInProgress || _pendingPrependHeight.HasValue || _windowStart <= 0)
            return;

        try
        {
            var nearTop = await JSRuntime.InvokeAsync<bool>("isNearTop");
            if (!nearTop)
                return;

            _loadMoreInProgress = true;
            var prevHeight = await JSRuntime.InvokeAsync<double>("getScrollHeight");
            _windowStart = MessageListWindow.LoadMore(_windowStart);
            _pendingPrependHeight = prevHeight;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _pendingPrependHeight = null;
            _loadMoreInProgress = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribed)
        {
            Timeline.Changed -= OnTimelineChanged;
            Timeline.PinRequested -= OnPinRequested;
            _subscribed = false;
        }

        if (!_scrollManagerInitialized)
            return;

        try
        {
            await JSRuntime.InvokeVoidAsync("destroyMessageListScroll");
        }
        catch
        {
            // ignore
        }
    }
}
