@using AntDesign
@using Seeing.Agent.Scheduler.Models
@using Seeing.Agent.WebUI.Services

@{
    var (color, icon) = GetStateDisplay(State);
    var text = UiText.JobStateText(State, Expired);
}

<Tag Color="@color">
    @if (ShowText)
    {
        <Icon Type="@icon" />
        @text
    }
    else
    {
        <Icon Type="@icon" />
    }
</Tag>

@code {
    /// <summary>任务状态（<see cref="JobState"/>）。</summary>
    [Parameter] public JobState State { get; set; }

    /// <summary>启用但不会再有后续自动触发（一次性已过期等）。优先于 State 呈现。</summary>
    [Parameter] public bool Expired { get; set; }

    /// <summary>是否显示文字（false 时只渲染图标）。</summary>
    [Parameter] public bool ShowText { get; set; } = true;

    private static (string color, string icon) GetStateDisplay(JobState state) => state switch
    {
        JobState.Scheduled => ("green", IconType.Outline.CheckCircle),
        JobState.Running => ("blue", IconType.Outline.Sync),
        JobState.Paused => ("orange", IconType.Outline.PauseCircle),
        JobState.Disabled => ("default", IconType.Outline.Stop),
        _ => ("default", IconType.Outline.QuestionCircle)
    };
}
