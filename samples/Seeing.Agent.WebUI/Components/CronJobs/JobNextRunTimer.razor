@using AntDesign
@using Seeing.Agent.Scheduler.Models
@implements IDisposable

@code {
    [Parameter] public DateTime? NextRun { get; set; }
    [Parameter] public JobState State { get; set; } = JobState.Scheduled;
    [Parameter] public bool ShowIcon { get; set; } = true;
    
    private TimeSpan _remaining;
    private string _displayText = "-";
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        UpdateRemaining();
        _cts = new CancellationTokenSource();
        _ = RunTimerAsync(_cts.Token);
    }

    private async Task RunTimerAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                UpdateRemaining();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    protected override void OnParametersSet()
    {
        UpdateRemaining();
    }

    private void UpdateRemaining()
    {
        if (State == JobState.Paused || State == JobState.Disabled)
        {
            _displayText = "-";
            return;
        }

        if (NextRun.HasValue)
        {
            _remaining = NextRun.Value - DateTime.Now;
            if (_remaining.TotalSeconds <= 0)
            {
                _displayText = "即将执行";
            }
            else if (_remaining.TotalDays >= 1)
            {
                _displayText = $"{(int)_remaining.TotalDays}天 {_remaining.Hours:D2}:{_remaining.Minutes:D2}:{_remaining.Seconds:D2}";
            }
            else
            {
                _displayText = $"{_remaining.Hours:D2}:{_remaining.Minutes:D2}:{_remaining.Seconds:D2}";
            }
        }
        else
        {
            _displayText = "-";
        }
    }
}

<span class="next-run-timer">
    @if (ShowIcon)
    {
        <Icon Type="@IconType.Outline.ClockCircle" />
    }
    @_displayText
</span>