@using AntDesign
@using Microsoft.JSInterop
@using Seeing.Agent.Abstractions.Background
@using Seeing.Agent.WebUI.Helpers
@using Seeing.Agent.WebUI.Models
@using Seeing.Agent.WebUI.Models.Messaging
@using Seeing.Agent.WebUI.Rendering.Abstractions
@using Seeing.Agent.WebUI.Services
@inject IJSRuntime JSRuntime
@inject MessageService MessageService
@inject BackgroundActivityUiService ActivityControl

@* bash 专用命令卡（只读，无 stdin）：命令/输出靠颜色区分，浅色紧凑 *@

<div class="tool-call-shell bash-terminal-shell">
    <div class="bash-terminal-header" onclick="@ToggleExpand">
        <span class="bash-terminal-title">@_card.DisplayTitle</span>
        <div class="bash-terminal-meta">
            <Tag Color="@ToolCall.StatusTagColor" Style="font-size: 11px;">@ToolCall.StatusText</Tag>
            @if (_card.ExitCode.HasValue)
            {
                <span class="bash-exit-badge @BashToolDisplayHelper.ExitBadgeClass(_card.ExitCode)">
                    @BashToolDisplayHelper.ExitBadgeText(_card.ExitCode)
                </span>
            }
            @if (_card.TimedOut)
            {
                <Tag Color="@("warning")" Style="font-size: 11px;">超时</Tag>
            }
            @if (_card.Aborted)
            {
                <Tag Color="@("default")" Style="font-size: 11px;">已取消</Tag>
            }
            @if (!string.IsNullOrEmpty(ToolCall.GetFormattedDuration()))
            {
                <span class="bash-duration">@ToolCall.GetFormattedDuration()</span>
            }
            @if (ToolCall.IsRunning)
            {
                <Spin Size="@SpinSize.Small" />
            }
            <Icon Type="@(_isExpanded ? IconType.Outline.Down : IconType.Outline.Right)"
                  Style="font-size: 12px; color: var(--color-text-tertiary);" />
        </div>
    </div>

    @* bash 转后台（background=true）时不再另起状态行：命令与输出复用前台终端样式，
       活动状态/输出大小/取消入口压到展开区底部一行（见 body 末尾）。 *@

    @if (_isExpanded)
    {
        var bg = ToolCall.BackgroundActivity;
        var liveTail = bg is not null ? bg.LiveOutputTail : _card.DisplayOutput;
        var outputText = _showFullOutput && _fullOutput is not null ? _fullOutput : liveTail;
        // 前台活动（工具正在等待）不显示后台说明，只提供「转后台」。
        // 转后台后工具立即返回，但 Origin 仍是 ToolForeground —— 只能用工具是否还活区隔：
        // 前台且工具未结束 = 前台样式；前台但工具已结束 = 活动已独立跑，按后台展示。
        // 前台正常完成时活动也已终态，不应出现"后台"提示；
        // 只有「工具已返回、活动仍在跑」才是真正转过后台。
        var showBackgroundHint = bg is not null
            && (!bg.IsForeground
                || (bg.Status == BackgroundActivityStatus.Running && !ToolCall.IsRunning));
        var hasMoreOutput = bg is not null
            ? (bg.OutputBytes ?? 0) > 4096
            : BashToolDisplayHelper.ShouldCollapseByDefault(liveTail, false);

        <div class="bash-terminal-body">
            <code class="bash-command" title="@(_card.Workdir ?? "")">
                <span class="bash-prompt">$</span>@(_card.Command ?? "")
            </code>

            @if (!string.IsNullOrEmpty(outputText))
            {
                <pre @ref="_outputRef"
                     class="bash-terminal-pre @((bg is null && !_outputExpanded) ? "is-collapsed" : null)"
                     @onscroll="OnOutputScroll">@outputText</pre>
            }

            @if (!string.IsNullOrEmpty(ToolCall.Error))
            {
                <pre class="bash-terminal-pre is-error">@ToolCall.Error</pre>
            }

            <div class="bash-output-actions">
                @if (bg is null)
                {
                    @* 前台：按长度折叠（与既有行为一致）。 *@
                    @if (BashToolDisplayHelper.ShouldCollapseByDefault(outputText, false))
                    {
                        <button type="button" class="bash-text-action" @onclick="ToggleOutputExpanded">
                            @(_outputExpanded ? "收起" : "展开全部")
                        </button>
                    }
                }
                else if (showBackgroundHint && (hasMoreOutput || _fullOutput is not null))
                {
                    @* 后台：事件只带尾部，按需从活动输出读全量。前台运行中不提供（输出仍在长）。 *@
                    <button type="button" class="bash-text-action" @onclick="ToggleFullOutputAsync">
                        @(_showFullOutput ? "收起" : "展开全部")
                    </button>
                }
                <button type="button" class="bash-text-action is-muted" @onclick="@(() => CopyAsync(outputText))">复制</button>
            </div>

            @if (bg is not null && showBackgroundHint)
            {
                @* 后台活动的全部说明压成一行小字：多行回执（activity_id / 跟踪工具提示）不再占正文。 *@
                <div class="bash-background-hint">
                    <span class="bash-background-status">@bg.StatusText</span>
                    @if (bg.OutputSizeText is { } size)
                    {
                        <span>输出 @size</span>
                    }
                    <code class="bash-background-id" title="@bg.Id">@bg.Id</code>
                    @if (bg.CanCancel)
                    {
                        <button type="button" class="bash-text-action"
                                disabled="@(_cancelling || !ActivityControl.IsAvailable)"
                                @onclick="CancelBackgroundAsync">取消</button>
                    }
                </div>
            }
            else if (bg is not null && bg.CanDetach)
            {
                @* 前台运行中：把等待者放行，活动继续跑。不本地改状态，等 activity.* 事件。 *@
                <div class="bash-output-actions">
                    <button type="button" class="bash-text-action" disabled="@_detaching" @onclick="DetachAsync">转后台</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ToolCallViewModel ToolCall { get; set; } = new();
    [Parameter] public ContentBlock Block { get; set; } = default!;
    [Parameter] public RenderContext Context { get; set; } = default!;
    [Parameter] public EventCallback<ToolCallViewModel> OnToolClick { get; set; }

    private BashCardModel _card = BashCardModel.From(new ToolCallViewModel { Name = "bash" });
    private bool _isExpanded;
    private bool _outputExpanded = true;
    private bool _stickToBottom = true;
    private bool _userToggledCard;
    private bool _userToggledOutput;
    private string? _lastToolCallId;
    private string? _lastStatus;
    private ElementReference _outputRef;
    private bool _cancelling;
    private bool _detaching;
    private string? _fullOutput;
    private bool _showFullOutput;
    private bool _autoLoadedFull;

    /// <summary>
    /// 是否有可渲染的输出正文（前台取结果、后台取活动实时尾部）。
    /// <para>
    /// 输出为空时 <c>pre</c> 不存在，<see cref="_outputRef"/> 是空引用：此时调 JS 会抛
    /// <see cref="JSException"/> 并把 <c>_stickToBottom</c> 永久置 false（后台活动首帧常常还没有输出）。
    /// </para>
    /// </summary>
    private bool HasOutputText
    {
        get
        {
            if (_showFullOutput && !string.IsNullOrEmpty(_fullOutput))
                return true;

            return ToolCall.BackgroundActivity is { } bg
                ? !string.IsNullOrEmpty(bg.LiveOutputTail)
                : !string.IsNullOrEmpty(_card.DisplayOutput);
        }
    }

    protected override void OnParametersSet()
    {
        _card = BashCardModel.From(ToolCall);
        var status = ToolCall.Status?.ToLowerInvariant() ?? "";
        var isNew = _lastToolCallId != ToolCall.Id;

        if (isNew)
        {
            _lastToolCallId = ToolCall.Id;
            _userToggledCard = false;
            _userToggledOutput = false;
            _stickToBottom = true;
            _fullOutput = null;
            _showFullOutput = false;
            _autoLoadedFull = false;
            // 执行中、或后台活动仍在跑时默认展开；历史已完成默认折叠。
            _isExpanded = ToolCall.IsRunning
                || ToolCall.BackgroundActivity?.Status == BackgroundActivityStatus.Running;
            _outputExpanded = !BashToolDisplayHelper.ShouldCollapseByDefault(_card.DisplayOutput, ToolCall.IsRunning);
        }
        else if (!_userToggledCard)
        {
            // 执行中/后台活动进行中保持展开；结束后保持展开，避免折叠卸载 body 造成闪屏
            if (ToolCall.IsRunning
                || ToolCall.BackgroundActivity?.Status == BackgroundActivityStatus.Running)
            {
                _isExpanded = true;
            }
        }

        // 输出区：仅在用户未手动切换时，按长度在结束瞬间收起；流式过程勿强行展开
        if (!_userToggledOutput && !ToolCall.IsRunning
            && _lastStatus is "running" or "pending"
            && status is "success" or "failed" or "cancelled" or "rejected")
        {
            _outputExpanded = !BashToolDisplayHelper.ShouldCollapseByDefault(_card.DisplayOutput, false);
        }

        ToolCall.IsExpanded = _isExpanded;
        _lastStatus = status;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 终态时自动加载一次全量：事件只带尾部（4096 字符），
        // 否则用户必须点「展开全部」才能看到完整输出。
        if (ToolCall.BackgroundActivity is { } bg
            && bg.IsTerminal
            && !_autoLoadedFull
            && (bg.OutputBytes ?? 0) > 4096)
        {
            _autoLoadedFull = true;
            var full = await ActivityControl.ReadOutputAsync(bg.Id, bg.SessionId);
            if (!string.IsNullOrEmpty(full))
            {
                _fullOutput = full;
                _showFullOutput = true;
                StateHasChanged();
            }
        }

        // 转后台后工具调用已返回（IsRunning=false），但活动仍在跑、输出仍在长：两者都算「活」。
        var live = ToolCall.IsRunning
            || ToolCall.BackgroundActivity?.Status == BackgroundActivityStatus.Running;
        if (!_isExpanded || !_stickToBottom || !live || !HasOutputText)
            return;

        try
        {
            await JSRuntime.InvokeVoidAsync("bashTerminalStickBottom", _outputRef);
        }
        catch (JSException)
        {
            _stickToBottom = false;
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private void ToggleExpand()
    {
        _userToggledCard = true;
        _isExpanded = !_isExpanded;
        ToolCall.IsExpanded = _isExpanded;
    }

    private void ToggleOutputExpanded()
    {
        _userToggledOutput = true;
        _outputExpanded = !_outputExpanded;
    }

    /// <summary>
    /// 后台活动：事件只带尾部，展开时从活动输出分页读全量（最多约 256KB）。
    /// </summary>
    private async Task ToggleFullOutputAsync()
    {
        if (_showFullOutput)
        {
            _showFullOutput = false;
            return;
        }

        if (_fullOutput is null && ToolCall.BackgroundActivity is { } bg)
            _fullOutput = await ActivityControl.ReadOutputAsync(bg.Id, bg.SessionId);

        _showFullOutput = !string.IsNullOrEmpty(_fullOutput);
    }

    private async Task OnOutputScroll()
    {
        try
        {
            _stickToBottom = await JSRuntime.InvokeAsync<bool>("bashTerminalIsNearBottom", _outputRef);
        }
        catch
        {
            _stickToBottom = true;
        }
    }

    private async Task CopyAsync(string? outputText)
    {
        var text = !string.IsNullOrEmpty(outputText)
            ? outputText!
            : (_card.Command ?? "");
        if (string.IsNullOrEmpty(text) && string.IsNullOrEmpty(ToolCall.Error))
            return;
        if (string.IsNullOrEmpty(text) && !string.IsNullOrEmpty(ToolCall.Error))
            text = ToolCall.Error;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            MessageService.Success("已复制");
        }
        catch
        {
            MessageService.Error("复制失败");
        }
    }

    /// <summary>
    /// 取消后台活动（用户显式操作）。
    /// <para>成功与否不由本地改状态：终态以 activity 事件为准（事件是唯一真相）。</para>
    /// </summary>
    private async Task CancelBackgroundAsync()
    {
        if (ToolCall.BackgroundActivity is not { } activity || _cancelling)
            return;

        _cancelling = true;
        try
        {
            await ActivityControl.CancelAsync(activity.Id, activity.SessionId);
        }
        finally
        {
            _cancelling = false;
        }
    }

    /// <summary>
    /// 「转后台」：放行前台等待者，活动继续运行。
    /// <para>
    /// 不本地改状态：工具随后返回成功、hint 行出现，都由工具调用更新与
    /// <c>activity.*</c> 事件驱动；本地抢先改会与推送打架。
    /// </para>
    /// </summary>
    private async Task DetachAsync()
    {
        if (ToolCall.BackgroundActivity is not { } activity || _detaching)
            return;

        _detaching = true;
        try
        {
            await ActivityControl.DetachAsync(activity.Id);
        }
        finally
        {
            _detaching = false;
        }
    }
}
