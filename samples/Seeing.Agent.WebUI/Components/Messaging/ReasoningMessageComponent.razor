@using AntDesign
@using Seeing.Agent.WebUI.Rendering.Abstractions

@* 推理消息组件 - 渲染思考/推理过程 *@

<div class="content-block-reasoning reasoning-section @(_isExpanded ? "expanded" : "collapsed")" data-reasoning-id="@Block.Id">
    @* 折叠头部（可点击） *@
    <div class="reasoning-header" onclick="@ToggleExpanded" onclick:stopPropagation="true">
        <span class="reasoning-toggle-icon">▶</span>
        <span class="reasoning-icon">
            @if (IsComplete)
            {
                <Icon Type="@IconType.Outline.Bulb" Theme="@IconThemeType.Outline" />
            }
            else
            {
                <Icon Type="@IconType.Outline.Loading" Theme="@IconThemeType.Outline" Spin="true" />
            }
        </span>
        <span class="reasoning-label">@(IsComplete ? "已思考" : "思考中")</span>
        <span class="reasoning-preview">
            @GetContentPreview()
        </span>
    </div>
    
    @* 内容区域 *@
    <div class="reasoning-content">
        <div class="reasoning-content-scroll" style="font-size: 12px; color: var(--color-text-tertiary); max-height: 400px; overflow-y: auto; overflow-x: hidden; word-break: break-word; overflow-wrap: break-word;">
            @((MarkupString)HtmlContent)
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Content { get; set; } = string.Empty;
    
    [Parameter]
    public RenderContext Context { get; set; } = default!;
    
    [Parameter]
    public ContentBlock Block { get; set; } = default!;

    /// <summary>折叠状态：流式时默认展开，完成后默认折叠</summary>
    private bool _isExpanded;

    /// <summary>是否已完成</summary>
    private bool IsComplete => Block.IsComplete;

    /// <summary>渲染后的 HTML 内容</summary>
    private string HtmlContent => string.IsNullOrEmpty(Content) 
        ? string.Empty 
        : Context.Cache?.GetOrCreateMarkdown(Content, Context.GetMarkdownCacheKey(Block)) ?? Content;

    protected override void OnInitialized()
    {
        // 流式时默认展开，完成后默认折叠
        _isExpanded = !Block.IsComplete;
    }

    /// <summary>切换展开/折叠</summary>
    private void ToggleExpanded()
    {
        _isExpanded = !_isExpanded;
        StateHasChanged();
    }

    /// <summary>获取内容预览（第一行，最多 60 字符）</summary>
    private string GetContentPreview()
    {
        if (!IsComplete)
            return "思考中...";

        if (string.IsNullOrEmpty(Content))
            return "0 字符";
        
        var text = Content;
        var firstLine = text.Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .FirstOrDefault(l => l.Length > 0 && !l.StartsWith("```") && !l.StartsWith("#"));
        
        if (string.IsNullOrEmpty(firstLine))
            firstLine = text.Split('\n').FirstOrDefault()?.Trim() ?? "";
        
        if (firstLine.Length > 60)
            return firstLine[..60] + "...";
        
        return firstLine;
    }
}