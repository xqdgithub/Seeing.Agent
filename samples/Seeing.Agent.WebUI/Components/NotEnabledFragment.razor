@namespace Seeing.Agent.WebUI.Components
@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Seeing.Agent.Core.Scenarios
@using Seeing.Agent.WebUI.Services
@inject NavigationManager Navigation

<div class="not-enabled-fragment" style="padding: 48px 24px; max-width: 640px; margin: 0 auto;">
    <PageTitle>未启用 · @(FeatureTitle ?? "功能") · Seeing</PageTitle>
    <Alert Type="@AlertType.Info"
           ShowIcon="true"
           Message="@($"当前工作模式未启用「{FeatureTitle ?? "该功能"}」")"
           Description="@BuildDescription()"
           Style="margin-bottom: 24px;" />
    <Space>
        <Button Type="@ButtonType.Primary" OnClick="GoSettings">前往设置切换工作模式</Button>
        <Button OnClick="GoHome">返回首页</Button>
    </Space>
</div>

@code {
    /// <summary>功能显示名（如「记忆」「MCP」）。</summary>
    [Parameter] public string? FeatureTitle { get; set; }

    /// <summary>提供该页的模块 id（仅用于查找可切换的工作模式，不展示给用户）。</summary>
    [Parameter] public string? ModuleId { get; set; }

    private string BuildDescription()
    {
        var name = FeatureTitle ?? "该功能";
        var scenarios = SuggestScenarios();
        if (scenarios.Count == 0)
            return $"当前工作模式不包含「{name}」。请前往设置切换到包含该功能的工作模式，或调整该工作模式包含的模块。";

        return $"当前工作模式不包含「{name}」。可切换到包含它的工作模式：{string.Join("、", scenarios)}。";
    }

    private IReadOnlyList<string> SuggestScenarios()
    {
        if (string.IsNullOrWhiteSpace(ModuleId))
            return [];

        return BuiltInScenarios.All
            .Where(s => s.Modules.Any(m => string.Equals(m, ModuleId, StringComparison.OrdinalIgnoreCase)))
            .Select(s => s.Name)
            .ToArray();
    }

    private void GoSettings() => Navigation.NavigateTo("/settings");

    private void GoHome() => Navigation.NavigateTo("/");
}
