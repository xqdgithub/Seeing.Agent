@using AntDesign
@using Seeing.Agent.Core.Llm
@using Seeing.Agent.Llm
@using Seeing.Agent.Memory.Abstractions
@using Seeing.Agent.Memory.Configuration
@inject IMemoryOptionsStore OptionsStore
@inject IModelConfigManager ModelManager
@inject IEmbeddingStatus EmbeddingStatus
@inject IEmbeddingConnectionTester EmbeddingTester
@inject IMessageService MessageService

@*
    记忆配置卡片。由设置页 Settings.razor 经 SettingsCardContribution 渲染为「记忆」页签。
    刻意不带 WorkspacePageShell：设置页已在外壳内，再嵌一层会出现双标题与双面包屑。
    保存按钮放在卡片内部（原页面在页面头部 Extra 区，卡片化后没有 Extra 区）。
*@

@if (_options is not null)
{
    <Alert Type="@AlertType.Info"
           Message="@($"向量状态: {(EmbeddingStatus.IsAvailable ? "已启用" : EmbeddingStatus.Reason)}")"
           ShowIcon="true" Style="margin-bottom: 16px;" />

    <Form Model="@_options" Layout="@FormLayout.Vertical">
        <Card Title="捕获" Style="margin-bottom: 16px;">
            <FormItem Label="自动捕获"><Switch @bind-Value="@_options.Capture.AutoCapture" /></FormItem>
            <FormItem Label="捕获对话"><Switch @bind-Value="@_options.Capture.CaptureChat" /></FormItem>
            <FormItem Label="捕获工具">
                <Switch @bind-Value="@_options.Capture.CaptureTools" Disabled />
                <div style="color:#888;font-size:12px;margin-top:4px;">批量抽取模式下工具捕获已停用</div>
            </FormItem>
            <FormItem Label="Snippet 上限"><AntDesign.InputNumber @bind-Value="@_options.Capture.MaxSnippetChars" Min="256" Max="32000" /></FormItem>
            <FormItem Label="队列容量"><AntDesign.InputNumber @bind-Value="@_options.Capture.QueueCapacity" Min="8" Max="4096" /></FormItem>
        </Card>
        <Card Title="抽取" Style="margin-bottom: 16px;">
            <FormItem Label="启用 LLM 抽取"><Switch @bind-Value="@_options.Extraction.Enabled" /></FormItem>
            <FormItem Label="最低重要性"><AntDesign.InputNumber @bind-Value="@_options.Extraction.MinImportance" Min="0" Max="1" Step="0.1" /></FormItem>
            <FormItem Label="每 N 轮抽取"><AntDesign.InputNumber @bind-Value="@_options.Extraction.ExtractEveryNTurns" Min="0" Max="100" /></FormItem>
            <FormItem Label="空闲 Flush 分钟"><AntDesign.InputNumber @bind-Value="@_options.Extraction.FlushIdleMinutes" Min="0" Max="1440" /></FormItem>
            <FormItem Label="每分钟 Flush 上限"><AntDesign.InputNumber @bind-Value="@_options.Extraction.MaxCandidatesPerMinute" Min="1" Max="60" /></FormItem>
            <FormItem Label="抽取模型">
                <ModelSelectDropdown Value="@_extractionKey"
                                     ValueChanged="OnExtractionKeyChanged"
                                     FilterType="ModelType.Text"
                                     AllowClear="true"
                                     Placeholder="空则使用 chat 默认模型"
                                     Style="width: 100%;" />
            </FormItem>
        </Card>
        <Card Title="演化" Style="margin-bottom: 16px;">
            <FormItem Label="启用演化"><Switch @bind-Value="@_options.Evolution.Enabled" /></FormItem>
            <FormItem Label="会话结束时演化"><Switch @bind-Value="@_options.Evolution.OnSessionEnd" /></FormItem>
            <FormItem Label="空闲分钟"><AntDesign.InputNumber @bind-Value="@_options.Evolution.IdleMinutes" Min="1" Max="1440" /></FormItem>
            <FormItem Label="Digest 重要性阈值"><AntDesign.InputNumber @bind-Value="@_options.Evolution.PromoteToDigestMinImportance" Min="0" Max="1" Step="0.1" /></FormItem>
        </Card>
        <Card Title="Embedding" Style="margin-bottom: 16px;">
            <FormItem Label="启用向量检索">
                <Switch @bind-Value="@_options.Embedding.Enabled" />
                <div style="color:#888;font-size:12px;margin-top:4px;">
                    默认关闭。向量索引一开跑就有后台成本，必须显式开启（决议 10）
                </div>
            </FormItem>
            <FormItem Label="Embedding 模型">
                <ModelSelectDropdown Value="@_embeddingKey"
                                     ValueChanged="OnEmbeddingKeyChanged"
                                     FilterType="ModelType.Embedding"
                                     AllowClear="true"
                                     Placeholder="空则不启用向量检索"
                                     Style="width: 100%;" />
                <div style="color:#888;font-size:12px;margin-top:4px;">
                    必须显式选择 <c>provider/model</c>；不读全局 embedding 默认值，也不自动挑模型。
                </div>
            </FormItem>
            @if (!ModelManager.GetModelsByType(ModelType.Embedding).Any())
            {
                <Alert Type="@AlertType.Warning"
                       Message="请先在模型管理中为模型勾选 Embedding 类型"
                       ShowIcon="true"
                       Style="margin-bottom: 12px;" />
            }
            else if (_embeddingModelUnresolved)
            {
                <Alert Type="@AlertType.Warning"
                       Message="@($"已配置的向量模型不在模型目录中：{_embeddingKey}（请重新选择或清空）")"
                       ShowIcon="true"
                       Style="margin-bottom: 12px;" />
            }
            <FormItem Label="连接测试">
                <Space>
                    <Button Loading="@_testingEmbedding" OnClick="TestEmbeddingAsync">测试连接</Button>
                    @if (!string.IsNullOrEmpty(_embeddingTestMessage))
                    {
                        <span style="@(_embeddingTestOk ? "color: #389e0d;" : "color: #cf1322;")">@_embeddingTestMessage</span>
                    }
                    @if (_embeddingTestDimensions is int dims)
                    {
                        @* 维度只展示：配置项已删除，不再落盘（探测值随模型而变，写死反而会漂移） *@
                        <span style="color: #888;">维度: @dims（仅探测结果，不写入配置）</span>
                    }
                </Space>
            </FormItem>
        </Card>
        <Card Title="召回">
            <FormItem Label="模式">
                <Select TItem="MemoryRetrievalMode"
                        TItemValue="MemoryRetrievalMode"
                        @bind-Value="@_options.Retrieval.Mode"
                        Style="width: 240px;">
                    <SelectOptions>
                        <SelectOption TItem="MemoryRetrievalMode" TItemValue="MemoryRetrievalMode" Value="MemoryRetrievalMode.Both" Label="Both" />
                        <SelectOption TItem="MemoryRetrievalMode" TItemValue="MemoryRetrievalMode" Value="MemoryRetrievalMode.AutoInject" Label="AutoInject" />
                        <SelectOption TItem="MemoryRetrievalMode" TItemValue="MemoryRetrievalMode" Value="MemoryRetrievalMode.ToolsOnly" Label="ToolsOnly" />
                    </SelectOptions>
                </Select>
            </FormItem>
            <FormItem Label="TopK"><AntDesign.InputNumber @bind-Value="@_options.Retrieval.TopK" Min="1" Max="50" /></FormItem>
            <FormItem Label="注入超时(ms)"><AntDesign.InputNumber @bind-Value="@_options.Retrieval.InjectTimeoutMs" Min="50" Max="5000" /></FormItem>
        </Card>
    </Form>

    <div style="text-align: right; margin-top: 16px;">
        <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Save"
                OnClick="SaveAsync" Loading="@_saving">保存</Button>
    </div>
}

@code {
    private MemoryOptions? _options;
    private bool _saving;
    private bool _testingEmbedding;
    private bool _embeddingTestOk;
    private string? _embeddingTestMessage;
    private int? _embeddingTestDimensions;
    private string? _embeddingKey;
    private string? _extractionKey;
    /// <summary>配置里的向量模型引用在目录中找不到（只提示，不自动改写配置）。</summary>
    private bool _embeddingModelUnresolved;

    protected override void OnInitialized()
    {
        _options = Clone(OptionsStore.Get());
        RefreshModelKeys();
    }

    private void RefreshModelKeys()
    {
        if (_options is null) return;

        _embeddingKey = ResolveEmbeddingKey(_options.Embedding.ModelId);
        _extractionKey = ResolveExtractionKey(_options.Extraction.Model);
    }

    /// <summary>
    /// 回填向量模型下拉：<c>Embedding.ModelId</c> 本身就是 <c>provider/model</c> 引用，
    /// 经 <see cref="IModelConfigManager.GetModel"/> 校验存在性；找不到也原样回显，
    /// 让下拉显示「（不可用）」并给出告警——静默清空配置等于替用户做决定。
    /// </summary>
    private string? ResolveEmbeddingKey(string? modelId)
    {
        if (string.IsNullOrWhiteSpace(modelId))
        {
            _embeddingModelUnresolved = false;
            return null;
        }

        var reference = modelId.Trim();
        _embeddingModelUnresolved = ModelManager.GetModel(reference) is null;
        return reference;
    }

    private string? ResolveExtractionKey(string? model)
    {
        if (string.IsNullOrWhiteSpace(model))
            return null;

        if (ModelManager.GetModel(model) is not null)
            return model;

        var match = ModelManager.GetModelsByType(ModelType.Text)
            .FirstOrDefault(kv => kv.Value.Id.Equals(model, StringComparison.OrdinalIgnoreCase));
        return match.Key is { Length: > 0 } ? match.Key : model;
    }

    private void OnExtractionKeyChanged(string? value)
    {
        _extractionKey = value;
        if (_options is null) return;

        if (string.IsNullOrEmpty(value))
        {
            _options.Extraction.Model = null;
            return;
        }

        var cfg = ModelManager.GetModel(value);
        _options.Extraction.Model = cfg?.Id ?? value;
    }

    /// <summary>只写 <c>Embedding.ModelId</c>（Provider / Model / Dimensions 配置项已删除）。</summary>
    private void OnEmbeddingKeyChanged(string? value)
    {
        _embeddingKey = value;
        if (_options is null) return;

        // 换了模型就丢掉上一次探测结果，避免把旧维度当成当前模型的结论
        _embeddingTestMessage = null;
        _embeddingTestDimensions = null;

        if (string.IsNullOrEmpty(value))
        {
            _embeddingModelUnresolved = false;
            _options.Embedding.ModelId = null;
            return;
        }

        var reference = value.Trim();
        _embeddingModelUnresolved = ModelManager.GetModel(reference) is null;
        _options.Embedding.ModelId = reference;
    }

    private async Task SaveAsync()
    {
        if (_options is null) return;
        _saving = true;
        try
        {
            await OptionsStore.SaveAsync(_options);
            MessageService.Success("记忆设置已保存");
            _options = Clone(OptionsStore.Get());
            RefreshModelKeys();
        }
        catch (Exception ex)
        {
            MessageService.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestEmbeddingAsync()
    {
        if (_options is null) return;
        _testingEmbedding = true;
        _embeddingTestMessage = null;
        _embeddingTestDimensions = null;
        try
        {
            // 探针按 ModelId 发（空则由 tester 按配置判定失败，不自动挑模型）；维度只展示不落盘
            var result = await EmbeddingTester.TestAsync(
                _options.Embedding.ModelId,
                CancellationToken.None);
            _embeddingTestOk = result.Success;
            _embeddingTestMessage = result.Message;
            _embeddingTestDimensions = result.Dimensions;
        }
        catch (Exception ex)
        {
            _embeddingTestOk = false;
            _embeddingTestMessage = ex.Message;
        }
        finally
        {
            _testingEmbedding = false;
        }
    }

    private static MemoryOptions Clone(MemoryOptions src) =>
        System.Text.Json.JsonSerializer.Deserialize<MemoryOptions>(
            System.Text.Json.JsonSerializer.Serialize(src)) ?? new MemoryOptions();
}
