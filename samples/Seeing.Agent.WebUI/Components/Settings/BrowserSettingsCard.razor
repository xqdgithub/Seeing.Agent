@using AntDesign
@using Microsoft.Extensions.Options
@using System.ComponentModel
@using System.Diagnostics
@using System.Text.Json
@using Seeing.Agent.Abstractions.Configuration
@using Seeing.Agent.Tools.Browser
@using Seeing.Agent.WebUI.Services
@inject SeeingConfigService ConfigService
@inject IOptionsMonitor<BrowserOptions> BrowserOptionsMonitor
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IMessageService MessageService
@implements IDisposable

@*
    浏览器配置卡片（设置页页签「浏览器」）。

    为什么这些项要暴露给用户：
      · Headless 是「能不能过反爬」的决定性开关，也是「会不会弹窗」的开关 ——
        两种需求都存在，写死任何一侧都会让另一类用户无法工作。
      · AntiDetection 涉及安全与兼容性的取舍（去掉沙箱、要求真 GPU），
        用户需要知道代价并自行决定。
      · ExecutablePath / AllowPrivateHosts 属于本机事实与安全边界，必须是用户级配置。

    ⚠ 作用域：本卡保存到**用户级** seeing.json。Browser 节被注册为 UserOnly
      （ExecutablePath 决定启动哪个可执行文件、AllowPrivateHosts 决定能否访问内网），
      项目级配置文件随仓库分发、内容由第三方控制，允许它们覆盖等于 git clone 即远程代码执行/SSRF。
*@

@if (_model is not null)
{
    if (_pendingRestart)
    {
        <Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom: 16px;"
               Message="有浏览器设置已保存，但当前运行的浏览器还是旧设置。请点击下方「关闭浏览器」；若浏览器没在运行，下次打开时会直接用新设置。" />
    }

    @* ── 浏览器进程（只读） ── *@
    <Card Title="浏览器进程" Style="margin-bottom: 16px;">
        <Descriptions Column="2">
            <DescriptionsItem Title="状态">
                @if (_hostAlive)
                {
                    <Tag Color="@("green")">运行中</Tag>
                }
                else
                {
                    <Tag>未运行</Tag>
                    <span style="color:#888;font-size:12px;">
                        @(_hostInfo is null ? "首次使用浏览器时会自动启动" : "以下为上次运行的记录")
                    </span>
                }
            </DescriptionsItem>
            <DescriptionsItem Title="配置文件位置">
                <code>@HostProfilePath</code>
            </DescriptionsItem>
            <DescriptionsItem Title="进程号">
                @(_hostInfo is { } processInfo ? processInfo.HostPid.ToString() : "-")
            </DescriptionsItem>
            <DescriptionsItem Title="启动标识">
                @(_hostInfo?.Generation ?? "-")
            </DescriptionsItem>
            <DescriptionsItem Title="连接地址" Span="2">
                @if (string.IsNullOrWhiteSpace(_hostInfo?.Endpoint))
                {
                    <span>-</span>
                }
                else
                {
                    <code>@_hostInfo!.Endpoint</code>
                }
            </DescriptionsItem>
            <DescriptionsItem Title="上次错误" Span="2">
                @if (string.IsNullOrWhiteSpace(_hostInfo?.LastError))
                {
                    <span>无</span>
                }
                else
                {
                    <span style="color:#cf1322;">@_hostInfo!.LastError</span>
                }
            </DescriptionsItem>
        </Descriptions>

        <div style="margin-top: 16px; color:#888; font-size:12px;">
            @(_hostAlive ? "正在使用的设置" : "上次运行使用的设置")
        </div>

        @if (_hostInfo?.Effective is { } effective)
        {
            <Descriptions Column="2">
                <DescriptionsItem Title="启动方式">
                    @(effective.Headless ? "无头（不弹窗口）" : "有窗口显示")
                </DescriptionsItem>
                <DescriptionsItem Title="浏览器程序">
                    @(string.IsNullOrWhiteSpace(effective.ExecutablePath) ? "自动探测" : effective.ExecutablePath)
                </DescriptionsItem>
                <DescriptionsItem Title="User-Agent">
                    @(string.IsNullOrWhiteSpace(effective.UserAgent) ? "自动" : effective.UserAgent)
                </DescriptionsItem>
                <DescriptionsItem Title="反自动化检测规避">
                    @(effective.AntiDetection ? "开启" : "关闭")
                </DescriptionsItem>
                <DescriptionsItem Title="自动退出" Span="2">
                    @DescribeHostIdle(effective.HostIdleSeconds)
                </DescriptionsItem>
            </Descriptions>
        }
        else
        {
            <div style="color:#888;font-size:12px;">尚无运行记录</div>
        }

        <div style="display:flex;align-items:center;gap:12px;margin-top:16px;flex-wrap:wrap;">
            <Button Loading="@_closing" OnClick="CloseBrowserAsync">关闭浏览器</Button>
            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="RefreshHostAndRender">刷新状态</Button>
            <span style="color:#888;font-size:12px;">
                浏览器相关设置修改后，关闭浏览器才会生效。
            </span>
        </div>
    </Card>

    @* ── 显示与反检测 ── *@
    <Card Title="运行模式" Style="margin-bottom: 16px;">
        <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-bottom:12px;line-height:1.6;">
            下列设置在浏览器进程启动时读取，由浏览器进程持有；改动后需重启浏览器才会生效。
        </div>
        <Form Model="@_model" Layout="@FormLayout.Vertical">
            <FormItem>
                <div style="display:flex;align-items:center;gap:8px;">
                    <Switch @bind-Value="@_model.Headless" />
                    <span>无头模式（不弹窗）</span>
                </div>
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    <strong>遇到「请验证你是真人」时应关闭。</strong>
                    有头模式的渲染指纹与普通浏览器几乎一致（真实 GPU 合成、真实窗口焦点）；
                    无头模式即使做了伪装，仍可能被识别。代价是会在桌面弹出一个浏览器窗口。
                    <br />
                    <strong>有头模式下每个会话是一个独立 OS 窗口</strong>（不是同一个窗口里的标签页）：
                    Chromium 只给可见标签页出 screencast 帧，共用标签页会让后台会话永远黑屏。
                </div>
            </FormItem>

            <FormItem Label="宿主空闲退出（秒，0 = 不退出）">
                <AntDesign.InputNumber @bind-Value="@_model.HostIdleSeconds" Min="0" Max="86400" Style="width: 140px;" />
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    连续这么久没有任何存活客户端时，浏览器宿主进程自行退出（Chromium 随之关闭）。
                    <br />
                    它只在宿主启动时读取，改动后需重启浏览器才生效。
                </div>
            </FormItem>

            <FormItem>
                <div style="display:flex;align-items:center;gap:8px;">
                    <Switch @bind-Value="@_model.AntiDetection" />
                    <span>启用反自动化检测规避</span>
                </div>
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    开启后：移除 <code>--no-sandbox</code> / <code>--disable-gpu</code> 等自动化标志、
                    消除 <code>navigator.webdriver</code>、伪装 UA 去掉 Headless 标记、
                    修补 <code>navigator.plugins</code> / <code>languages</code> / WebGL vendor。@*
                    *@关闭后启动参数最保守（兼容无 GPU 的容器），但指纹明显是自动化。
                </div>
            </FormItem>
        </Form>
    </Card>

    @* ── 登录态 ── *@
    <Card Title="登录态" Style="margin-bottom: 16px;">
        <Form Model="@_model" Layout="@FormLayout.Vertical">
            <FormItem>
                <div style="display:flex;align-items:center;gap:8px;">
                    <Switch @bind-Value="@_model.PersistLogin" />
                    <span>复用持久 profile（保留登录态）</span>
                </div>
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    开启后所有会话共用同一个浏览器 profile：在任何一次会话里登录过的站点，
                    之后都保持登录。@*
                    *@<strong>代价是 cookie 跨会话共享</strong>——两个会话同时操作同一站点账号会互相顶掉登录态。
                    <br />
                    关闭则每次会话独立隔离（每会话一个无痕上下文），
                    <strong>浏览器重启后登录态丢失</strong>，需要重新登录。
                    这个开关在每次建页时读取，改了不需要重启浏览器。
                </div>
            </FormItem>

            <FormItem Label="profile 目录（留空使用默认）">
                <Input @bind-Value="@_model.ProfileDirectory"
                       Placeholder="留空 → 用户目录/.seeing/browser-profile" />
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    当前生效：<code>@EffectiveProfilePath</code>
                    <br />
                    它同时是浏览器宿主的<b>固定身份</b>与 Chromium 的 <code>user-data-dir</code>
                    （与上面的「复用持久 profile」开关无关——宿主必须有稳定目录，否则客户端会各自认出
                    一个不存在的宿主并重复拉起浏览器）。
                    <br />
                    同一目录不能被两个浏览器进程同时打开；多个实例请各配不同目录。
                    目录在启动浏览器时读取，<strong>改动后需重启浏览器</strong>。
                </div>
            </FormItem>
        </Form>
    </Card>

    @* ── 视口与超时 ── *@
    <Card Title="视口与超时" Style="margin-bottom: 16px;">
        <Form Model="@_model" Layout="@FormLayout.Vertical">
            <FormItem Label="初始视口宽 / 高（像素）">
                <Space>
                    <AntDesign.InputNumber @bind-Value="@_model.ViewportWidth" Min="320" Max="4096" Style="width: 120px;" />
                    <span>×</span>
                    <AntDesign.InputNumber @bind-Value="@_model.ViewportHeight" Min="240" Max="4096" Style="width: 120px;" />
                </Space>
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    只用于「还没人打开工作台」时的初始值；工作台连上后会自动按面板实际尺寸调整。
                </div>
            </FormItem>

            <FormItem Label="空闲回收（秒，0 = 不回收）">
                <AntDesign.InputNumber @bind-Value="@_model.IdleSeconds" Min="0" Max="86400" Style="width: 140px;" />
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    页面静默多久后回收（只关页面，不关浏览器进程，<strong>不影响登录态</strong>）。
                    <br />
                    实际回收时间 = 该值 + 最多 30 秒（后台每 30 秒扫描一次）。
                </div>
            </FormItem>

            <FormItem Label="单次操作超时（秒）">
                <AntDesign.InputNumber @bind-Value="@_model.DefaultTimeoutSeconds" Min="1" Max="300" Style="width: 140px;" />
            </FormItem>
        </Form>
    </Card>

    @* ── 安全边界 ── *@
    <Card Title="安全边界" Style="margin-bottom: 16px;">
        <div class="browser-settings-hint" style="color:#cf1322;font-size:12px;margin-bottom:12px;line-height:1.6;">
            <strong>已知安全边界（不是「已隔离」）：</strong>浏览器宿主在 loopback 上提供
            <b>无认证</b>的 CDP / HTTP 端点（如 <code>/json/version</code>）。
            同机的<b>任意进程</b>都可以通过它接管该浏览器，并读取其中的全部 cookie
            （包括已登录站点）。只有改用 Pipe 或在本地 token 代理之后才算隔离 ——
            当前实现两者都没有，请把这台机器上的进程都视为同等可信。
        </div>
        <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-bottom:12px;line-height:1.6;">
            可执行文件、启动参数与 User-Agent 都在浏览器进程启动时读取，改动后需重启浏览器才会生效。
        </div>
        <Form Model="@_model" Layout="@FormLayout.Vertical">
            <FormItem>
                <div style="display:flex;align-items:center;gap:8px;">
                    <Switch @bind-Value="@_model.AllowPrivateHosts" />
                    <span>允许访问内网与回环地址</span>
                </div>
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    默认关闭：阻止访问 <code>127.0.0.1</code>、<code>192.168.*</code>、
                    云元数据地址 <code>169.254.169.254</code> 等。@*
                    *@<strong>开启后智能体可访问本机与内网上的任何服务</strong>（包括管理后台），请确认你信任当前会话。
                </div>
            </FormItem>

            <FormItem Label="浏览器可执行文件路径（留空自动探测）">
                <Input @bind-Value="@_model.ExecutablePath"
                       Placeholder="@ExecutablePlaceholder" />
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    当前探测结果：<code>@_resolvedExecutable</code>
                    <Button Type="@ButtonType.Link" Size="@ButtonSize.Small"
                            OnClick="RefreshExecutableAndRender">重新探测</Button>
                    <br />
                    浏览器进程在启动时探测磁盘，并把结果固定下来；换浏览器或改了路径后需重启浏览器。
                    这里点「重新探测」只刷新本页显示。
                </div>
            </FormItem>

            <FormItem Label="追加启动参数（每行一个）">
                <TextArea @bind-Value="@_model.ExtraArgsText" Rows="3"
                          Placeholder="例如：--proxy-server=http://127.0.0.1:7890" />
                <div class="browser-settings-hint" style="color:#888;font-size:12px;margin-top:4px;line-height:1.6;">
                    追加在默认参数之后，可用于覆盖。需要代理访问外网时写在这里。
                </div>
            </FormItem>

            <FormItem Label="自定义 User-Agent（留空自动处理）">
                <Input @bind-Value="@_model.UserAgent"
                       Placeholder="留空 → 反检测开启时去掉 UA 里的 Headless 标记" />
            </FormItem>
        </Form>
    </Card>

    <div style="text-align: right;">
        <Space>
            <Button OnClick="ResetToEffective" Disabled="@_saving">撤销修改</Button>
            <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Save"
                    OnClick="SaveAsync" Loading="@_saving">保存</Button>
        </Space>
    </div>
}

@code {
    private BrowserSettingsModel? _model;
    private bool _saving;
    private bool _pendingRestart;

    /// <summary>最近一次读到的发现文件内容（可能属于已经退出的宿主，用于展示上次错误与上次设置）。</summary>
    private BrowserHostInfo? _hostInfo;

    /// <summary>发现文件描述的宿主进程是否仍然存活（PID 与启动时刻都要对上）。</summary>
    private bool _hostAlive;

    /// <summary>「关闭浏览器」请求进行中（防重复点击，同时驱动按钮 Loading）。</summary>
    private bool _closing;

    /// <summary>进入编辑时的进程级签名快照（保存后比对，判断是否真的需要重启）。</summary>
    private string _signatureBeforeSave = string.Empty;
    private string _resolvedExecutable = "(未检测)";
    private string EffectiveProfilePath => BrowserEngine.ResolveProfileDirectory(BrowserOptionsMonitor.CurrentValue);

    /// <summary>
    /// 浏览器进程使用的 profile 目录（与「复用持久 profile」开关无关：宿主必须有稳定的身份）。
    /// </summary>
    private string HostProfilePath => BrowserHostLocator.ResolveHostProfileDirectory(
        BrowserOptionsMonitor.CurrentValue.ProfileDirectory);

    private IDisposable? _optionsSub;

    protected override void OnInitialized()
    {
        _optionsSub = BrowserOptionsMonitor.OnChange((_, _) =>
        {
            // 外部改了配置（文件热重载）：刷新可执行文件探测结果与默认路径展示。
            // 刻意不回填编辑中的表单：用户可能正在改，被外部热重载覆盖会丢输入。
            _ = InvokeAsync(() =>
            {
                RefreshExecutable();
                RefreshHost();
                StateHasChanged();
            });
        });

        ResetToEffective();
        RefreshExecutable();
        RefreshHost();
    }

    public void Dispose() => _optionsSub?.Dispose();

    /// <summary>从当前生效配置回填编辑模型（丢弃未保存修改）。</summary>
    private void ResetToEffective()
    {
        var o = BrowserOptionsMonitor.CurrentValue;
        _model = new BrowserSettingsModel
        {
            Headless = o.Headless,
            AntiDetection = o.AntiDetection,
            PersistLogin = o.PersistLogin,
            ProfileDirectory = o.ProfileDirectory ?? string.Empty,
            ViewportWidth = o.ViewportWidth,
            ViewportHeight = o.ViewportHeight,
            IdleSeconds = o.IdleSeconds,
            HostIdleSeconds = o.HostIdleSeconds,
            DefaultTimeoutSeconds = o.DefaultTimeoutSeconds,
            AllowPrivateHosts = o.AllowPrivateHosts,
            ExecutablePath = o.ExecutablePath ?? string.Empty,
            UserAgent = o.UserAgent ?? string.Empty,
            ExtraArgsText = o.ExtraArgs is { Length: > 0 } args ? string.Join('\n', args) : string.Empty
        };
        _pendingRestart = false;
        _signatureBeforeSave = BrowserEngine.ComputeSignature(o);
    }

    private void RefreshExecutable()
    {
        var resolved = BrowserEngine.ResolveExecutable(BrowserOptionsMonitor.CurrentValue);
        _resolvedExecutable = resolved.Found
            ? $"{resolved.Path}（{resolved.Source}）"
            : resolved.Source;
    }

    /// <summary>手动刷新探测结果（用户刚装完浏览器，不想重启服务只想看探测是否命中）。</summary>
    private void RefreshExecutableAndRender()
    {
        RefreshExecutable();
        StateHasChanged();
    }

    /// <summary>
    /// 读发现文件，刷新「浏览器进程」卡片。
    /// </summary>
    /// <remarks>
    /// <b>为什么同时保留「进程已死」的发现文件</b>：宿主崩溃/被杀时不会清理这个文件，
    /// 里面的 <c>lastError</c> 与 <c>effective</c> 正是排查「为什么浏览器起不来」的唯一线索。
    /// 全丢掉会让设置页在故障时变成一片空白，只能去翻日志文件。
    /// </remarks>
    private void RefreshHost()
    {
        var locator = new BrowserHostLocator(HostProfilePath);
        _hostInfo = locator.Read();
        _hostAlive = _hostInfo is not null && IsHostProcessAlive(_hostInfo);
    }

    private void RefreshHostAndRender()
    {
        RefreshHost();
        StateHasChanged();
    }

    /// <summary>
    /// 发现文件描述的宿主进程是否仍是「同一个活进程」。
    /// </summary>
    /// <remarks>
    /// 只比对 PID 不够：PID 会被系统复用，读到崩溃前的残留文件时可能命中一个无关进程。
    /// 因此与重启端点使用同一份判定（<see cref="BrowserHostLocator.IsSameHost"/>）。
    /// </remarks>
    private static bool IsHostProcessAlive(BrowserHostInfo info)
    {
        try
        {
            using var process = Process.GetProcessById(info.HostPid);
            return !process.HasExited
                   && BrowserHostLocator.IsSameHost(info, info.HostPid, new DateTimeOffset(process.StartTime));
        }
        catch (Exception ex) when (ex is ArgumentException
                                       or InvalidOperationException
                                       or Win32Exception
                                       or NotSupportedException)
        {
            return false;
        }
    }

    /// <summary>宿主空闲退出秒数的用户语言描述（0 = 不自动退出）。</summary>
    private static string DescribeHostIdle(int seconds)
        => seconds > 0
            ? $"{seconds} 秒没有客户端连用时自动退出"
            : "不自动退出（常驻后台）";

    /// <summary>
    /// 请求关闭当前浏览器进程（不自动重启）。
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>为什么不在这里直接杀进程</b>：结束宿主是服务端动作，且必须做「发现文件 + 启动时刻」的身份校验。
    /// 走 <c>POST /browser/host/restart</c> 让逻辑只有一份，页面只负责发起与回显结果。
    /// </para>
    /// <para>
    /// <b>为什么不自动重启</b>：用户可能正在有头窗口里登录/过验证码，换掉浏览器等于把窗口撤走。
    /// 这里只结束旧进程，新进程由下一次打开浏览器时按当时的设置拉起。
    /// </para>
    /// </remarks>
    private async Task CloseBrowserAsync()
    {
        if (_closing)
            return;

        _closing = true;
        try
        {
            var client = HttpClientFactory.CreateClient();
            // 同源调用：BaseUri 由宿主决定（WebUI 与桌面壳的端口/前缀都不写死）。
            client.BaseAddress = new Uri(NavigationManager.BaseUri);

            using var response = await client.PostAsync("browser/host/restart", content: null);
            var body = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                MessageService.Error($"重启浏览器失败（HTTP {(int)response.StatusCode}）");
                return;
            }

            using var document = JsonDocument.Parse(body);
            var root = document.RootElement;
            var ok = root.TryGetProperty("ok", out var okElement) && okElement.ValueKind == JsonValueKind.True;
            var reason = root.TryGetProperty("reason", out var reasonElement)
                         && reasonElement.ValueKind == JsonValueKind.String
                ? reasonElement.GetString()
                : null;

            if (ok)
            {
                MessageService.Success("已关闭浏览器；下次打开网页时会按当前配置自动启动。");
                // 「需重启」到这里已经兑现（旧进程没了，新进程必然读新配置），不能再留着警告。
                _pendingRestart = false;
                _signatureBeforeSave = BrowserEngine.ComputeSignature(BrowserOptionsMonitor.CurrentValue);
            }
            else if (string.Equals(reason, "no host", StringComparison.Ordinal))
            {
                MessageService.Warning("当前没有正在运行的浏览器，无需关闭");
            }
            else
            {
                MessageService.Error("关闭浏览器失败，请查看浏览器宿主日志后重试");
            }
        }
        catch (Exception ex)
        {
            MessageService.Error($"重启浏览器失败：{ex.Message}");
        }
        finally
        {
            _closing = false;
            RefreshHost();
        }
    }

    /// <summary>输入框占位文案：按平台给出真实候选顺序（写死 Windows 会误导 Linux 用户）。</summary>
    private static string ExecutablePlaceholder
        => OperatingSystem.IsWindows()
            ? "留空 → 系统 Edge → 系统 Chrome → 用户级 Chrome/Edge/Chromium"
            : OperatingSystem.IsMacOS()
                ? "留空 → /Applications 下的 Chrome / Chromium / Edge"
                : "留空 → /usr/bin、/opt、/snap/bin、PATH、Puppeteer 缓存中的 Chrome / Chromium";

    private async Task SaveAsync()
    {
        if (_model is null)
            return;

        _saving = true;
        try
        {
            var options = new BrowserOptions
            {
                Headless = _model.Headless,
                AntiDetection = _model.AntiDetection,
                PersistLogin = _model.PersistLogin,
                ProfileDirectory = Blank(_model.ProfileDirectory),
                ViewportWidth = _model.ViewportWidth,
                ViewportHeight = _model.ViewportHeight,
                IdleSeconds = _model.IdleSeconds,
                HostIdleSeconds = _model.HostIdleSeconds,
                DefaultTimeoutSeconds = _model.DefaultTimeoutSeconds,
                AllowPrivateHosts = _model.AllowPrivateHosts,
                ExecutablePath = Blank(_model.ExecutablePath),
                UserAgent = Blank(_model.UserAgent),
                ExtraArgs = ParseArgs(_model.ExtraArgsText)
            };

            // Browser 节是 UserOnly：必须写用户级，写项目级会被 ValidateScope 拒绝。
            await ConfigService.SaveSectionAsync(
                BrowserOptions.SectionName, options, ConfigLevel.User);

            // 判断「是否需要重启」：只比对**进程级签名**（Headless / AntiDetection /
            // ExecutablePath / UserAgent / ExtraArgs / 宿主 profile 目录 / 宿主空闲退出）。
            // 视口、超时、页面空闲回收、PersistLogin 在运行期实时读取，改了不需要重启 ——
            // 无条件提示「请重启」会让用户白重启，也会让提示失去可信度。
            // ⚠ ProfileDirectory 与 PersistLogin 是两件事：前者是宿主身份（进签名），
            // 后者只决定页面上下文（不进签名）。
            var savedSignature = BrowserEngine.ComputeSignature(options);

            MessageService.Success("浏览器设置已保存");
            _pendingRestart = !string.Equals(savedSignature, _signatureBeforeSave, StringComparison.Ordinal);

            // 基线随之推进：否则「什么都不改再点一次保存」仍会按旧基线判成「需重启」。
            _signatureBeforeSave = savedSignature;
            RefreshExecutable();
            RefreshHost();
        }
        catch (Exception ex)
        {
            MessageService.Error($"保存失败：{ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? Blank(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string[]? ParseArgs(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return null;

        var parts = text
            .Split(['\n', '\r'], StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .ToArray();

        return parts.Length == 0 ? null : parts;
    }

    /// <summary>编辑模型（只做 UI 绑定与格式转换，不承载业务规则）。</summary>
    private sealed class BrowserSettingsModel
    {
        public bool Headless { get; set; } = true;
        public bool AntiDetection { get; set; } = true;
        public bool PersistLogin { get; set; } = true;
        public string ProfileDirectory { get; set; } = string.Empty;
        public int ViewportWidth { get; set; } = 1280;
        public int ViewportHeight { get; set; } = 800;
        public int IdleSeconds { get; set; } = 600;
        public int HostIdleSeconds { get; set; } = 1800;
        public int DefaultTimeoutSeconds { get; set; } = 30;
        public bool AllowPrivateHosts { get; set; }
        public string ExecutablePath { get; set; } = string.Empty;
        public string UserAgent { get; set; } = string.Empty;
        public string ExtraArgsText { get; set; } = string.Empty;
    }
}
