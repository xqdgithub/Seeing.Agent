@using AntDesign
@using Seeing.Agent.Abstractions.Llm
@using Seeing.Agent.Llm
@inject IModelConfigManager ModelManager
@implements IDisposable

<Select TItemValue="string"
        TItem="ModelPickerItem"
        Value="@Value"
        ValueExpression="@(() => Value)"
        ValueChanged="OnValueChanged"
        DataSource="@_items"
        ValueName="@nameof(ModelPickerItem.Key)"
        LabelName="@nameof(ModelPickerItem.DisplayName)"
        GroupName="@nameof(ModelPickerItem.Provider)"
        SortByGroup="SortDirection.Ascending"
        SortByLabel="SortDirection.Ascending"
        Placeholder="@Placeholder"
        AllowClear="@AllowClear"
        Disabled="@Disabled"
        EnableSearch="true"
        Style="@Style"
        Class="@Class"
        OnDropdownVisibleChange="OnDropdownVisibleChange">
    <ItemTemplate Context="item">
        <div class="model-select-dropdown-item">
            <span class="model-select-dropdown-name">@item.DisplayName</span>
            <Tag Class="model-select-dropdown-provider">@item.Provider</Tag>
            @if (item.IsFree)
            {
                <Tag Color="@("green")">免费</Tag>
            }
        </div>
    </ItemTemplate>
</Select>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public ModelType? FilterType { get; set; } = ModelType.Text;
    [Parameter] public string? ProviderId { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "选择模型";
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Class { get; set; }

    private List<ModelPickerItem> _items = [];

    protected override void OnInitialized()
    {
        ModelManager.ModelConfigChanged += OnModelConfigChanged;
        Reload();
    }

    protected override void OnParametersSet() => EnsureOrphanOption();

    private void OnModelConfigChanged(object? sender, ModelConfigChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            Reload();
            StateHasChanged();
        });

    private void OnDropdownVisibleChange(bool open)
    {
        if (open)
            Reload();
    }

    private void Reload()
    {
        _items = ModelPickerItem.Build(ModelManager.GetModels(), FilterType, ProviderId).ToList();
        EnsureOrphanOption();
    }

    private void EnsureOrphanOption()
    {
        if (string.IsNullOrEmpty(Value))
            return;
        if (_items.Any(i => string.Equals(i.Key, Value, StringComparison.Ordinal)))
            return;

        var slash = Value.IndexOf('/');
        var provider = slash > 0 ? Value[..slash] : "其他";
        var modelId = slash > 0 ? Value[(slash + 1)..] : Value;
        _items.Insert(0, new ModelPickerItem
        {
            Key = Value,
            Provider = provider,
            ModelId = modelId,
            DisplayName = $"{modelId}（不可用）",
            Types = []
        });
    }

    private async Task OnValueChanged(string? value)
    {
        Value = value;
        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(value);
    }

    public void Dispose()
        => ModelManager.ModelConfigChanged -= OnModelConfigChanged;
}
