@* 主页仪表盘卡片外壳：标题 + 可选右上角链接 + 整卡点击 + hover 抬升。 *@

<div class="dash-card @(OnClick.HasDelegate ? "is-clickable" : null) @Class"
     @onclick="HandleClick"
     role="@(OnClick.HasDelegate ? "button" : null)"
     tabindex="@(OnClick.HasDelegate ? "0" : null)"
     @onkeydown="HandleKeyDown">
    <div class="dash-card-head">
        <span class="dash-card-title">@Title</span>
        @if (!string.IsNullOrWhiteSpace(LinkText))
        {
            <a class="dash-card-link"
               @onclick="HandleLink"
               @onclick:stopPropagation="true">@LinkText</a>
        }
    </div>
    @ChildContent
</div>

<style>
    .dash-card {
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
        /* 瀑布流（CSS columns）里必须整卡留在同一列 */
        break-inside: avoid;
        -webkit-column-break-inside: avoid;
        transition: border-color .15s, transform .15s;
    }

    .dash-card.is-clickable {
        cursor: pointer;
    }

        .dash-card.is-clickable:hover {
            border-color: #1890ff;
            transform: translateY(-1px);
        }

        .dash-card.is-clickable:focus-visible {
            outline: 2px solid #1890ff;
            outline-offset: 2px;
        }

    .dash-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .dash-card-title {
        font-size: 13px;
        font-weight: 600;
        color: #262626;
    }

    .dash-card-link {
        font-size: 12px;
        color: #1890ff;
        text-decoration: none;
        white-space: nowrap;
    }

        .dash-card-link:hover {
            text-decoration: underline;
        }

    @@media (prefers-reduced-motion: reduce) {
        .dash-card {
            transition: none;
        }
    }
</style>

@code {
    /// <summary>卡片标题（左上）。</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>右上角链接文案；为空则不显示。</summary>
    [Parameter] public string? LinkText { get; set; }

    /// <summary>右上角链接回调（不会冒泡到整卡点击）。</summary>
    [Parameter] public EventCallback OnLink { get; set; }

    /// <summary>整卡点击回调；未提供则卡片不可点击。</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>额外 CSS 类。</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }

    private async Task HandleLink()
    {
        if (OnLink.HasDelegate)
            await OnLink.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        // 键盘可达：Enter / Space 等价于点击
        if (args.Key is "Enter" or " " or "Spacebar")
            await HandleClick();
    }
}
