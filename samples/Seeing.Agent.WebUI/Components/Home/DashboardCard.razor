@* 主页仪表盘卡片外壳：标题 + 可选右上角链接 + 整卡点击 + hover 抬升。 *@

<div class="@CssClass"
     @onclick="HandleClick"
     role="@(OnClick.HasDelegate ? "button" : null)"
     tabindex="@(OnClick.HasDelegate ? "0" : null)"
     @onkeydown="HandleKeyDown">
    <div class="dash-card-head">
        <span class="dash-card-title">@Title</span>
        @if (!string.IsNullOrWhiteSpace(LinkText))
        {
            <a class="dash-card-link"
               @onclick="HandleLink"
               @onclick:stopPropagation="true">@LinkText</a>
        }
    </div>
    @ChildContent
</div>

@code {
    /// <summary>卡片标题（左上）。</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>右上角链接文案；为空则不显示。</summary>
    [Parameter] public string? LinkText { get; set; }

    /// <summary>右上角链接回调（不会冒泡到整卡点击）。</summary>
    [Parameter] public EventCallback OnLink { get; set; }

    /// <summary>整卡点击回调；未提供则卡片不可点击。</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>额外 CSS 类。</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string CssClass => string.Join(
        ' ',
        new[] { "dash-card", OnClick.HasDelegate ? "is-clickable" : null, Class }
            .Where(part => !string.IsNullOrWhiteSpace(part)));

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }

    private async Task HandleLink()
    {
        if (OnLink.HasDelegate)
            await OnLink.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        // 键盘可达：Enter / Space 等价于点击
        if (args.Key is "Enter" or " " or "Spacebar")
            await HandleClick();
    }
}
