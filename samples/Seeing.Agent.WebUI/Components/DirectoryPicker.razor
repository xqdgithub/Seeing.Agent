@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Seeing.Agent.WebUI.Services
@inject IDirectoryBrowser Browser

@* 浏览器与桌面共用的目录选择对话框：列出服务端目录，点击进入；路径栏支持粘贴/回车跳转。 *@
<Modal @bind-Visible="_visible"
       Title="@Title"
       Centered="true"
       Width="720"
       OnOk="Confirm"
       OkText="@("使用此目录")"
       OnCancel="Hide">
    <Spin Spinning="@(_listing is null)">
        <div class="dir-picker-path">
            @* AntDesign 的 Button 没有 Title 参数；提示信息要用 Tooltip 承载 *@
            <Tooltip Title="@("磁盘根")">
                <Button Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.Home"
                        OnClick="GoRoots" />
            </Tooltip>
            @if (!_showingRoots && _listing?.ParentPath is not null)
            {
                <Button Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.ArrowUp"
                        OnClick="@(() => Navigate(_listing!.ParentPath!))" />
            }
            <div class="dir-picker-path-input" @onpaste="OnPathPaste">
                <Input Value="@_pathInput"
                       ValueChanged="EventCallback.Factory.Create<string>(this, OnPathValueChanged)"
                       OnPressEnter="EventCallback.Factory.Create(this, CommitPath)"
                       Placeholder="粘贴或输入路径后回车"
                       Size="@InputSize.Small"
                       AllowClear="true" />
            </div>
        </div>

        @if (_showingRoots)
        {
            <div class="dir-picker-list">
                @foreach (var root in _roots)
                {
                    <div class="dir-picker-item" @onclick="@(() => Navigate(root.FullPath))">
                        <Icon Type="@IconType.Outline.Hdd" /> @root.Name
                    </div>
                }
            </div>
        }
        else if (_listing is not null)
        {
            <div class="dir-picker-list">
                @foreach (var entry in _listing.Directories)
                {
                    <div class="dir-picker-item" @onclick="@(() => Navigate(entry.FullPath))">
                        <Icon Type="@IconType.Outline.Folder" /> @entry.Name
                    </div>
                }
                @if (_listing.Directories.Count == 0)
                {
                    <Empty Description="@("没有子目录")" />
                }
            </div>

            @if (_listing.Error is not null)
            {
                <Alert Type="@AlertType.Error" Message="@_listing.Error" ShowIcon="true" />
            }

            <Divider />
            <InputGroup Compact>
                <Input @bind-Value="_newFolderName" Placeholder="新建文件夹名称" />
                <Button OnClick="CreateFolder">新建文件夹</Button>
            </InputGroup>
        }
    </Spin>
</Modal>

@code {
    private bool _visible;
    private bool _showingRoots;
    private string _newFolderName = "";
    private string _pathInput = "";
    private bool _commitOnNextChange;
    private DirectoryListing? _listing;
    private IReadOnlyList<DirectoryEntryView> _roots = Array.Empty<DirectoryEntryView>();

    /// <summary>对话框标题。</summary>
    [Parameter] public string Title { get; set; } = "选择目录";

    /// <summary>打开时的起始目录；为空则从用户主目录开始。</summary>
    [Parameter] public string? InitialPath { get; set; }

    /// <summary>用户确认选择后的回调（参数为目录绝对路径）。</summary>
    [Parameter] public EventCallback<string> OnSelected { get; set; }

    /// <summary>显示对话框。</summary>
    public void Show()
    {
        _visible = true;
        _newFolderName = "";
        _commitOnNextChange = false;
        _roots = Browser.GetRoots();
        _showingRoots = false;
        _listing = Browser.List(InitialPath ?? "");
        SyncPathInput();
        StateHasChanged();
    }

    /// <summary>隐藏对话框（不选择）。</summary>
    public void Hide()
    {
        _visible = false;
        StateHasChanged();
    }

    private void Navigate(string path)
    {
        _showingRoots = false;
        _listing = Browser.List(path);
        _newFolderName = "";
        SyncPathInput();
    }

    private void GoRoots()
    {
        _roots = Browser.GetRoots();
        _showingRoots = true;
        SyncPathInput();
    }

    /// <summary>粘贴后等 ValueChanged 带上新文本再尝试跳转。</summary>
    private void OnPathPaste(ClipboardEventArgs _)
    {
        _commitOnNextChange = true;
    }

    private void OnPathValueChanged(string value)
    {
        _pathInput = value ?? "";
        if (!_commitOnNextChange)
            return;

        _commitOnNextChange = false;
        CommitPath();
    }

    /// <summary>
    /// 路径栏提交：目录存在则进入；否则清空输入并回到当前位置（列表不动）。
    /// </summary>
    private void CommitPath()
    {
        var candidate = _pathInput.Trim().Trim('"');
        if (string.IsNullOrEmpty(candidate))
        {
            SyncPathInput();
            return;
        }

        // 与当前位置相同：只规范化显示，避免无意义刷新
        if (!_showingRoots
            && _listing is { Error: null } listing
            && string.Equals(candidate, listing.Path, StringComparison.OrdinalIgnoreCase))
        {
            _pathInput = listing.Path;
            return;
        }

        var next = Browser.List(candidate);
        if (next.Error is not null)
        {
            SyncPathInput();
            return;
        }

        _showingRoots = false;
        _listing = next;
        _newFolderName = "";
        _pathInput = next.Path;
    }

    private void SyncPathInput()
    {
        _pathInput = _showingRoots ? "" : (_listing?.Error is null ? _listing?.Path ?? "" : "");
    }

    private void CreateFolder()
    {
        if (_listing is null || _showingRoots)
            return;

        var result = Browser.CreateSubdirectory(_listing.Path, _newFolderName);
        _listing = result;
        if (result.Error is null)
            _newFolderName = "";
        SyncPathInput();

        StateHasChanged();
    }

    private async Task Confirm()
    {
        if (_showingRoots || _listing is null || _listing.Error is not null)
            return;

        _visible = false;
        await OnSelected.InvokeAsync(_listing.Path);
    }
}
