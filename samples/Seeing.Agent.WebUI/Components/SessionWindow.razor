    /// <summary>
    /// 手动触发压缩 - 通过命令通道发送 /compact（由主库 CompressionService 执行）
    /// </summary>
    private async Task OnCompactRequested()
    {
        if (SessionState.CurrentSession == null) return;

        if (SessionState.IsExecuting)
        {
            MessageService.Warning("当前会话正在执行，请稍后再压缩");
            return;
        }

        // 复用提交链路：ChatOrchestrator 识别 /compact 命令 → shouldContinue:false 终止循环
        // → CommandResultEvent(NeedsRefresh=true) → OnHandlerChanged 刷新时间线
        await OnSubmitMessage(new PromptSubmitEventArgs { Text = "/compact" });
    }

