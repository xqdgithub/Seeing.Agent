    /// <summary>
    /// 从 Base64 字符串中提取纯 Base64 数据（去除 data: 前缀）
    /// </summary>
    private static string ExtractBase64Data(string? base64Content)
    {
        if (string.IsNullOrEmpty(base64Content))
            return string.Empty;

        // 检查是否有 data: URL 前缀
        const string dataPrefix = "data:";
        if (base64Content.StartsWith(dataPrefix))
        {
            // 找到 base64, 的位置
            var base64Index = base64Content.IndexOf(";base64,", StringComparison.Ordinal);
            if (base64Index >= 0)
            {
                return base64Content.Substring(base64Index + 8);
            }
        }

        return base64Content;
    }

    /// <summary>
    /// 释放资源（导航离开 / 电路断开）
    /// </summary>
    public void Dispose()
    {
        SessionState.CancelExecution();
        _budgetSubscription?.Dispose();
        _sessionEventSubscription?.Dispose();
        _seeingAgentOptionsSubscription?.Dispose();

        // 退订事件回调并摘除 handler 订阅（aggregator 的父会话订阅由 Rebind 自行切换；
        // circuit 关闭时 SeeingCircuitHandler 统一 DetachAllForCircuit，此处不调用）
        if (_handler != null)
        {
            if (_onHandlerChangedCallback != null)
            {
                _handler.OnStateChanged -= _onHandlerChangedCallback;
                _onHandlerChangedCallback = null;
            }
            Router.DetachConsumer(_handler.SessionId, _handler);
        }
        if (_aggregator != null)
        {
            _aggregator.AssistantChanged -= OnAggregatorAssistantChanged;
        }

        // 窗口自建 SessionState 释放执行锁与取消令牌源
        SessionState.Dispose();

        // 2026-08-27 修复：Dispose 不再取消后端执行 / 标记未完成 Task 为取消。
        // 刷新页面 / 导航离开 / 关闭标签都会触发 Blazor circuit 关闭 → Dispose；
        // 原先在此调用 CancelBySessionAsync 会取消整个会话的后端执行（表现为"对话已取消: user"），
        // 且 MarkIncompleteTasksCancelledAsync 会把仍进行中的子任务标记为取消。
        // 现改为仅清理 UI 订阅：后端执行继续，重新打开会话经 Reconcile 恢复进度/结果。
        // 用户主动取消仍走 OnCancelExecution（保留）。
    }
}
