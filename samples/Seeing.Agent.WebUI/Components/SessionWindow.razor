    /// <summary>
    /// Summary 模式：执行状态 → AntDesign BadgeStatus 映射
    /// </summary>
    private BadgeStatus GetStatusBadge()
    {
        if (SessionState.IsExecuting
            || SessionState.ExecutionStatus is ExecutionStatus.Running
                or ExecutionStatus.Pending
                or ExecutionStatus.Queued)
        {
            return SessionState.IsQueued ? BadgeStatus.Default : BadgeStatus.Processing;
        }
        return BadgeStatus.Success;
    }

    /// <summary>
    /// Summary 模式：最新 assistant 消息预览（截断约 120 字符）；
    /// 为空则取运行中工具调用名。
    /// </summary>
    private string GetLatestAssistantPreview()
    {
        var messages = SessionState.CurrentSession?.Messages;
        if (messages == null)
            return "暂无消息";

        var lastAssistant = messages.LastOrDefault(m =>
            string.Equals(m.Role, "assistant", StringComparison.OrdinalIgnoreCase) && !m.IsSummary);
        if (lastAssistant != null && !string.IsNullOrWhiteSpace(lastAssistant.Content))
        {
            return lastAssistant.Content.Length <= 120
                ? lastAssistant.Content
                : lastAssistant.Content[..120] + "…";
        }

        var runningTool = messages
            .SelectMany(m => m.ToolCalls ?? Enumerable.Empty<SessionToolCall>())
            .FirstOrDefault(t => string.Equals(t.Status, "running", StringComparison.OrdinalIgnoreCase));
        if (runningTool != null && !string.IsNullOrEmpty(runningTool.Name))
            return $"正在执行工具: {runningTool.Name}";

        return "暂无消息";
    }

