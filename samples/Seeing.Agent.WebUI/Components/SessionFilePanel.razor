@using Seeing.Agent.Abstractions.Files
@using Seeing.Agent.Abstractions.Interactions
@using Seeing.Agent.WebUI.Files.Components
@using Seeing.Agent.WebUI.Files.Services
@using Seeing.Agent.WebUI.Services
@using Microsoft.JSInterop
@inject SessionEventStreamRouter Router
@inject CircuitContext CircuitContext
@inject FilePanelState PanelState
@inject HostRequestActivePanelRegistry PanelRegistry
@inject IJSRuntime JS
@implements IDisposable

@* 面板可见性由 FilePanelState.IsOpen 驱动；默认关闭，经工具栏工作目录徽标切换。
   左右位置由 FilePanelState.Side 驱动（默认 Left）：左侧面板在前（order 负值），右侧聊天在前。 *@
@if (!string.IsNullOrEmpty(SessionId)
     && PanelState.IsOpen
     && string.Equals(PanelState.SessionId, SessionId, StringComparison.Ordinal))
{
    <div class="@DockClass" style="@DockStyle">
        <ResizeHandle CssVariable="--file-panel-width" Vertical="true" Min="20" Max="80"
                      Default="50" StorageKey="seeing-files-panel-width-pct" Percent="true"
                      Invert="@(!IsLeft)" />
        <div class="session-file-panel">
            <FilePanelHost @ref="_host" />
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "SessionId")] private string? SessionId { get; set; }

    private FilePanelHost? _host;
    private AgentFileChangeBridge? _bridge;
    private bool _sideRestored;

    private bool IsLeft => PanelState.Side == FilePanelSide.Left;

    private string DockClass => IsLeft
        ? "session-file-panel-dock session-file-panel-dock--left"
        : "session-file-panel-dock session-file-panel-dock--right";

    private string DockStyle => IsLeft ? "order:-2" : "order:1";

    protected override void OnInitialized()
    {
        PanelState.Changed += OnPanelChanged;
        if (string.IsNullOrEmpty(SessionId)) return;

        _bridge = Router.GetOrCreateCircuitConsumer<AgentFileChangeBridge>(CircuitContext.Id ?? "");
        _bridge.Rebind(SessionId);
        _bridge.AgentChanged += OnAgentChanged;
        _bridge.OpenRequested += OnAgentOpen;
        Router.AttachConsumer(SessionId, _bridge);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 首渲染从 localStorage 恢复面板左右偏好（持久化跨刷新）
        if (!_sideRestored)
        {
            _sideRestored = true;
            try
            {
                // 默认侧别由 FilePanelState（C#）单点决定；仅当存在持久化偏好时覆盖
                var stored = await JS.InvokeAsync<string?>("seeingFilesPanel.getPanelSide");
                if (string.Equals(stored, "right", StringComparison.OrdinalIgnoreCase))
                    PanelState.SetSide(FilePanelSide.Right);
                else if (string.Equals(stored, "left", StringComparison.OrdinalIgnoreCase))
                    PanelState.SetSide(FilePanelSide.Left);
            }
            catch { /* JS 未就绪：忽略 */ }
        }

        // 面板渲染后就绪状态变化：同步活跃面板登记（宿主请求定位）
        SyncPanelRegistration();
    }

    private void OnPanelChanged()
    {
        // 侧别变更即持久化
        _ = PersistSideAsync();
        SyncPanelRegistration();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task PersistSideAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("seeingFilesPanel.setPanelSide",
                PanelState.Side == FilePanelSide.Left ? "left" : "right");
        }
        catch { /* JS 未就绪：忽略 */ }
    }

    private Task OnAgentChanged(FileResourceId id, FileDiffData? diff) => InvokeAsync(() =>
        _host is null ? Task.CompletedTask : _host.NotifyAgentChangeAsync(id, diff));

    private Task OnAgentOpen(FileResourceId id, int? line, int? column) => InvokeAsync(() =>
    {
        // agent 请求打开：面板未开时自动打开（默认隐藏目录树），宿主经 PendingOpen 消费
        PanelState.RequestOpen(SessionId ?? "", new FileOpenRequest(id, line, column));
        return Task.CompletedTask;
    });

    /// <summary>是否本组件应作为该会话的活跃面板（session 匹配 + 面板开 + 宿主已渲染）。</summary>
    private bool ShouldServe =>
        !string.IsNullOrEmpty(SessionId)
        && PanelState.IsOpen
        && string.Equals(PanelState.SessionId, SessionId, StringComparison.Ordinal)
        && _host is not null;

    /// <summary>同步活跃面板登记（幂等：Register 覆盖 / Unregister 幂等）。</summary>
    private void SyncPanelRegistration()
    {
        var circuitId = CircuitContext.Id ?? "";
        if (string.IsNullOrEmpty(SessionId) || string.IsNullOrEmpty(circuitId)) return;

        if (ShouldServe)
            PanelRegistry.Register(SessionId, circuitId, HandleHostRequestAsync);
        else
            PanelRegistry.Unregister(SessionId, circuitId);
    }

    /// <summary>宿主请求处理入口（编组到 Blazor 同步上下文执行）。</summary>
    private Task<HostResponse> HandleHostRequestAsync(HostRequest req, CancellationToken ct)
    {
        var tcs = new TaskCompletionSource<HostResponse>(TaskCreationOptions.RunContinuationsAsynchronously);
        var reg = ct.Register(() => tcs.TrySetResult(new HostResponse
        {
            RequestId = req.RequestId,
            SessionId = req.SessionId,
            Status = HostResponseStatus.Cancelled
        }));
        _ = InvokeAsync(async () =>
        {
            try { tcs.TrySetResult(await ComputeHostResponseAsync(req)); }
            catch (Exception ex) { tcs.TrySetException(ex); }
            finally { reg.Dispose(); }
        });
        return tcs.Task;
    }

    private async Task<HostResponse> ComputeHostResponseAsync(HostRequest req)
    {
        var host = _host;
        if (host is null)
            return new HostResponse { RequestId = req.RequestId, SessionId = req.SessionId, Status = HostResponseStatus.Unavailable };
        try
        {
            HostResponsePayload payload;
            switch (req.Kind)
            {
                case "editor.command":
                    var commandId = req.Payload!.Value.GetProperty("commandId").GetString()!;
                    System.Text.Json.JsonElement? args =
                        req.Payload!.Value.TryGetProperty("args", out var a) && a.ValueKind != System.Text.Json.JsonValueKind.Null ? a : null;
                    var path = req.Payload!.Value.TryGetProperty("path", out var p) && p.ValueKind == System.Text.Json.JsonValueKind.String ? p.GetString() : null;
                    payload = await host.ExecuteEditorCommandAsync(commandId, args, path);
                    break;
                case "editor.query":
                    var qkind = req.Payload!.Value.GetProperty("kind").GetString()!;
                    var qpath = req.Payload!.Value.TryGetProperty("path", out var p2) && p2.ValueKind == System.Text.Json.JsonValueKind.String ? p2.GetString() : null;
                    payload = await host.QueryEditorAsync(qkind, qpath);
                    break;
                case "editor.list_commands":
                    payload = await host.ListEditorCommandsAsync();
                    break;
                default:
                    payload = HostResponsePayload.Unavailable;
                    break;
            }

            return payload.Available
                ? new HostResponse
                {
                    RequestId = req.RequestId,
                    SessionId = req.SessionId,
                    Status = HostResponseStatus.Completed,
                    Payload = payload.Payload
                }
                : new HostResponse { RequestId = req.RequestId, SessionId = req.SessionId, Status = HostResponseStatus.Unavailable };
        }
        catch (Exception ex)
        {
            return new HostResponse { RequestId = req.RequestId, SessionId = req.SessionId, Status = HostResponseStatus.Failed, Reason = ex.Message };
        }
    }

    public void Dispose()
    {
        PanelState.Changed -= OnPanelChanged;
        if (!string.IsNullOrEmpty(SessionId))
            PanelRegistry.Unregister(SessionId, CircuitContext.Id ?? "");
        if (_bridge is not null)
        {
            _bridge.AgentChanged -= OnAgentChanged;
            _bridge.OpenRequested -= OnAgentOpen;
            if (!string.IsNullOrEmpty(SessionId))
                Router.DetachConsumer(SessionId, _bridge);
        }
    }
}
