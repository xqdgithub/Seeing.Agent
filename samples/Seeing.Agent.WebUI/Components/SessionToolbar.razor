@using AntDesign
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Services = Seeing.Agent.WebUI.Services
@using Seeing.Session.Core
@using Seeing.Agent.Abstractions.Agents
@using Seeing.Agent.Core.Configuration
@using Seeing.Agent.Configuration
@using Seeing.Agent.Core.Scenarios
@using Seeing.Agent.WebUI.Shared
@inject IAgentRegistry AgentRegistry
@inject IMessageService MessageService
@inject IOptionsMonitor<SeeingAgentOptions> SeeingAgentOptions
@inject IScenarioCatalog ScenarioCatalog
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (Mode == Services.SessionWindowMode.Full)
{
    <div class="session-toolbar">
        <div class="session-toolbar-left">
            @if (LeftActions != null)
            {
                <div class="session-toolbar-left-actions">
                    @LeftActions(Context)
                </div>
            }
            @if (!string.IsNullOrEmpty(Context.Title))
            {
                <Tooltip Title="@Context.Title">
                    <span Class="session-toolbar-title">@Context.Title</span>
                </Tooltip>
            }
            @if (!string.IsNullOrEmpty(Context.SessionId))
            {
                <Tooltip Title="会话信息">
                    <Button Type="@ButtonType.Text"
                            Size="@ButtonSize.Small"
                            Icon="@IconType.Outline.InfoCircle"
                            Class="session-toolbar-info"
                            OnClick="@ShowSessionInfo" />
                </Tooltip>
                <WorkbenchPicker SessionId="@Context.SessionId" SessionScenario="@Context.SessionScenario" />
            }
            @if (Context.ShowScenarioBadge && Context.CurrentSession != null)
            {
                <Tooltip Title="@ScenarioBadgeTooltip">
                    <span Class="session-scenario-badge" data-testid="session-scenario-badge">
                        <Icon Type="@IconType.Outline.Appstore" />
                        @(EffectiveScenarioDisplay)
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Edit"
                                OnClick="@OnEditScenario"
                                Class="session-scenario-edit" />
                    </span>
                </Tooltip>
            }
            @if (Context.ShowSubAgentBadge)
            {
                <Badge Status="@BadgeStatus.Warning" Text="@Services.SessionRelationView.BadgeText(Context.Relation, Context.IsAnchor, Context.Label, Context.SuccessorTitle)" />
            }
            else
            {
                @if (ToolbarRelationBadge is { } relationBadge)
                {
                    <Badge Status="@BadgeStatus.Default" Text="@relationBadge" />
                }
                @if (Context.PendingInputCount > 0)
                {
                    <Badge Status="@BadgeStatus.Default" Text="@($"待处理（{Context.PendingInputCount} 条）")" />
                }
                else if (Context.HasActiveExecution)
                {
                    <Badge Status="@BadgeStatus.Processing" Text="执行中" />
                }
            }

            @if (Context.ShowSubAgentBadge)
            {
                <div class="subagent-meta" title="子智能体">
                    <span class="subagent-meta-chip">
                        <span class="subagent-meta-label">智能体</span>
                        <span class="subagent-meta-value">@(string.IsNullOrEmpty(Context.SelectedAgent) ? "—" : Context.SelectedAgent)</span>
                    </span>
                    @if (!string.IsNullOrEmpty(Context.SelectedModel))
                    {
                        <span class="subagent-meta-chip">
                            <span class="subagent-meta-label">模型</span>
                            <span class="subagent-meta-value">@Context.SelectedModel</span>
                        </span>
                    }
                </div>
            }
            else if (_optionsReady && Context.CurrentSession != null)
            {
                <Select TItemValue="string" TItem="string"
                        Value="@Context.SelectedAgent"
                        ValueExpression="@(() => Context.SelectedAgent)"
                        ValueChanged="EventCallback.Factory.Create<string>(this, OnAgentChanged)"
                        DataSource="@_agentNames"
                        Style="min-width: 120px;"
                        Size="@InputSize.Small"
                        Placeholder="智能体" />
            }
            @if (Context.ShowAcpModeSelector && _optionsReady && Context.CurrentSession != null && Context.IsAcpPassthrough)
            {
                <Input Value="@Context.SelectedAcpMode"
                       ValueChanged="EventCallback.Factory.Create<string?>(this, OnAcpModeChanged)"
                       Placeholder="模式"
                       Style="width: 100px;"
                       Size="@InputSize.Small" />
                <Input Value="@Context.SelectedModel"
                       ValueChanged="EventCallback.Factory.Create<string?>(this, OnAcpModelChanged)"
                       Placeholder="Provider/Model"
                       Style="width: 160px;"
                       Size="@InputSize.Small" />
            }
        </div>
        <div class="session-toolbar-right">
            <SlotHost SlotName="session_toolbar_actions" />
            @if (Context.ShowReturnToParent)
            {
                <Button Type="@ButtonType.Text"
                        Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.ArrowLeft"
                        OnClick="@ReturnToParentSession">
                    返回主会话
                </Button>
            }
            @if (Context.CanDetach)
            {
                <Tooltip Title="分叉为独立会话（可编辑）">
                    <Button Type="@ButtonType.Text"
                            Size="@ButtonSize.Small"
                            Icon="@IconType.Outline.Copy"
                            OnClick="@OnBranchSession" />
                </Tooltip>
            }
            <Tooltip Title="清空会话">
                <Button Type="@ButtonType.Text"
                        Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.Delete"
                        OnClick="@OnClearSession"
                        Disabled="@(Context.IsExecuting || !Context.CanClear)" />
            </Tooltip>
            @if (RightActions != null)
            {
                <div class="session-toolbar-right-actions">
                    @RightActions(Context)
                </div>
            }
        </div>
    </div>
}

@if (_infoModalVisible)
{
    <Modal Title="会话信息"
           Visible="true"
           OnCancel="@HideSessionInfo"
           Footer="@null"
           Width="560">
        <Descriptions Bordered Column="1" Size="@DescriptionsSize.Small" Class="session-info-descriptions">
            <DescriptionsItem Title="会话 ID">
                <div class="session-info-id-row">
                    <code class="session-info-id">@_infoSessionId</code>
                    <Tooltip Title="复制 ID">
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Copy"
                                OnClick="@CopySessionIdAsync" />
                    </Tooltip>
                </div>
            </DescriptionsItem>
            <DescriptionsItem Title="标题">
                <div class="session-info-id-row">
                    <span class="session-info-title">@DisplayOrDash(_infoTitle)</span>
                    @if (Context.CanRename)
                    {
                        <Tooltip Title="重命名会话">
                            <Button Type="@ButtonType.Text"
                                    Size="@ButtonSize.Small"
                                    Icon="@IconType.Outline.Edit"
                                    OnClick="@OnRenameFromInfo" />
                        </Tooltip>
                    }
                </div>
            </DescriptionsItem>
            <DescriptionsItem Title="类型">@_infoKind</DescriptionsItem>
            <DescriptionsItem Title="来源">@_infoOrigin</DescriptionsItem>
            <DescriptionsItem Title="状态">@_infoStatus</DescriptionsItem>
            <DescriptionsItem Title="智能体">@DisplayOrDash(_infoAgent)</DescriptionsItem>
            <DescriptionsItem Title="模型">@DisplayOrDash(_infoModel)</DescriptionsItem>
            <DescriptionsItem Title="工作模式">@DisplayOrDash(_infoScenario)</DescriptionsItem>
            <DescriptionsItem Title="工作目录">@DisplayOrDash(_infoWorkingDirectory)</DescriptionsItem>
            <DescriptionsItem Title="会话组">@DisplayOrDash(_infoGroupId)</DescriptionsItem>
            <DescriptionsItem Title="父会话">@DisplayOrDash(_infoParentSessionId)</DescriptionsItem>
            <DescriptionsItem Title="分区">@DisplayOrDash(_infoPartitionId)</DescriptionsItem>
            <DescriptionsItem Title="出站绑定">
                <div class="session-info-id-row">
                    <span class="session-info-title">@DisplayOrDash(_infoChannelRoute)</span>
                    @if (Context.CanEditOutboundBinding)
                    {
                        <Tooltip Title="编辑出站绑定">
                            <Button Type="@ButtonType.Text"
                                    Size="@ButtonSize.Small"
                                    Icon="@IconType.Outline.Edit"
                                    OnClick="@OnEditOutboundFromInfo" />
                        </Tooltip>
                    }
                </div>
            </DescriptionsItem>
            <DescriptionsItem Title="创建时间">@_infoCreatedAt</DescriptionsItem>
            <DescriptionsItem Title="更新时间">@_infoUpdatedAt</DescriptionsItem>
            <DescriptionsItem Title="最后活跃">@_infoLastActiveAt</DescriptionsItem>
            <DescriptionsItem Title="消息数">@_infoMessageCount</DescriptionsItem>
        </Descriptions>
    </Modal>
}

@if (RenameModalVisible)
{
    <Modal Title="重命名会话"
           Visible="true"
           OnOk="@OnRenameConfirm"
           OnCancel="@OnRenameCancel"
           OkText="@OkText"
           CancelText="@CancelText">
        <Form Model="@RenameForm" Layout="@FormLayout.Horizontal">
            <FormItem Label="会话标题">
                <Input @bind-Value="@RenameForm.Title"
                       Placeholder="输入新的会话标题" />
            </FormItem>
        </Form>
    </Modal>
}

@if (ScenarioModalVisible)
{
    <Modal Title="编辑工作模式"
           Visible="true"
           OnOk="@OnScenarioConfirm"
           OnCancel="@OnScenarioCancel"
           OkText="@OkText"
           CancelText="@CancelText">
        <Form Model="@ScenarioFormModel" Layout="@FormLayout.Vertical">
            <FormItem Label="工作模式">
                <Select TItemValue="string"
                        TItem="ScenarioOption"
                        @bind-Value="@ScenarioFormModel.Scenario"
                        DataSource="@_scenarioOptions"
                        ValueName="@nameof(ScenarioOption.Value)"
                        LabelName="@nameof(ScenarioOption.Label)"
                        Placeholder="跟随进程"
                        AllowClear="true"
                        Style="width: 100%;" />
            </FormItem>
        </Form>
    </Modal>
}

@if (OutboundModalVisible)
{
    <Modal Title="编辑出站绑定"
           Visible="true"
           OnOk="@OnOutboundConfirm"
           OnCancel="@OnOutboundCancel"
           OkText="@OkText"
           CancelText="@CancelText">
        <Form Model="@OutboundForm" Layout="@FormLayout.Horizontal">
            <FormItem Label="从目录选择">
                <ConversationPicker Placeholder="从目录选择会话，自动填充下方字段"
                                    OnSelected="@OnOutboundConversationSelected" />
            </FormItem>
            <FormItem Label="渠道标识">
                <Input @bind-Value="@OutboundForm.ChannelId"
                       Placeholder="如 qq、wecom；全部留空则清除绑定" />
            </FormItem>
            <FormItem Label="对话类型">
                <Select TItemValue="string"
                        TItem="KindOption"
                        @bind-Value="@OutboundForm.Kind"
                        DataSource="@_kindOptions"
                        ValueName="@nameof(KindOption.Value)"
                        LabelName="@nameof(KindOption.Label)"
                        Placeholder="单聊 / 群聊 / 频道"
                        AllowClear="true"
                        Style="width: 100%;" />
            </FormItem>
            <FormItem Label="对话标识">
                <Input @bind-Value="@OutboundForm.ExternalId"
                       Placeholder="外部对话标识" />
            </FormItem>
            <FormItem Label="显示名称">
                <Input @bind-Value="@OutboundForm.Title"
                       Placeholder="可选，便于识别" />
            </FormItem>
        </Form>
    </Modal>
}

@code {
    [Parameter, EditorRequired] public Services.SessionWindowContext Context { get; set; } = new();
    [Parameter] public Services.SessionWindowMode Mode { get; set; } = Services.SessionWindowMode.Full;
    [Parameter] public RenderFragment<Services.SessionWindowContext>? LeftActions { get; set; }
    [Parameter] public RenderFragment<Services.SessionWindowContext>? RightActions { get; set; }

    private const string OkText = "确定";
    private const string CancelText = "取消";

    private List<string> _agentNames = new();
    private List<ScenarioOption> _scenarioOptions = [];
    private bool _optionsReady;
    private bool RenameModalVisible;
    private RenameSessionForm RenameForm { get; set; } = new();
    private bool ScenarioModalVisible;
    private ScenarioForm ScenarioFormModel { get; set; } = new();
    private bool OutboundModalVisible;
    private OutboundEditForm OutboundForm { get; set; } = new();

    private bool _infoModalVisible;
    private string _infoSessionId = "";
    private string? _infoTitle;
    private string _infoKind = "—";
    private string _infoOrigin = "—";
    private string _infoStatus = "—";
    private string? _infoAgent;
    private string? _infoModel;
    private string? _infoScenario;
    private string? _infoWorkingDirectory;
    private string? _infoGroupId;
    private string? _infoParentSessionId;
    private string? _infoPartitionId;
    private string? _infoChannelRoute;
    private string _infoCreatedAt = "—";
    private string _infoUpdatedAt = "—";
    private string _infoLastActiveAt = "—";
    private string _infoMessageCount = "—";

    /// <summary>
    /// 工具栏关系徽标。纯「主线」不展示：当前会话就是锚点，标题已经说明身份。
    /// 交接、分叉、备份仍保留。
    /// </summary>
    private string? ToolbarRelationBadge
    {
        get
        {
            if (Context.ShowSubAgentBadge)
                return null;
            if (!Context.IsAnchor && Context.Relation == SessionRelation.None)
                return null;

            var text = Services.SessionRelationView.BadgeText(
                Context.Relation, Context.IsAnchor, Context.Label, Context.SuccessorTitle);
            return text == "主线" ? null : text;
        }
    }

    private string? ProcessScenario => SeeingAgentOptions.CurrentValue.Scenario;

    private string? EffectiveScenario =>
        Services.SessionShellVisibility.ResolveEffectiveScenario(Context.SessionScenario, ProcessScenario);

    private string EffectiveScenarioDisplay =>
        string.IsNullOrWhiteSpace(EffectiveScenario) ? "—" : EffectiveScenario!;

    private string ScenarioBadgeTooltip =>
        Context.SessionScenario is null
            ? $"工作模式：跟随进程（{EffectiveScenarioDisplay}）"
            : $"工作模式：{Context.SessionScenario}（仅对下一次提交生效）";

    protected override async Task OnInitializedAsync()
    {
        Context.StateChanged += OnContextStateChanged;
        await LoadOptionsAsync();
    }

    /// <summary>
    /// 订阅窗口状态变更：Context 的只读状态（SelectedAgent/SelectedModel/能力标记等）
    /// 由 SessionWindow 的 SyncContextState 刷新，此处收到通知后重渲染控件绑定值。
    /// </summary>
    private void OnContextStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadOptionsAsync()
    {
        _optionsReady = false;

        var agentNames = new List<string>();
        try
        {
            var agents = await AgentRegistry.GetPrimaryAgentsAsync();
            agentNames = agents
                .Where(a => !string.IsNullOrEmpty(a.Name))
                .Select(a => a.Name)
                .ToList();
        }
        catch (Exception)
        {
            // ignore
        }

        RefreshScenarioOptions();

        _agentNames = agentNames;
        // Native 模型目录由输入框底栏的 ModelSelectBadge 自行读取；此处不因 Agent 列表为空而挡住 Agent/ACP 控件
        _optionsReady = true;
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshScenarioOptions()
    {
        _scenarioOptions = ScenarioCatalog.ListAll()
            .Select(s => new ScenarioOption(s.Name, s.Name))
            .Prepend(new ScenarioOption("", "跟随进程"))
            .ToList();
    }

    private async Task OnAgentChanged(string value)
    {
        if (Context.SetAgentAsync != null)
            await Context.SetAgentAsync(value);
    }

    private async Task OnScenarioChanged(string? value)
    {
        if (Context.SetScenarioAsync != null)
            await Context.SetScenarioAsync(string.IsNullOrWhiteSpace(value) ? null : value);
    }

    private void OnEditScenario()
    {
        ScenarioFormModel.Scenario = Context.SessionScenario;
        ScenarioModalVisible = true;
    }

    private async Task OnScenarioConfirm()
    {
        if (Context.SetScenarioAsync != null)
        {
            var value = string.IsNullOrWhiteSpace(ScenarioFormModel.Scenario) ? null : ScenarioFormModel.Scenario;
            await Context.SetScenarioAsync(value);
        }

        ScenarioModalVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnScenarioCancel()
    {
        ScenarioModalVisible = false;
    }

    private async Task OnAcpModelChanged(string? value)
    {
        if (Context.SetModelAsync != null)
            await Context.SetModelAsync(value ?? "");
    }

    private void OnAcpModeChanged(string? value)
    {
        Context.SetAcpMode?.Invoke(value ?? "");
    }

    private void ShowSessionInfo()
    {
        var session = Context.CurrentSession;
        _infoSessionId = session?.Id ?? Context.SessionId;
        _infoTitle = session?.Title ?? Context.Title;
        _infoKind = FormatKind(session?.Kind);
        _infoOrigin = FormatOrigin(session?.Origin);
        _infoStatus = session?.Status.ToString() ?? "—";
        _infoAgent = session?.SelectedAgent ?? Context.SelectedAgent;
        _infoModel = session?.SelectedModel ?? Context.SelectedModel;
        _infoScenario = session?.Scenario ?? Context.SessionScenario;
        _infoWorkingDirectory = session?.WorkingDirectory;
        _infoGroupId = session?.GroupId;
        _infoParentSessionId = Context.ParentSessionId;
        _infoPartitionId = session?.PartitionId;
        _infoChannelRoute = FormatChannelRoute(session?.ChannelRoute);
        _infoCreatedAt = FormatDateTime(session?.CreatedAt);
        _infoUpdatedAt = FormatDateTime(session?.UpdatedAt);
        _infoLastActiveAt = FormatDateTime(session?.LastActiveAt);
        _infoMessageCount = session is null ? "—" : session.MessageCount.ToString();
        _infoModalVisible = true;
    }

    private void HideSessionInfo() => _infoModalVisible = false;

    private async Task CopySessionIdAsync()
    {
        if (string.IsNullOrEmpty(_infoSessionId))
            return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _infoSessionId);
            MessageService.Success("已复制会话 ID");
        }
        catch
        {
            // 剪贴板不可用时静默失败
        }
    }

    private static string DisplayOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatDateTime(DateTime? value) =>
        value is { } dt && dt != default ? dt.ToString("yyyy-MM-dd HH:mm:ss") : "—";

    private static string FormatKind(SessionKind? kind) => kind switch
    {
        SessionKind.Root => "主会话",
        SessionKind.SubAgent => "子会话",
        null => "—",
        _ => kind.Value.ToString()
    };

    private static string FormatOrigin(SessionOrigin? origin) => origin switch
    {
        SessionOrigin.User => "用户",
        SessionOrigin.SubAgentTask => "子任务",
        SessionOrigin.Reflection => "复盘",
        SessionOrigin.Scheduler => "定时任务",
        SessionOrigin.Heartbeat => "心跳",
        null => "—",
        _ => origin.Value.ToString()
    };

    private static string? FormatChannelRoute(SessionChannelRoute? route)
    {
        if (route is null)
            return null;

        var parts = new[] { route.ChannelId, route.Kind, route.ExternalId, route.Title }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var text = string.Join(" / ", parts);
        return string.IsNullOrWhiteSpace(text) ? null : text;
    }

    private void OnRenameFromInfo()
    {
        RenameForm.Title = _infoTitle ?? Context.Title ?? "";
        _infoModalVisible = false;
        RenameModalVisible = true;
    }

    private async Task OnRenameConfirm()
    {
        if (!string.IsNullOrWhiteSpace(RenameForm.Title))
        {
            var title = RenameForm.Title.Trim();
            if (Context.RenameAsync != null)
                await Context.RenameAsync(title);
            _infoTitle = title;
        }

        RenameModalVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnRenameCancel()
    {
        RenameModalVisible = false;
    }

    private async Task OnBranchSession()
    {
        if (Context.BranchAsync != null)
            await Context.BranchAsync();
    }

    private async Task OnClearSession()
    {
        if (Context.ClearAsync != null)
            await Context.ClearAsync();
    }

    private void ReturnToParentSession()
    {
        Context.ReturnToParent?.Invoke();
    }

    private static string? NormalizeOutbound(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void OnEditOutboundFromInfo()
    {
        var session = Context.CurrentSession;
        var route = session?.ChannelRoute;
        OutboundForm = new OutboundEditForm
        {
            ChannelId = route?.ChannelId ?? "",
            Kind = route?.Kind ?? "",
            ExternalId = route?.ExternalId ?? "",
            Title = route?.Title ?? ""
        };
        _infoModalVisible = false;
        OutboundModalVisible = true;
    }

    /// <summary>目录选择器选中 → 回填表单 4 字段（手填字段可再改，确认时以表单为准）。</summary>
    private void OnOutboundConversationSelected(Seeing.Agent.Abstractions.Channels.ConversationInfo conversation)
    {
        OutboundForm = new OutboundEditForm
        {
            ChannelId = conversation.ChannelId,
            Kind = conversation.Kind.ToString().ToLowerInvariant(),
            ExternalId = conversation.ExternalId,
            Title = conversation.Title ?? ""
        };
        InvokeAsync(StateHasChanged);
    }

    private async Task OnOutboundConfirm()
    {
        if (!TryBuildRoute(OutboundForm, out var route, out var error))
        {
            MessageService.Warning(error!);
            return;
        }

        if (Context.SaveOutboundAsync != null)
            await Context.SaveOutboundAsync(route);

        _infoChannelRoute = FormatChannelRoute(route);
        OutboundModalVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private static bool TryBuildRoute(OutboundEditForm form, out SessionChannelRoute? route, out string? error)
    {
        var channelId = NormalizeOutbound(form.ChannelId);
        var kind = NormalizeOutbound(form.Kind)?.ToLowerInvariant();
        var externalId = NormalizeOutbound(form.ExternalId);
        var title = NormalizeOutbound(form.Title);
        route = null;
        error = null;

        if (channelId == null && kind == null && externalId == null && title == null)
            return true;

        if (channelId == null || externalId == null || kind is not ("direct" or "group" or "guild"))
        {
            error = "出站绑定需要 ChannelId、Kind（direct/group/guild）和 ExternalId；全部留空则清除绑定";
            return false;
        }

        route = new SessionChannelRoute
        {
            ChannelId = channelId,
            Kind = kind,
            ExternalId = externalId,
            Title = title
        };
        return true;
    }

    private void OnOutboundCancel()
    {
        OutboundModalVisible = false;
    }

    public void Dispose()
    {
        Context.StateChanged -= OnContextStateChanged;
    }

    /// <summary>重命名表单模型</summary>
    private class RenameSessionForm
    {
        public string Title { get; set; } = "";
    }

    /// <summary>场景编辑表单模型</summary>
    private class ScenarioForm
    {
        public string? Scenario { get; set; }
    }

    private static readonly KindOption[] _kindOptions =
    [
        new("direct", "单聊"),
        new("group", "群聊"),
        new("guild", "频道"),
    ];

    private sealed class OutboundEditForm
    {
        public string ChannelId { get; set; } = "";
        public string Kind { get; set; } = "";
        public string ExternalId { get; set; } = "";
        public string Title { get; set; } = "";
    }

    private sealed record KindOption(string Value, string Label);

    private sealed record ScenarioOption(string Value, string Label);
}
