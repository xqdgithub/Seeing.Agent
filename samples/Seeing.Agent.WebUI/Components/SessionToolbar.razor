@using AntDesign
@using Microsoft.Extensions.Options
@using Services = Seeing.Agent.WebUI.Services
@using Seeing.Session.Core
@using Seeing.Agent.Abstractions.Agents
@using Seeing.Agent.Core.Llm
@using Seeing.Agent.Llm
@using Seeing.Agent.Core.Configuration
@using Seeing.Agent.Configuration
@using Seeing.Agent.Core.Scenarios
@inject IAgentRegistry AgentRegistry
@inject ILlmService LlmService
@inject IMessageService MessageService
@inject IOptionsMonitor<SeeingAgentOptions> SeeingAgentOptions
@inject IScenarioCatalog ScenarioCatalog
@implements IDisposable

@if (Mode == Services.SessionWindowMode.Full)
{
    <div class="session-toolbar">
        <div class="session-toolbar-left">
            @if (LeftActions != null)
            {
                <div class="session-toolbar-left-actions">
                    @LeftActions(Context)
                </div>
            }
            @if (!string.IsNullOrEmpty(Context.Title))
            {
                <Tooltip Title="@Context.Title">
                    <span Class="session-toolbar-title">@Context.Title</span>
                </Tooltip>
            }
            @if (Context.GetWorkspace != null)
            {
                <Tooltip Title="@Context.GetWorkspace()">
                    <span Class="session-workspace-badge">
                        <Icon Type="@IconType.Outline.Folder" />
                        @TruncateWorkspacePath(Context.GetWorkspace())
                    </span>
                </Tooltip>
            }
            @if (Context.ShowScenarioBadge && Context.CurrentSession != null)
            {
                <Tooltip Title="@ScenarioBadgeTooltip">
                    <span Class="session-scenario-badge" data-testid="session-scenario-badge">
                        <Icon Type="@IconType.Outline.Appstore" />
                        @(EffectiveScenarioDisplay)
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Edit"
                                OnClick="@OnEditScenario"
                                Class="session-scenario-edit" />
                    </span>
                </Tooltip>
            }
            @if (Context.ShowSubAgentBadge)
            {
                <Badge Status="@BadgeStatus.Warning" Text="@Services.SessionRelationView.BadgeText(Context.Relation, Context.IsAnchor, Context.Label, Context.SuccessorTitle)" />
            }
            else
            {
                @if (Context.IsAnchor || Context.Relation != SessionRelation.None)
                {
                    <Badge Status="@BadgeStatus.Default" Text="@Services.SessionRelationView.BadgeText(Context.Relation, Context.IsAnchor, Context.Label, Context.SuccessorTitle)" />
                }
                @if (Context.IsQueued)
                {
                    <Badge Status="@BadgeStatus.Default" Text="@($"排队中 ({Context.QueuePosition})" )" />
                }
                else if (Context.HasActiveExecution)
                {
                    <Badge Status="@BadgeStatus.Processing" Text="执行中" />
                }
            }

            @if (Context.ShowSubAgentBadge)
            {
                <div class="subagent-meta" title="子代理（只读）">
                    <span class="subagent-meta-chip">
                        <span class="subagent-meta-label">Agent</span>
                        <span class="subagent-meta-value">@(string.IsNullOrEmpty(Context.SelectedAgent) ? "—" : Context.SelectedAgent)</span>
                    </span>
                    @if (!string.IsNullOrEmpty(Context.SelectedModel))
                    {
                        <span class="subagent-meta-chip">
                            <span class="subagent-meta-label">Model</span>
                            <span class="subagent-meta-value">@Context.SelectedModel</span>
                        </span>
                    }
                </div>
            }
            else if (_optionsReady && Context.CurrentSession != null)
            {
                <Select TItemValue="string" TItem="string"
                        Value="@Context.SelectedAgent"
                        ValueExpression="@(() => Context.SelectedAgent)"
                        ValueChanged="EventCallback.Factory.Create<string>(this, OnAgentChanged)"
                        DataSource="@_agentNames"
                        Style="min-width: 120px;"
                        Size="@InputSize.Small"
                        Placeholder="智能体" />
            }
            @if (Context.ShowAcpModeSelector && _optionsReady && Context.CurrentSession != null && Context.IsAcpPassthrough)
            {
                <Input Value="@Context.SelectedAcpMode"
                       ValueChanged="EventCallback.Factory.Create<string?>(this, OnAcpModeChanged)"
                       Placeholder="Mode"
                       Style="width: 80px;"
                       Size="@InputSize.Small" />
                <Input Value="@Context.SelectedModel"
                       ValueChanged="EventCallback.Factory.Create<string?>(this, OnAcpModelChanged)"
                       Placeholder="Provider/Model"
                       Style="width: 160px;"
                       Size="@InputSize.Small" />
            }
            else if (Context.ShowModelSelector && _optionsReady && Context.CurrentSession != null)
            {
                <ModelSelectBadge Value="@Context.SelectedModel"
                                  ValueChanged="EventCallback.Factory.Create<string?>(this, OnModelChangedNullable)"
                                  FilterType="ModelType.Text"
                                  AllowClear="false"
                                  IsInvalid="@Context.ModelInvalid"
                                  Placeholder="选择模型"
                                  Style="width: 160px; max-width: 160px;" />
                @if (TryGetThinkingLevels(out var thinkingLevels))
                {
                    <Select TItemValue="string" TItem="ThinkingLevelOption"
                            Value="@Context.SelectedThinkingEffort"
                            ValueExpression="@(() => Context.SelectedThinkingEffort)"
                            ValueChanged="EventCallback.Factory.Create<string>(this, OnThinkingEffortChanged)"
                            DataSource="@thinkingLevels"
                            ValueName="@nameof(ThinkingLevelOption.Key)"
                            LabelName="@nameof(ThinkingLevelOption.Label)"
                            Style="min-width: 100px;"
                            Size="@InputSize.Small"
                            Placeholder="思考" />
                }
            }
        </div>
        <div class="session-toolbar-right">
            @if (Context.ShowReturnToParent)
            {
                <Button Type="@ButtonType.Text"
                        Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.ArrowLeft"
                        OnClick="@ReturnToParentSession">
                    返回主会话
                </Button>
            }
            <Tooltip Title="重命名会话">
                <Button Type="@ButtonType.Text"
                        Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.Edit"
                        OnClick="@OnRenameSession"
                        Disabled="@(!Context.CanRename)" />
            </Tooltip>
            @if (Context.CanDetach)
            {
                <Tooltip Title="分叉为独立会话（可编辑）">
                    <Button Type="@ButtonType.Text"
                            Size="@ButtonSize.Small"
                            Icon="@IconType.Outline.Copy"
                            OnClick="@OnBranchSession" />
                </Tooltip>
            }
            @if (Context.CanEditOutboundBinding)
            {
                <Tooltip Title="编辑出站绑定">
                    <Button Type="@ButtonType.Text"
                            Size="@ButtonSize.Small"
                            Icon="@IconType.Outline.Api"
                            OnClick="@OnEditOutbound" />
                </Tooltip>
            }
            <Tooltip Title="清空会话">
                <Button Type="@ButtonType.Text"
                        Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.Delete"
                        OnClick="@OnClearSession"
                        Disabled="@(Context.IsExecuting || !Context.CanClear)" />
            </Tooltip>
            @if (RightActions != null)
            {
                <div class="session-toolbar-right-actions">
                    @RightActions(Context)
                </div>
            }
        </div>
    </div>
}

@if (RenameModalVisible)
{
    <Modal Title="重命名会话"
           Visible="true"
           OnOk="@OnRenameConfirm"
           OnCancel="@OnRenameCancel"
           OkText="@OkText"
           CancelText="@CancelText">
        <Form Model="@RenameForm" Layout="@FormLayout.Horizontal">
            <FormItem Label="会话标题">
                <Input @bind-Value="@RenameForm.Title"
                       Placeholder="输入新的会话标题" />
            </FormItem>
        </Form>
    </Modal>
}

@if (ScenarioModalVisible)
{
    <Modal Title="编辑场景"
           Visible="true"
           OnOk="@OnScenarioConfirm"
           OnCancel="@OnScenarioCancel"
           OkText="@OkText"
           CancelText="@CancelText">
        <Form Model="@ScenarioFormModel" Layout="@FormLayout.Vertical">
            <FormItem Label="场景">
                <Select TItemValue="string"
                        TItem="ScenarioOption"
                        @bind-Value="@ScenarioFormModel.Scenario"
                        DataSource="@_scenarioOptions"
                        ValueName="@nameof(ScenarioOption.Value)"
                        LabelName="@nameof(ScenarioOption.Label)"
                        Placeholder="跟随进程"
                        AllowClear="true"
                        Style="width: 100%;" />
            </FormItem>
        </Form>
    </Modal>
}

@if (OutboundModalVisible)
{
    <Modal Title="编辑出站绑定"
           Visible="true"
           OnOk="@OnOutboundConfirm"
           OnCancel="@OnOutboundCancel"
           OkText="@OkText"
           CancelText="@CancelText">
        <Form Model="@OutboundForm" Layout="@FormLayout.Horizontal">
            <FormItem Label="ChannelId">
                <Input @bind-Value="@OutboundForm.ChannelId"
                       Placeholder="如 qq / wecom，留空表示未绑定" />
            </FormItem>
            <FormItem Label="UserId">
                <Input @bind-Value="@OutboundForm.UserId"
                       Placeholder="出站用户/对端 ID，可留空" />
            </FormItem>
        </Form>
    </Modal>
}

@code {
    [Parameter, EditorRequired] public Services.SessionWindowContext Context { get; set; } = new();
    [Parameter] public Services.SessionWindowMode Mode { get; set; } = Services.SessionWindowMode.Full;
    [Parameter] public RenderFragment<Services.SessionWindowContext>? LeftActions { get; set; }
    [Parameter] public RenderFragment<Services.SessionWindowContext>? RightActions { get; set; }

    private const string OkText = "确定";
    private const string CancelText = "取消";

    private List<string> _agentNames = new();
    private List<ScenarioOption> _scenarioOptions = [];
    private bool _optionsReady;
    private bool RenameModalVisible;
    private RenameSessionForm RenameForm { get; set; } = new();
    private bool ScenarioModalVisible;
    private ScenarioForm ScenarioFormModel { get; set; } = new();
    private bool OutboundModalVisible;
    private OutboundEditForm OutboundForm { get; set; } = new();

    private string? ProcessScenario => SeeingAgentOptions.CurrentValue.Scenario;

    private string? EffectiveScenario =>
        Services.SessionShellVisibility.ResolveEffectiveScenario(Context.SessionScenario, ProcessScenario);

    private string EffectiveScenarioDisplay =>
        string.IsNullOrWhiteSpace(EffectiveScenario) ? "—" : EffectiveScenario!;

    private string ScenarioBadgeTooltip =>
        Context.SessionScenario is null
            ? $"会话场景：跟随进程（{EffectiveScenarioDisplay}）"
            : $"会话场景：{Context.SessionScenario}（仅影响下一次 Submit）";

    protected override async Task OnInitializedAsync()
    {
        Context.StateChanged += OnContextStateChanged;
        await LoadOptionsAsync();
    }

    /// <summary>
    /// 订阅窗口状态变更：Context 的只读状态（SelectedAgent/SelectedModel/能力标记等）
    /// 由 SessionWindow 的 SyncContextState 刷新，此处收到通知后重渲染控件绑定值。
    /// </summary>
    private void OnContextStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadOptionsAsync()
    {
        _optionsReady = false;

        var agentNames = new List<string>();
        try
        {
            var agents = await AgentRegistry.GetPrimaryAgentsAsync();
            agentNames = agents
                .Where(a => !string.IsNullOrEmpty(a.Name))
                .Select(a => a.Name)
                .ToList();
        }
        catch (Exception)
        {
            // ignore
        }

        RefreshScenarioOptions();

        _agentNames = agentNames;
        // 模型选择由 ModelSelectBadge 自行读目录；不因 Agent 列表为空而隐藏
        _optionsReady = true;
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshScenarioOptions()
    {
        _scenarioOptions = ScenarioCatalog.ListAll()
            .Select(s => new ScenarioOption(s.Name, s.Name))
            .Prepend(new ScenarioOption("", "跟随进程"))
            .ToList();
    }

    private async Task OnAgentChanged(string value)
    {
        if (Context.SetAgentAsync != null)
            await Context.SetAgentAsync(value);
    }

    private async Task OnScenarioChanged(string? value)
    {
        if (Context.SetScenarioAsync != null)
            await Context.SetScenarioAsync(string.IsNullOrWhiteSpace(value) ? null : value);
    }

    private void OnEditScenario()
    {
        ScenarioFormModel.Scenario = Context.SessionScenario;
        ScenarioModalVisible = true;
    }

    private async Task OnScenarioConfirm()
    {
        if (Context.SetScenarioAsync != null)
        {
            var value = string.IsNullOrWhiteSpace(ScenarioFormModel.Scenario) ? null : ScenarioFormModel.Scenario;
            await Context.SetScenarioAsync(value);
        }

        ScenarioModalVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnScenarioCancel()
    {
        ScenarioModalVisible = false;
    }

    private Task OnModelChangedNullable(string? value) => OnModelChanged(value);

    private async Task OnModelChanged(string? value)
    {
        var modelId = value ?? "";
        // Badge 无 AllowClear；空事件多为思考档挂载引发的受控回滚
        if (string.IsNullOrEmpty(modelId) && !Context.IsAcpPassthrough)
            return;
        if (string.Equals(Context.SelectedModel ?? "", modelId, StringComparison.Ordinal))
            return;

        if (Context.SetModelAsync != null)
            await Context.SetModelAsync(modelId);
    }

    private async Task OnThinkingEffortChanged(string value)
    {
        if (string.Equals(Context.SelectedThinkingEffort ?? "", value ?? "", StringComparison.Ordinal))
            return;

        if (Context.SetThinkingEffortAsync != null)
            await Context.SetThinkingEffortAsync(value);
    }

    private bool TryGetThinkingLevels(out List<ThinkingLevelOption> levels)
    {
        levels = new List<ThinkingLevelOption>();
        var modelId = Context.SelectedModel;
        if (string.IsNullOrWhiteSpace(modelId))
            return false;

        var thinking = LlmService.GetModelConfig(modelId)?.Options?.Thinking;
        if (thinking is not { Supported: true } || thinking.Levels is null || thinking.Levels.Count == 0)
            return false;

        levels.Add(new ThinkingLevelOption("", "默认"));
        foreach (var level in thinking.Levels)
        {
            if (string.IsNullOrWhiteSpace(level.Key))
                continue;
            levels.Add(new ThinkingLevelOption(level.Key, string.IsNullOrWhiteSpace(level.Label) ? level.Key : level.Label!));
        }

        return levels.Count > 1;
    }

    private sealed record ThinkingLevelOption(string Key, string Label);

    private async Task OnAcpModelChanged(string? value)
    {
        if (Context.SetModelAsync != null)
            await Context.SetModelAsync(value ?? "");
    }

    private void OnAcpModeChanged(string? value)
    {
        Context.SetAcpMode?.Invoke(value ?? "");
    }

    private void OnRenameSession()
    {
        RenameForm.Title = Context.Title ?? "";
        RenameModalVisible = true;
    }

    private async Task OnRenameConfirm()
    {
        if (!string.IsNullOrWhiteSpace(RenameForm.Title))
        {
            if (Context.RenameAsync != null)
                await Context.RenameAsync(RenameForm.Title.Trim());
        }

        RenameModalVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnRenameCancel()
    {
        RenameModalVisible = false;
    }

    private async Task OnBranchSession()
    {
        if (Context.BranchAsync != null)
            await Context.BranchAsync();
    }

    private async Task OnClearSession()
    {
        if (Context.ClearAsync != null)
            await Context.ClearAsync();
    }

    private void ReturnToParentSession()
    {
        Context.ReturnToParent?.Invoke();
    }

    private static string? NormalizeOutbound(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void OnEditOutbound()
    {
        var session = Context.CurrentSession;
        if (session == null) return;

        OutboundForm = new OutboundEditForm
        {
            ChannelId = session.ChannelId ?? "",
            UserId = session.UserId ?? ""
        };
        OutboundModalVisible = true;
    }

    private async Task OnOutboundConfirm()
    {
        if (Context.SaveOutboundAsync != null)
        {
            await Context.SaveOutboundAsync(
                NormalizeOutbound(OutboundForm.ChannelId),
                NormalizeOutbound(OutboundForm.UserId));
        }

        OutboundModalVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnOutboundCancel()
    {
        OutboundModalVisible = false;
    }

    /// <summary>
    /// 截断工作区路径显示
    /// </summary>
    private static string TruncateWorkspacePath(string path)
    {
        if (string.IsNullOrEmpty(path)) return path;
        if (path.Length <= 30) return path;

        var parts = path.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        if (parts.Length <= 2) return path;

        // 显示最后两级目录
        return ".../" + string.Join("/", parts.TakeLast(2));
    }

    public void Dispose()
    {
        Context.StateChanged -= OnContextStateChanged;
    }

    /// <summary>重命名表单模型</summary>
    private class RenameSessionForm
    {
        public string Title { get; set; } = "";
    }

    /// <summary>场景编辑表单模型</summary>
    private class ScenarioForm
    {
        public string? Scenario { get; set; }
    }

    private sealed class OutboundEditForm
    {
        public string ChannelId { get; set; } = "";
        public string UserId { get; set; } = "";
    }

    private sealed record ScenarioOption(string Value, string Label);
}
