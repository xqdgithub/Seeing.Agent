@using AntDesign
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using Seeing.Agent.WebUI.State
@implements IDisposable
@inject AppState AppState
@inject NavigationManager NavigationManager
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject IMessageService MessageService

<Sider Class="@GetSiderClass()"
       Width="240"
       CollapsedWidth="80"
       Collapsed="@EffectiveCollapsed"
       CollapsedChanged="@OnCollapsedChanged"
       Collapsible="@(!AppState.IsMobile)"
       Theme="@SiderTheme.Light"
       Style="@GetSiderStyle()">
    <a href="/" class="sider-header" style="cursor: pointer; text-decoration: none;">
        @if (!EffectiveCollapsed)
        {
            <div class="logo-section">
                <img src="ai.svg" alt="Seeing.Agent" class="app-logo" width="24" height="24" />
                <span class="logo-text">Seeing.Agent</span>
            </div>
        }
        else
        {
            <Tooltip Title="Seeing.Agent" Placement="@Placement.Right">
                <img src="ai.svg" alt="Seeing.Agent" class="app-logo app-logo-collapsed" width="24" height="24" />
            </Tooltip>
        }
    </a>

    <Menu Mode="@MenuMode.Inline"
          Theme="@MenuTheme.Light"
          SelectedKeys="@_selectedKeys"
          @bind-OpenKeys="_openKeys"
          Class="sider-menu">

        <MenuItem Key="chat" OnClick="@(() => NavigateTo(GetChatPath()))">
            <Icon Type="@IconType.Outline.Message" />
            <span>聊天</span>
        </MenuItem>

        <SubMenu Key="control">
            <TitleTemplate>
                <Icon Type="@IconType.Outline.Control" />
                <span>控制中心</span>
            </TitleTemplate>
            <ChildContent>
                <MenuItem Key="sessions" OnClick="@(() => NavigateTo("/sessions"))">
                    <Icon Type="@IconType.Outline.Team" />
                    <span>会话</span>
                </MenuItem>
                <MenuItem Key="cron-jobs" OnClick="@(() => NavigateTo("/cron-jobs"))">
                    <Icon Type="@IconType.Outline.ClockCircle" />
                    <span>定时任务</span>
                </MenuItem>
                <MenuItem Key="heartbeat" OnClick="@(() => NavigateTo("/heartbeat"))">
                    <Icon Type="@IconType.Outline.Heart" />
                    <span>心跳</span>
                </MenuItem>
            </ChildContent>
        </SubMenu>

        <SubMenu Key="workspace">
            <TitleTemplate>
                <Icon Type="@IconType.Outline.Folder" />
                <span>工作区</span>
            </TitleTemplate>
            <ChildContent>
                <MenuItem Key="skills" OnClick="@(() => NavigateTo("/skills"))">
                    <Icon Type="@IconType.Outline.Star" />
                    <span>技能</span>
                </MenuItem>
                <MenuItem Key="tools" OnClick="@(() => NavigateTo("/tools"))">
                    <Icon Type="@IconType.Outline.Tool" />
                    <span>工具</span>
                </MenuItem>
                <MenuItem Key="mcp" OnClick="@(() => NavigateTo("/mcp"))">
                    <Icon Type="@IconType.Outline.Api" />
                    <span>MCP</span>
                </MenuItem>
                <MenuItem Key="acp" OnClick="@(() => NavigateTo("/acp"))">
                    <Icon Type="@IconType.Outline.Robot" />
                    <span>ACP</span>
                </MenuItem>
                <MenuItem Key="memory" OnClick="@(() => NavigateTo("/memory"))">
                    <Icon Type="@IconType.Outline.Database" />
                    <span>记忆</span>
                </MenuItem>
            </ChildContent>
        </SubMenu>

        <SubMenu Key="settings">
            <TitleTemplate>
                <Icon Type="@IconType.Outline.Setting" />
                <span>设置</span>
            </TitleTemplate>
            <ChildContent>
                <MenuItem Key="agents" OnClick="@(() => NavigateTo("/agents"))">
                    <Icon Type="@IconType.Outline.UsergroupAdd" />
                    <span>智能体管理</span>
                </MenuItem>
                <MenuItem Key="agent-config" OnClick="@(() => NavigateTo("/agent-config"))">
                    <Icon Type="@IconType.Outline.Edit" />
                    <span>智能体配置</span>
                </MenuItem>
                <MenuItem Key="models" OnClick="@(() => NavigateTo("/models"))">
                    <Icon Type="@IconType.Outline.CloudServer" />
                    <span>模型</span>
                </MenuItem>
                <MenuItem Key="gateway" OnClick="@(() => NavigateTo("/gateway"))">
                    <Icon Type="@IconType.Outline.Global" />
                    <span>Gateway</span>
                </MenuItem>
                <MenuItem Key="gateway-clients" OnClick="@(() => NavigateTo("/gateway-clients"))">
                    <Icon Type="@IconType.Outline.Api" />
                    <span>Gateway 客户端</span>
                </MenuItem>
                <MenuItem Key="security" OnClick="@(() => NavigateTo("/security"))">
                    <Icon Type="@IconType.Outline.Lock" />
                    <span>安全</span>
                </MenuItem>
                <MenuItem Key="settings-page" OnClick="@(() => NavigateTo("/settings"))">
                    <Icon Type="@IconType.Outline.Tool" />
                    <span>系统设置</span>
                </MenuItem>
            </ChildContent>
        </SubMenu>
    </Menu>

    <div class="sider-shutdown">
        <Popconfirm Title="确定关闭当前 WebUI 程序？关闭后需要重新启动程序才能再次访问。"
                    OkText="关闭程序"
                    CancelText="取消"
                    OnConfirm="RequestShutdown">
            <Button Type="@ButtonType.Text"
                    Danger="true"
                    Block
                    Class="sider-shutdown-button"
                    Disabled="@_shutdownRequested">
                <Icon Type="@IconType.Outline.CloseCircle" />
                <span class="sider-shutdown-label">@(_shutdownRequested ? "正在关闭..." : "关闭 WebUI")</span>
            </Button>
        </Popconfirm>
    </div>
</Sider>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    private string[] _selectedKeys = Array.Empty<string>();
    private string[] _openKeys = new[] { "control", "workspace", "settings" };

    /// <summary>菜单项到所属 SubMenu 的映射</summary>
    private static readonly Dictionary<string, string> KeyToSubMenu = new(StringComparer.OrdinalIgnoreCase)
    {
        ["sessions"] = "control",
        ["cron-jobs"] = "control",
        ["heartbeat"] = "control",
        ["skills"] = "workspace",
        ["tools"] = "workspace",
        ["mcp"] = "workspace",
        ["acp"] = "workspace",
        ["memory"] = "workspace",
        ["agents"] = "settings",
        ["agent-config"] = "settings",
        ["models"] = "settings",
        ["gateway"] = "settings",
        ["gateway-clients"] = "settings",
        ["security"] = "settings",
        ["settings-page"] = "settings",
    };

    private bool _shutdownRequested;

    /// <summary>有效折叠状态：移动端 overlay 模式时强制展开 Sider</summary>
    private bool EffectiveCollapsed =>
        AppState.IsMobile ? !AppState.MobileSidebarOpen : Collapsed;

    /// <summary>根据设备和 overlay 状态返回不同 CSS class</summary>
    private string GetSiderClass()
    {
        if (!AppState.IsMobile) return "app-sider";
        return AppState.MobileSidebarOpen ? "app-sider sider-overlay" : "app-sider sider-hidden";
    }

    /// <summary>根据设备和 overlay 状态返回不同内联样式</summary>
    private string GetSiderStyle()
    {
        var baseStyle = "overflow: auto; height: 100vh; position: fixed; left: 0; top: 0;";
        if (AppState.IsMobile && AppState.MobileSidebarOpen)
            return baseStyle + " z-index: 200;";
        return baseStyle + " z-index: 100;";
    }

    /// <summary>打开移动端侧边栏 overlay</summary>
    public void OpenMobileSidebar()
    {
        AppState.MobileSidebarOpen = true;
        AppState.NotifyChange();
    }

    /// <summary>关闭移动端侧边栏 overlay</summary>
    public void CloseMobileSidebar()
    {
        AppState.MobileSidebarOpen = false;
        AppState.NotifyChange();
    }

    protected override void OnInitialized()
    {
        AppState.OnChange += OnAppStateChange;
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateSelectedKey();
    }

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChange;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void UpdateSelectedKey()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        var segment = path.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

        _selectedKeys = segment switch
        {
            "" or "home" => new[] { "chat" },
            "session" => new[] { "chat" },
            "settings" => new[] { "settings-page" },
            _ => new[] { segment }
        };

        if (!string.IsNullOrEmpty(segment) && KeyToSubMenu.TryGetValue(segment, out var subMenuKey))
        {
            if (!_openKeys.Contains(subMenuKey))
            {
                _openKeys = _openKeys.Concat(new[] { subMenuKey }).ToArray();
            }
        }
    }

    private async Task RequestShutdown()
    {
        if (_shutdownRequested)
            return;

        _shutdownRequested = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("shutdownWebUi");
        }
        catch (Exception ex)
        {
            _shutdownRequested = false;
            MessageService.Error($"关闭 WebUI 失败: {ex.Message}");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateSelectedKey();
        InvokeAsync(StateHasChanged);
    }

    private void OnAppStateChange() => InvokeAsync(StateHasChanged);

    /// <summary>导航到指定路径，移动端 overlay 模式下自动关闭侧边栏</summary>
    private void NavigateTo(string path)
    {
        NavigationManager.NavigateTo(path);
        if (AppState.IsMobile && AppState.MobileSidebarOpen)
            CloseMobileSidebar();
    }

    private string GetChatPath() =>
        !string.IsNullOrEmpty(AppState.CurrentSessionId)
            ? $"/session/{AppState.CurrentSessionId}"
            : "/sessions";

    /// <summary>折叠状态变更回调：移动端关闭 Sider 内置折叠，只用 CSS 控制</summary>
    private async Task OnCollapsedChanged(bool collapsed)
    {
        if (AppState.IsMobile) return;
        Collapsed = collapsed;
        if (CollapsedChanged.HasDelegate)
            await CollapsedChanged.InvokeAsync(collapsed);
    }
}
