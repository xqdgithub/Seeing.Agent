@using AntDesign
@using Seeing.Agent.WebUI.Components.Messaging
@using Seeing.Agent.WebUI.Models
@using Seeing.Agent.WebUI.Models.Messaging
@using Seeing.Agent.WebUI.Rendering.Abstractions
@inject IMessageRenderPipeline Pipeline

@* Loop 分组：头部每次重建（轻量），内容块按消息分段缓存 *@
<div class="@Pipeline.GetLoopContainerClass(Loop)">
    <MessageHeader Role="assistant"
                   Timestamp="@(Loop.StartTime ?? DateTime.Now)"
                   Status="@Pipeline.GetLoopStatus(Loop)"
                   ShowStatusIndicator="@Loop.IsExecuting"
                   Tags="@Pipeline.BuildLoopTags(Loop)"
                   MetaItems="@Pipeline.BuildLoopMetaItems(Loop)"
                   CustomRoleName="助手" />
    @_body
    @if (!string.IsNullOrEmpty(Loop.Error))
    {
        <div class="loop-error" style="padding: var(--space-2) var(--space-3); background: var(--color-error-bg); border: 1px solid var(--color-error-border); border-radius: var(--radius-sm); margin-top: var(--space-2); color: var(--color-error);">
            @Loop.Error
        </div>
    }
</div>

@code {
    /// <summary>
    /// Loop 分组数据
    /// </summary>
    [Parameter]
    public LoopGroupViewModel Loop { get; set; } = new();

    /// <summary>
    /// 与 TimelineItem.Revision 同步；内容变化时重建变化的单条消息分段。
    /// </summary>
    [Parameter]
    public int ContentRevision { get; set; }

    /// <summary>
    /// 与 TimelineItem.StructureRevision 同步；轮次内消息增删/重排时重建全部分段。
    /// </summary>
    [Parameter]
    public int StructureRevision { get; set; }

    /// <summary>
    /// 工具点击事件回调
    /// </summary>
    [Parameter]
    public EventCallback<ToolCallViewModel> OnToolClick { get; set; }

    private int _lastStructureRevision = int.MinValue;
    private readonly List<SegmentCache> _segments = new();
    private RenderFragment? _body;

    /// <summary>
    /// 单条消息的渲染缓存。只允许在 Blazor Dispatcher 线程读写。
    /// </summary>
    private sealed class SegmentCache
    {
        public required string MessageId { get; init; }
        public required string IdPrefix { get; init; }
        public int Revision { get; set; }
        public required List<RenderFragment> Fragments { get; set; }
    }

    protected override void OnParametersSet()
    {
        var ordered = Loop.Messages.OrderBy(m => m.Step).ToList();
        var structureChanged = _lastStructureRevision != StructureRevision
                               || _segments.Count != ordered.Count;

        // Id 前缀分配表必须跨消息共享（重复 MessageId 要按 Loop 内出现次序消歧），
        // 因此每次重建全部分段时先用完整消息集合算好前缀，再逐段构建。
        var prefixes = structureChanged
            ? AllocatePrefixes(ordered)
            : null;

        if (structureChanged)
        {
            _segments.Clear();
            for (var i = 0; i < ordered.Count; i++)
                _segments.Add(NewSegment(ordered[i], prefixes![i]));
        }
        else
        {
            // 结构未变：只重建版本变化的单条消息（避免每次 delta 重建整个 Loop）。
            // 前缀沿用上一次分配的集合，保持块 Id 稳定。
            for (var i = 0; i < ordered.Count; i++)
            {
                if (_segments[i].MessageId != ordered[i].Id || _segments[i].Revision != ordered[i].Revision)
                    _segments[i] = NewSegment(ordered[i], _segments[i].IdPrefix);
            }
        }

        _lastStructureRevision = StructureRevision;

        // 快照后再捕获：RenderFragment 只看到本次构建时的分段，
        // 避免后续 OnParametersSet 原地改 _segments 时旧片段读到新内容。
        var snapshot = _segments.ToArray();
        _body = builder =>
        {
            var seq = 0;
            foreach (var segment in snapshot)
            {
                foreach (var fragment in segment.Fragments)
                    builder.AddContent(seq++, fragment);
            }
        };
    }

    /// <summary>为 Loop 内全部消息分配 Id 前缀（重复 MessageId 追加 <c>#{n}</c> 消歧）。</summary>
    private static string[] AllocatePrefixes(List<MessageViewModel> ordered)
    {
        var seen = new Dictionary<string, int>(StringComparer.Ordinal);
        var prefixes = new string[ordered.Count];
        for (var i = 0; i < ordered.Count; i++)
            prefixes[i] = ContentBlockBuilder.AllocateIdPrefix(ordered[i], i, seen);
        return prefixes;
    }

    /// <summary>为单条消息构建渲染片段（该消息版本变化时才调用）。</summary>
    private SegmentCache NewSegment(MessageViewModel message, string idPrefix)
    {
        var context = Pipeline.BuildContext(message, GetRenderOptions(), null, OnToolClick);
        var blocks = ContentBlockBuilder.BuildFromMessage(message, idPrefix);

        return new SegmentCache
        {
            MessageId = message.Id,
            IdPrefix = idPrefix,
            Revision = message.Revision,
            Fragments = blocks
                .OrderBy(b => b.SortIndex)
                .Select(b => Pipeline.RenderBlock(b, context))
                .ToList()
        };
    }

    /// <summary>
    /// 获取渲染选项
    /// </summary>
    private RenderOptions GetRenderOptions()
    {
        return new RenderOptions
        {
            ShowReasoning = true,
            ExpandReasoningByDefault = false
        };
    }
}
