@using AntDesign
@using Seeing.Agent.WebUI.Models

<Modal Title="@ModalTitle"
       Visible="@Visible"
       MaskClosable="false"
       Width="600"
       OnCancel="@OnDenyOnce"
       Footer="@null"
       Class="permission-modal">

    <!-- 风险警告 -->
    @if (Request.IsHighRisk || !string.IsNullOrEmpty(Request.RiskWarning))
    {
        <Alert Type="@AlertType.Warning"
               ShowIcon="true"
               Message="风险提示"
               Description="@Request.RiskWarning"
               Style="margin-bottom: var(--space-3);" />
    }

    <!-- 请求详情 -->
    <div Class="permission-request-details">
        <div Class="permission-detail-row" Style="margin-bottom: var(--space-3);">
            <div Class="permission-detail-label" Style="font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                请求类型
            </div>
            <div Class="permission-detail-value">
                <Tag Color="@GetRequestTypeColor()">
                    <Icon Type="@GetRequestTypeIcon()" />
                    <span Style="margin-left: var(--space-1);">@Request.GetRequestTypeText()</span>
                </Tag>
            </div>
        </div>

        <div Class="permission-detail-row" Style="margin-bottom: var(--space-3);">
            <div Class="permission-detail-label" Style="font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                目标
            </div>
            <div Class="permission-detail-value" Style="font-weight: var(--font-weight-medium);">
                @Request.Target
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Request.Description))
        {
            <div Class="permission-detail-row" Style="margin-bottom: var(--space-3);">
                <div Class="permission-detail-label" Style="font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                    描述
                </div>
                <div Class="permission-detail-value">@Request.Description</div>
            </div>
        }

        @if (Request.Arguments != null)
        {
            <div Class="permission-detail-row" Style="margin-bottom: var(--space-3);">
                <div Class="permission-detail-label" Style="font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                    @GetArgumentsLabel()
                </div>
                <div Class="permission-detail-value" Style="background: var(--color-bg-tertiary); padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); max-height: 150px; overflow-y: auto;">
                    <pre Style="margin: 0; font-size: var(--font-size-xs); white-space: pre-wrap; word-break: break-all;">
@GetArgumentsString()
                    </pre>
                </div>
            </div>
        }

        <div Class="permission-detail-row" Style="margin-bottom: var(--space-3);">
            <div Class="permission-detail-label" Style="font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                请求时间
            </div>
            <div Class="permission-detail-value" Style="font-size: var(--font-size-xs); color: var(--color-text-tertiary);">
                @Request.RequestTime.ToString("HH:mm:ss")
            </div>
        </div>
    </div>

    <!-- 操作按钮 -->
    @if (Request.IsFileSystemOperation)
    {
        <div Class="permission-actions" Style="margin-top: var(--space-4);">
@*             <div Style="font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-bottom: var(--space-2);">
                选择允许范围：
            </div> *@
            <div Style="display: flex; flex-direction: column; gap: var(--space-2);">
                <div Style="display: flex; gap: var(--space-2);">
                    <Button Type="@ButtonType.Default" OnClick="@OnAllowOnce" Style="flex: 1;">
                        <Icon Type="@IconType.Outline.Check" /> 本次允许
                    </Button>
                    <Button Type="@ButtonType.Primary" Ghost OnClick="@OnAllowFile" Style="flex: 1;">
                        <Icon Type="@IconType.Outline.File" /> 始终允许
                    </Button>
                </div>
                @if (!string.IsNullOrEmpty(Request.GetDirectoryPath()))
                {
                    <div Style="display: flex; gap: var(--space-2);">
                        <Button Type="@ButtonType.Primary" OnClick="@OnAllowDirectory" Style="flex: 1;">
                            <Icon Type="@IconType.Outline.Folder" /> 允许此目录
                        </Button>
                    </div>
                }
                <Divider Style="margin: var(--space-1) 0;" />
                <div Style="display: flex; gap: var(--space-2);">
                    <Button Type="@ButtonType.Default" Danger OnClick="@OnDenyOnce" Style="flex: 1;">
                        <Icon Type="@IconType.Outline.CloseCircle" /> 本次拒绝
                    </Button>
                    <Button Type="@ButtonType.Primary" Danger Ghost OnClick="@OnDenySession" Style="flex: 1;">
                        <Icon Type="@IconType.Outline.Stop" /> 始终拒绝
                    </Button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div Class="permission-actions" Style="margin-top: var(--space-4); display: flex; justify-content: flex-end; gap: var(--space-2);">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Default" OnClick="@OnAllowOnce">
                        <Icon Type="@IconType.Outline.Check" /> 本次允许
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" OnClick="@OnAllowSession">
                        <Icon Type="@IconType.Outline.CheckCircle" /> 始终允许
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Default" Danger OnClick="@OnDenyOnce">
                        <Icon Type="@IconType.Outline.CloseCircle" /> 本次拒绝
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Default" Danger Ghost OnClick="@OnDenySession">
                        <Icon Type="@IconType.Outline.Stop" /> 始终拒绝
                    </Button>
                </SpaceItem>
                
            </Space>
        </div>
    }
</Modal>

@code {
    [Parameter] public PermissionRequestViewModel Request { get; set; } = new();
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<PermissionDecisionViewModel> OnDecision { get; set; }
    [Parameter] public EventCallback<bool> OnVisibleChange { get; set; }

    private string ModalTitle => $"权限请求 - {Request.GetRequestTypeText()}";

    private string GetRequestTypeColor()
    {
        return Request.Type switch
        {
            PermissionRequestType.Tool => "blue",
            PermissionRequestType.SubAgent => "purple",
            PermissionRequestType.Write => "orange",
            PermissionRequestType.Read => "cyan",
            PermissionRequestType.Confirmation => "cyan",
            _ => "default"
        };
    }

    private string GetRequestTypeIcon()
    {
        return Request.Type switch
        {
            PermissionRequestType.Tool => IconType.Outline.Tool,
            PermissionRequestType.SubAgent => IconType.Outline.Robot,
            PermissionRequestType.Write => IconType.Outline.FileText,
            PermissionRequestType.Read => IconType.Outline.FileText,
            PermissionRequestType.Confirmation => IconType.Outline.QuestionCircle,
            _ => IconType.Outline.InfoCircle
        };
    }

    private string GetArgumentsLabel()
    {
        return Request.Type switch
        {
            PermissionRequestType.Tool => "工具参数",
            PermissionRequestType.SubAgent => "调用提示",
            PermissionRequestType.Write => "内容预览",
            PermissionRequestType.Read => "路径信息",
            _ => "参数"
        };
    }

    private string GetArgumentsString()
    {
        if (Request.Arguments == null) return "";
        return Request.Arguments switch
        {
            string s => s,
            _ => System.Text.Json.JsonSerializer.Serialize(Request.Arguments, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })
        };
    }

    private async Task OnAllowOnce()
        => await Decide(true, DecisionScope.Once);

    private async Task OnAllowFile()
        => await Decide(true, DecisionScope.SessionFile);

    private async Task OnAllowDirectory()
        => await Decide(true, DecisionScope.SessionDirectory);

    private async Task OnAllowSession()
        => await Decide(true, DecisionScope.Session);

    private async Task OnDenyOnce()
        => await Decide(false, DecisionScope.Once);

    private async Task OnDenySession()
        => await Decide(false, DecisionScope.Session);

    private async Task Decide(bool approved, DecisionScope scope)
    {
        await OnDecision.InvokeAsync(new PermissionDecisionViewModel
        {
            Approved = approved,
            Scope = scope
        });
        await OnVisibleChange.InvokeAsync(false);
    }
}
