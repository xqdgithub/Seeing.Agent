<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <!-- 不参与 CPM，使用显式版本 -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="memory.db" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Seeing.ConfigSchema/Seeing.ConfigSchema.csproj" />
    <ProjectReference Include="../../src/Seeing.Agent/Seeing.Agent.csproj" />
    <ProjectReference Include="../../src/Seeing.Agent.App/Seeing.Agent.App.csproj" />
    <ProjectReference Include="../../src/Seeing.Session/Seeing.Session.csproj" />
    <ProjectReference Include="../../src/Seeing.Agent.Memory/Seeing.Agent.Memory.csproj" />
    <ProjectReference Include="../../src/Seeing.Agent.Acp/Seeing.Agent.Acp.csproj" />
    <ProjectReference Include="../../src/Seeing.Agent.TokenBudget/Seeing.Agent.TokenBudget.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AntDesign" Version="1.6.2" />
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Seeing.Agent.Gateway/Seeing.Agent.Gateway.csproj" />
    <ProjectReference Include="../../src/Seeing.Agent.Scheduler/Seeing.Agent.Scheduler.csproj" />
    <ProjectReference Include="../Seeing.Gateway.ChannelHost/Seeing.Gateway.ChannelHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!--
    ChannelHost 打包策略：
    1. 始终使用 framework-dependent 发布（不使用 SelfContained）
    2. Build 时同步到 WebUI 输出目录（同级根目录）
    3. Publish 时发布到 WebUI 发布目录（同级根目录）
    4. 启动时统一使用 dotnet Seeing.Gateway.ChannelHost.dll
  -->
  <Target Name="CopyChannelHostForBuild" AfterTargets="Build" Condition="'$(PublishDir)' == ''">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../Seeing.Gateway.ChannelHost/Seeing.Gateway.ChannelHost.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutDir);SelfContained=false;RuntimeIdentifier=" />
    <!-- 删除项目引用带来的 ChannelHost exe/dll（我们使用 Publish 输出版本），删除 exe 因为它不能跨平台 -->
    <Delete Files="$(OutDir)Seeing.Gateway.ChannelHost.exe" Condition="Exists('$(OutDir)Seeing.Gateway.ChannelHost.exe')" />
    <Delete Files="$(OutDir)Seeing.Gateway.ChannelHost" Condition="Exists('$(OutDir)Seeing.Gateway.ChannelHost')" />
    <!-- 清理旧的 channel-host 子目录（之前版本遗留） -->
    <RemoveDir Directories="$(OutDir)channel-host" Condition="Exists('$(OutDir)channel-host')" />
  </Target>
  <Target Name="PublishChannelHost" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../Seeing.Gateway.ChannelHost/Seeing.Gateway.ChannelHost.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir);SelfContained=false;RuntimeIdentifier=" />

    <Delete Files="$(PublishDir)Seeing.Gateway.ChannelHost" Condition="Exists('$(PublishDir)Seeing.Gateway.ChannelHost')" />
    <Delete Files="$(PublishDir)Seeing.Gateway.ChannelHost.exe" Condition="Exists('$(PublishDir)Seeing.Gateway.ChannelHost.exe')" />
  </Target>
</Project>
