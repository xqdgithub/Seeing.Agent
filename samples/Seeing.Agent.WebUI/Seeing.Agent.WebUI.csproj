<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <!-- 不参与 CPM，使用显式版本 -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!--
      静态资源基路径压平到根，保持与独立运行 WebUI 时完全一致的 URL 结构。
      作为被引用项目时（桌面宿主 Seeing.Agent.Desktop），默认会挂到
      _content/Seeing.Agent.WebUI/ 前缀下，导致 _Host.cshtml 里的
      <link href="css/...">、<script src="js/app.js"> 全部 404。
      写在这里而不是宿主用 AdditionalProperties 覆盖：后者会让本项目以另一套
      全局属性重复构建，压缩资源指纹对不上，发布时报 MSB3030。
    -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="memory.db" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Seeing.Agent.HostComposition\Seeing.Agent.HostComposition.csproj" />
    <ProjectReference Include="..\..\src\support\Seeing.Agent.Tools.Support\Seeing.Agent.Tools.Support.csproj" />
    <ProjectReference Include="..\..\src\primitives\Seeing.ConfigSchema\Seeing.ConfigSchema.csproj" />
    <ProjectReference Include="..\..\src\spine\Seeing.Agent.Core\Seeing.Agent.Core.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Basic\Seeing.Agent.Tools.Basic.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.ChannelMessaging\Seeing.Agent.Tools.ChannelMessaging.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.FileSystem\Seeing.Agent.Tools.FileSystem.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Shell\Seeing.Agent.Tools.Shell.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Web\Seeing.Agent.Tools.Web.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Git\Seeing.Agent.Tools.Git.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Workspace\Seeing.Agent.Workspace.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Session\Seeing.Agent.Tools.Session.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.ToolDiscovery\Seeing.Agent.Tools.ToolDiscovery.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Skills\Seeing.Agent.Skills.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Mcp\Seeing.Agent.Mcp.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Llm.OpenAI\Seeing.Agent.Llm.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Llm.Anthropic\Seeing.Agent.Llm.Anthropic.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Llm.ModelCapabilities\Seeing.Agent.Llm.ModelCapabilities.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Llm.ModelCatalog.Builtin\Seeing.Agent.Llm.ModelCatalog.Builtin.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Agents.BuiltIn\Seeing.Agent.Agents.BuiltIn.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.IO.Local\Seeing.IO.Local.csproj" />
    <ProjectReference Include="..\..\src\hosting\Seeing.Agent.Hosting\Seeing.Agent.Hosting.csproj" />
    <ProjectReference Include="..\..\src\hosting\Seeing.Agent.Hosting.Web\Seeing.Agent.Hosting.Web.csproj" />
    <ProjectReference Include="..\..\src\primitives\Seeing.Session\Seeing.Session.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Memory\Seeing.Agent.Memory.csproj" />
    <ProjectReference Include="..\..\plugs\providers\Seeing.Provider.TypeSafeApi\Seeing.Provider.TypeSafeApi.csproj" />
    <ProjectReference Include="..\..\plugs\providers\Seeing.Provider.DeepSeek\Seeing.Provider.DeepSeek.csproj" />
    <ProjectReference Include="..\..\plugs\providers\Seeing.Provider.MiMo\Seeing.Provider.MiMo.csproj" />
    <ProjectReference Include="..\..\plugs\providers\Seeing.Provider.OpenCodeZen\Seeing.Provider.OpenCodeZen.csproj" />
    <ProjectReference Include="..\..\plugs\providers\Seeing.Provider.SiliconFlow\Seeing.Provider.SiliconFlow.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Acp\Seeing.Agent.Acp.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.TokenBudget\Seeing.Agent.TokenBudget.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Question\Seeing.Agent.Tools.Question.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.Editor\Seeing.Agent.Tools.Editor.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Llm.TypeSafe\Seeing.Agent.Llm.TypeSafe.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Tools.SystemOne\Seeing.Agent.Tools.SystemOne.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Files\Seeing.Agent.Files.csproj" />
    <ProjectReference Include="..\Seeing.Agent.WebUI.Files\Seeing.Agent.WebUI.Files.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AntDesign" Version="1.6.2" />
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\gateway\Seeing.Agent.Gateway\Seeing.Agent.Gateway.csproj" />
    <ProjectReference Include="..\..\src\capabilities\Seeing.Agent.Scheduler\Seeing.Agent.Scheduler.csproj" />
    <!--
      ChannelHost 是 RID 无关的纯托管产物（UseAppHost=false），
      与 WebUI 的 RID 完全解耦：真实产物由嵌套 MSBuild Publish 生成，
      这里的引用只用于保证构建顺序。
      若让 RuntimeIdentifier 传播过去，它就会按 RID 去解析 assets 与原生 apphost，
      而 RID 只写在 WebUI 的 PublishProfile 里、不会进入它的 restore，
      造成 restore/build 的 RID 视图不一致 → NETSDK1047 或 apphost 缺失。
    -->
    <ProjectReference Include="..\Seeing.Gateway.ChannelHost\Seeing.Gateway.ChannelHost.csproj" ReferenceOutputAssembly="false">
      <GlobalPropertiesToRemove>RuntimeIdentifier;SelfContained;PublishProfile;PublishUrl;WebPublishMethod</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <!--
    ChannelHost 打包策略：
    1. 始终使用 framework-dependent 发布（不使用 SelfContained）
    2. Build 时同步到 WebUI 输出目录（同级根目录）
    3. Publish 时发布到 WebUI 发布目录（同级根目录）
    4. 启动时统一使用 dotnet Seeing.Gateway.ChannelHost.dll

    **ChannelHost 全程不带 RuntimeIdentifier。** 它是 RID 无关的纯托管产物
    （UseAppHost=false，只有 .dll / .deps.json / .runtimeconfig.json），
    原生启动器从没被用到（见 ChannelHostManager.BuildChannelHostStartInfo）。

    WebUI 以 -r <rid> 或 PublishProfile 发布到 linux-x64 时，RID 只属于 WebUI
    自己，不会进入 ChannelHost 的 restore。若这里把 RID 透传给嵌套 MSBuild，
    它会按 RID 去找 obj/<Config>/<tfm>/<rid>/ 下的 apphost / deps.json /
    runtimeconfig.json —— 这些文件因为 restore 没有该 RID 目标而根本不存在，
    于是报「无法复制 …/linux-x64/apphost，原因是找不到该文件」
    （历史报错原文），或直接 NETSDK1047「资产文件没有 net10.0/linux-x64 目标」。
    两者还会争抢同一组中间文件，并行构建下进一步表现为随机失败。
    因此嵌套调用必须 RemoveProperties 掉 RuntimeIdentifier / SelfContained。

    目标目录必须转成**绝对路径**再传给嵌套 MSBuild：
    $(OutDir) / $(PublishDir) 是相对路径（如 bin\Release\net10.0\win-x64\），
    MSBuild 任务会以**被调用项目**的目录为基准解析它 ——
    于是 ChannelHost 把产物发布回了自己的 bin，WebUI 输出目录什么也没拿到。
    表现为只剩 ProjectReference 带来的 exe + deps + runtimeconfig
    （ReferenceOutputAssembly=false 不复制 .dll），
    运行期 ResolveChannelHost 找不到 Seeing.Gateway.ChannelHost.dll 而启动失败。
  -->
  <Target Name="PassChannelHostPublishDirs">
    <PropertyGroup>
      <!--
        不再向 ChannelHost 传 RuntimeIdentifier：它是 RID 无关的纯托管产物
        （UseAppHost=false，只产出 .dll / .deps.json / .runtimeconfig.json），
        一律 `dotnet Seeing.Gateway.ChannelHost.dll` 启动。
        传 RID 会让它按 RID 去解析 assets（net10.0/<rid>）与原生 apphost，
        而 RID 只存在于 WebUI 的 PublishProfile、不会进入 ChannelHost 的 restore，
        于是 restore 与 build 的 RID 视图不一致，报 NETSDK1047 /
        「无法复制 …linux-x64/apphost，原因是找不到该文件」。
      -->
      <!-- 嵌套 MSBuild 的 PublishDir 基准是被调用项目目录，必须给绝对路径；
           若调用方已给绝对路径（如 -o / PublishDir 指定外部目录），
           不能再拼 MSBuildThisFileDirectory，否则会得到 ...\samples\C:\... 这种非法路径 -->
      <_ChannelHostBuildPublishDir Condition="!$([System.IO.Path]::IsPathRooted('$(OutDir)'))">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(OutDir)'))</_ChannelHostBuildPublishDir>
      <_ChannelHostBuildPublishDir Condition="$([System.IO.Path]::IsPathRooted('$(OutDir)'))">$([MSBuild]::NormalizeDirectory('$(OutDir)'))</_ChannelHostBuildPublishDir>
      <_ChannelHostRealPublishDir Condition="'$(PublishDir)' != '' and !$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(PublishDir)'))</_ChannelHostRealPublishDir>
      <_ChannelHostRealPublishDir Condition="'$(PublishDir)' != '' and $([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$([MSBuild]::NormalizeDirectory('$(PublishDir)'))</_ChannelHostRealPublishDir>
    </PropertyGroup>
  </Target>

  <Target Name="CopyChannelHostForBuild"
          AfterTargets="Build"
          DependsOnTargets="PassChannelHostPublishDirs">
    <!--
      不要加 Condition 判断「是否在发布」：
      历史上这里写过 '$(PublishDir)' == ''，但 PublishDir 有 SDK 默认值
      （bin/<config>/<tfm>/<rid>/publish/）永远非空，目标从不执行 ——
      输出目录只剩 ProjectReference 带来的 exe + deps + runtimeconfig
      （ReferenceOutputAssembly=false 不复制 .dll），
      运行期 ResolveChannelHost 找不到 Seeing.Gateway.ChannelHost.dll。
      而发布场景下 Desktop 构建 WebUI 时会带 _IsPublishing 等标志，
      用标志位判断同样不可靠（被引用项目与顶层项目的标志不一致）。

      改为无条件执行：嵌套 Publish 是幂等的，
      发布阶段由 PublishChannelHost 额外写一遍发布目录，两者互不冲突。
    -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)../Seeing.Gateway.ChannelHost/Seeing.Gateway.ChannelHost.csproj"
             Targets="Publish"
             RemoveProperties="PublishProfile;PublishUrl;WebPublishMethod;RuntimeIdentifier;SelfContained"
             Properties="Configuration=$(Configuration);PublishDir=$(_ChannelHostBuildPublishDir);SelfContained=false" />

    <!--
      再删 ProjectReference 带来的 exe / 无扩展名 apphost：
      ReferenceOutputAssembly=false 只复制这几个「半套」文件，
      Publish 产物已包含完整的 exe，跨平台也不该带 Windows 专属 apphost。
      .dll / .pdb 必须保留 —— 那是 ResolveChannelHost 真正要找的东西。
    -->
    <Delete Files="$(OutDir)Seeing.Gateway.ChannelHost" Condition="Exists('$(OutDir)Seeing.Gateway.ChannelHost')" />

    <!-- 清理旧的 channel-host 子目录（之前版本遗留） -->
    <RemoveDir Directories="$(OutDir)channel-host" Condition="Exists('$(OutDir)channel-host')" />
  </Target>

  <Target Name="PublishChannelHost"
          AfterTargets="Publish;PublishOnly"
          DependsOnTargets="PassChannelHostPublishDirs"
          Condition="'$(_ChannelHostRealPublishDir)' != ''">
    <!-- RemoveProperties 理由同上：发布配置不可下传给没有该配置的嵌套项目 -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)../Seeing.Gateway.ChannelHost/Seeing.Gateway.ChannelHost.csproj"
             Targets="Publish"
             RemoveProperties="PublishProfile;PublishUrl;WebPublishMethod;RuntimeIdentifier;SelfContained"
             Properties="Configuration=$(Configuration);PublishDir=$(_ChannelHostRealPublishDir);SelfContained=false" />

    <Delete Files="$(PublishDir)Seeing.Gateway.ChannelHost" Condition="Exists('$(PublishDir)Seeing.Gateway.ChannelHost')" />
  </Target>
</Project>
