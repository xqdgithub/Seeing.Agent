    /// <summary>
    /// 分支会话（从 SubAgent 分叉为无 Parent 的独立 Root）
    /// </summary>
    private async Task OnBranchSession()
    {
        if (SessionState.CurrentSession == null) return;

        var title = IsSubAgentView
            ? string.Format("{0} (独立会话)", SessionState.Title)
            : string.Format("{0} (分支)", SessionState.Title);
        
        var branchedSession = await ChatOrchestrator.BranchSessionAsync(SessionState.CurrentSession.Id, title);
        
        MessageService.Success(IsSubAgentView
            ? "已分叉为独立会话，可继续对话"
            : "会话已分支");
        
        NavigationManager.NavigateTo(string.Format("/session/{0}", branchedSession.Id));
    }

