    /// <summary>
    /// 清空会话
    /// </summary>
    private async Task OnClearSession()
    {
        if (IsSubAgentView) return;

        if (SessionState.CurrentSession != null)
        {
            SessionState.CurrentSession.ClearMessages();
            SessionState.CurrentSession.Title = "新会话";
            SessionState.CurrentTodoList = null;
            _currentStreamingMessageId = string.Empty;
            EventStreamHandler.ClearCache();

            await SessionManager.SaveAsync(SessionState.CurrentSession.Id);
            UpdateBudgetStatus();
            MessageService.Info("会话已清空");
            ResetTimelineFromSession();
        }

        await InvokeAsync(StateHasChanged);
    }
    
