@page "/session"
@page "/session/{SessionId}"
@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Seeing.Agent.WebUI.Models
@using Seeing.Agent.WebUI.Commands
@using Services = Seeing.Agent.WebUI.Services
@using Core = Seeing.Agent.Core
@using Seeing.Session.Core
@using Seeing.Agent.WebUI.State
@using Seeing.Agent.Tools
@using Seeing.Agent.Skills
@using Seeing.Agent.Configuration
@using Microsoft.Extensions.Options
@using Seeing.Agent.Llm
@using Seeing.Session.Management
@using Seeing.Agent.App
@using Seeing.Agent.App.Events
@using Seeing.Agent.App.Models
@using Seeing.Agent.App.Execution
@using Seeing.Agent.Core.Events
@using Seeing.Agent.Core.Reminders
@using Seeing.Agent.Core.Instructions
@inject SessionState SessionState
@inject AppState AppState
@inject EventStreamHandler EventStreamHandler
@inject ErrorHandlingService ErrorHandlingService
@inject NavigationManager NavigationManager
@inject IMessageService MessageService
@inject IChatOrchestrator ChatOrchestrator
@inject Abstractions.Agents.IAgentRegistry AgentRegistry
@inject Core.AgentSelectionResolver AgentSelectionResolver
@inject IWorkspaceProvider WorkspaceProvider
@inject Seeing.Agent.Abstractions.Permissions.IPermissionChannel PermissionChannel
@inject ToolManager ToolInvoker
@inject SkillManager SkillManager
@inject ILlmService LlmService
@inject IModelManager ModelManager
@inject Services.CommandListService CommandListService
@inject Seeing.Agent.TokenBudget.IBudgetStatusNotifier BudgetNotifier
@inject Seeing.Agent.TokenBudget.ITokenBudgetManager TokenBudgetManager
@inject ISessionManager SessionManager
@inject ISessionEventPublisher SessionEventPublisher
@inject Seeing.Agent.Core.Background.IBackgroundTaskManager BackgroundTaskManager
@inject Services.MessageTimelineStore Timeline
@inject IOptionsMonitor<SeeingAgentOptions> SeeingAgentOptions
@implements IDisposable

<div Class="session-page-container">
    <!-- 会话头部 -->
    <div Class="session-header">
        <div Class="session-header-left">
            <Button Type="@ButtonType.Text"
                    Size="@ButtonSize.Small"
                    Icon="@IconType.Outline.Home"
                    OnClick="@GoToHome">
                @if (!AppState.SidebarCollapsed && !AppState.IsMobile)
                {
                    <span>首页</span>
                }
            </Button>
            @if (!AppState.IsMobile)
            {
                <Divider Type="@DividerType.Vertical" />
            }
            <Tooltip Title="@SessionState.Title">
                <span Class="session-title">@SessionState.Title</span>
            </Tooltip>
            @if (IsSubAgentView)
            {
                <Badge Status="@BadgeStatus.Warning" Text="子会话（只读）" />
            }
            else if (SessionState.IsQueued)
            {
                <Badge Status="@BadgeStatus.Default" Text="@($"排队中 ({SessionState.QueuePosition})" )" />
            }
            else if (SessionState.HasActiveExecution)
            {
                <Badge Status="@BadgeStatus.Processing" Text="执行中" />
            }
            @{
                var currentWorkspace = !string.IsNullOrEmpty(SessionState.CurrentSession?.WorkingDirectory) 
                    ? SessionState.CurrentSession.WorkingDirectory 
                    : WorkspaceProvider.WorkspaceRoot;
            }
            @if (!AppState.IsMobile)
            {
                <Tooltip Title="@currentWorkspace">
                    <span Class="session-workspace-badge">
                        <Icon Type="@IconType.Outline.Folder" />
                        @TruncateWorkspacePath(currentWorkspace)
                    </span>
                </Tooltip>
            }
            @if (!AppState.IsMobile && !IsSubAgentView && _optionsReady && SessionState.CurrentSession != null)
            {
                <Tooltip Title="编辑出站绑定">
                    <Button Type="@ButtonType.Text"
                            Size="@ButtonSize.Small"
                            Icon="@IconType.Outline.Api"
                            OnClick="@OnEditOutbound" />
                </Tooltip>
            }
            @if (IsSubAgentView && !string.IsNullOrEmpty(SessionState.CurrentSession?.ParentSessionId))
            {
                <Button Type="@ButtonType.Link"
                        Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.ArrowLeft"
                        OnClick="@ReturnToParentSession"
                        Style="margin-left: 8px;">
                    返回主会话
                </Button>
            }
        </div>
        <div Class="session-header-right">
            @if (AppState.IsMobile)
            {
                @* 移动端：新建按钮 + 更多菜单 *@
                <Button Type="@ButtonType.Text"
                        Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.Plus"
                        OnClick="@CreateNewSessionAsync"
                        Disabled="@(SessionState.IsExecuting || IsSubAgentView)" />
                <Button Type="@ButtonType.Text"
                        Size="@ButtonSize.Small"
                        Icon="@IconType.Outline.Ellipsis"
                        OnClick="@ToggleMobileHeader"
                        Class="mobile-header-more-btn" />
            }
            else
            {
            <Space>
                <SpaceItem>
                    @if (IsSubAgentView)
                    {
                        <div class="subagent-meta" title="子代理（只读）">
                            <span class="subagent-meta-chip">
                                <span class="subagent-meta-label">Agent</span>
                                <span class="subagent-meta-value">@(string.IsNullOrEmpty(_selectedAgent) ? "—" : _selectedAgent)</span>
                            </span>
                            @if (!string.IsNullOrEmpty(_selectedModel))
                            {
                                <span class="subagent-meta-chip">
                                    <span class="subagent-meta-label">Model</span>
                                    <span class="subagent-meta-value">@_selectedModel</span>
                                </span>
                            }
                        </div>
                    }
                    else if (_optionsReady)
                    {
                        <Select TItemValue="string" TItem="string"
                                Value="@_selectedAgent"
                                ValueExpression="@(() => _selectedAgent)"
                                ValueChanged="EventCallback.Factory.Create<string>(this, OnAgentChanged)"
                                DataSource="@_agentNames"
                                Style="min-width: 120px;"
                                Size="@InputSize.Small"
                                Placeholder="智能体" />
                    }
                </SpaceItem>
                @if (!IsSubAgentView && _optionsReady && _isAcpPassthrough)
                {
                    <SpaceItem>
                        <Input Value="@_selectedAcpMode"
                               ValueChanged="EventCallback.Factory.Create<string?>(this, OnAcpModeChanged)"
                               Placeholder="Mode"
                               Style="width: 80px;"
                               Size="@InputSize.Small" />
                    </SpaceItem>
                    <SpaceItem>
                        <Input Value="@_selectedModel"
                               ValueChanged="EventCallback.Factory.Create<string?>(this, OnAcpModelChanged)"
                               Placeholder="Provider/Model"
                               Style="width: 160px;"
                               Size="@InputSize.Small" />
                    </SpaceItem>
                }
                else if (!IsSubAgentView && _optionsReady)
                {
                    <SpaceItem>
                        <Select TItemValue="string" TItem="ModelViewModel"
                                Value="@_selectedModel"
                                ValueExpression="@(() => _selectedModel)"
                                ValueChanged="@OnModelChanged"
                                DataSource="@_models"
                                ValueName="Id"
                                LabelName="ModelName"
                                GroupName="@nameof(ModelViewModel.ProviderName)"
                                SortByGroup="SortDirection.Ascending"
                                SortByLabel="SortDirection.Ascending"
                                Style="min-width: 160px;"
                                Size="@InputSize.Small"
                                Placeholder="模型"
                                Class="@(_modelInvalid ? "model-select-invalid" : null)"
                                EnableSearch="true">
                            <ItemTemplate Context="model">
                                <span>@model.ModelName</span>
                            </ItemTemplate>
                        </Select>
                    </SpaceItem>
                }
                <SpaceItem>
                    <Tooltip Title="重命名会话">
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Edit"
                                OnClick="@OnRenameSession"
                                Disabled="@IsSubAgentView" />
                    </Tooltip>
                </SpaceItem>
                <SpaceItem>
                    <Tooltip Title="@(IsSubAgentView ? "分叉为独立会话（可编辑）" : "分支会话")">
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Copy"
                                OnClick="@OnBranchSession" />
                    </Tooltip>
                </SpaceItem>
                <SpaceItem>
                    <Tooltip Title="新建会话">
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Plus"
                                OnClick="@CreateNewSessionAsync"
                                Disabled="@(SessionState.IsExecuting || IsSubAgentView)" />
                    </Tooltip>
                </SpaceItem>
                <SpaceItem>
                    <Tooltip Title="清空会话">
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Delete"
                                OnClick="@OnClearSession"
                                Disabled="@(SessionState.IsExecuting || IsSubAgentView)" />
                    </Tooltip>
                </SpaceItem>
             </Space>
            }
        </div>
    </div>

    @* 移动端溢出面板：智能体/模型选择 + 操作按钮 *@
    @if (AppState.IsMobile && _showMobileHeaderPanel && !IsSubAgentView)
    {
        <div class="session-header-mobile-panel">
            <div class="mobile-panel-row">
                @if (_optionsReady && !_isAcpPassthrough)
                {
                    <Select TItemValue="string" TItem="string"
                            Value="@_selectedAgent"
                            ValueExpression="@(() => _selectedAgent)"
                            ValueChanged="EventCallback.Factory.Create<string>(this, OnAgentChanged)"
                            DataSource="@_agentNames"
                            Style="flex:1; min-width: 0;"
                            Size="@InputSize.Small"
                            Placeholder="智能体" />
                }
                @if (_optionsReady && !_isAcpPassthrough)
                {
                    <Select TItemValue="string" TItem="ModelViewModel"
                            Value="@_selectedModel"
                            ValueExpression="@(() => _selectedModel)"
                            ValueChanged="@OnModelChanged"
                            DataSource="@_models"
                            ValueName="Id"
                            LabelName="ModelName"
                            GroupName="@nameof(ModelViewModel.ProviderName)"
                            SortByGroup="SortDirection.Ascending"
                            SortByLabel="SortDirection.Ascending"
                            Style="flex:1; min-width: 0;"
                            Size="@InputSize.Small"
                            Placeholder="模型"
                            Class="@(_modelInvalid ? "model-select-invalid" : null)"
                            EnableSearch="true">
                        <ItemTemplate Context="model">
                            <span>@model.ModelName</span>
                        </ItemTemplate>
                    </Select>
                }
            </div>
            <div class="mobile-panel-actions">
                <Button Size="@ButtonSize.Small" Icon="@IconType.Outline.Edit"
                        OnClick="@OnRenameSession">重命名</Button>
                <Button Size="@ButtonSize.Small" Icon="@IconType.Outline.Copy"
                        OnClick="@OnBranchSession">分支</Button>
                <Button Size="@ButtonSize.Small" Icon="@IconType.Outline.Delete"
                        OnClick="@OnClearSession"
                        Disabled="@(SessionState.IsExecuting)">清空</Button>
            </div>
        </div>
    }

    <!-- 主内容区域（消息列 + Todo 面板）；输入与消息同列，避免 Todo 出现时输入相对对话偏移 -->
    <div Class="session-content-wrapper">
        <div Class="session-main-column">
            <!-- 消息列表区域 -->
            <div Class="session-messages-container">
            @if (ShowEmptyState)
            {
                <!-- 无会话状态：引导用户创建新会话 -->
                <Empty Class="session-empty-state">
                    <DescriptionTemplate>
                        <div Class="empty-content">
                            <Icon Type="@IconType.Outline.FileAdd" Class="empty-icon" Style="font-size: 48px;" />
                            <p Style="font-size: 18px; margin-top: 16px;">暂无会话</p>
                            <p Class="empty-hint">点击下方按钮或顶部工具栏的"新建会话"开始对话</p>
                            <Button Type="@ButtonType.Primary"
                                    Icon="@IconType.Outline.Plus"
                                    OnClick="@CreateNewSessionAsync"
                                    Style="margin-top: 16px;">
                                新建会话
                            </Button>
                        </div>
                    </DescriptionTemplate>
                </Empty>
            }
            else
            {
                <MessageList AutoScroll="true"
                             OnToolClick="@OnToolClick"
                             CompactionInProgress="@_compactionInProgress"
                             CompactionReasoning="@_compactionReasoning"
                             CompactionProgress="@_compactionProgress" />
            }
            
            <!-- 加载状态指示器 -->
            @if (IsLoadingSession)
            {
                <div Class="loading-overlay">
                    <Spin Size="@SpinSize.Large" Tip="加载会话..." />
                </div>
            }
            </div>

            <!-- 输入区域：仅在非空状态时显示；SubAgent 子会话只读 -->
            @if (!ShowEmptyState)
            {
                <div Class="session-input-container">
                    @if (IsSubAgentView)
                    {
                        <div class="subagent-readonly-banner" style="padding: 12px 16px; background: var(--color-bg-secondary, #f5f5f5); border-radius: 8px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                            <Icon Type="@IconType.Outline.Eye" />
                            <span style="flex: 1;">当前为 Task 子会话（只读）。可返回主会话，或分叉为独立会话后再继续对话。</span>
                            @if (!string.IsNullOrEmpty(SessionState.CurrentSession?.ParentSessionId))
                            {
                                <Button Type="@ButtonType.Default"
                                        Size="@ButtonSize.Small"
                                        Icon="@IconType.Outline.ArrowLeft"
                                        OnClick="@ReturnToParentSession">
                                    返回主会话
                                </Button>
                            }
                            <Button Type="@ButtonType.Primary"
                                    Size="@ButtonSize.Small"
                                    Icon="@IconType.Outline.Copy"
                                    OnClick="@OnBranchSession">
                                分叉为独立会话
                            </Button>
                        </div>
                    }
                    else
                    {
                        <!-- Slot 扩展点: session_prompt -->
                        <SlotHost SlotName="session_prompt" />
                        
                         <PromptInput IsProcessing="@SessionState.HasActiveExecution"
                                      Placeholder="@GetPlaceholderText()"
                                      HelpText="@GetHelpText()"
                                      AvailableCommands="_availableCommands"
                                      SessionState="SessionState"
                                      CancellationTokenSource="@SessionState.CancellationTokenSource"
                                      BudgetStatus="SessionState.BudgetStatus"
                                      AutoApprove="@CurrentAutoApprove"
                                      OnAutoApproveChanged="@OnAutoApproveChanged"
                                      GlobalAutoApprove="_globalAutoApprove"
                                      AutoApproveDisabled="@IsSubAgentView"
                                      OnCompactRequested="OnCompactRequested"
                                      OnSubmitCallback="@OnSubmitMessage"
                                      OnCancelCallback="@OnCancelExecution" />
                    }
                </div>
            }
        </div>
        
        @* Todo 侧边面板（当有任务时显示） *@
        @if (SessionState.CurrentTodoList != null && SessionState.CurrentTodoList.HasTasks)
        {
            <div Class="session-todo-panel">
                <TodoPanel TodoList="@SessionState.CurrentTodoList" />
            </div>
        }
    </div>
    
    <!-- 错误提示 -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <Alert Type="@AlertType.Error"
               Message="@ErrorMessage"
               ShowIcon="true"
               Closable="true"
               OnClose="@OnClearError"
               Class="session-error-alert" />
    }
    
    <!-- 重命名对话框（仅在打开时渲染，避免隐藏 Modal 内 FormItem 初始化失败） -->
    @if (RenameModalVisible)
    {
        <Modal Title="重命名会话"
               Visible="true"
               OnOk="@OnRenameConfirm"
               OnCancel="@OnRenameCancel"
               OkText="@OkText"
               CancelText="@CancelText">
            <Form Model="@RenameForm" Layout="@FormLayout.Horizontal">
                <FormItem Label="会话标题">
                    <Input @bind-Value="@RenameForm.Title"
                           Placeholder="输入新的会话标题" />
                </FormItem>
            </Form>
        </Modal>
    }

    @if (OutboundModalVisible)
    {
        <Modal Title="编辑出站绑定"
               Visible="true"
               OnOk="@OnOutboundConfirm"
               OnCancel="@OnOutboundCancel"
               OkText="@OkText"
               CancelText="@CancelText">
            <Form Model="@OutboundForm" Layout="@FormLayout.Horizontal">
                <FormItem Label="ChannelId">
                    <Input @bind-Value="@OutboundForm.ChannelId"
                           Placeholder="如 qq / wecom，留空表示未绑定" />
                </FormItem>
                <FormItem Label="UserId">
                    <Input @bind-Value="@OutboundForm.UserId"
                           Placeholder="出站用户/对端 ID，可留空" />
                </FormItem>
            </Form>
        </Modal>
    }
</div>

@code {

    /// <summary>
    /// 常量文本（避免编码问题）
    /// </summary>
    private const string OkText = "确定";
    private const string CancelText = "取消";
    
    /// <summary>
    /// Agent/模型选择器相关
    /// </summary>
    private string _selectedAgent = "";
    private List<string> _agentNames = new();
    private string _selectedModel = "";
    private List<ModelViewModel> _models = new();
    private string _selectedAcpMode = "";
    private bool _isAcpPassthrough;
    private bool _optionsReady;
    private bool _showMobileHeaderPanel;

    /// <summary>native 模型是否校验失败（标红提示，发送时校验）</summary>
    private bool _modelInvalid;
    
    /// <summary>
    /// 模型视图类 - 用于选择器显示
    /// </summary>
    private class ModelViewModel
    {
        /// <summary>完整 ID（provider/model 格式）</summary>
        public string Id { get; init; } = "";
        
        /// <summary>模型名称</summary>
        public string ModelName { get; init; } = "";
        
        /// <summary>Provider 名称</summary>
        public string ProviderName { get; init; } = "";
    }

    private static ModelViewModel ToModelViewModel(string catalogKey, ModelConfig config)
    {
        var providerName = config.Provider;
        var modelName = config.Id;
        if (string.IsNullOrEmpty(modelName))
            modelName = config.Name ?? catalogKey;

        if (string.IsNullOrEmpty(providerName) || string.IsNullOrEmpty(modelName))
        {
            var slash = catalogKey.IndexOf('/');
            if (slash > 0)
            {
                if (string.IsNullOrEmpty(providerName))
                    providerName = catalogKey[..slash];
                if (string.IsNullOrEmpty(modelName))
                    modelName = catalogKey[(slash + 1)..];
            }
        }

        if (string.IsNullOrEmpty(providerName))
            providerName = "其他";

        return new ModelViewModel
        {
            Id = catalogKey,
            ModelName = modelName,
            ProviderName = providerName
        };
    }

    /// <summary>
    /// 可用命令列表（从后端获取）
    /// </summary>
    private List<CommandItemViewModel> _availableCommands = new();

    /// <summary>
    /// 当前流式输出的消息 ID
    /// </summary>
    private string _currentStreamingMessageId = string.Empty;

    /// <summary>
    /// 路由参数：会话 ID
    /// </summary>
    [Parameter]
    public string? SessionId { get; set; }

    /// <summary>
    /// 是否正在加载会话
    /// </summary>
    private bool IsLoadingSession { get; set; } = false;

    /// <summary>
    /// 是否显示空状态（无会话）
    /// </summary>
    private bool ShowEmptyState { get; set; } = false;

    /// <summary>Task 子会话：只读查看，不可发送/修改</summary>
    private bool IsSubAgentView =>
        SessionState.CurrentSession?.Kind == SessionKind.SubAgent;

    /// <summary>
    /// 错误消息
    /// </summary>
    private string? ErrorMessage { get; set; }

    /// <summary>
    /// 重命名对话框可见性
    /// </summary>
    private bool RenameModalVisible { get; set; } = false;

    /// <summary>
    /// 重命名表单
    /// </summary>
    private RenameSessionForm RenameForm { get; set; } = new();

    /// <summary>
    /// 出站绑定编辑对话框
    /// </summary>
    private bool OutboundModalVisible { get; set; }

    private OutboundEditForm OutboundForm { get; set; } = new();

    /// <summary>
    /// 当前选中的工具调用（用于详情显示）
    /// </summary>
    private ToolCallViewModel? SelectedToolCall { get; set; }

    private bool _hasRendered;
    private string? _loadedSessionId;
    private IDisposable? _budgetSubscription;
    private IDisposable? _sessionEventSubscription;
    private IDisposable? _seeingAgentOptionsSubscription;
    private bool _globalAutoApprove;
    /// <summary>压缩进行中标志（压缩耗时较长，页面需实时反馈）</summary>
    private bool _compactionInProgress;
    /// <summary>压缩进度实时文本（摘要正文增量拼接）</summary>
    private string? _compactionProgress;
    /// <summary>压缩进度推理文本（思考过程增量拼接，流式中在列表末尾自动展开展示）</summary>
    private string? _compactionReasoning;
    /// <summary>上次已渲染到 UI 的标题（与 SessionData 引用就地更新解耦）。</summary>
    private string? _renderedTitle;

    /// <summary>
    /// 组件初始化
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // MessageList subscribes to Timeline.Changed itself — Session does not refresh the whole page on every token.

        // 订阅 AppState 变更事件，确保移动端/桌面端切换时同步重渲染
        AppState.OnChange += OnAppStateChange;

        // 会话级自动批准：读取全局默认值 + 订阅热更
        _globalAutoApprove = SeeingAgentOptions.CurrentValue.Permission?.AutoApproveAll ?? false;
        _seeingAgentOptionsSubscription = SeeingAgentOptions.OnChange((opts, name) =>
        {
            _globalAutoApprove = opts.Permission?.AutoApproveAll ?? false;
            _ = InvokeAsync(StateHasChanged);
        });
        
        // 加载 Agent 和模型选项列表（不设置选中值）
        await LoadOptionsAsync();
        
        // 加载工具和技能数据
        await LoadToolsAndSkillsAsync();
        
        // 加载命令列表（从后端）
        LoadCommandsFromBackend();
        
        // 加载会话（选项就绪后再加载，避免 Select 在 DataSource 为空时渲染）
        if (!string.IsNullOrEmpty(SessionId))
        {
            await LoadSessionByIdAsync(SessionId);
            _loadedSessionId = SessionId;
            
            // 检查是否有正在进行的执行（页面刷新恢复）
            var overview = ChatOrchestrator.GetOverview(SessionId);
            if (overview?.CurrentExecution != null)
            {
                // 恢复执行状态
                SessionState.ExecutionStatus = overview.CurrentExecution.Status;
                SessionState.QueuePosition = overview.CurrentExecution.QueuePosition;
                SessionState.CurrentExecutionId = overview.CurrentExecution.ExecutionId;
                
                // 如果有活跃执行，恢复订阅事件流
                if (overview.HasActiveExecution)
                {
                    _ = ConsumeEventStreamAsync(overview.CurrentExecution.ExecutionId);
                }
            }
        }
        else
        {
            await LoadSessionAsync();
            _loadedSessionId = SessionState.CurrentSession?.Id;
        }
        
        // Subscribe to Budget status updates
        SubscribeToBudgetUpdates();
        SubscribeToSessionEvents();
    }

    private void SubscribeToBudgetUpdates()
    {
        // Dispose previous subscription
        _budgetSubscription?.Dispose();
        
        if (!string.IsNullOrEmpty(SessionState.SessionId))
        {
            _budgetSubscription = BudgetNotifier.Subscribe(SessionState.SessionId, status =>
            {
                SessionState.UpdateBudgetStatus(status);
                _ = InvokeAsync(StateHasChanged);
            });
        }
    }

    /// <summary>
    /// 会话级订阅：标题由 SetTitleAsync → SessionEvent.Updated 驱动，与 execution 生命周期解耦。
    /// </summary>
    private void SubscribeToSessionEvents()
    {
        _sessionEventSubscription?.Dispose();
        _sessionEventSubscription = SessionEventPublisher.Events.Subscribe(new SessionEventObserver(OnSessionLifecycleEvent));
    }

    private void OnSessionLifecycleEvent(SessionEvent evt)
    {
        if (evt.Type != SessionEventType.Updated)
            return;

        var current = SessionState.CurrentSession;
        if (current == null ||
            !string.Equals(evt.SessionId, current.Id, StringComparison.Ordinal))
            return;

        var newTitle = evt.Data?.Title;
        if (string.IsNullOrEmpty(newTitle))
            newTitle = SessionManager.Get(evt.SessionId)?.Title;

        ApplyTitleToUi(newTitle);
    }

    /// <summary>
    /// 将标题同步到 UI。用 _renderedTitle 区分「引用已就地改写」与「需要重绘」。
    /// </summary>
    private void ApplyTitleToUi(string? newTitle)
    {
        if (string.IsNullOrEmpty(newTitle))
            return;

        var current = SessionState.CurrentSession;
        if (current == null)
            return;

        current.Title = newTitle;
        if (string.Equals(_renderedTitle, newTitle, StringComparison.Ordinal))
            return;

        _renderedTitle = newTitle;
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed class SessionEventObserver : IObserver<SessionEvent>
    {
        private readonly Action<SessionEvent> _onNext;

        public SessionEventObserver(Action<SessionEvent> onNext) => _onNext = onNext;

        public void OnNext(SessionEvent value) => _onNext(value);
        public void OnError(Exception error) { }
        public void OnCompleted() { }
    }

    /// <summary>
    /// Full rebuild — whitelist only: load / switch session / compaction / SessionUpdated.
    /// Always requests force pin so enter/switch lands at the latest messages.
    /// </summary>
    private void ResetTimelineFromSession()
    {
        var session = SessionState.CurrentSession;
        if (session?.Messages is null)
        {
            Timeline.ResetFromSession([], SessionState.SessionId ?? "");
            Timeline.RequestPinToBottom();
            return;
        }

        Timeline.ResetFromSession(session.Messages, SessionState.SessionId ?? "");
        Timeline.RequestPinToBottom();
    }

    /// <summary>
    /// Append any session messages not yet in the timeline (user/system after submit or cancel).
    /// </summary>
    private void ReconcileTimelineFromSession()
    {
        var session = SessionState.CurrentSession;
        if (session?.Messages is null)
            return;

        Timeline.ReconcileAppendFromSession(session.Messages, SessionState.SessionId ?? "");
    }

    private void CompleteCurrentTimelineTurn()
    {
        var loopId = EventStreamHandler.GetCurrentLoopId()
            ?? ResolveCurrentStreamingAssistantMessage()?.LoopId;
        Timeline.CompleteTurn(loopId);
    }

    /// <summary>
    /// Resolve the assistant message currently being streamed (preserves timeline identity).
    /// </summary>
    private SessionMessage? ResolveCurrentStreamingAssistantMessage()
    {
        var fromHandler = EventStreamHandler.GetCurrentAssistantMessage();
        if (fromHandler != null
            && string.Equals(fromHandler.Role, "assistant", StringComparison.OrdinalIgnoreCase))
        {
            _currentStreamingMessageId = fromHandler.Id ?? _currentStreamingMessageId;
            return fromHandler;
        }

        var messages = SessionState.CurrentSession?.Messages;
        if (messages == null)
            return null;

        if (!string.IsNullOrEmpty(_currentStreamingMessageId))
        {
            var byId = messages.FirstOrDefault(m => m.Id == _currentStreamingMessageId);
            if (byId != null
                && string.Equals(byId.Role, "assistant", StringComparison.OrdinalIgnoreCase))
                return byId;
        }

        return messages.LastOrDefault(m =>
            string.Equals(m.Role, "assistant", StringComparison.OrdinalIgnoreCase) && !m.IsSummary);
    }

    /// <summary>
    /// In-place sync of the streaming assistant message (keeps ToolCall IsExpanded / Revision isolation).
    /// Falls back to reconcile (never mid-stream full Reset).
    /// </summary>
    private void SyncTimelineAssistantFromStream(bool isComplete = false)
    {
        var msg = ResolveCurrentStreamingAssistantMessage();
        if (msg == null)
        {
            ReconcileTimelineFromSession();
            return;
        }

        _currentStreamingMessageId = msg.Id ?? _currentStreamingMessageId;
        Timeline.SyncAssistantMessage(msg, SessionState.SessionId ?? "", isComplete);
    }

    /// <summary>
    /// 计算并更新当前会话的 Token 预算状态
    /// </summary>
    private void UpdateBudgetStatus()
    {
        var session = SessionState.CurrentSession;
        if (session == null) return;

        try
        {
            // 使用 TokenBudgetManager 计算预算状态
            var status = TokenBudgetManager.GetBudgetStatus(session, session.SelectedModel);

            var response = new Seeing.Agent.TokenBudget.Api.Responses.BudgetStatusResponse
            {
                SessionId = session.Id,
                CurrentTokens = status.CurrentTokens,
                MaxTokens = status.MaxTokens,
                AvailableTokens = status.AvailableTokens,
                UsagePercentage = status.UsagePercentage,
                Level = status.Level.ToString().ToLowerInvariant(),
                NeedsCompaction = status.Level >= BudgetLevel.Critical,
                Breakdown = null
            };

            SessionState.UpdateBudgetStatus(response);
        }
        catch (Exception)
        {
            // 忽略计算错误
        }
    }

    /// <summary>
    /// 根据当前 tokens 确定预算级别
    /// </summary>
    private static string DetermineLevel(int currentTokens, int maxTokens)
    {
        if (maxTokens <= 0) return "normal";
        var percentage = 100.0 * currentTokens / maxTokens;
        if (percentage >= 100) return "overflow";
        if (percentage >= 90) return "critical";
        if (percentage >= 80) return "warning";
        return "normal";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _hasRendered = true;
    }

