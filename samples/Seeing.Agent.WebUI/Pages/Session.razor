@page "/session"
@page "/session/{SessionId}"
@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Seeing.Agent.WebUI.Models
@using Seeing.Agent.WebUI.Commands
@using Services = Seeing.Agent.WebUI.Services
@using Core = Seeing.Agent.Core
@using Seeing.Session.Core
@using Seeing.Agent.WebUI.State
@using Seeing.Agent.Tools
@using Seeing.Agent.Skills
@using Seeing.Agent.Configuration
@using Microsoft.Extensions.Options
@using Seeing.Agent.Llm
@using Seeing.Session.Management
@using Seeing.Agent.App
@using Seeing.Agent.App.Events
@using Seeing.Agent.Events
@using Seeing.Agent.Models
@using Seeing.Agent.Execution
@using Seeing.Agent.Core.Events
@using Seeing.Agent.Core.Reminders
@using Seeing.Agent.Core.Instructions
@inject SessionState GlobalSessionState
@inject AppState AppState
@inject NavigationManager NavigationManager
@inject IMessageService MessageService
@inject IChatOrchestrator ChatOrchestrator
@inject IWorkspaceProvider WorkspaceProvider
@inject ToolManager ToolInvoker
@inject SkillManager SkillManager
@implements IDisposable

<div Class="session-page-container">
    @* 会话窗口：会话加载/事件绑定/时间线/提交/取消/只读/Todo/压缩/budget/标题 全在此承载；
       本页仅注入页级导航（经工具栏左右插槽读写 Context）与对话框。 *@
    <SessionWindow SessionId="@(SessionId ?? "")"
                   ViewMode="Services.SessionWindowMode.Full"
                   AggregatorSessionId="@(SessionId ?? "")"
                   GlobalSessionState="@GlobalSessionState">
        <ToolbarLeftActions Context="ctx">
            @{
                // 幂等同步 AppState.CurrentSessionId（供首页"继续会话"导航定位）
                SyncCurrentSessionId(ctx);
            }
            <Button Type="@ButtonType.Text"
                    Size="@ButtonSize.Small"
                    Icon="@IconType.Outline.Home"
                    OnClick="@GoToHome">
                @if (!AppState.SidebarCollapsed && !AppState.IsMobile)
                {
                    <span>首页</span>
                }
            </Button>
        </ToolbarLeftActions>
        <ToolbarRightActions Context="ctx">
            <Space>
                @if (!ctx.IsSubAgentView)
                {
                    <SpaceItem>
                        <Tooltip Title="分支会话">
                            <Button Type="@ButtonType.Text"
                                    Size="@ButtonSize.Small"
                                    Icon="@IconType.Outline.Copy"
                                    OnClick="@OnBranchSession" />
                        </Tooltip>
                    </SpaceItem>
                }
                <SpaceItem>
                    <Tooltip Title="多 Agent 会议大屏">
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.VideoCamera"
                                OnClick="@GoToConference" />
                    </Tooltip>
                </SpaceItem>
                <SpaceItem>
                    <Tooltip Title="新建会话">
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Plus"
                                OnClick="@CreateNewSessionAsync"
                                Disabled="@(ctx.IsExecuting || ctx.IsSubAgentView)" />
                    </Tooltip>
                </SpaceItem>
            </Space>
        </ToolbarRightActions>
    </SessionWindow>
</div>

@code {

    private bool _hasRendered;

    /// <summary>
    /// 路由参数：会话 ID
    /// </summary>
    [Parameter]
    public string? SessionId { get; set; }

    /// <summary>
    /// 组件初始化：会话加载/事件绑定/Agent 与模型选项等均由 SessionWindow + SessionToolbar 承载，
    /// 本页仅订阅 AppState 变更与预载工具/技能数据。
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // 订阅 AppState 变更事件，确保移动端/桌面端切换时同步重渲染
        AppState.OnChange += OnAppStateChange;

        // 加载工具和技能数据
        await LoadToolsAndSkillsAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _hasRendered = true;
    }

    private void OnAppStateChange()
    {
        RequestRender();
    }

    private void RequestRender()
    {
        if (!_hasRendered)
            return;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 幂等同步 AppState.CurrentSessionId（供首页"继续会话"导航定位；无需事件订阅）
    /// </summary>
    private void SyncCurrentSessionId(Services.SessionWindowContext ctx)
    {
        var id = ctx.CurrentSession?.Id;
        if (!string.IsNullOrEmpty(id)
            && !string.Equals(AppState.CurrentSessionId, id, StringComparison.Ordinal))
        {
            AppState.CurrentSessionId = id;
        }
    }

    /// <summary>
    /// 加载工具和技能数据（用于快速命令浮窗）
    /// </summary>
    private async Task LoadToolsAndSkillsAsync()
    {
        try
        {
            // 加载工具和技能信息（用于其他用途）
            await ToolInvoker.GetToolSchemasAsync();
            await SkillManager.DiscoverSkillsAsync();
        }
        catch (Exception)
        {
            // 静默处理，不影响主流程
        }
    }

    /// <summary>
    /// 创建新会话
    /// </summary>
    private async Task CreateNewSessionAsync()
    {
        try
        {
            var session = await ChatOrchestrator.CreateSessionAsync(
                workingDirectory: WorkspaceProvider.WorkspaceRoot);
            NavigationManager.NavigateTo(string.Format("/session/{0}", session.Id));
        }
        catch (Exception ex)
        {
            MessageService.Error(string.Format("创建会话失败: {0}", ex.Message));
        }
    }

    /// <summary>
    /// 返回首页
    /// </summary>
    private void GoToHome()
    {
        NavigationManager.NavigateTo("/home");
    }

    /// <summary>
    /// 前往多 Agent 会议大屏（SessionState 为全局 Scoped 实例，窗口桥接已写入当前会话）
    /// </summary>
    private void GoToConference()
    {
        var id = GlobalSessionState.CurrentSession?.Id;
        if (string.IsNullOrEmpty(id)) return;
        NavigationManager.NavigateTo($"/conference/{id}");
    }

    /// <summary>
    /// 分支会话（导航到新会话页；子会话分叉为独立会话由工具栏承载）
    /// </summary>
    private async Task OnBranchSession()
    {
        var session = GlobalSessionState.CurrentSession;
        if (session == null) return;

        var branched = await ChatOrchestrator.BranchSessionAsync(session.Id, $"{session.Title} (分支)");
        NavigationManager.NavigateTo($"/session/{branched.Id}");
    }

    /// <summary>
    /// 释放资源（导航离开 / 电路断开）
    /// </summary>
    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChange;
    }
}
