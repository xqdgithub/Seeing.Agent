    /// <summary>
    /// 提交消息处理（使用 Submit + SubscribeEvents 模式）
    /// </summary>
    private async Task OnSubmitMessage(PromptSubmitEventArgs args)
    {
        if (IsSubAgentView)
        {
            ErrorMessage = "子会话为只读，请先分叉为独立会话后再发送消息";
            return;
        }

        // 验证输入
        if (string.IsNullOrWhiteSpace(args.Text) && args.Attachments.Count == 0)
        {
            ErrorMessage = "请输入消息内容";
            return;
        }

        // 确保有当前会话
        if (SessionState.CurrentSession == null)
        {
            ErrorMessage = "请先创建或选择一个会话";
            return;
        }

        // 清除错误消息
        ErrorMessage = null;

        // Native 模式：发送前校验当前选择的模型真实可用（为空或不在可用目录中 → 拦截并要求选择）
        if (!_isAcpPassthrough)
        {
            var modelAvailable = !string.IsNullOrEmpty(_selectedModel)
                && _models.Any(m => m.Id == _selectedModel);
            if (!modelAvailable)
            {
                _modelInvalid = true;
                ErrorMessage = string.IsNullOrEmpty(_selectedModel)
                    ? "请先选择一个可用的模型"
                    : $"当前模型不可用（{_selectedModel}），请重新选择";
                args.IsRejected = true;
                return;
            }
        }

        // 构建输入
        var input = new ChatInput { Text = args.Text };
        
        if (args.Attachments != null && args.Attachments.Count > 0)
        {
            input = new ChatInput
            {
                Text = args.Text,
                Attachments = args.Attachments
                    .Where(a => a.Status == AttachmentUploadStatus.Completed)
                    .Select(a => new ChatAttachment
                    {
                        Base64Data = ExtractBase64Data(a.Base64Content),
                        MimeType = a.FileType,
                        FileName = a.FileName
                    }).ToList()
            };
        }

        var options = new ChatOptions
        {
            AgentId = SessionState.SelectedAgent,
            ModelId = SessionState.SelectedModel,
            ModeId = SessionState.SelectedAcpMode,
            WorkingDirectory = SessionState.CurrentSession?.WorkingDirectory ?? WorkspaceProvider.WorkspaceRoot,
            // 传递权限通道，支持交互式确认
            PermissionChannel = PermissionChannel,
            // 会话级自动批准策略（三态）
            AutoApprove = SessionState.CurrentSession?.AutoApprove ?? SessionAutoApprove.FollowGlobal
        };

        try
        {
            // 防重复提交：已有执行则直接拒绝（避免 Enter/点击竞态打出两次 Loop）
            if (!SessionState.TryStartExecution())
            {
                ErrorMessage = "当前会话已有执行在进行中，请稍候";
                return;
            }

            SessionState.ExecutionStatus = ExecutionStatus.Pending;
            
            // 提交执行（用户消息会立即保存）
            var result = await ChatOrchestrator.SubmitAsync(SessionState.SessionId, input, options);
            
            if (!result.Success)
            {
                ErrorMessage = result.Error ?? "提交失败";
                SessionState.CompleteExecution();
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Append newly persisted user (and any other) messages without full Reset.
            ReconcileTimelineFromSession();
            Timeline.RequestPinToBottom();
            _currentStreamingMessageId = string.Empty;

            // 更新 UI 状态
            SessionState.ExecutionStatus = result.Status;
            SessionState.QueuePosition = result.QueuePosition;
            SessionState.CurrentExecutionId = result.ExecutionId;
            
            await InvokeAsync(StateHasChanged);

            // 订阅事件流
            _ = ConsumeEventStreamAsync(result.ExecutionId!);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"执行失败: {ex.Message}";
            SessionState.CompleteExecution();
            SessionState.ExecutionStatus = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// 消费事件流（后台任务）
    /// </summary>
    private async Task ConsumeEventStreamAsync(string executionId)
    {
        var charCount = 0;
        var _currentCodeBlockDepth = 0;

        try
        {
            await foreach (var evt in ChatOrchestrator.SubscribeEvents(SessionState.SessionId, CancellationToken.None))
            {
                // 检查是否是当前执行的事件
                if (evt is ExecutionCompleteEvent completeEvt && completeEvt.ExecutionId == executionId)
                {
                    // 立即结束执行态；晚到标题由会话级 SessionEvent 订阅更新，不阻塞本循环
                    SessionState.ExecutionStatus = completeEvt.Status;
                    SessionState.CurrentExecutionId = null;
                    SessionState.CompleteExecution();
                    SyncTimelineAssistantFromStream(isComplete: true);
                    CompleteCurrentTimelineTurn();
                    ReconcileTimelineFromSession();
                    await SyncTitleFromSessionAsync();
                    await InvokeAsync(StateHasChanged);
                    break;
                }

                // 处理事件 - 由 EventStreamHandler 统一处理（必须 await，否则 Task 字段可能未写入就刷新）
                await EventStreamHandler.ProcessEventAsync(evt);

                if (evt is StreamDeltaEvent deltaEvt)
                {
                    var contentLen = deltaEvt.ContentDelta?.Length ?? 0;
                    var reasoningLen = deltaEvt.ReasoningDelta?.Length ?? 0;
                    charCount += contentLen + reasoningLen;

                    var inCodeBlock = _currentCodeBlockDepth > 0;
                    var contentDelta = deltaEvt.ContentDelta;
                    var hasNewline = contentDelta?.Contains("\n") == true;
                    var threshold = inCodeBlock ? 20 : 8;

                    if (contentDelta?.Contains("```") == true)
                    {
                        _currentCodeBlockDepth += contentDelta.Count(c => c == '`') / 3;
                        _currentCodeBlockDepth = Math.Max(0, _currentCodeBlockDepth % 2 == 0 ? 0 : 1);
                        threshold = 0;
                    }

                    if (charCount >= threshold || hasNewline || threshold == 0)
                    {
                        SyncTimelineAssistantFromStream(isComplete: false);
                        charCount = 0;
                    }
                }
                else if (evt is StreamStartEvent or ToolCallEvent or StreamCompleteEvent
                         or LoopStartEvent or SubAgentEvent
                         or TaskStartedEvent or TaskProgressEvent or TaskCompletedEvent or TaskFailedEvent
                         or PermissionRequestEvent or PermissionResponseEvent
                         or TodoUpdateEvent or ModeUpdateEvent)
                {
                    SyncTimelineAssistantFromStream(isComplete: false);
                }
                else if (evt is LoopCompleteEvent)
                {
                    SyncTimelineAssistantFromStream(isComplete: true);
                    CompleteCurrentTimelineTurn();
                }
                else if (evt is LoopCancelledEvent or ErrorEvent)
                {
                    SyncTimelineAssistantFromStream(isComplete: true);
                    CompleteCurrentTimelineTurn();
                    ReconcileTimelineFromSession();
                }
                else if (evt is SessionTitleChangedEvent titleEvt)
                {
                    if (string.Equals(SessionState.CurrentSession?.Id, titleEvt.SessionId, StringComparison.Ordinal))
                        ApplyTitleToUi(titleEvt.Title);
                }
                else if (evt is SessionUpdatedEvent)
                {
                    // Whitelist: structural session rewrite
                    ResetTimelineFromSession();
                }
                else if (evt is NavigateEvent navEvt)
                {
                    if (!string.IsNullOrEmpty(navEvt.Target))
                        NavigationManager.NavigateTo(navEvt.Target);
                }
                else if (evt is CommandResultEvent commandEvt)
                {
                    // 命令结果：压缩等命令要求全量刷新时间线；导航命令走 NavigationTarget
                    if (commandEvt.NeedsRefresh)
                    {
                        ResetTimelineFromSession();
                        ReconcileTimelineFromSession();
                        await InvokeAsync(StateHasChanged);
                    }

                    if (!string.IsNullOrEmpty(commandEvt.NavigationTarget))
                    {
                        NavigationManager.NavigateTo(commandEvt.NavigationTarget);
                    }
                }
                else if (evt is CompactionStartedEvent)
                {
                    // 压缩开始：在列表末尾显示流式进度条目（与最终摘要条位置一致），等待 summarizing 增量
                    _compactionInProgress = true;
                    _compactionProgress = string.Empty;
                    _compactionReasoning = string.Empty;
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt is CompactionDeltaEvent compactionDeltaEvt)
                {
                    // 压缩进度：实时拼接摘要生成内容（正文 + 思考），页面不长时间无响应
                    if (!string.IsNullOrEmpty(compactionDeltaEvt.ContentDelta))
                    {
                        _compactionProgress += compactionDeltaEvt.ContentDelta;
                    }
                    if (!string.IsNullOrEmpty(compactionDeltaEvt.ReasoningDelta))
                    {
                        _compactionReasoning += compactionDeltaEvt.ReasoningDelta;
                    }
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt is CompactionCompletedEvent)
                {
                    // 压缩完成：会话内容已变更，全量重建时间线
                    _compactionInProgress = false;
                    _compactionProgress = null;
                    _compactionReasoning = null;
                    ResetTimelineFromSession();
                    ReconcileTimelineFromSession();
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt is CompactionFailedEvent failedEvt)
                {
                    _compactionInProgress = false;
                    _compactionProgress = null;
                    _compactionReasoning = null;
                    ResetTimelineFromSession();
                    ReconcileTimelineFromSession();
                    if (!string.IsNullOrEmpty(failedEvt.ErrorMessage))
                    {
                        MessageService.Error(string.Format("压缩失败: {0}", failedEvt.ErrorMessage));
                    }
                }
                else
                {
                    // Unknown event: incremental sync only — never mid-stream Reset
                    SyncTimelineAssistantFromStream(isComplete: false);
                    ReconcileTimelineFromSession();
                }
            }
        }
        catch (OperationCanceledException)
        {
            if (SessionState.ExecutionStatus == ExecutionStatus.Cancelled)
            {
                if (SessionState.CurrentSession != null)
                {
                    SessionState.CurrentSession.AddMessage(SessionMessage.SystemMessage("执行已取消"));
                }
            }

            SyncTimelineAssistantFromStream(isComplete: true);
            CompleteCurrentTimelineTurn();
            ReconcileTimelineFromSession();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"执行失败: {ex.Message}";
            if (SessionState.CurrentSession != null)
            {
                SessionState.CurrentSession.AddMessage(SessionMessage.SystemMessage($"执行出错: {ex.Message}"));
            }

            SyncTimelineAssistantFromStream(isComplete: true);
            CompleteCurrentTimelineTurn();
            ReconcileTimelineFromSession();
        }
        finally
        {
            SessionState.ExecutionStatus = null;
            SessionState.CurrentExecutionId = null;
            SessionState.CompleteExecution();
            SyncTimelineAssistantFromStream(isComplete: true);
            CompleteCurrentTimelineTurn();
            ReconcileTimelineFromSession();
            _currentStreamingMessageId = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// 从 SessionManager 同步最新标题到 UI 状态。
    /// </summary>
    private Task SyncTitleFromSessionAsync()
    {
        if (SessionState.CurrentSession == null)
            return Task.CompletedTask;

        var live = SessionManager.Get(SessionState.CurrentSession.Id);
        ApplyTitleToUi(live?.Title);
