@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Seeing.Agent.WebUI.Models
@using Seeing.Agent.WebUI.Commands
@using Services = Seeing.Agent.WebUI.Services
@using Core = Seeing.Agent.Core
@using Seeing.Session.Core
@using Seeing.Agent.WebUI.State
@using Seeing.Agent.Core.Tools
@using Seeing.Agent.Skills
@using Seeing.Agent.Core.Configuration
@using Seeing.Agent.Configuration
@using Microsoft.Extensions.Options
@using Seeing.Agent.Core.Llm
@using Seeing.Agent.Llm
@using Seeing.Session.Management
@using Seeing.Agent.Hosting
@using Seeing.Agent.Hosting.Events
@using Seeing.Agent.Core.Events
@using Seeing.Agent.Abstractions.Models
@using Seeing.Agent.Abstractions.Execution
@using Seeing.Agent.Core.Execution
@using Seeing.Agent.Core.Reminders
@using Seeing.Agent.Core.Instructions
@inject SessionState GlobalSessionState
@inject AppState AppState
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IMessageService MessageService
@inject ISessionDirectory SessionDirectory
@inject IWorkspaceProvider WorkspaceProvider
@inject SkillManager SkillManager
@inject Services.SessionEventStreamRouter Router
@inject CircuitContext CircuitContext
@inject Services.PermissionInboxView PermissionView
@inject ISessionManager SessionManager
@inject ISessionGroupManager GroupManager
@implements IDisposable

<div Class="session-page-container">
    @if (_mainMissing)
    {
        <Alert Type="@AlertType.Error"
               Message="主会话不存在或已删除"
               ShowIcon="true"
               Closable="true"
               OnClose="@OnCloseMainMissing"
               Class="session-main-missing">
            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="@GoToHome">返回首页</Button>
        </Alert>
    }
    else
    {
    @* 顶部关系条：主线链（前任 → 锚点）+ 分支计数，数据源为组快照（点击仅切 active，URL 不变）。 *@
    <SessionRelationBar Model="_relationModel"
                        OnSelect="OnTileClick"
                        OnOpenDrawer="OpenRelationDrawer" />
    @* 双栏布局：主区为 active 会话（Full + SessionToolbar 头部），侧栏为非 active 会话（Summary 卡片）；
       侧栏无窗口时隐藏，主窗全宽。头部仍用会话页 SessionToolbar（Agent/模型切换、页级导航插槽）。 *@
    <div class="session-dual-grid">
        <div class="session-main-area">
            @if (string.IsNullOrEmpty(_activeSessionId))
            {
                @* 无可用会话：由 SessionWindow 无路由参数模式展示空态 *@
                <SessionWindow SessionId=""
                               ViewMode="Services.SessionWindowMode.Full"
                               GlobalSessionState="@GlobalSessionState">
                    <ToolbarLeftActions Context="ctx">
                        <Button Type="@ButtonType.Text"
                                Size="@ButtonSize.Small"
                                Icon="@IconType.Outline.Home"
                                OnClick="@GoToHome">
                            @if (!AppState.SidebarCollapsed && !AppState.IsMobile)
                            {
                                <span>首页</span>
                            }
                        </Button>
                    </ToolbarLeftActions>
                </SessionWindow>
            }
            else
            {
                @* 主窗：去掉 @key，切换 active 时复用窗口实例（走 OnParametersSetAsync 切换分支）。
                   原实现 @key 会销毁重建整窗：新 handler 订阅即重放 ≤100 条缓冲事件 +
                   Toolbar/PromptInput/MessageList 全量挂载 + 聚合器 Reconcile 全表扫。 *@
                <ErrorBoundary>
                    <SessionWindow SessionId="@_activeSessionId"
                                   ViewMode="Services.SessionWindowMode.Full"
                                   AggregatorSessionId="@_mainSessionId"
                                   GlobalSessionState="@GlobalSessionState"
                                   OnClick="@OnTileClick"
                                   OnExecutionStateChanged="@OnExecutionStateChanged">
                        <ToolbarLeftActions Context="ctx">
                            @{
                                // 幂等同步 AppState.CurrentSessionId（供首页"继续会话"导航定位）
                                SyncCurrentSessionId(ctx);
                            }
                            <Button Type="@ButtonType.Text"
                                    Size="@ButtonSize.Small"
                                    Icon="@IconType.Outline.Home"
                                    OnClick="@GoToHome">
                                @if (!AppState.SidebarCollapsed && !AppState.IsMobile)
                                {
                                    <span>首页</span>
                                }
                            </Button>
                        </ToolbarLeftActions>
                        <ToolbarRightActions Context="ctx">
                            <Space>
                                @if (ctx.CanBranch)
                                {
                                    <SpaceItem>
                                        <Tooltip Title="分支会话">
                                            <Button Type="@ButtonType.Text"
                                                    Size="@ButtonSize.Small"
                                                    Icon="@IconType.Outline.Copy"
                                                    OnClick="@OnBranchSession" />
                                        </Tooltip>
                                    </SpaceItem>
                                }
                                <SpaceItem>
                                    <Tooltip Title="多 Agent 会议大屏">
                                        <Button Type="@ButtonType.Text"
                                                Size="@ButtonSize.Small"
                                                Icon="@IconType.Outline.VideoCamera"
                                                OnClick="@GoToConference" />
                                    </Tooltip>
                                </SpaceItem>
                                <SpaceItem>
                                    <Tooltip Title="新建会话">
                                        <Button Type="@ButtonType.Text"
                                                Size="@ButtonSize.Small"
                                                Icon="@IconType.Outline.Plus"
                                                OnClick="@CreateNewSessionAsync"
                                                Disabled="@(ctx.IsExecuting || !ctx.CanCreateSession)" />
                                    </Tooltip>
                                </SpaceItem>
                            </Space>
                        </ToolbarRightActions>
                    </SessionWindow>
                </ErrorBoundary>
            }
        </div>
        @if (ShowSidebar)
        {
            <div class="session-side-area">
                @foreach (var sec in _sidebarSections)
                {
                    <div class="session-side-section @($"session-side-section--{sec.Section}")" @key="sec.Section">
                        <div class="session-side-section__title">
                            <span class="session-side-section__dot" aria-hidden="true"></span>
                            <span>@sec.Title</span>
                            <span class="session-side-section__count">
                                @sec.Entries.Count
                                @if (sec.PendingPermissionTotal > 0)
                                {
                                    <text> · 待批 @sec.PendingPermissionTotal</text>
                                }
                            </span>
                        </div>
                        @foreach (var entry in sec.Entries)
                        {
                            <ErrorBoundary>
                                <div class="session-side-entry">
                                    <Badge Count="@entry.PendingPermissions" Style="width: 100%;">
                                        <SessionWindow @key="@entry.SessionId"
                                                       SessionId="@entry.SessionId"
                                                       ViewMode="Services.SessionWindowMode.Summary"
                                                       AggregatorSessionId="@_mainSessionId"
                                                       GlobalSessionState="@GlobalSessionState"
                                                       OnClick="@OnTileClick"
                                                       OnExecutionStateChanged="@OnExecutionStateChanged" />
                                    </Badge>
                                    @* 条目操作：绝对定位浮在卡片右上角，默认透明不占布局；
                                       hover / 键盘聚焦时淡入。stopPropagation 保证不触发卡片的「切换 active」。
                                       点击后主动失焦：否则焦点留在按钮上，按钮组会一直显示（粘住）。 *@
                                    <div class="session-side-entry__actions">
                                        <button type="button"
                                                class="session-side-entry__action"
                                                title="重命名"
                                                aria-label="重命名"
                                                @onclick="() => RenameTileAsync(entry.SessionId)"
                                                @onclick:stopPropagation="true">
                                            <Icon Type="@IconType.Outline.Edit" />
                                        </button>
                                        <button type="button"
                                                class="session-side-entry__action"
                                                title="在新标签打开"
                                                aria-label="在新标签打开"
                                                @onclick="() => OpenTileInNewTab(entry.SessionId)"
                                                @onclick:stopPropagation="true">
                                            <Icon Type="@IconType.Outline.Link" />
                                        </button>
                                    </div>
                                </div>
                            </ErrorBoundary>
                        }
                    </div>
                }
            </div>
        }

        @* 侧栏显隐入口（悬浮，不占布局）：
           展开态 = 贴右缘的圆形「收起」钮；收起态 = 同一位置的圆形「展开」钮 + 数量角标。
           用 position: fixed 脱离布局流，侧栏收起时页面内容可占满整宽。 *@
        @if (_sidebarSections.Count > 0)
        {
            <button type="button"
                    class="session-side-toggle session-side-toggle--float @(ShowSidebar ? "is-expanded" : "is-collapsed")"
                    title="@(ShowSidebar ? "收起侧栏" : "展开侧栏")"
                    aria-label="@(ShowSidebar ? "收起侧栏" : "展开侧栏")"
                    aria-expanded="@ShowSidebar"
                    @onclick="ToggleSidebar">
                <Icon Type="@(ShowSidebar ? IconType.Outline.Right : IconType.Outline.Left)" />
                @if (!ShowSidebar)
                {
                    <span class="session-side-toggle__count">@_sidebarSections.Sum(s => s.Entries.Count)</span>
                }
            </button>
        }
    </div>

    @* 关系抽屉：完整关系树 + 节点操作（切换/重命名/新标签/删除） *@
    <SessionRelationDrawer Open="_relationDrawerOpen"
                           Model="_relationModel"
                           OpenChanged="@(open => _relationDrawerOpen = open)"
                           OnSelect="OnTileClick"
                           OnNodeAction="OnRelationNodeAction" />

    @* 关系抽屉触发的重命名弹窗（走既有 SessionDirectory.RenameAsync） *@
    <Modal Title="重命名会话"
           Visible="@(_renameSessionId != null)"
           OnOk="ConfirmRenameAsync"
           OnCancel="CancelRename"
           OkText="@("确定")"
           CancelText="@("取消")">
        <Input @bind-Value="_renameTitle" Placeholder="请输入会话标题" />
    </Modal>
    }
</div>

@code {

    private bool _hasRendered;

    /// <summary>
    /// 路由参数：会话 ID（主会话）
    /// </summary>
    [Parameter]
    public string? SessionId { get; set; }

    // ---- 双栏状态：主会话 + active 切换 + 侧栏窗口 ----
    private string? _mainSessionId;
    private string? _activeSessionId;
    private bool _mainMissing;
    private SessionWindowRegistry? _registry;
    private IReadOnlyList<SessionWindowRegistry.WindowNode> _windows = Array.Empty<SessionWindowRegistry.WindowNode>();

    // ---- 关系展示（顶条 / 抽屉 / 侧栏分区）----
    private RelationTreeModel? _relationModel;
    private IReadOnlyList<SidebarSection> _sidebarSections = Array.Empty<SidebarSection>();
    private SessionGroup? _currentGroup;
    private bool _relationDrawerOpen;
    private int _relationRefreshGeneration;

    /// <summary>执行态收集（sessionId → isExecuting）：由各 SessionWindow 回调上报，不写入 registry。</summary>
    private readonly Dictionary<string, bool> _executionStates = new(StringComparer.Ordinal);

    /// <summary>侧栏可见性状态机（按组记忆隐藏/自动展开）。</summary>
    private readonly Services.SessionSidebarVisibility _sidebarVisibility = new();

    /// <summary>当前侧栏是否应显示（渲染时读取，避免模板里写条件表达式刺穿可读性）。</summary>
    private bool ShowSidebar =>
        _sidebarSections.Count > 0
        && _sidebarVisibility.ShouldShow(SidebarGroupKey, _sidebarSections.Sum(s => s.Entries.Count));

    // ---- 重命名弹窗（关系抽屉 Rename 动作触发）----
    private string? _renameSessionId;
    private string? _renameTitle;

    /// <summary>
    /// 组件初始化：会话加载/事件绑定/Agent 与模型选项等均由 SessionWindow + SessionToolbar 承载，
    /// 本页订阅 AppState 变更、预载工具/技能数据，并接线双栏子会话 registry。
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // 订阅 AppState 变更事件，确保移动端/桌面端切换时同步重渲染
        AppState.OnChange += OnAppStateChange;
        PermissionView.Changed += OnPermissionChanged;

        // 加载工具和技能数据
        await LoadToolsAndSkillsAsync();

        // 解析主会话：路由参数优先，否则最近 Root 会话（ListSessionsAsync 仅返回 Root，避免子会话被误选为主会话）
        var mainId = !string.IsNullOrEmpty(SessionId)
            ? SessionId
            : (await SessionDirectory.ListSummariesAsync()).FirstOrDefault()?.Id;
        if (string.IsNullOrEmpty(mainId))
        {
            // 无任何会话：主窗由 SessionWindow 空态兜底（_activeSessionId 保持空）
            return;
        }

        // URL 指定但主会话已删除 → 错误态（缓存 → 存储兜底确认，与大屏一致）
        var main = SessionManager.Get(mainId);
        if (main == null)
        {
            main = await SessionManager.LoadAsync(mainId);
            if (main == null)
            {
                _mainMissing = true;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        _mainSessionId = mainId;
        _activeSessionId = mainId;
        InitRegistry(mainId);

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 路由参数变化：主会话切换时重新校验主会话（缓存 → 存储兜底）并重绑 registry 父流。
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(SessionId))
            return;
        if (_mainSessionId != null
            && string.Equals(SessionId, _mainSessionId, StringComparison.Ordinal))
            return;

        _mainSessionId = SessionId;
        _activeSessionId = SessionId;

        // 换路由重新校验主会话（缓存 → 存储兜底），重置错误态
        var main = SessionManager.Get(SessionId);
        if (main == null)
        {
            main = await SessionManager.LoadAsync(SessionId);
            if (main == null)
            {
                _mainMissing = true;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        _mainMissing = false;

        // 初始 _mainMissing 导致 registry 未建立（接线在 OnInitializedAsync 提前 return 后缺失）
        // → 换有效路由时兜底接线；已存在则 Rebind 切换父流
        if (_registry == null)
            InitRegistry(SessionId);
        else
            _registry.Rebind(SessionId);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>关闭主会话缺失错误提示（返回可操作态；registry 已失效，路由切换会重新校验接线）</summary>
    private void OnCloseMainMissing()
    {
        _mainMissing = false;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 建立 registry 接线：按 circuit 获取/创建 Consumer、订阅窗口集合变化、绑定主会话父流。
    /// 订阅必须先于 Rebind：Rebind 内 EnumerateAsync 的首段枚举为同步完成（ListChildrenAsync 返回已完成 Task），
    /// 若订阅在后会丢失首次枚举的 WindowsChanged，导致侧栏初始不展示（需再次触发才出现）。
    /// </summary>
    private void InitRegistry(string mainId)
    {
        var circuitId = CircuitContext.Id ?? "";
        _registry = Router.GetOrCreateCircuitConsumer<SessionWindowRegistry>(circuitId);
        _registry.WindowsChanged -= OnWindowsChanged; // 防重复订阅
        _registry.WindowsChanged += OnWindowsChanged;
        _registry.Rebind(mainId);
        OnWindowsChanged(); // 同步当前窗口集合（兜底首次枚举）
    }

    private void OnWindowsChanged()
    {
        // SessionWindowRegistry.WindowsChanged 由组事件后台循环（ConfigureAwait(false)）触发；
        // 窗口集合/活跃会话/侧栏等 UI 投影必须回到 Blazor 同步上下文串行变更，避免与渲染线程竞态。
        _ = InvokeAsync(async () =>
        {
            _windows = _registry?.Windows ?? Array.Empty<SessionWindowRegistry.WindowNode>();
            var active = _registry?.ActiveSessionId;
            if (!string.IsNullOrEmpty(active))
                _activeSessionId = active;
            RebuildSidebar();
            StateHasChanged();

            // 关系刷新必须让出首帧：切换 active 时组内 N 个 Summary 窗口会同时挂载并排队加载，
            // 若在此同步 await，续体会插到主窗首帧之前（实测 9 个 Summary 时主区延迟 1.2s）。
            // 先让出批处理，保证主窗与侧栏骨架先渲染，关系条随后补齐。
            await Task.Yield();
            await RefreshRelationSafelyAsync();
        });
    }

    /// <summary>按侧栏分区模型重建条目（执行中置顶 + 三分区），数据骨架为 registry 窗口快照。</summary>
    private void RebuildSidebar()
    {
        var active = _activeSessionId;
        var entries = _windows
            .Where(w => !string.Equals(w.SessionId, active, StringComparison.Ordinal))
            .Select(w => new SidebarEntry(
                w.SessionId,
                w.Title,
                w.Relation,
                w.IsAnchor,
                IsExecuting(w.SessionId),
                FindParentSessionId(w.SessionId),
                w.Label,
                w.IsActive,
                PermissionView.CountBySession(w.SessionId)));
        _sidebarSections = SessionSidebarView.Build(entries);

        // 观察组成员变化：检测到新增子 Agent 时自动展开侧栏（用户手动收起后也生效）
        _sidebarVisibility.Observe(SidebarGroupKey, _windows.Select(w => w.SessionId));
    }

    /// <summary>
    /// 侧栏可见性的记忆键。
    /// <para>
    /// 优先用组 Id；组快照尚未就绪时回退主会话 Id。二者不会同时切换
    /// （组 Id 由主会话派生），因此不会出现「隐藏记录写到两处」的问题。
    /// </para>
    /// </summary>
    private string? SidebarGroupKey =>
        _currentGroup?.Id ?? _mainSessionId ?? _activeSessionId;

    /// <summary>组快照（GetGroupForSessionAsync）→ 顶条 / 抽屉的关系树模型。</summary>
    private async Task RefreshRelationAsync()
    {
        var generation = ++_relationRefreshGeneration;
        var probe = _registry?.AnchorSessionId;
        if (string.IsNullOrEmpty(probe))
            probe = _activeSessionId ?? _mainSessionId;
        if (string.IsNullOrEmpty(probe))
            return;

        var group = await GroupManager.GetGroupForSessionAsync(probe);
        if (generation != _relationRefreshGeneration)
            return; // 丢弃过期刷新（换组/连续事件）

        _currentGroup = group;
        RebuildSidebar();
        _relationModel = group is null ? null : BuildRelationModel(group);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>fire-and-forget 关系刷新：异常静默兜底，避免未观察任务异常中断组事件回流。</summary>
    private async Task RefreshRelationSafelyAsync()
    {
        try
        {
            await RefreshRelationAsync();
        }
        catch (Exception)
        {
            // 关系刷新为 UI 增强：失败不应阻断组事件回流 / 页面渲染
        }
    }

    /// <summary>组成员快照 → 关系树节点（标题取会话管理，执行态取页面收集字典）。</summary>
    private RelationTreeModel BuildRelationModel(SessionGroup group)
    {
        var nodes = group.Members
            .OrderBy(m => m.Order)
            .Select(m => new RelationNode(
                m.SessionId,
                SessionManager.Get(m.SessionId)?.Title ?? m.Label ?? string.Empty,
                m.Relation,
                m.IsAnchor,
                IsExecuting(m.SessionId),
                m.ParentSessionId,
                m.Label,
                string.Equals(m.SessionId, _activeSessionId, StringComparison.Ordinal)))
            .ToList();
        return RelationTreeModel.Build(nodes);
    }

    /// <summary>查询页面侧收集的执行态（registry 不持权威执行态）。</summary>
    private bool IsExecuting(string sessionId)
        => !string.IsNullOrEmpty(sessionId)
           && _executionStates.TryGetValue(sessionId, out var executing)
           && executing;

    /// <summary>来源会话 ID（组快照反查，供侧栏来源行/分区映射）。</summary>
    private string? FindParentSessionId(string sessionId)
        => _currentGroup?.Members
            .FirstOrDefault(m => string.Equals(m.SessionId, sessionId, StringComparison.Ordinal))?.ParentSessionId;

    /// <summary>各 SessionWindow 上报执行态：更新收集字典并刷新顶条/侧栏“执行中置顶”。</summary>
    private void OnExecutionStateChanged((string SessionId, bool IsExecuting) state)
    {
        if (string.IsNullOrEmpty(state.SessionId))
            return;

        _executionStates[state.SessionId] = state.IsExecuting;

        // 子会话开始执行时自动展开侧栏（用户收起后也能看到正在干活的任务）
        if (state.IsExecuting)
            _sidebarVisibility.NotifyExecuting(state.SessionId, isExecuting: true, SidebarGroupKey);

        RebuildSidebar();
        if (_currentGroup is not null)
            _relationModel = BuildRelationModel(_currentGroup);
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>切换侧栏可见性（用户点击隐藏/展开按钮）。</summary>
    private void ToggleSidebar()
    {
        _sidebarVisibility.Toggle(SidebarGroupKey);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OpenRelationDrawer() => _relationDrawerOpen = true;

    /// <summary>重命名侧栏条目：先失焦再开弹窗，避免操作按钮因残留焦点而持续显示。</summary>
    private async Task RenameTileAsync(string sessionId)
    {
        await BlurActiveElementAsync();
        OpenRename(sessionId);
    }

    /// <summary>在新标签打开指定会话。</summary>
    private async Task OpenTileInNewTab(string sessionId)
    {
        if (string.IsNullOrEmpty(sessionId))
            return;

        await BlurActiveElementAsync();

        try
        {
            await JS.InvokeVoidAsync("open", $"/session/{sessionId}", "_blank");
        }
        catch (Exception ex)
        {
            // JS 互操作在 circuit 断开时会抛错；不影响主流程
            MessageService.Error($"打开新标签失败: {ex.Message}");
        }
    }

    /// <summary>主动失焦（失败不影响主流程：多数场景 CSS 的 :hover 规则已足够）。</summary>
    private async Task BlurActiveElementAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("blurActiveElement");
        }
        catch
        {
            // JS 互操作不可用（circuit 断开 / 尚未初始化）时忽略
        }
    }

    /// <summary>关系抽屉节点操作：切换/重命名/新标签/删除（删除确认已在抽屉内完成）。</summary>
    private async Task OnRelationNodeAction((string SessionId, RelationNodeAction Action) action)
    {
        switch (action.Action)
        {
            case RelationNodeAction.Select:
                await OnTileClick(action.SessionId);
                break;
            case RelationNodeAction.Rename:
                OpenRename(action.SessionId);
                break;
            case RelationNodeAction.OpenNewTab:
                await JS.InvokeVoidAsync("open", $"/session/{action.SessionId}", "_blank");
                break;
            case RelationNodeAction.Delete:
                await DeleteSessionAsync(action.SessionId);
                break;
        }
    }

    private void OpenRename(string sessionId)
    {
        _renameSessionId = sessionId;
        _renameTitle = SessionManager.Get(sessionId)?.Title ?? string.Empty;
    }

    private async Task ConfirmRenameAsync()
    {
        var id = _renameSessionId;
        var title = _renameTitle?.Trim();
        _renameSessionId = null;
        if (string.IsNullOrEmpty(id) || string.IsNullOrEmpty(title))
            return;

        try
        {
            await SessionDirectory.RenameAsync(id, title);
        }
        catch (Exception ex)
        {
            MessageService.Error($"重命名失败: {ex.Message}");
        }
        await RefreshRelationAsync();
    }

    private void CancelRename() => _renameSessionId = null;

    private async Task DeleteSessionAsync(string sessionId)
    {
        var wasMain = string.Equals(sessionId, _mainSessionId, StringComparison.Ordinal);
        var groupId = _registry?.GroupId;
        try
        {
            await SessionDirectory.DeleteAsync(sessionId);
        }
        catch (Exception ex)
        {
            MessageService.Error($"删除会话失败: {ex.Message}");
            return;
        }

        if (wasMain)
            _mainSessionId = null;
        if (string.Equals(sessionId, _activeSessionId, StringComparison.Ordinal))
            _activeSessionId = null;
        await RefreshRelationAsync();

        // 删除主会话后：若组/registry 已回退新锚点，导航到新锚点，避免路由停留在已删会话
        if (wasMain)
        {
            string? newAnchor = null;
            if (!string.IsNullOrEmpty(groupId))
                newAnchor = (await GroupManager.GetGroupAsync(groupId))?.AnchorSessionId;
            if (string.IsNullOrEmpty(newAnchor))
                newAnchor = _registry?.AnchorSessionId;
            if (string.IsNullOrEmpty(newAnchor))
                newAnchor = _currentGroup?.AnchorSessionId;

            if (!string.IsNullOrEmpty(newAnchor)
                && !string.Equals(newAnchor, sessionId, StringComparison.Ordinal))
            {
                NavigationManager.NavigateTo($"/session/{newAnchor}");
            }
        }
    }

    /// <summary>点击侧栏卡片：经组管理器切换组 active（URL 不变，组事件回流刷新窗口）</summary>
    private async Task OnTileClick(string sessionId)
    {
        if (string.IsNullOrEmpty(sessionId)
            || string.Equals(sessionId, _activeSessionId, StringComparison.Ordinal))
            return;

        // 乐观更新：先切本地 active 并立即渲染，再走组管理器的异步切换。
        // SetActiveAsync 涉及组锁与落盘，若等它返回才渲染，用户点击后会盯着旧内容几百毫秒。
        // 本地更新后 SessionWindow 立刻收到新 SessionId，装载状态机随即进入「加载中」并显示骨架。
        _activeSessionId = sessionId;
        RebuildSidebar();
        if (_currentGroup is not null)
            _relationModel = BuildRelationModel(_currentGroup);
        await InvokeAsync(StateHasChanged);

        var groupId = _registry?.GroupId;
        if (!string.IsNullOrEmpty(groupId))
            await GroupManager.SetActiveAsync(groupId, sessionId);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _hasRendered = true;
    }

    private void OnAppStateChange()
    {
        RequestRender();
    }

    private void RequestRender()
    {
        if (!_hasRendered)
            return;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 幂等同步 AppState.CurrentSessionId（供首页"继续会话"导航定位；无需事件订阅）
    /// </summary>
    private void SyncCurrentSessionId(Services.SessionWindowContext ctx)
    {
        var id = ctx.CurrentSession?.Id;
        if (!string.IsNullOrEmpty(id)
            && !string.Equals(AppState.CurrentSessionId, id, StringComparison.Ordinal))
        {
            AppState.CurrentSessionId = id;
        }
    }

    /// <summary>
    /// 加载工具和技能数据（用于快速命令浮窗）
    /// </summary>
    private async Task LoadToolsAndSkillsAsync()
    {
        try
        {
            // 加载技能信息（工具清单由会话结算提供，无需在此预热）
            await SkillManager.RefreshSkillsAsync();
        }
        catch (Exception)
        {
            // 静默处理，不影响主流程
        }
    }

    /// <summary>
    /// 创建新会话
    /// </summary>
    private async Task CreateNewSessionAsync()
    {
        try
        {
            var session = await SessionDirectory.CreateAsync(
                workingDirectory: WorkspaceProvider.GetProjectRoot());
            NavigationManager.NavigateTo(string.Format("/session/{0}", session.Id));
        }
        catch (Exception ex)
        {
            MessageService.Error(string.Format("创建会话失败: {0}", ex.Message));
        }
    }

    /// <summary>
    /// 返回首页
    /// </summary>
    private void GoToHome()
    {
        NavigationManager.NavigateTo("/home");
    }

    /// <summary>
    /// 前往多 Agent 会议大屏（跳转 URL 主会话而非当前 active，避免子会话被当作主会话）
    /// </summary>
    private void GoToConference()
    {
        var id = _mainSessionId ?? GlobalSessionState.CurrentSession?.Id;
        if (string.IsNullOrEmpty(id)) return;
        NavigationManager.NavigateTo($"/conference/{id}");
    }

    /// <summary>
    /// 分支会话（导航到新会话页；子会话分叉为独立会话由工具栏承载）
    /// </summary>
    private async Task OnBranchSession()
    {
        var session = GlobalSessionState.CurrentSession;
        if (session == null) return;

        var branched = await SessionDirectory.BranchAsync(session.Id, $"{session.Title} (分支)");
        NavigationManager.NavigateTo($"/session/{branched.Id}");
    }

    private void OnPermissionChanged() => _ = InvokeAsync(() =>
    {
        // 先按最新在途计数重建侧栏分区（徽标数字），再重渲染
        RebuildSidebar();
        StateHasChanged();
    });

    /// <summary>
    /// 释放资源（导航离开 / 电路断开）
    /// </summary>
    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChange;
        PermissionView.Changed -= OnPermissionChanged;
        if (_registry != null)
            _registry.WindowsChanged -= OnWindowsChanged;
        // circuit 关闭由 SeeingCircuitHandler → Router.DetachAllForCircuit 统一释放
    }
}
