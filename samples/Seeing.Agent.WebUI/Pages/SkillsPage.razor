@using AntDesign
@inject ISkillCatalog SkillCatalog
@inject ISkillWriter SkillWriter
@inject IMessageService MessageService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>技能 - Seeing.Agent</PageTitle>

<div class="workspace-page">
    <div class="page-header">
        <Breadcrumb>
            <BreadcrumbItem>工作区</BreadcrumbItem>
            <BreadcrumbItem>技能</BreadcrumbItem>
        </Breadcrumb>
        <div class="header-actions">
            <Space>
                <SpaceItem><Button Icon="@IconType.Outline.Sync" OnClick="RefreshSkills">刷新</Button></SpaceItem>
                <SpaceItem><Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="CreateSkill">创建技能</Button></SpaceItem>
            </Space>
        </div>
    </div>
    
    <!-- Statistics Bar -->
    <div class="page-stats">
        <div class="stat-item">
            <div class="stat-icon"><Icon Type="@IconType.Outline.Appstore" /></div>
            <div class="stat-content">
                <span class="stat-value">@_totalCount</span>
                <span class="stat-label">技能总数</span>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon" style="background: var(--color-success-bg); color: var(--color-success);"><Icon Type="@IconType.Outline.CheckCircle" /></div>
            <div class="stat-content">
                <span class="stat-value">@_enabledCount</span>
                <span class="stat-label">已启用</span>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon" style="background: var(--color-bg-tertiary); color: var(--color-text-tertiary);"><Icon Type="@IconType.Outline.Stop" /></div>
            <div class="stat-content">
                <span class="stat-value">@_disabledCount</span>
                <span class="stat-label">已禁用</span>
            </div>
        </div>
    </div>

    <!-- 目录问题（冲突 / 加载失败）不静默：直接展示 -->
    @if (_snapshot is { } snapshot && snapshot.Conflicts.Count > 0)
    {
        <Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom: 12px;"
               Message="@($"同名技能冲突 {snapshot.Conflicts.Count} 项（保留高优先级来源，其余不可调用）")"
               Description="@DescribeConflicts(snapshot)" />
    }
    @if (_snapshot is { } issueSnapshot && issueSnapshot.Issues.Count > 0)
    {
        <Alert Type="@AlertType.Error" ShowIcon="true" Style="margin-bottom: 12px;"
               Message="@($"技能加载问题 {issueSnapshot.Issues.Count} 项")"
               Description="@DescribeIssues(issueSnapshot)" />
    }
    
    <div class="page-filters">
        <div class="filter-search">
            <Input @bind-Value="_searchText" Placeholder="搜索技能..." AllowClear="true" DebounceMilliseconds="300">
                <Prefix><Icon Type="@IconType.Outline.Search" /></Prefix>
            </Input>
        </div>
        <div class="filter-divider"></div>
        <div class="view-mode-toggle">
            <button class="view-mode-btn @(_isCardView ? "active" : "")" onclick="@(() => SetViewMode(true))" title="Card View">
                <Icon Type="@IconType.Outline.Appstore" />
            </button>
            <button class="view-mode-btn @(!_isCardView ? "active" : "")" onclick="@(() => SetViewMode(false))" title="List View">
                <Icon Type="@IconType.Outline.UnorderedList" />
            </button>
        </div>
    </div>
    
    <div class="page-content">
        @if (_isLoading) {
            <div class="loading-spinner">
                <Spin Size="@SpinSize.Large" />
            </div>
        }
        else if (!_filteredSkills.Any()) {
            <div class="empty-state">
                <div class="empty-state-icon"><Icon Type="@IconType.Outline.FileText" /></div>
                <h3 class="empty-state-title">@(_searchText.Length > 0 ? "No skills found" : "No skills yet")</h3>
                <p class="empty-state-description">
                    @if (_searchText.Length > 0) {
                        @:No skills match your search criteria. Try a different search term.
                    } else {
                        @:Get started by creating your first skill to extend the agent's capabilities.
                    }
                </p>
                <div class="empty-state-action">
                    @if (_searchText.Length > 0) {
                        <Button OnClick="ClearSearch">Clear Search</Button>
                    } else {
                        <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="CreateSkill">Create Skill</Button>
                    }
                </div>
            </div>
        }
        else if (_isCardView) {
            <div class="items-grid">
            @foreach (var entry in _filteredSkills) {
                <div class="item-card">
                    <div class="item-card-header">
                        <div class="card-icon @(IsEnabled(entry) ? "success" : "")">
                            <Icon Type="@IconType.Outline.Code" />
                        </div>
                        <div class="card-title-section">
                            <h3 class="card-title">@entry.Info.Name</h3>
                            <div class="card-status-row">
                                <Tag Color="@GetSourceColor(entry)">@GetSourceLabel(entry)</Tag>
                                <Tag Color="@(IsEnabled(entry) ? "success" : "default")">
                                    @(IsEnabled(entry) ? "Enabled" : "Disabled")
                                </Tag>
                            </div>
                        </div>
                        <div class="card-header-action">
                            <Button Type="@ButtonType.Text" Size="@ButtonSize.Small"
                                    Icon="@IconType.Outline.InfoCircle"
                                    OnClick="@(() => ViewSkill(entry.Info.Name))" />
                        </div>
                    </div>
                    <div class="item-card-body">
                        <p class="card-description">@GetDescriptionPreview(entry.Info.Description)</p>
                        @if (!string.IsNullOrEmpty(entry.DirectoryPath)) {
                            <div class="meta-item">
                                <Icon Type="@IconType.Outline.Folder" />
                                <span class="meta-value">@GetLocationPreview(entry.DirectoryPath)</span>
                            </div>
                        }
                    </div>
                    <div class="item-card-footer">
                        <div class="card-actions">
                            <Switch Checked="@IsEnabled(entry)" OnChange="@((bool v) => ToggleSkill(entry, v))" />
                        </div>
                    </div>
                </div>
            }
            </div>
        }
        else {
            <div class="items-table-container">
                <table class="items-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in _filteredSkills) {
                        <tr>
                            <td>
                                <div class="table-cell-name">
                                    <div class="table-cell-icon"><Icon Type="@IconType.Outline.Code" /></div>
                                    <div class="table-cell-text">
                                        <span class="table-cell-title">@entry.Info.Name</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <Tag Color="@GetSourceColor(entry)">@GetSourceLabel(entry)</Tag>
                            </td>
                            <td>
                                <Tag Color="@(IsEnabled(entry) ? "success" : "default")">
                                    @(IsEnabled(entry) ? "Enabled" : "Disabled")
                                </Tag>
                            </td>
                            <td>
                                <span class="table-cell-description">@GetDescriptionPreview(entry.Info.Description)</span>
                            </td>
                            <td>
                                <div class="table-cell-actions">
                                    <Button Type="@ButtonType.Text" Size="@ButtonSize.Small"
                                            Icon="@IconType.Outline.InfoCircle"
                                            OnClick="@(() => ViewSkill(entry.Info.Name))" />
                                    <Switch Checked="@IsEnabled(entry)" OnChange="@((bool v) => ToggleSkill(entry, v))" />
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private string _searchText = "";
    private bool _isLoading = false;
    private bool _isCardView = true;

    /// <summary>目录快照（唯一渲染数据源；不再维护本地技能缓存）。</summary>
    private SkillCatalogSnapshot? _snapshot;

    /// <summary>目录变更订阅（Dispose 时退订）。</summary>
    private IDisposable? _subscription;

    private bool _disposed;

    private List<SkillCatalogEntry> _filteredSkills = new();

    // Statistics
    private int _totalCount => _snapshot?.Entries.Count ?? 0;
    private int _enabledCount => _snapshot?.Entries.Count(IsEnabled) ?? 0;
    private int _disabledCount => _totalCount - _enabledCount;

    protected override async Task OnInitializedAsync()
    {
        // 先订阅再取快照：避免「取完快照、订阅之前」发布的版本被漏掉
        _subscription = SkillCatalog.Subscribe(OnCatalogChanged);
        _snapshot = await SkillCatalog.EnsureFreshAsync();
        ApplyFilter();
    }

    /// <summary>目录事件可能来自 watcher 线程：切回 UI 上下文再渲染。</summary>
    private void OnCatalogChanged(SkillCatalogSnapshot snapshot)
    {
        if (_disposed)
            return;

        _ = InvokeAsync(() =>
        {
            _snapshot = snapshot;
            ApplyFilter();
            StateHasChanged();
        });
    }

    async Task RefreshSkills()
    {
        _isLoading = true;
        StateHasChanged();

        _snapshot = await SkillCatalog.RefreshAsync();
        ApplyFilter();

        _isLoading = false;
        StateHasChanged();
    }

    void ApplyFilter()
    {
        _filteredSkills = (_snapshot?.Entries ?? [])
            .Where(entry => string.IsNullOrEmpty(_searchText)
                || entry.Info.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            .OrderBy(GetSourceSortOrder)
            .ThenBy(entry => entry.Info.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    void SetViewMode(bool isCard)
    {
        _isCardView = isCard;
    }

    void ClearSearch()
    {
        _searchText = "";
        ApplyFilter();
    }

    /// <summary>启用/禁用：层级取当前生效层级（未禁用时按来源推断），写操作由 ISkillWriter 收口。</summary>
    private async Task ToggleSkill(SkillCatalogEntry entry, bool enabled)
    {
        var result = await SkillWriter.SetEnabledAsync(entry.Info.Name, enabled, ResolveLevel(entry));
        if (!result.Success)
        {
            MessageService.Error(result.Error ?? "操作失败");
            return;
        }

        MessageService.Success(enabled ? "已启用" : "已禁用");
        StateHasChanged();
    }

    private ConfigLevel ResolveLevel(SkillCatalogEntry entry)
    {
        if (_snapshot is not null && _snapshot.DisabledScopes.TryGetValue(entry.Info.Name, out var scope))
            return scope;

        return entry.Source == SkillSource.UserFile ? ConfigLevel.User : ConfigLevel.Project;
    }

    /// <summary>技能是否可用：目录快照未把该名列入禁用集合（各层级并集语义）。</summary>
    private bool IsEnabled(SkillCatalogEntry entry) =>
        _snapshot is not null && !_snapshot.DisabledNames.Contains(entry.Info.Name);

    /// <summary>来源标签（读 SkillCatalogEntry.Source，不再嗅探路径前缀）。</summary>
    string GetSourceLabel(SkillCatalogEntry entry) => entry.Source switch
    {
        SkillSource.Registered => "内置",
        SkillSource.ProjectFile => "项目级",
        SkillSource.UserFile => "用户级",
        _ => "未知"
    };

    int GetSourceSortOrder(SkillCatalogEntry entry) => entry.Source switch
    {
        SkillSource.ProjectFile => 1,
        SkillSource.UserFile => 2,
        SkillSource.Registered => 3,
        _ => 4
    };

    /// <summary>来源标签颜色（AntDesign Tag Color）。</summary>
    string GetSourceColor(SkillCatalogEntry entry) => entry.Source switch
    {
        SkillSource.ProjectFile => "blue",
        SkillSource.UserFile => "purple",
        SkillSource.Registered => "orange",
        _ => "default"
    };

    string DescribeConflicts(SkillCatalogSnapshot snapshot) =>
        string.Join("；", snapshot.Conflicts.Take(5).Select(conflict =>
            $"{conflict.Name}：保留 {conflict.WinnerOrigin}，忽略 {conflict.LoserOrigin}"))
        + (snapshot.Conflicts.Count > 5 ? $"；等 {snapshot.Conflicts.Count} 项" : "");

    string DescribeIssues(SkillCatalogSnapshot snapshot) =>
        string.Join("；", snapshot.Issues.Take(5).Select(issue => $"{issue.Path}：{issue.Reason}"))
        + (snapshot.Issues.Count > 5 ? $"；等 {snapshot.Issues.Count} 项" : "");

    string GetDescriptionPreview(string? d) => string.IsNullOrEmpty(d) ? "无描述" : (d.Length > 100 ? d[..100] + "..." : d);
    string GetLocationPreview(string? loc) => loc?.Length > 40 ? "..." + loc[^Math.Min(40, loc.Length)..] : loc ?? "";
    void ViewSkill(string name) => NavigationManager.NavigateTo($"/skills/{name}");
    void CreateSkill() => NavigationManager.NavigateTo("/skills/create");

    public void Dispose()
    {
        _disposed = true;
        _subscription?.Dispose();
        _subscription = null;
    }
}
