        public IReadOnlyList<LlmCapabilityKind> DefaultFor { get; set; } = [];
        /// <summary>默认身份文案，如 <c>chat, embedding</c>。</summary>
        public string DefaultForDisplay => string.Join(", ", DefaultFor.Select(LlmCapabilityMap.ToConfigKey));
        /// <summary>「设为默认」下拉的候选能力（具备该能力且该能力当前还没指向本模型）。</summary>
