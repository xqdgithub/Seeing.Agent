        }
    }

    /// <summary>从 catalog key 提取模型 ID（去掉已知 Provider 前缀）。</summary>
    private static string ExtractModelId(string key, string providerId)
    {
        var prefix = providerId + "/";
        return key.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? key[prefix.Length..] : key;
    }

