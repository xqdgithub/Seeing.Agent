    /// <summary>列表「思考」列：n 档 / 默认关闭 · n 档 / 不支持 / —。</summary>
    private static string DescribeThinkingColumn(ThinkingOptions? thinking)
    {
        if (thinking is null)
            return "—";

        if (!thinking.Supported || thinking.Levels is not { Count: > 0 })
            return "不支持";

        return ThinkingEffortKeys.IsDefaultOff(thinking)
            ? $"默认关闭 · {thinking.Levels.Count} 档"
            : $"{thinking.Levels.Count} 档";
    }

