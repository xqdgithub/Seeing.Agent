@using System.Text.Json
@using AntDesign
@using Seeing.Agent.Core.Configuration
@using Seeing.Agent.Configuration
@using Seeing.Agent.Core.Llm
@using Seeing.Agent.Llm
@using Seeing.Agent.Abstractions.Llm
@using Seeing.ConfigSchema
@inject IProviderManager ProviderManager
@inject ILlmClientFactoryResolver LlmClientFactories
@inject IModelConfigManager ModelManager
@inject UnifiedConfigManager ConfigManager
@inject IMessageService MessageService
@implements IDisposable

<PageTitle>模型 · Seeing</PageTitle>

<WorkspacePageShell Loading="@_loading">
    <Breadcrumb>
        <BreadcrumbItem>设置</BreadcrumbItem>
        <BreadcrumbItem>模型</BreadcrumbItem>
    </Breadcrumb>
    <Extra>
        <Space>
            <Button Icon="@IconType.Outline.Reload" Loading="@_refreshingAll"
                    Disabled="@_refreshingCurrent" OnClick="RefreshAllAsync">
                刷新全部
            </Button>
            <Button Icon="@IconType.Outline.Plus" OnClick="ShowAddProvider">添加 Provider</Button>
        </Space>
    </Extra>
    <ChildContent>
        @* 默认模型按能力各配一格；失效项只报告、不清除。 *@
        <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 12px;"
               Message="@DefaultModelsSummary" />
        @if (_invalidDefaults.Count > 0)
        {
            <Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom: 16px;"
                   Message="以下默认模型已失效（配置已保留，请手动修正）"
                   Description="@InvalidDefaultsSummary" />
        }

        <Row Gutter="16">
            @* Provider 列表只是导航（名称 + 选中态），不需要宽栏；窄栏把空间让给右侧详情与模型表格。
               4/20 = 1:5，24 栅格下左侧约占 1/6。 *@
            <Col Span="4">
                <Card Title="Provider 列表" Size="@CardSize.Small">
                    @* 按来源分组：用户先找自己配的，再看插件带的。组内按显示名排序（而非 id）——
                       显示的是 Name，用 id 排序会出现「看起来毫无规律」的顺序。 *@
                    <Menu Mode="@MenuMode.Inline" SelectedKeys="@_selectedProviderKeys" OnMenuItemClicked="OnProviderSelected">
                        @foreach (var group in ProviderGroups)
                        {
                            <MenuItemGroup Key="@($"group-{group.Key}")" Title="@group.Title">
                                @foreach (var p in group.Items)
                                {
                                    <MenuItem Key="@p.Key">
                                        @* 窄栏下长名称必须截断，否则会把菜单撑出卡片 *@
                                        <span style="display: inline-flex; align-items: center; gap: 8px; max-width: 100%;"
                                              title="@(p.Value.Name ?? p.Key)">
                                            <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @(p.Value.Name ?? p.Key)
                                            </span>
                                        </span>
                                    </MenuItem>
                                }
                            </MenuItemGroup>
                        }
                    </Menu>
                </Card>
            </Col>
            <Col Span="20">
                @if (_currentProviderInfo != null)
                {
                    <Card Title="@($"Provider 详情 · {_selectedProviderId}")">
                        @* 配置来源信息：帮助定位 Provider 从哪个文件加载（用户级 / 项目级 / 扩展） *@
                        <div style="margin-bottom: 16px; padding: 8px 12px; background: #e6f4ff; border: 1px solid #91caff; border-radius: 6px; font-size: 13px;">
                            来源：
                            @if (_currentProviderInfo.Origin == ProviderOrigin.Extension)
                            {
                                <Tag Color="@("blue")">扩展</Tag>
                                <span>由扩展 @(_currentProviderInfo.OwnerId) 注册，配置由扩展自身管理</span>
                            }
                            else
                            {
                                <Tag>配置</Tag>
                                <span>加载自用户级配置文件</span>
                            }
                        </div>
                        @* 生效能力常显：下面表单里的能力多选框只表达「配置覆盖」，
                           未勾选 ≠ 没有能力。两者混为一谈会让人误读成「这个 Provider 什么都没声明」。 *@
                        <div style="margin-bottom: 16px; padding: 8px 12px; background: #f6ffed; border: 1px solid #b7eb8f; border-radius: 6px; font-size: 13px;">
                            <span>生效能力：</span>
                            <strong>@_capabilityView.EffectiveText</strong>
                            <Tag Style="margin-left: 8px;">@_capabilityView.SourceText(_currentProviderInfo.Protocol, _currentProviderInfo.Origin)</Tag>
                            @if (_capabilityView.HasDrift)
                            {
                                <Tag Color="@("warning")">配置与运行时不符</Tag>
                            }
                        </div>
                        @if (_capabilityView.HasDrift)
                        {
                            <Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom: 16px;"
                                   Message="@_capabilityView.DriftText" />
                        }
                        @if (!string.IsNullOrEmpty(_configLoadError))
                        {
                            <Alert Type="@AlertType.Error" Message="@_configLoadError" ShowIcon="true" />
                        }
                        else if (_schemaFields is { Count: > 0 })
                        {
                            <SchemaDrivenConfigForm @ref="_schemaForm" Fields="_schemaFields" Values="_schemaValues" />
                            <Button Type="@ButtonType.Primary" Loading="_savingProviderConfig" OnClick="SaveProviderConfigAsync"
                                    Style="margin-top: 12px;">
                                保存配置
                            </Button>
                        }
                        else if (_currentProvider is not null)
                        {
                            <Form Layout="@FormLayout.Vertical" Model="@_currentProvider" Context="formContext">
                            <div>
                                <FormItem Label="标识"><Input @bind-Value="@_currentProvider.Id" Disabled="true" /></FormItem>
                                <FormItem Label="协议类型">
                                    <Select TItemValue="string" TItem="string" @bind-Value="@_currentProvider.Type">
                                        @foreach (var protocol in AvailableProtocols)
                                        {
                                            <SelectOption TItemValue="string" TItem="string" Value="@protocol"
                                                          Label="@DescribeProtocol(protocol)" />
                                        }
                                    </Select>
                                </FormItem>
                                @* Provider 能力多选框：写入 Provider 自身的能力声明（唯一真相）。 *@
                                <FormItem Label="支持能力">
                                    <Select Mode="@SelectMode.Multiple"
                                            TItemValue="string"
                                            TItem="string"
                                            @key="@($"provider-capabilities-{_selectedProviderId}")"
                                            Values="@_providerCapabilities"
                                            ValuesChanged="OnProviderCapabilitiesChanged"
                                            Style="width: 100%;"
                                            Placeholder="留空表示使用该 Provider 的默认能力">
                                        @foreach (var kind in CapabilityLabels.All)
                                        {
                                            <SelectOption TItemValue="string" TItem="string"
                                                          Value="@LlmCapabilityMap.ToConfigKey(kind)"
                                                          Label="@CapabilityLabels.Label(kind)" />
                                        }
                                    </Select>
                                    <div style="color: #888; font-size: 12px; margin-top: 4px;">
                                        @ProviderCapabilitiesHint
                                    </div>
                                </FormItem>
                                <FormItem Label="显示名称"><Input @bind-Value="@_currentProvider.Name" /></FormItem>
                                <FormItem Label="接口地址（Base URL）"><Input @bind-Value="@_currentProvider.BaseUrl" /></FormItem>
                                <FormItem Label="访问密钥（API Key）"><Input Password @bind-Value="@_currentProvider.ApiKey" /></FormItem>
                                <FormItem Label="自定义请求头（JSON）">
                                    <TextArea Rows="6" @bind-Value="@_headersJson"
                                              Placeholder="{ &quot;Authorization&quot;: &quot;Bearer ...&quot; }"
                                              Style="font-family: monospace;" />
                                    <div style="color: #888; font-size: 12px; margin-top: 4px;">
                                        每个键值都会附加到 Provider 请求中，与内置请求头同名时会覆盖内置值。请勿填写无效 JSON。
                                    </div>
                                </FormItem>
                                <FormItem Label="合并远端模型列表">
                                    <AntDesign.Switch @bind-Value="@_currentProvider.ListModels" />
                                    <div style="color: #888; font-size: 12px; margin-top: 4px;">
                                        开启且该协议支持时，模型列表取「配置中的模型」与「远端返回的模型」的并集。
                                    </div>
                                </FormItem>
                                <div style="margin-top: 12px;">
                                    <Button Type="@ButtonType.Primary" Loading="_savingProviderConfig" OnClick="SaveProviderConfigAsync">
                                        保存配置
                                    </Button>
                                </div>
                            </div>
                            </Form>
                        }
                        else
                        {
                            <Descriptions>
                                <DescriptionsItem Title="标识">@_currentProviderInfo!.Id</DescriptionsItem>
                                <DescriptionsItem Title="名称">@(_currentProviderInfo.Name ?? _currentProviderInfo.Id)</DescriptionsItem>
                                <DescriptionsItem Title="来源">
                                    @if (_currentProviderInfo.Origin == ProviderOrigin.Extension)
                                    {
                                        <Tag Color="@("blue")">扩展</Tag>
                                    }
                                    else
                                    {
                                        <Tag>配置</Tag>
                                    }
                                </DescriptionsItem>
                                <DescriptionsItem Title="模型数">@_modelRows.Count</DescriptionsItem>
                            </Descriptions>
                            <Alert Type="@AlertType.Info" ShowIcon="true"
                                   Message="该 Provider 由扩展提供，连接配置需要在扩展自身中修改。" />
                        }

                        @* Shared Test Connection — schema, handcrafted, and extension tracks (not load-error-only) *@
                        @if (string.IsNullOrEmpty(_configLoadError))
                        {
                            <Divider />
                            <Space>
                                @* @key：切换 Provider 时强制重建，避免 AntDesign Select 残留上一 Provider 的 Option *@
                                <ModelSelectDropdown @key="@($"test-conn-{_selectedProviderId}")"
                                                     Value="@_testModelKey"
                                                     ValueChanged="OnTestModelKeyChanged"
                                                     ProviderId="@_selectedProviderId"
                                                     FilterType="@((ModelType?)null)"
                                                     Style="width: 240px;"
                                                     Placeholder="选择测试模型"
                                                     Disabled="@(_modelRows.Count == 0)"
                                                     AllowClear="true" />
                                <Select TItemValue="LlmCapabilityKind" TItem="LlmCapabilityKind"
                                        @bind-Value="_testCapability" Style="width: 180px;">
                                    @foreach (var kind in CapabilityLabels.All)
                                    {
                                        <SelectOption TItemValue="LlmCapabilityKind" TItem="LlmCapabilityKind"
                                                      Value="@kind" Label="@CapabilityLabels.Label(kind)" />
                                    }
                                </Select>
                                <Button Loading="@_testing" OnClick="TestConnection"
                                        Disabled="@(string.IsNullOrEmpty(_testModelKey))">
                                    测试连接
                                </Button>
                            </Space>
                        }
                    </Card>

                    <Card Title="模型列表" Style="margin-top: 16px;">
                        <div style="margin-bottom: 12px;">
                            <Space Wrap>
                                <Button Icon="@IconType.Outline.Reload" Size="@ButtonSize.Small"
                                        Loading="@_refreshingCurrent" Disabled="@_refreshingAll"
                                        OnClick="RefreshCurrentAsync">
                                    刷新
                                </Button>
                                <Button Icon="@IconType.Outline.Plus" Size="@ButtonSize.Small"
                                        OnClick="ShowAddModel">
                                    添加模型
                                </Button>
                                <Divider Type="@DividerType.Vertical" />
                                <Input Placeholder="搜索 ID / 名称" Style="width: 220px;"
                                       Value="@_searchText" OnInput="OnSearchInput" AllowClear />
                                <Select Mode="@SelectMode.Multiple"
                                        TItemValue="ModelType"
                                        TItem="ModelType"
                                        Values="@_typeFilter"
                                        ValuesChanged="OnTypeFilterChanged"
                                        Style="min-width: 200px;"
                                        Placeholder="类型筛选"
                                        AllowClear>
                                    @foreach (var t in Enum.GetValues<ModelType>())
                                    {
                                        <SelectOption TItemValue="ModelType" TItem="ModelType" Value="@t" Label="@UiText.ModelTypeText(t)" />
                                    }
                                </Select>
                                <Divider Type="@DividerType.Vertical" />
                                <AntDesign.Switch @bind-Value="_showAll" CheckedChildren="显示全部" UnCheckedChildren="仅已启用"
                                                  OnChange="OnShowAllChanged" />
                                <Button Size="@ButtonSize.Small" OnClick="EnableAllModelsAsync"
                                        Disabled="@(_catalogRows.Count == 0)">全部启用</Button>
                                <Button Size="@ButtonSize.Small" OnClick="DisableAllModelsAsync"
                                        Disabled="@(ModelManager.GetEnabledModelIds(_selectedProviderId).Count == 0)">全部禁用</Button>
                            </Space>
                        </div>
                        @* ScrollX 用 max-content：列宽由内容决定、永不压缩到窗口宽度以下，
                           窄窗口时出现横向滚动条；操作列 Fixed=Right 始终贴在右侧可见。 *@
                        <Table TItem="ModelRow" DataSource="@_filteredRows" RowKey="@(m => m.Key)" Size="@TableSize.Small"
                               PageSize="20" ScrollX="@("max-content")">
                            <Column TData="ModelRow" Title="启用" Width="80" Fixed="@ColumnFixPlacement.Left">
                                <AntDesign.Switch Checked="context.IsEnabled" CheckedChildren="启用" UnCheckedChildren="禁用"
                                                 OnChange="@(v => ToggleModelEnabled(context, v))" />
                            </Column>
                            <Column TData="ModelRow" Title="模型 ID" Width="240" Ellipsis>
                                <Tooltip Title="@context.Id">
                                    <span>@context.Id</span>
                                </Tooltip>
                            </Column>
                            <Column TData="ModelRow" Title="名称" Width="180" Ellipsis>
                                <Tooltip Title="@context.Name">
                                    <span>@context.Name</span>
                                </Tooltip>
                            </Column>
                            <Column TData="ModelRow" Title="类型" Width="150">
                                <span>@context.TypesDisplay</span>
                            </Column>
                            @* 可路由能力 = Provider 能力与模型类型取交集；不一致只告警，不阻止保存 *@
                            <Column TData="ModelRow" Title="可路由能力" Width="180">
                                <span>@(string.IsNullOrEmpty(context.RoutableDisplay) ? "—" : context.RoutableDisplay)</span>
                                @if (!string.IsNullOrEmpty(context.CapabilityGapDisplay))
                                {
                                    <Tooltip Title="@($"该模型声明了 {context.CapabilityGapDisplay}，但所属 Provider 未开启对应能力，调用时会被拒绝。")">
                                        <Tag Color="@("warning")" Style="margin: 0;">缺少能力</Tag>
                                    </Tooltip>
                                }
                            </Column>
                            <Column TData="ModelRow" Title="上下文" Width="110">
                                <span>@context.Context</span>
                            </Column>
                            <Column TData="ModelRow" Title="输出" Width="110">
                                <span>@context.Output</span>
                            </Column>
                            <Column TData="ModelRow" Title="思考" Width="120">
                                <span>@context.ThinkingDisplay</span>
                            </Column>
                            <ActionColumn Title="操作" Width="360" Fixed="@ColumnFixPlacement.Right">
                                <Space>
                                    <Button Size="@ButtonSize.Small" OnClick="@(() => ShowEditModel(context))">编辑</Button>
                                    @if (context.IsOverridden)
                                    {
                                        <Tooltip Title="已应用用户覆盖">
                                            <Tag Color="@("orange")" Style="margin: 0;">已覆盖</Tag>
                                        </Tooltip>
                                        <Popconfirm Title="移除用户覆盖，恢复默认元数据？" OnConfirm="@(() => RestoreModelDefault(context))">
                                            <Button Size="@ButtonSize.Small">恢复默认</Button>
                                        </Popconfirm>
                                    }
                                    @* 设为默认时需先指定目标能力；不具备该能力的选项置灰 *@
                                    <Dropdown>
                                        <Overlay>
                                            <Menu Selectable="false">
                                                @foreach (var kind in context.DefaultCandidates)
                                                {
                                                    <MenuItem OnClick="() => SetDefaultModelAsync(context.Key, kind)">
                                                        @CapabilityLabels.Label(kind)
                                                    </MenuItem>
                                                }
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <Button Size="@ButtonSize.Small"
                                                    Disabled="@(context.DefaultCandidates.Count == 0)">
                                                @if (context.IsDefault)
                                                {
                                                    <span>@($"默认: {context.DefaultForDisplay}")</span>
                                                }
                                                else
                                                {
                                                    <span>设为默认</span>
                                                }
                                                <Icon Type="@IconType.Outline.Down" />
                                            </Button>
                                        </ChildContent>
                                    </Dropdown>
                                    @if (CanDeleteModel)
                                    {
                                        <Popconfirm Title="确定要删除此模型吗？" OnConfirm="@(() => DeleteModel(context))">
                                            <Button Size="@ButtonSize.Small" Danger Icon="@IconType.Outline.Delete">删除</Button>
                                        </Popconfirm>
                                    }
                                </Space>
                            </ActionColumn>
                        </Table>
                    </Card>
                }
                else
                {
                    <Empty Description="@("请选择或添加 Provider")" />
                }
            </Col>
        </Row>
    </ChildContent>
</WorkspacePageShell>

<Modal Title="添加 Provider" Visible="@_addModalVisible" OnOk="ConfirmAddProvider" OnCancel="@(() => _addModalVisible = false)">
    @if (_addModalVisible)
    {
        <Form Layout="@FormLayout.Vertical" Model="@_addProviderForm" Context="formContext">
        <div>
            <FormItem Label="Provider 标识"><Input @bind-Value="@_newProviderId" Placeholder="如 openai" /></FormItem>
            <FormItem Label="协议类型">
                <Select TItemValue="string" TItem="string" @bind-Value="@_newProviderType">
                    @foreach (var protocol in AvailableProtocols)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@protocol"
                                      Label="@DescribeProtocol(protocol)" />
                    }
                </Select>
                <div style="color: #888; font-size: 12px; margin-top: 4px;">
                    协议由已加载的模型模块提供；同一协议只能对应一个客户端实现。
                </div>
            </FormItem>
        </div>
        </Form>
    }
</Modal>

<Modal Title="添加模型" Visible="@_addModelVisible"
       OnOk="ConfirmAddModelAsync" OnCancel="@(() => _addModelVisible = false)" ConfirmLoading="@_addingModel">
    @if (_addModelVisible)
    {
        <Form Layout="@FormLayout.Vertical" Model="@_addModelForm">
            <FormItem Label="所属 Provider">
                <Input Value="@_selectedProviderId" Disabled="true" />
            </FormItem>
            <FormItem Label="添加方式">
                <RadioGroup @bind-Value="_addModelMode">
                    <Radio Value="@AddModelMode.FromList">从列表选择</Radio>
                    <Radio Value="@AddModelMode.Manual">手动新建</Radio>
                </RadioGroup>
            </FormItem>
            @if (_addModelMode == AddModelMode.FromList)
            {
                <FormItem Label="选择模型">
                    <ModelSelectDropdown Value="@_addModelForm.Id"
                                         ValueChanged="OnAddModelPickFromList"
                                         ProviderId="@_selectedProviderId"
                                         FilterType="@((ModelType?)null)"
                                         Models="@_addModelCandidates"
                                         Style="width: 100%;"
                                         Placeholder="从当前 Provider 的可用模型中选择" />
                    <div style="color: #888; font-size: 12px; margin-top: 4px;">
                        从当前 Provider 的可用模型中选择；选中后自动预填 ID、名称与长度。
                    </div>
                </FormItem>
            }
            <FormItem Label="模型 ID" Required>
                <Input @bind-Value="@_addModelForm.Id" Disabled="@(_addModelMode == AddModelMode.FromList)"
                       Placeholder="如 gpt-4o-mini 或 Qwen/Qwen3-VL-Embedding-8B" />
            </FormItem>
            <FormItem Label="显示名称">
                <Input @bind-Value="@_addModelForm.Name" Placeholder="可选，默认等于模型 ID" />
            </FormItem>
            <FormItem Label="用途类型">
                <Select Mode="@SelectMode.Multiple"
                        TItemValue="ModelType"
                        TItem="ModelType"
                        Values="@_addModelTypes"
                        ValuesChanged="OnAddModelTypesChanged"
                        Style="width: 100%;"
                        Placeholder="默认：文本">
                    @foreach (var t in Enum.GetValues<ModelType>())
                    {
                        <SelectOption TItemValue="ModelType" TItem="ModelType" Value="@t" Label="@UiText.ModelTypeText(t)" />
                    }
                </Select>
            </FormItem>
            <FormItem Label="上下文长度">
                <AntDesign.InputNumber @bind-Value="@_addModelForm.Context" Min="1" Max="2000000" Style="width: 100%;" />
            </FormItem>
            <FormItem Label="输出长度（token）">
                <AntDesign.InputNumber @bind-Value="@_addModelForm.Output" Min="1" Max="2000000" Style="width: 100%;" />
            </FormItem>
        </Form>
    }
</Modal>

<Modal Title="编辑模型" Visible="@_editModelVisible"
       OnOk="SaveEditModelAsync" OnCancel="@(() => _editModelVisible = false)" ConfirmLoading="@_savingEditModel">
    @if (_editModelVisible)
    {
        <Form Layout="@FormLayout.Vertical" Model="@_editModelForm">
            <FormItem Label="所属 Provider">
                <Input Value="@_selectedProviderId" Disabled="true" />
            </FormItem>
            <FormItem Label="模型 ID">
                <Input Value="@_editKey" Disabled="true" />
            </FormItem>
            <FormItem Label="显示名称">
                <Input @bind-Value="@_editModelForm.Name" />
            </FormItem>
            <FormItem Label="用途类型">
                <Select Mode="@SelectMode.Multiple"
                        TItemValue="ModelType"
                        TItem="ModelType"
                        Values="@_editTypes"
                        ValuesChanged="OnEditTypesChanged"
                        Style="width: 100%;"
                        Placeholder="选择用途类型（留空表示文本）">
                    @foreach (var t in Enum.GetValues<ModelType>())
                    {
                        <SelectOption TItemValue="ModelType" TItem="ModelType" Value="@t" Label="@UiText.ModelTypeText(t)" />
                    }
                </Select>
            </FormItem>
            <FormItem Label="上下文长度">
                <AntDesign.InputNumber @bind-Value="@_editModelForm.Context" Min="1" Max="2000000" Style="width: 100%;" />
            </FormItem>
            <FormItem Label="输出长度（token）">
                <AntDesign.InputNumber @bind-Value="@_editModelForm.Output" Min="1" Max="2000000" Style="width: 100%;" />
            </FormItem>
            <FormItem Label="输入模态">
                <Select Mode="@SelectMode.Tags"
                        TItemValue="string"
                        TItem="string"
                        Values="@_editInputModalities"
                        ValuesChanged="OnEditInputModalitiesChanged"
                        Style="width: 100%;"
                        Placeholder="如 text、image">
                    @foreach (var m in new[] { "text", "image", "audio", "video", "pdf" })
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@m" Label="@m" />
                    }
                </Select>
            </FormItem>
            @* 语音合成看输出模态、语音转写看输入模态，两者缺一都会在路由时被拒绝 *@
            <FormItem Label="输出模态">
                <Select Mode="@SelectMode.Tags"
                        TItemValue="string"
                        TItem="string"
                        Values="@_editOutputModalities"
                        ValuesChanged="OnEditOutputModalitiesChanged"
                        Style="width: 100%;"
                        Placeholder="如 text、image、audio">
                    @foreach (var m in new[] { "text", "image", "audio", "video", "embedding" })
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@m" Label="@m" />
                    }
                </Select>
            </FormItem>
            @* 思考强度：自定义档位时关闭档固定在首位（是否提供由开关控制），其后才是用户自填档位。
               「默认关闭」不需要单独模式——把默认档指向关闭档就已经是这个语义。 *@
            <FormItem Label="思考强度">
                <RadioGroup TValue="ThinkingEditMode" Value="@_editThinkingMode"
                            ValueChanged="OnEditThinkingModeChanged">
                    <Radio Value="@ThinkingEditMode.Inherit">跟随声明</Radio>
                    <Radio Value="@ThinkingEditMode.Custom">自定义档位</Radio>
                </RadioGroup>
                <div style="color: #888; font-size: 12px; margin-top: 4px;">@_thinkingDeclarationHint</div>
            </FormItem>
            @if (_editThinkingMode == ThinkingEditMode.Custom)
            {
                <FormItem Label="关闭档">
                    <Space Align="SpaceAlign.Center">
                        <AntDesign.Switch Checked="@_editCloseLevelEnabled"
                                          CheckedChildren="提供" UnCheckedChildren="不提供"
                                          OnChange="OnCloseLevelEnabledChanged" />
                        <span style="color: #888; font-size: 12px;">
                            code 固定为 <code>@ThinkingEffortKeys.DisabledKey</code>；会话里选它才是真正关掉思考
                        </span>
                    </Space>
                </FormItem>
                <FormItem Label="其它档位">
                    @* 快速选择：点一下即把该档位加入表格（已存在则跳过），省去手打 code。
                       也允许完全自定义——表格里的 code 输入框仍是自由文本。 *@
                    <div style="margin-bottom: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px;">
                        <span style="color: #888; font-size: 12px; margin-right: 2px;">常用档位</span>
                        @foreach (var known in ThinkingEffortKeys.WellKnownLevels)
                        {
                            var existing = _editThinkingLevels.FirstOrDefault(row =>
                                string.Equals(row.Key?.Trim(), known.Key, StringComparison.OrdinalIgnoreCase));
                            <Tag Color="@(existing is null ? null : "blue")"
                                 Style="cursor: pointer; user-select: none; margin: 0;"
                                 OnClick="@(() => ApplyWellKnownLevel(known))">
                                @($"{(existing is null ? "+" : "✓")} {known.Label} · {known.Key}")
                            </Tag>
                        }
                    </div>
                    <Table TItem="ThinkingLevelEditRow" DataSource="@_editThinkingLevels" HidePagination
                           Size="@TableSize.Small" RowKey="@(l => l.RowId)" Context="levelContext"
                           Style="max-width: 560px;">
                        <ActionColumn Title="code（可自由输入）" Width="200">
                            <AutoComplete TItem="string"
                                          Value="@levelContext.Key"
                                          ValueChanged="@(value => OnLevelKeyChanged(levelContext, value))"
                                          Options="@ThinkingEffortKeys.WellKnownLevels.Select(l => l.Key)"
                                          Placeholder="如 high" />
                        </ActionColumn>
                        <ActionColumn Title="显示名称">
                            <Input @bind-Value="@levelContext.Label" Placeholder="可选，默认同 code" />
                        </ActionColumn>
                        <ActionColumn Title="" Width="70">
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger
                                    OnClick="() => RemoveThinkingLevel(levelContext)">删除</Button>
                        </ActionColumn>
                    </Table>
                    <Button Size="@ButtonSize.Small" Icon="@IconType.Outline.Plus"
                            OnClick="AddThinkingLevel" Style="margin-top: 8px;">
                        添加档位
                    </Button>
                </FormItem>
                <FormItem Label="默认档">
                    <Select TItemValue="string" TItem="string"
                            @key="@($"edit-thinking-default-{_editKey}-{_editCloseLevelEnabled}")"
                            Value="@_editThinkingDefault"
                            ValueChanged="OnEditThinkingDefaultChanged"
                            AllowClear="true"
                            Placeholder="不指定（未选档时不传思考字段）"
                            Style="width: 100%;">
                        @foreach (var key in ThinkingLevelKeys)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value="@key" Label="@key" />
                        }
                    </Select>
                    <div style="color: #888; font-size: 12px; margin-top: 4px;">
                        选 <code>@ThinkingEffortKeys.DisabledKey</code> 即「模型默认关闭思考」，会话里仍可临时改回其它档。
                    </div>
                </FormItem>
                <FormItem Label="思考回传字段">
                    <Input @bind-Value="_editThinkingInterleaved" Placeholder="如 reasoning_content（留空不回传）" />
                    <div style="color: #888; font-size: 12px; margin-top: 4px;">
                        OpenAI 兼容协议专用：填 reasoning_content 才会在多轮把历史思考回传。
                    </div>
                </FormItem>
            }
            @if (_editHasOverride)
            {
                <Alert Type="@AlertType.Info" ShowIcon="true"
                       Message="该模型已有用户覆盖；仅保存与默认值不同的字段。可点列表中的「恢复默认」清除覆盖。" />
            }
        </Form>
    }
</Modal>

@code {
    private ProviderInfo? _currentProviderInfo;
    private ProviderConfig? _currentProvider;
    private string _selectedProviderId = "";
    private string[] _selectedProviderKeys = Array.Empty<string>();
    private List<ModelRow> _modelRows = new();
    private List<ModelRow> _catalogRows = new();
    private List<ModelRow> _filteredRows = new();
    private string _searchText = "";
    private IEnumerable<ModelType> _typeFilter = Array.Empty<ModelType>();
    private CancellationTokenSource? _searchCts;
    private bool _showAll;
    private AddModelMode _addModelMode = AddModelMode.FromList;
    private ConfigLevel _saveLevel = ModelConfigManager.ModelStoreLevel;
    private bool _loading;
    private bool _testing;
    private bool _refreshingAll;
    private bool _refreshingCurrent;
    private bool _addModalVisible;
    private string _newProviderId = "";
    private string _newProviderType = ProviderTypes.OpenAi;
    private readonly AddProviderForm _addProviderForm = new();
    private string _editKey = "";
    private IEnumerable<ModelType> _editTypes = Array.Empty<ModelType>();
    private bool _addModelVisible;
    private bool _addingModel;
    private readonly AddModelForm _addModelForm = new();
    private IReadOnlyDictionary<string, ModelConfig> _addModelCandidates = new Dictionary<string, ModelConfig>();
    private IEnumerable<ModelType> _addModelTypes = new[] { ModelType.Text };
    private string _testModelKey = "";
    /// <summary>测试连接的目标能力（由用户显式选择，不做推导）。</summary>
    private LlmCapabilityKind _testCapability = LlmCapabilityKind.Chat;
    private string _headersJson = "{}";
    /// <summary>Provider 表单里的能力多选值（配置键，小驼峰，出处是 <see cref="LlmCapabilityMap.ToConfigKey"/>）。</summary>
    private IEnumerable<string> _providerCapabilities = Array.Empty<string>();
    /// <summary>
    /// 当前 Provider 的能力投影：生效位集（<see cref="ProviderInfo.Capabilities"/>）+ 配置声明来源。
    /// <para><b>为什么单独存一份</b>：多选框只表达「配置覆盖」，未勾选时它为空；
    /// 直接把它当生效能力会得到「这个 Provider 没有能力」的错误结论。</para>
    /// </summary>
    private ProviderCapabilityView _capabilityView = ProviderCapabilityProjection.Build(null, null);
    /// <summary>已配置的能力默认值（能力 → <c>provider/model</c>），随目录刷新重取。</summary>
    private IReadOnlyDictionary<LlmCapabilityKind, string> _capabilityDefaults = new Dictionary<LlmCapabilityKind, string>();
    /// <summary>失效的默认模型诊断：只报告，不清除。</summary>
    private IReadOnlyDictionary<LlmCapabilityKind, string> _invalidDefaults = new Dictionary<LlmCapabilityKind, string>();

    private IConfigurableLlmProvider? _configurable;
    private IReadOnlyList<ConfigFieldSchema>? _schemaFields;
    private Dictionary<string, object?> _schemaValues = new();
    private SchemaDrivenConfigForm? _schemaForm;
    private bool _savingProviderConfig;
    private string? _configLoadError;
    private bool _editModelVisible;
    private bool _savingEditModel;
    private bool _editHasOverride;
    private IEnumerable<string> _editInputModalities = Array.Empty<string>();
    private IEnumerable<string> _editOutputModalities = Array.Empty<string>();
    private ThinkingEditMode _editThinkingMode = ThinkingEditMode.Inherit;
    private string? _editThinkingDefault;
    private string? _editThinkingInterleaved;
    private List<ThinkingLevelEditRow> _editThinkingLevels = [];
    /// <summary>自定义/默认关闭模式下是否提供关闭档（关闭档恒为第一行，code 固定 disabled）。</summary>
    private bool _editCloseLevelEnabled;
    /// <summary>
    /// 打开弹窗时生效声明的档位预算（key → budgetTokens）。
    /// 弹窗不编辑预算，但保存时要按 key 继承回去，否则改一次档位表就把
    /// Anthropic 固定预算模型的 budgetTokens 抹掉。
    /// </summary>
    private Dictionary<string, int?> _editThinkingBudgets = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>当前模型生效的思考声明摘要（只读提示，帮助判断「正在覆盖什么」）。</summary>
    private string _thinkingDeclarationHint = "";
    private readonly EditModelForm _editModelForm = new();

    private bool CanEditCurrentProvider =>
        _currentProviderInfo?.Origin == ProviderOrigin.Configured &&
        _currentProvider is not null;

    /// <summary>删除仅对配置型 Provider 开放；扩展 Provider 用「恢复默认」表达移除语义。</summary>
    private bool CanDeleteModel => CanEditCurrentProvider;

    /// <summary>
    /// Provider 列表的分组视图：配置型 → 内置 → 扩展，组内按显示名排序。
    /// 规则本身在 <see cref="ProviderListGrouping"/>（纯函数，有单测守门）。
    /// </summary>
    private IReadOnlyList<ProviderGroup> ProviderGroups
        => ProviderListGrouping.Build(ProviderManager.GetProviders());

    protected override async Task OnInitializedAsync()
    {
        ModelManager.ModelConfigChanged += OnModelConfigChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        var providers = ProviderManager.GetProviders();
        if (providers.Count > 0 && string.IsNullOrEmpty(_selectedProviderId))
            await SelectProviderAsync(ProviderGroups[0].Items[0].Key);

        _loading = false;
    }

    private async Task RefreshAllAsync()
    {
        if (_refreshingAll || _refreshingCurrent)
            return;

        _refreshingAll = true;
        try
        {
            await ModelManager.RefreshCatalogAsync();
            if (!string.IsNullOrEmpty(_selectedProviderId))
                await SelectProviderAsync(_selectedProviderId);
            else
                RefreshModelRows();

            MessageService.Success("已刷新全部模型目录");
        }
        catch (Exception ex)
        {
            MessageService.Error($"刷新失败：{ex.Message}");
        }
        finally
        {
            _refreshingAll = false;
        }
    }

    private async Task RefreshCurrentAsync()
    {
        if (_refreshingAll || _refreshingCurrent || string.IsNullOrEmpty(_selectedProviderId))
            return;

        _refreshingCurrent = true;
        try
        {
            await ModelManager.RefreshCatalogAsync(_selectedProviderId);
            await SelectProviderAsync(_selectedProviderId);
            MessageService.Success($"已刷新 {_selectedProviderId} 的模型目录");
        }
        catch (Exception ex)
        {
            MessageService.Error($"刷新失败：{ex.Message}");
        }
        finally
        {
            _refreshingCurrent = false;
        }
    }

    private void OnModelConfigChanged(object? sender, ModelConfigChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (!string.IsNullOrEmpty(_selectedProviderId))
                RefreshModelRows();
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private async Task OnProviderSelected(MenuItem item) => await SelectProviderAsync(item.Key);

    private async Task SelectProviderAsync(string id)
    {
        _configLoadError = null;
        _schemaFields = null;
        _schemaValues = new();
        _configurable = null;
        _currentProvider = null;
        _headersJson = "{}";
        _providerCapabilities = Array.Empty<string>();

        _selectedProviderId = id;
        _selectedProviderKeys = new[] { id };
        _currentProviderInfo = ProviderManager.GetProvider(id);
        _capabilityView = ProviderCapabilityProjection.Build(_currentProviderInfo, null);

        if (ProviderManager.TryGetConfigurable(id, out var configurable) && configurable is not null)
        {
            _configurable = configurable;
            _schemaFields = configurable.GetConfigSchema();

            if (_schemaFields is { Count: > 0 })
            {
                try
                {
                    var loaded = await configurable.LoadConfigAsync();
                    _schemaValues = loaded.ToDictionary(kv => kv.Key, kv => kv.Value);
                    _capabilityView = ProviderCapabilityProjection.Build(
                        _currentProviderInfo, ReadCapabilitySection(_schemaValues));
                }
                catch (Exception ex)
                {
                    _configLoadError = $"加载配置失败: {ex.Message}";
                }
            }
            else if (_currentProviderInfo?.Origin == ProviderOrigin.Configured &&
                     ConfigManager.GetSection<Dictionary<string, ProviderConfig>>("Providers").TryGetValue(id, out var schemaNullConfig))
            {
                // ConfiguredLlmProvider: schema null → handcrafted form（编辑副本，不脏写 live 配置）
                _currentProvider = CloneProviderConfig(schemaNullConfig);
                _headersJson = SerializeHeaders(_currentProvider.Headers);
                _providerCapabilities = ToCapabilityKeys(_currentProvider.Capabilities);
                _capabilityView = ProviderCapabilityProjection.Build(_currentProviderInfo, _currentProvider.Capabilities);
            }
        }
        else if (_currentProviderInfo?.Origin == ProviderOrigin.Configured &&
                 ConfigManager.GetSection<Dictionary<string, ProviderConfig>>("Providers").TryGetValue(id, out var configured))
        {
            _currentProvider = CloneProviderConfig(configured);
            _headersJson = SerializeHeaders(_currentProvider.Headers);
            _providerCapabilities = ToCapabilityKeys(_currentProvider.Capabilities);
            _capabilityView = ProviderCapabilityProjection.Build(_currentProviderInfo, _currentProvider.Capabilities);
        }

        RefreshModelRows();
    }

    private void RefreshModelRows()
    {
        RefreshCapabilityDefaults();

        _catalogRows = BuildRows(ModelManager.GetCatalogModelsByProvider(_selectedProviderId));

        _modelRows = _showAll
            ? _catalogRows
            : BuildRows(ModelManager.GetModelsByProvider(_selectedProviderId));

        ApplyFilter();

        // 当前选中测试模型若不在本 Provider 列表中，回落到首项或清空
        if (_modelRows.Count == 0)
            _testModelKey = "";
        else if (string.IsNullOrEmpty(_testModelKey) || _modelRows.All(m => m.Key != _testModelKey))
            _testModelKey = _modelRows[0].Key;
    }

    /// <summary>对当前行集合应用搜索词与类型筛选。</summary>
    private void ApplyFilter()
    {
        IEnumerable<ModelRow> query = _modelRows;

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            query = query.Where(r =>
                r.Id.Contains(term, StringComparison.OrdinalIgnoreCase)
                || r.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || r.Key.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        var types = _typeFilter?.ToArray() ?? Array.Empty<ModelType>();
        if (types.Length > 0)
            query = query.Where(r => r.Types.Any(t => types.Contains(t)));

        _filteredRows = query.ToList();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(300, token);
            ApplyFilter();
        }
        catch (OperationCanceledException)
        {
            // debounce
        }
    }

    private void OnTypeFilterChanged(IEnumerable<ModelType> values)
    {
        _typeFilter = values?.ToArray() ?? Array.Empty<ModelType>();
        ApplyFilter();
    }

    private List<ModelRow> BuildRows(IReadOnlyDictionary<string, ModelConfig> models)
    {
        var enabledIds = new HashSet<string>(
            ModelManager.GetEnabledModelIds(_selectedProviderId),
            StringComparer.OrdinalIgnoreCase);

        // 当前 Provider 的运行时能力投影（ProviderInfo.Capabilities）
        var providerCapabilities = _currentProviderInfo?.Capabilities ?? LlmCapabilityKind.None;

        return models
            .Select(m =>
            {
                var effective = ModelManager.GetEffectiveTypes(m.Value);
                var declared = CapabilityLabels.MaskOfTypes(effective);
                var routable = declared & providerCapabilities;
                var missing = declared & ~providerCapabilities;
                var defaultFor = _capabilityDefaults
                    .Where(pair => string.Equals(pair.Value, m.Key, StringComparison.OrdinalIgnoreCase))
                    .Select(pair => pair.Key)
                    .ToList();
                // 「设为默认」候选：具备该能力、且该能力当前还没指向本模型
                var defaultCandidates = CapabilityLabels.All
                    .Where(kind => ModelManager.CanSetAsDefaultModel(m.Key, kind))
                    .Where(kind => !defaultFor.Contains(kind))
                    .ToList();

                return new ModelRow
                {
                    Key = m.Key,
                    Id = m.Value.Id,
                    Name = m.Value.Name ?? m.Value.Id,
                    Provider = m.Value.Provider,
                    Context = m.Value.Limit.Context,
                    Output = m.Value.Limit.Output,
                    // 任一能力的默认即算默认
                    IsDefault = defaultFor.Count > 0,
                    DefaultFor = defaultFor,
                    DefaultCandidates = defaultCandidates,
                    TypesDisplay = string.Join("、", effective.Select(UiText.ModelTypeText)),
                    Types = effective.ToList(),
                    RoutableDisplay = CapabilityLabels.Describe(routable),
                    CapabilityGapDisplay = CapabilityLabels.Describe(missing),
                    IsEnabled = enabledIds.Contains(m.Value.Id),
                    IsOverridden = ModelManager.GetModelOverride(m.Value.Provider, m.Value.Id) is not null,
                    ThinkingDisplay = DescribeThinkingColumn(m.Value.Options?.Thinking)
                };
            })
            .ToList();
    }

    /// <summary>重取能力默认值快照与失效诊断（设置变更、设默认、删模型后都要刷新）。</summary>
    private void RefreshCapabilityDefaults()
    {
        _capabilityDefaults = ModelManager.GetAllDefaultModels();
        _invalidDefaults = ModelManager.ValidateDefaultModels();
    }

    /// <summary>顶部提示：按能力列出已配置的默认模型；一个都没有时提示去设置页配置。</summary>
    private string DefaultModelsSummary =>
        _capabilityDefaults.Count == 0
            ? "默认模型：尚未为任何能力配置默认模型（可在「设置」页按能力配置）"
            : "默认模型（按能力）："
              + string.Join("｜", _capabilityDefaults
                  .OrderBy(pair => (int)pair.Key)
                  .Select(pair => $"{CapabilityLabels.Label(pair.Key)}={pair.Value}"));

    /// <summary>失效告警文案（只报告，不自动清除）。</summary>
    private string InvalidDefaultsSummary =>
        string.Join("｜", _invalidDefaults
            .OrderBy(pair => (int)pair.Key)
            .Select(pair => pair.Key == LlmCapabilityKind.None
                ? pair.Value
                : $"{CapabilityLabels.Label(pair.Key)}：{pair.Value}"));

    /// <summary>能力多选区提示：区分「配置覆盖」与「生效能力」，两者不可混淆。</summary>
    private string ProviderCapabilitiesHint
    {
        get
        {
            if (_currentProviderInfo is null)
                return string.Empty;

            return _capabilityView.Source switch
            {
                // 覆盖是用户写的：清空后回到 Provider 自己的默认值（具体是什么由 Provider 决定）
                ProviderCapabilitySource.Declared =>
                    $"已声明 {_capabilityView.DeclaredText}；全部取消后保存，表示交回该 Provider 的默认能力。",
                ProviderCapabilitySource.Disabled =>
                    "配置中已显式关闭全部能力（该 Provider 当前不提供任何能力）；勾选任意一项即可恢复。",
                // 未配置覆盖：此时运行时生效值就是默认值，直接照实说，不要用协议缺省去冒充
                _ => $"未配置覆盖，使用默认能力：{_capabilityView.EffectiveText}。"
            };
        }
    }

    /// <summary>多选值回填：只认已登记的能力名，未登记的名字保留原样供后端报错。</summary>
    private static IEnumerable<string> ToCapabilityKeys(List<string>? values) =>
        values is null
            ? Array.Empty<string>()
            : values
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => LlmCapabilityMap.TryParseConfigKey(value, out var kind)
                    ? LlmCapabilityMap.ToConfigKey(kind)
                    : value.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();

    /// <summary>
    /// 从 schema 表单值里取能力清单。
    /// <para>取不到键时返回 <c>null</c>（＝未声明）；键存在但值为空集合时返回空集合（＝显式关闭），
    /// 两者语义不同，不能合并成同一个默认值。</para>
    /// </summary>
    private static object? ReadCapabilitySection(IReadOnlyDictionary<string, object?> values)
    {
        foreach (var (key, value) in values)
        {
            if (string.Equals(key, "Capabilities", StringComparison.OrdinalIgnoreCase))
                return value;
        }

        return null;
    }

    private void OnProviderCapabilitiesChanged(IEnumerable<string>? values)
    {
        _providerCapabilities = ToCapabilityKeys(values?.ToList());
        if (_currentProvider is not null)
        {
            _currentProvider.Capabilities = _providerCapabilities.Count() > 0
                ? _providerCapabilities.ToList()
                : null;
            _capabilityView = ProviderCapabilityProjection.Build(_currentProviderInfo, _currentProvider.Capabilities);
        }
    }

    private void OnShowAllChanged(bool value)
    {
        _showAll = value;
        RefreshModelRows();
    }

    private async Task ToggleModelEnabled(ModelRow row, bool enabled)
    {
        var current = ModelManager.GetEnabledModelIds(_selectedProviderId).ToList();

        if (enabled)
        {
            if (!current.Contains(row.Id, StringComparer.OrdinalIgnoreCase))
                current.Add(row.Id);
        }
        else
        {
            current.RemoveAll(id => string.Equals(id, row.Id, StringComparison.OrdinalIgnoreCase));
        }

        await SaveEnabledAsync(current);
    }

    private async Task EnableAllModelsAsync()
    {
        var ids = _catalogRows.Select(r => r.Id).ToList();
        await SaveEnabledAsync(ids);
    }

    private async Task DisableAllModelsAsync()
        => await SaveEnabledAsync(new List<string>());

    private async Task SaveEnabledAsync(List<string> ids)
    {
        try
        {
            await ModelManager.SetEnabledModelsAsync(_selectedProviderId, ids);
            RefreshModelRows();
        }
        catch (Exception ex)
        {
            MessageService.Error($"保存启用清单失败：{ex.Message}");
        }
    }

    private void OnTestModelKeyChanged(string? value)
        => _testModelKey = value ?? "";

    private async Task SaveProviderConfigAsync()
    {
        if (_configurable is null) return;

        _savingProviderConfig = true;
        try
        {
            if (_schemaFields is { Count: > 0 })
            {
                string? err = null;
                if (_schemaForm is null || !_schemaForm.TryValidate(out err))
                {
                    MessageService.Error(err ?? "请检查配置");
                    return;
                }

                await _configurable.SaveConfigAsync(_schemaValues, _saveLevel);
            }
            else if (_currentProvider is not null)
            {
                var values = new Dictionary<string, object?>
                {
                    ["Name"] = _currentProvider.Name,
                    ["Type"] = _currentProvider.Type.ToString(),
                    ["BaseUrl"] = _currentProvider.BaseUrl,
                    ["ApiKey"] = _currentProvider.ApiKey,
                    ["Headers"] = ParseHeaders(),
                    ["Timeout"] = _currentProvider.Timeout,
                    ["MaxRetries"] = _currentProvider.MaxRetries,
                    // Review Focus #5：能力清单与 listModels 必须随保存回写，漏一处即静默丢配置
                    ["Capabilities"] = _currentProvider.Capabilities is null
                        ? null
                        : _currentProvider.Capabilities.ToList(),
                    ["ListModels"] = _currentProvider.ListModels
                };
                await _configurable.SaveConfigAsync(values, _saveLevel);
            }

            MessageService.Success("Provider 配置已保存");
            await SelectProviderAsync(_selectedProviderId);
        }
        catch (Exception ex)
        {
            MessageService.Error($"保存失败：{ex.Message}");
        }
        finally
        {
            _savingProviderConfig = false;
        }
    }

    private async Task TestConnection()
    {
        if (string.IsNullOrEmpty(_selectedProviderId)) return;
        if (string.IsNullOrEmpty(_testModelKey))
        {
            MessageService.Warning("请先选择测试模型");
            return;
        }
        _testing = true;
        try
        {
            var cfg = ModelManager.GetModel(_testModelKey);
            var modelId = cfg?.Id ?? _testModelKey;
            var ok = await ProviderManager.TestConnectionAsync(
                _selectedProviderId, modelId, _testCapability);
            var capabilityKey = LlmCapabilityMap.ToConfigKey(_testCapability);
            if (ok) MessageService.Success($"连接成功 ({modelId} · {capabilityKey})");
            else MessageService.Error($"连接失败 ({modelId} · {capabilityKey})");
        }
        finally { _testing = false; }
    }

    /// <summary>
    /// 把模型设为指定能力的默认值。后端写时校验（裸 ID / 模型不存在 / 能力不符）抛
    /// <see cref="ArgumentException"/>，UI 必须兜住并显示消息，不能让异常冒泡崩页面。
    /// </summary>
    private async Task SetDefaultModelAsync(string key, LlmCapabilityKind capability)
    {
        var configKey = LlmCapabilityMap.ToConfigKey(capability);
        if (!ModelManager.CanSetAsDefaultModel(key, capability))
        {
            MessageService.Warning($"模型 {key} 不具备 {configKey} 能力，不能作为该能力的默认模型");
            return;
        }

        try
        {
            await ModelManager.SetDefaultModelAsync(capability, key, _saveLevel);
            RefreshModelRows();
            MessageService.Success($"已设为 {configKey} 默认模型：{key}");
        }
        catch (ArgumentException ex)
        {
            // 后端写入时校验：裸标识、模型不存在、能力不匹配
            MessageService.Error($"设置默认模型失败：{ex.Message}");
        }
        catch (Exception ex)
        {
            MessageService.Error($"写入配置失败：{ex.Message}");
        }
    }

    /// <summary>该模型是否是任一能力的默认（没有全局唯一默认模型）。</summary>
    private bool IsDefaultForAnyCapability(string modelKey) =>
        _capabilityDefaults.Values.Any(reference =>
            string.Equals(reference, modelKey, StringComparison.OrdinalIgnoreCase));

    private async Task DeleteModel(ModelRow row)
    {
        if (IsDefaultForAnyCapability(row.Key))
        {
            MessageService.Warning("该模型仍是某个能力的默认模型，请先更改默认模型后再删除");
            return;
        }

        try
        {
            await ModelManager.DeleteModelAsync(row.Key, _saveLevel);
        }
        catch (Exception ex)
        {
            MessageService.Error($"删除失败：{ex.Message}");
            return;
        }

        // 目录刷新失败不应吞掉删除结果反馈（Popconfirm 依赖本方法正常返回才会关闭）
        try
        {
            await ModelManager.RefreshCatalogAsync(_selectedProviderId);
        }
        catch (Exception ex)
        {
            MessageService.Warning($"模型已删除，但目录刷新失败：{ex.Message}");
        }

        RefreshModelRows();
        MessageService.Success($"已删除模型 {row.Key}");
    }

    private void ShowEditModel(ModelRow row)
    {
        var config = ModelManager.GetModel(row.Key);
        if (config is null)
        {
            MessageService.Error("模型不存在");
            return;
        }

        _editKey = row.Key;
        var overridePatch = ModelManager.GetModelOverride(row.Provider, row.Id);
        _editHasOverride = overridePatch is not null;
        _editModelForm.Name = config.Name ?? config.Id;
        _editModelForm.Context = config.Limit?.Context > 0 ? config.Limit.Context : ModelLimitDefaults.Context;
        _editModelForm.Output = config.Limit?.Output > 0 ? config.Limit.Output : ModelLimitDefaults.Output;
        _editTypes = ModelManager.GetEffectiveTypes(config).ToArray();
        _editInputModalities = config.Modalities?.Input?.ToArray() ?? Array.Empty<string>();
        _editOutputModalities = config.Modalities?.Output?.ToArray() ?? Array.Empty<string>();

        // 初始模式只按「覆盖层有没有 thinking」判定：无覆盖 → 跟随声明。
        // 不能用生效值预填，否则一打开就写成 supported=true，等于把目录声明固化成用户覆盖。
        var thinkingOverride = overridePatch?.Thinking;
        var source = thinkingOverride ?? ToThinkingOverride(config.Options?.Thinking);
        _editThinkingMode = thinkingOverride is null
            ? ThinkingEditMode.Inherit
            : ThinkingEditMode.Custom;
        _editThinkingDefault = source?.Default;
        _editThinkingInterleaved = source?.Interleaved;

        // 关闭档是独立一行（固定 code=disabled）：从档位表里剥离出来，表格只放用户自填档位。
        var allLevels = source?.Levels ?? [];
        _editCloseLevelEnabled = allLevels.Any(level => ThinkingEffortKeys.IsOff(level.Key));
        _editThinkingLevels = allLevels
            .Where(level => !ThinkingEffortKeys.IsOff(level.Key))
            .Select(level => new ThinkingLevelEditRow
            {
                RowId = Guid.NewGuid().ToString("N"),
                Key = level.Key,
                Label = level.Label
            })
            .ToList();
        _editThinkingBudgets = allLevels
            .Where(level => !string.IsNullOrWhiteSpace(level.Key))
            .GroupBy(level => level.Key, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.First().BudgetTokens, StringComparer.OrdinalIgnoreCase);
        _thinkingDeclarationHint = DescribeThinking(config.Options?.Thinking, overridePatch?.Thinking);
        _editModelVisible = true;
    }

    /// <summary>把生效声明投影成覆盖形态，供弹窗预填（不改语义，仅取字段）。</summary>
    private static ModelThinkingOverride? ToThinkingOverride(ThinkingOptions? thinking)
    {
        if (thinking is null)
            return null;

        return new ModelThinkingOverride
        {
            Supported = thinking.Supported,
            Default = thinking.Default,
            Interleaved = thinking.Interleaved,
            Levels = thinking.Levels?
                .Select(level => new ThinkingLevel
                {
                    Key = level.Key,
                    Label = level.Label,
                    BudgetTokens = level.BudgetTokens
                })
                .ToList()
        };
    }

    /// <summary>只读提示：当前生效的思考声明与覆盖来源。</summary>
    private static string DescribeThinking(ThinkingOptions? effective, ModelThinkingOverride? patch)
    {
        var origin = patch is null ? "跟随声明" : "用户覆盖档位";
        if (effective is null || !ThinkingEffortKeys.IsSupported(effective))
            return $"当前生效：无思考档位（{origin}）";

        var levels = string.Join("、", effective.Levels!.Select(level => level.Key));
        var defaultText = string.IsNullOrWhiteSpace(effective.Default)
            ? "不指定"
            : ThinkingEffortKeys.IsOff(effective.Default) ? $"{effective.Default}（默认关闭）" : effective.Default;
        return $"当前生效：{levels}（默认档 {defaultText}，{origin}）";
    }

    private void OnEditThinkingModeChanged(ThinkingEditMode mode)
    {
        _editThinkingMode = mode;

        // 切到「自定义档位」且当前一个档位都没有时，自动补上关闭档，
        // 否则用户面对一张空表，很容易保存出一条「声明了思考但没有档位」的无效配置。
        if (mode == ThinkingEditMode.Custom && !_editCloseLevelEnabled && _editThinkingLevels.Count == 0)
            _editCloseLevelEnabled = true;
    }

