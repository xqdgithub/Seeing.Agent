    private string DefaultModelsSummary =>
        _capabilityDefaults.Count == 0
            ? "默认模型: 未配置任何能力的默认模型（设置页可按能力配置）"
            : "默认模型（按能力）: "
              + string.Join(" | ", _capabilityDefaults
                  .OrderBy(pair => (int)pair.Key)
                  .Select(pair => $"{LlmCapabilityMap.ToConfigKey(pair.Key)}={pair.Value}"));

    /// <summary>失效告警文案（<c>ValidateDefaultModels</c> 原样呈现，不自动清除）。</summary>
    private string InvalidDefaultsSummary =>
        string.Join(" | ", _invalidDefaults
            .OrderBy(pair => (int)pair.Key)
            .Select(pair => pair.Key == LlmCapabilityKind.None
                ? pair.Value
                : $"{LlmCapabilityMap.ToConfigKey(pair.Key)}: {pair.Value}"));

    /// <summary>能力多选区提示：未配置 = 按协议缺省（决议 19）。</summary>
    private string ProviderCapabilitiesHint
    {
        get
        {
            if (_currentProvider is null)
                return string.Empty;

            var protocol = ProviderTypes.Normalize(_currentProvider.Type);
            var protocolDefault = CapabilityLabels.Describe(LlmCapabilityMap.DefaultCapabilities(_currentProvider.Type));
            return _currentProvider.Capabilities is null
                ? $"未配置能力时缺省仅 {protocolDefault}（按协议 {protocol} 取缺省）。"
                : $"已声明 {string.Join(", ", _providerCapabilities)}；全部取消后保存 = 交回协议缺省（{protocolDefault}）。";
        }
    }

    /// <summary>多选值回填：只认已登记的能力名，未登记的名字保留原样供后端抛错（决议 19）。</summary>
    private static IEnumerable<string> ToCapabilityKeys(List<string>? values) =>
        values is null
            ? Array.Empty<string>()
            : values
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => LlmCapabilityMap.TryParseConfigKey(value, out var kind)
                    ? LlmCapabilityMap.ToConfigKey(kind)
                    : value.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();

