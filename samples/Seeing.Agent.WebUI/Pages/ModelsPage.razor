@page "/models"
@using System.Text.Json
@using AntDesign
@using Seeing.Agent.Configuration
@using Seeing.Agent.Llm
@using Seeing.ConfigSchema
@inject IProviderManager ProviderManager
@inject IModelConfigManager ModelManager
@inject UnifiedConfigManager ConfigManager
@inject IMessageService MessageService
@implements IDisposable

<PageTitle>模型 - Seeing.Agent</PageTitle>

<WorkspacePageShell Loading="@_loading">
    <Breadcrumb>
        <BreadcrumbItem>设置</BreadcrumbItem>
        <BreadcrumbItem>模型</BreadcrumbItem>
    </Breadcrumb>
    <Extra>
        <Space>
            <Button Icon="@IconType.Outline.Plus" OnClick="ShowAddProvider">添加 Provider</Button>
        </Space>
    </Extra>
    <ChildContent>
        <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 16px;"
               Message="@($"默认模型: {ModelManager.GetDefaultModel() ?? "未设置"}")" />

        <Row Gutter="16">
            <Col Span="6">
                <Card Title="Provider 列表" Size="@CardSize.Small">
                    <Menu Mode="@MenuMode.Inline" SelectedKeys="@_selectedProviderKeys" OnMenuItemClicked="OnProviderSelected">
                        @foreach (var p in ProviderManager.GetProviders().OrderBy(pair => pair.Key))
                        {
                            <MenuItem Key="@p.Key">
                                <span style="display: inline-flex; align-items: center; gap: 8px;">
                                    @(p.Value.Name ?? p.Key)
                                    @if (p.Value.Source == ProviderSource.Extension)
                                    {
                                        <Tag Color="@("blue")" Style="margin: 0; line-height: 18px;">扩展</Tag>
                                    }
                                </span>
                            </MenuItem>
                        }
                    </Menu>
                </Card>
            </Col>
            <Col Span="18">
                @if (_currentProviderInfo != null)
                {
                    <Card Title="@($"Provider: {_selectedProviderId}")">
                        @* 配置来源信息：帮助定位 Provider 从哪个文件加载（用户级 / 项目级 / 扩展） *@
                        <div style="margin-bottom: 16px; padding: 8px 12px; background: #e6f4ff; border: 1px solid #91caff; border-radius: 6px; font-size: 13px;">
                            来源：
                            @if (_currentProviderInfo.Source == ProviderSource.Extension)
                            {
                                <Tag Color="@("blue")">扩展</Tag>
                                <span>由扩展 @(_currentProviderInfo.OwnerExtensionId) 注册，配置由扩展自身管理</span>
                            }
                            else
                            {
                                <Tag>配置</Tag>
                                <span>加载自用户级配置文件</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_configLoadError))
                        {
                            <Alert Type="@AlertType.Error" Message="@_configLoadError" ShowIcon="true" />
                        }
                        else if (_schemaFields is { Count: > 0 })
                        {
                            <SchemaDrivenConfigForm @ref="_schemaForm" Fields="_schemaFields" Values="_schemaValues" />
                            <Button Type="@ButtonType.Primary" Loading="_savingProviderConfig" OnClick="SaveProviderConfigAsync"
                                    Style="margin-top: 12px;">
                                保存配置
                            </Button>
                        }
                        else if (_currentProvider is not null)
                        {
                            <Form Layout="@FormLayout.Vertical" Model="@_currentProvider" Context="formContext">
                            <div>
                                <FormItem Label="ID"><Input @bind-Value="@_currentProvider.Id" Disabled="true" /></FormItem>
                                <FormItem Label="类型">
                                    <Select TItemValue="ProviderType" TItem="ProviderType" @bind-Value="@_currentProvider.Type">
                                        <SelectOption TItemValue="ProviderType" TItem="ProviderType" Value="@ProviderType.OpenAI">OpenAI</SelectOption>
                                        <SelectOption TItemValue="ProviderType" TItem="ProviderType" Value="@ProviderType.Anthropic">Anthropic</SelectOption>
                                    </Select>
                                </FormItem>
                                <FormItem Label="名称"><Input @bind-Value="@_currentProvider.Name" /></FormItem>
                                <FormItem Label="Base URL"><Input @bind-Value="@_currentProvider.BaseUrl" /></FormItem>
                                <FormItem Label="API Key"><Input Password @bind-Value="@_currentProvider.ApiKey" /></FormItem>
                                <FormItem Label="自定义 Headers（JSON）">
                                    <TextArea Rows="6" @bind-Value="@_headersJson"
                                              Placeholder="{ &quot;Authorization&quot;: &quot;Bearer ...&quot; }"
                                              Style="font-family: monospace;" />
                                    <div style="color: #888; font-size: 12px; margin-top: 4px;">
                                        每个键值会透传到 Provider 请求；同名内置请求头将被覆盖。请勿提交无效 JSON。
                                    </div>
                                </FormItem>
                                <div style="margin-top: 12px;">
                                    <Button Type="@ButtonType.Primary" Loading="_savingProviderConfig" OnClick="SaveProviderConfigAsync">
                                        保存配置
                                    </Button>
                                </div>
                            </div>
                            </Form>
                        }
                        else
                        {
                            <Descriptions>
                                <DescriptionsItem Title="ID">@_currentProviderInfo!.Id</DescriptionsItem>
                                <DescriptionsItem Title="名称">@(_currentProviderInfo.Name ?? _currentProviderInfo.Id)</DescriptionsItem>
                                <DescriptionsItem Title="来源">
                                    @if (_currentProviderInfo.Source == ProviderSource.Extension)
                                    {
                                        <Tag Color="@("blue")">扩展</Tag>
                                    }
                                    else
                                    {
                                        <Tag>配置</Tag>
                                    }
                                </DescriptionsItem>
                                <DescriptionsItem Title="模型数">@_modelRows.Count</DescriptionsItem>
                            </Descriptions>
                            <Alert Type="@AlertType.Info" ShowIcon="true"
                                   Message="扩展 Provider 由扩展管理，不能在此编辑连接配置。" />
                        }

                        @* Shared Test Connection — schema, handcrafted, and extension tracks (not load-error-only) *@
                        @if (string.IsNullOrEmpty(_configLoadError))
                        {
                            <Divider />
                            <Space>
                                @* @key：切换 Provider 时强制重建，避免 AntDesign Select 残留上一 Provider 的 Option *@
                                <Select TItemValue="string"
                                        TItem="ModelRow"
                                        @key="@($"test-conn-{_selectedProviderId}")"
                                        DataSource="@_modelRows"
                                        @bind-Value="_testModelId"
                                        ValueName="@nameof(ModelRow.Id)"
                                        LabelName="@nameof(ModelRow.Id)"
                                        Style="width: 240px;"
                                        Placeholder="选择测试模型"
                                        Disabled="@(_modelRows.Count == 0)"
                                        AllowClear />
                                <Button Loading="@_testing" OnClick="TestConnection"
                                        Disabled="@(string.IsNullOrEmpty(_testModelId))">
                                    测试连接
                                </Button>
                            </Space>
                        }
                    </Card>

                    <Card Title="模型列表" Style="margin-top: 16px;">
                        <div style="margin-bottom: 12px;">
                            <Button Icon="@IconType.Outline.Plus" Size="@ButtonSize.Small"
                                    OnClick="ShowAddModel" Disabled="@(!CanEditCurrentProvider)">
                                添加模型
                            </Button>
                        </div>
                        <Table TItem="ModelRow" DataSource="@_modelRows" RowKey="@(m => m.Key)" Size="@TableSize.Small">
                            <PropertyColumn Property="c => c.Id" Title="模型 ID" />
                            <PropertyColumn Property="c => c.Name" Title="名称" />
                            <PropertyColumn Property="c => c.Provider" Title="Provider" />
                            <PropertyColumn Property="c => c.TypesDisplay" Title="类型" />
                            <Column TData="ModelRow" Title="免费" Width="90">
                                @if (context.IsFree)
                                {
                                    <Tag Color="@("green")">免费</Tag>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </Column>
                            <PropertyColumn Property="c => c.Context" Title="上下文" />
                            <PropertyColumn Property="c => c.Output" Title="输出" />
                            <ActionColumn Title="操作">
                                <Space>
                                    <Button Size="@ButtonSize.Small" OnClick="@(() => ShowEditModel(context))"
                                            Disabled="@(!CanEditCurrentProvider)">编辑</Button>
                                    <Tooltip Title="当前是默认模型">
                                        <Button Size="@ButtonSize.Small" OnClick="@(() => SetDefaultModel(context.Key))"
                                                Disabled="@context.IsDefault">设为默认</Button>
                                    </Tooltip>
                                    <Popconfirm Title="确定要删除此模型吗？" OnConfirm="@(() => DeleteModel(context))">
                                        <Button Size="@ButtonSize.Small" Danger Icon="@IconType.Outline.Delete"
                                                Disabled="@(!CanEditCurrentProvider)">删除</Button>
                                    </Popconfirm>
                                </Space>
                            </ActionColumn>
                        </Table>
                    </Card>
                }
                else
                {
                    <Empty Description="@("请选择或添加 Provider")" />
                }
            </Col>
        </Row>
    </ChildContent>
</WorkspacePageShell>

<Modal Title="添加 Provider" Visible="@_addModalVisible" OnOk="ConfirmAddProvider" OnCancel="@(() => _addModalVisible = false)">
    @if (_addModalVisible)
    {
        <Form Layout="@FormLayout.Vertical" Model="@_addProviderForm" Context="formContext">
        <div>
            <FormItem Label="Provider ID"><Input @bind-Value="@_newProviderId" Placeholder="如 openai" /></FormItem>
            <FormItem Label="类型">
                <Select TItemValue="ProviderType" TItem="ProviderType" @bind-Value="@_newProviderType">
                    <SelectOption TItemValue="ProviderType" TItem="ProviderType" Value="@ProviderType.OpenAI">OpenAI</SelectOption>
                    <SelectOption TItemValue="ProviderType" TItem="ProviderType" Value="@ProviderType.Anthropic">Anthropic</SelectOption>
                </Select>
            </FormItem>
        </div>
        </Form>
    }
</Modal>

<Modal Title="添加模型" Visible="@_addModelVisible"
       OnOk="ConfirmAddModelAsync" OnCancel="@(() => _addModelVisible = false)" ConfirmLoading="@_addingModel">
    @if (_addModelVisible)
    {
        <Form Layout="@FormLayout.Vertical" Model="@_addModelForm">
            <FormItem Label="Provider">
                <Input Value="@_selectedProviderId" Disabled="true" />
            </FormItem>
            <FormItem Label="模型 ID" Required>
                <Input @bind-Value="@_addModelForm.Id" Placeholder="如 gpt-4o-mini 或 Qwen/Qwen3-VL-Embedding-8B" />
            </FormItem>
            <FormItem Label="显示名称">
                <Input @bind-Value="@_addModelForm.Name" Placeholder="可选，默认等于模型 ID" />
            </FormItem>
            <FormItem Label="用途类型">
                <Select Mode="@SelectMode.Multiple"
                        TItemValue="ModelType"
                        TItem="ModelType"
                        Values="@_addModelTypes"
                        ValuesChanged="OnAddModelTypesChanged"
                        Style="width: 100%;"
                        Placeholder="默认 Text">
                    @foreach (var t in Enum.GetValues<ModelType>())
                    {
                        <SelectOption TItemValue="ModelType" TItem="ModelType" Value="@t" Label="@t.ToString()" />
                    }
                </Select>
            </FormItem>
            <FormItem Label="上下文长度">
                <AntDesign.InputNumber @bind-Value="@_addModelForm.Context" Min="1" Max="2000000" Style="width: 100%;" />
            </FormItem>
            <FormItem Label="输出长度（token）">
                <AntDesign.InputNumber @bind-Value="@_addModelForm.Output" Min="1" Max="2000000" Style="width: 100%;" />
            </FormItem>
        </Form>
    }
</Modal>

<Modal Title="编辑模型" Visible="@_editModelVisible"
       OnOk="SaveEditModelAsync" OnCancel="@(() => _editModelVisible = false)" ConfirmLoading="@_savingEditModel">
    @if (_editModelVisible)
    {
        <Form Layout="@FormLayout.Vertical" Model="@_editModelForm">
            <FormItem Label="Provider">
                <Input Value="@_selectedProviderId" Disabled="true" />
            </FormItem>
            <FormItem Label="模型 ID">
                <Input Value="@_editKey" Disabled="true" />
            </FormItem>
            <FormItem Label="显示名称">
                <Input @bind-Value="@_editModelForm.Name" />
            </FormItem>
            <FormItem Label="用途类型">
                <Select Mode="@SelectMode.Multiple"
                        TItemValue="ModelType"
                        TItem="ModelType"
                        Values="@_editTypes"
                        ValuesChanged="OnEditTypesChanged"
                        Style="width: 100%;"
                        Placeholder="选择用途类型（空=Text）">
                    @foreach (var t in Enum.GetValues<ModelType>())
                    {
                        <SelectOption TItemValue="ModelType" TItem="ModelType" Value="@t" Label="@t.ToString()" />
                    }
                </Select>
            </FormItem>
            <FormItem Label="上下文长度">
                <AntDesign.InputNumber @bind-Value="@_editModelForm.Context" Min="1" Max="2000000" Style="width: 100%;" />
            </FormItem>
            <FormItem Label="输出长度（token）">
                <AntDesign.InputNumber @bind-Value="@_editModelForm.Output" Min="1" Max="2000000" Style="width: 100%;" />
            </FormItem>
        </Form>
    }
</Modal>

@code {
    private ProviderInfo? _currentProviderInfo;
    private ProviderConfig? _currentProvider;
    private string _selectedProviderId = "";
    private string[] _selectedProviderKeys = Array.Empty<string>();
    private List<ModelRow> _modelRows = new();
    private ConfigLevel _saveLevel = ModelConfigManager.ModelStoreLevel;
    private bool _loading;
    private bool _testing;
    private bool _addModalVisible;
    private string _newProviderId = "";
    private ProviderType _newProviderType = ProviderType.OpenAI;
    private readonly AddProviderForm _addProviderForm = new();
    private string _editKey = "";
    private IEnumerable<ModelType> _editTypes = Array.Empty<ModelType>();
    private bool _addModelVisible;
    private bool _addingModel;
    private readonly AddModelForm _addModelForm = new();
    private IEnumerable<ModelType> _addModelTypes = new[] { ModelType.Text };
    private string _testModelId = "";
    private string _headersJson = "{}";

    private IConfigurableLlmProvider? _configurable;
    private IReadOnlyList<ConfigFieldSchema>? _schemaFields;
    private Dictionary<string, object?> _schemaValues = new();
    private SchemaDrivenConfigForm? _schemaForm;
    private bool _savingProviderConfig;
    private string? _configLoadError;
    private bool _editModelVisible;
    private bool _savingEditModel;
    private readonly EditModelForm _editModelForm = new();

    private bool CanEditCurrentProvider =>
        _currentProviderInfo?.Source == ProviderSource.Configured &&
        _currentProvider is not null;

    protected override async Task OnInitializedAsync()
    {
        ModelManager.ModelConfigChanged += OnModelConfigChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        var providers = ProviderManager.GetProviders();
        if (providers.Count > 0 && string.IsNullOrEmpty(_selectedProviderId))
            await SelectProviderAsync(providers.Keys.First());

        _loading = false;
    }

    private void OnModelConfigChanged(object? sender, ModelConfigChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (!string.IsNullOrEmpty(_selectedProviderId))
                RefreshModelRows();
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private async Task OnProviderSelected(MenuItem item) => await SelectProviderAsync(item.Key);

    private async Task SelectProviderAsync(string id)
    {
        _configLoadError = null;
        _schemaFields = null;
        _schemaValues = new();
        _configurable = null;
        _currentProvider = null;
        _headersJson = "{}";

        _selectedProviderId = id;
        _selectedProviderKeys = new[] { id };
        _currentProviderInfo = ProviderManager.GetProvider(id);

        if (ProviderManager.TryGetConfigurable(id, out var configurable) && configurable is not null)
        {
            _configurable = configurable;
            _schemaFields = configurable.GetConfigSchema();

            if (_schemaFields is { Count: > 0 })
            {
                try
                {
                    var loaded = await configurable.LoadConfigAsync();
                    _schemaValues = loaded.ToDictionary(kv => kv.Key, kv => kv.Value);
                }
                catch (Exception ex)
                {
                    _configLoadError = $"加载配置失败: {ex.Message}";
                }
            }
            else if (_currentProviderInfo?.Source == ProviderSource.Configured &&
                     ConfigManager.GetSection<Dictionary<string, ProviderConfig>>("Providers").TryGetValue(id, out var schemaNullConfig))
            {
                // ConfiguredLlmProvider: schema null → handcrafted form（编辑副本，不脏写 live 配置）
                _currentProvider = CloneProviderConfig(schemaNullConfig);
                _headersJson = SerializeHeaders(_currentProvider.Headers);
            }
        }
        else if (_currentProviderInfo?.Source == ProviderSource.Configured &&
                 ConfigManager.GetSection<Dictionary<string, ProviderConfig>>("Providers").TryGetValue(id, out var configured))
        {
            _currentProvider = CloneProviderConfig(configured);
            _headersJson = SerializeHeaders(_currentProvider.Headers);
        }

        RefreshModelRows();
    }

    private void RefreshModelRows()
    {
        var models = ModelManager.GetModelsByProvider(_selectedProviderId);
        _modelRows = models
            .Select(m =>
            {
                var effective = ModelManager.GetEffectiveTypes(m.Value);
                var isDefault = ModelManager.GetDefaultModel() == m.Key;
                return new ModelRow
                {
                    Key = m.Key,
                    Id = m.Value.Id,
                    Name = m.Value.Name ?? m.Value.Id,
                    Provider = m.Value.Provider,
                    Context = m.Value.Limit.Context,
                    Output = m.Value.Limit.Output,
                    IsDefault = isDefault,
                    TypesDisplay = string.Join(", ", effective),
                    IsFree = IsFreeModel(m.Value)
                };
            })
            .ToList();

        // 当前选中测试模型若不在本 Provider 列表中，回落到首项或清空
        if (_modelRows.Count == 0)
            _testModelId = "";
        else if (_modelRows.All(m => m.Id != _testModelId))
            _testModelId = _modelRows[0].Id;
    }

    /// <summary>
    /// 从模型扩展元数据读取免费标记（支持 bool 与 JSON 反序列化的 JsonElement/字符串）。
    /// </summary>
    private static bool IsFreeModel(Seeing.Agent.Abstractions.Llm.ModelConfig config)
    {
        if (config.Metadata is null ||
            !config.Metadata.TryGetValue(Seeing.Agent.Abstractions.Llm.ModelMetadataKeys.IsFree, out var value) ||
            value is null)
        {
            return false;
        }

        return value switch
        {
            bool b => b,
            JsonElement { ValueKind: JsonValueKind.True } => true,
            JsonElement { ValueKind: JsonValueKind.String } element
                when bool.TryParse(element.GetString(), out var parsed) => parsed,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };
    }

    private async Task SaveProviderConfigAsync()
    {
        if (_configurable is null) return;

        _savingProviderConfig = true;
        try
        {
            if (_schemaFields is { Count: > 0 })
            {
                string? err = null;
                if (_schemaForm is null || !_schemaForm.TryValidate(out err))
                {
                    MessageService.Error(err ?? "请检查配置");
                    return;
                }

                await _configurable.SaveConfigAsync(_schemaValues, _saveLevel);
            }
            else if (_currentProvider is not null)
            {
                var values = new Dictionary<string, object?>
                {
                    ["Name"] = _currentProvider.Name,
                    ["Type"] = _currentProvider.Type.ToString(),
                    ["BaseUrl"] = _currentProvider.BaseUrl,
                    ["ApiKey"] = _currentProvider.ApiKey,
                    ["Headers"] = ParseHeaders(),
                    ["Timeout"] = _currentProvider.Timeout,
                    ["MaxRetries"] = _currentProvider.MaxRetries,
                    ["DefaultModel"] = _currentProvider.DefaultModel
                };
                await _configurable.SaveConfigAsync(values, _saveLevel);
            }

            MessageService.Success("Provider 配置已保存");
            await SelectProviderAsync(_selectedProviderId);
        }
        catch (Exception ex)
        {
            MessageService.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            _savingProviderConfig = false;
        }
    }

    private async Task TestConnection()
    {
        if (string.IsNullOrEmpty(_selectedProviderId)) return;
        if (string.IsNullOrEmpty(_testModelId))
        {
            MessageService.Warning("请先选择测试模型");
            return;
        }
        _testing = true;
        try
        {
            var ok = await ProviderManager.TestConnectionAsync(_selectedProviderId, _testModelId);
            if (ok) MessageService.Success($"连接成功 ({_testModelId})");
            else MessageService.Error("连接失败");
        }
        finally { _testing = false; }
    }

    private async Task SetDefaultModel(string key)
    {
        if (!ModelManager.CanSetAsDefaultModel(key))
        {
            MessageService.Warning("仅 Text 类型模型可设为默认对话模型");
            return;
        }

        await ModelManager.SetDefaultModelAsync(key, _saveLevel);
        RefreshModelRows();
        MessageService.Success($"已设为默认模型：{key}");
    }

    private async Task DeleteModel(ModelRow row)
    {
        if (ModelManager.GetDefaultModel() == row.Key)
        {
            MessageService.Warning("请先更改默认模型后再删除");
            return;
        }

        await ModelManager.DeleteModelAsync(row.Key, _saveLevel);
        RefreshModelRows();
        MessageService.Success($"已删除模型 {row.Key}");
    }

    private void ShowEditModel(ModelRow row)
    {
        var config = ModelManager.GetModel(row.Key);
        if (config is null)
        {
            MessageService.Error("模型不存在");
            return;
        }

        _editKey = row.Key;
        _editModelForm.Name = config.Name ?? config.Id;
        _editModelForm.Context = config.Limit?.Context > 0 ? config.Limit.Context : 4096;
        _editModelForm.Output = config.Limit?.Output > 0 ? config.Limit.Output : 4096;
        _editTypes = ModelManager.GetEffectiveTypes(config).ToArray();
        _editModelVisible = true;
    }

    private async Task SaveEditModelAsync()
    {
        var config = ModelManager.GetModel(_editKey);
        if (config is null)
        {
            MessageService.Error("模型不存在");
            return;
        }

        _savingEditModel = true;
        try
        {
            config.Name = string.IsNullOrWhiteSpace(_editModelForm.Name) ? config.Id : _editModelForm.Name.Trim();
            config.Types = _editTypes?.ToList() ?? new List<ModelType>();
            config.Limit ??= new ModelLimits();
            if (_editModelForm.Context > 0)
                config.Limit.Context = _editModelForm.Context;
            if (_editModelForm.Output > 0)
                config.Limit.Output = _editModelForm.Output;

            await ModelManager.UpdateModelAsync(_editKey, config, _saveLevel);
            _editModelVisible = false;
            RefreshModelRows();
            MessageService.Success("模型已更新");
        }
        catch (Exception ex)
        {
            MessageService.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            _savingEditModel = false;
        }
    }

    private void OnEditTypesChanged(IEnumerable<ModelType> values)
        => _editTypes = values?.ToArray() ?? Array.Empty<ModelType>();

    private void ShowAddProvider()
    {
        _newProviderId = "";
        _addModalVisible = true;
    }

    private void ShowAddModel()
    {
        if (string.IsNullOrEmpty(_selectedProviderId))
        {
            MessageService.Warning("请先选择 Provider");
            return;
        }

        _addModelForm.Id = "";
        _addModelForm.Name = "";
        _addModelForm.Context = 4096;
        _addModelForm.Output = 4096;
        _addModelTypes = new[] { ModelType.Text };
        _addModelVisible = true;
    }

    private void OnAddModelTypesChanged(IEnumerable<ModelType> values)
        => _addModelTypes = values?.ToArray() ?? Array.Empty<ModelType>();

    private async Task ConfirmAddModelAsync()
    {
        if (string.IsNullOrEmpty(_selectedProviderId))
        {
            MessageService.Warning("请先选择 Provider");
            return;
        }

        var modelId = (_addModelForm.Id ?? "").Trim();
        if (string.IsNullOrWhiteSpace(modelId))
        {
            MessageService.Warning("请填写模型 ID");
            return;
        }

        var key = ModelRef.Format(_selectedProviderId, modelId);
        if (ModelManager.GetModel(key) is not null)
        {
            MessageService.Warning($"模型已存在: {key}");
            return;
        }

        _addingModel = true;
        try
        {
            var types = _addModelTypes?.ToList() ?? new List<ModelType>();
            if (types.Count == 0)
                types.Add(ModelType.Text);

            var config = new ModelConfig
            {
                Id = modelId,
                Name = string.IsNullOrWhiteSpace(_addModelForm.Name) ? modelId : _addModelForm.Name.Trim(),
                Provider = _selectedProviderId,
                Types = types,
                Limit = new ModelLimits
                {
                    Context = _addModelForm.Context > 0 ? _addModelForm.Context : 4096,
                    Output = _addModelForm.Output > 0 ? _addModelForm.Output : 4096
                }
            };

            await ModelManager.AddModelAsync(key, config, _saveLevel);
            _addModelVisible = false;
            await SelectProviderAsync(_selectedProviderId);
            MessageService.Success($"已添加模型 {key}");
        }
        catch (Exception ex)
        {
            MessageService.Error($"添加失败: {ex.Message}");
        }
        finally
        {
            _addingModel = false;
        }
    }

    private async Task ConfirmAddProvider()
    {
        if (string.IsNullOrWhiteSpace(_newProviderId)) return;
        var id = _newProviderId.Trim();

        var config = new ProviderConfig { Id = id, Type = _newProviderType, Name = id };
        await ProviderManager.SaveProviderAsync(id, config, _saveLevel);

        _addModalVisible = false;
        await SelectProviderAsync(id);
    }

    private static Dictionary<string, string>? ParseHeaders(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return null;

        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
                throw new InvalidOperationException("Headers 必须是 JSON 对象，例如 {\"Authorization\":\"Bearer ...\"}。");

            var headers = JsonSerializer.Deserialize<Dictionary<string, string>>(json);
            if (headers is null)
                throw new InvalidOperationException("Headers JSON 不能为空。");

            if (headers.Keys.Any(string.IsNullOrWhiteSpace))
                throw new InvalidOperationException("Headers 名称不能为空。");

            return headers;
        }
        catch (JsonException ex)
        {
            throw new InvalidOperationException("Headers 必须是有效的 JSON 对象。", ex);
        }
    }

    private Dictionary<string, string>? ParseHeaders()
        => ParseHeaders(_headersJson);

    private static string SerializeHeaders(IReadOnlyDictionary<string, string>? headers)
        => headers is null
            ? "{}"
            : JsonSerializer.Serialize(headers, new JsonSerializerOptions { WriteIndented = true });

    private static ProviderConfig CloneProviderConfig(ProviderConfig config) => new()
    {
        Id = config.Id,
        Type = config.Type,
        Name = config.Name,
        BaseUrl = config.BaseUrl,
        ApiKey = config.ApiKey,
        Proxy = config.Proxy,
        UseProxy = config.UseProxy,
        DefaultModel = config.DefaultModel,
        Timeout = config.Timeout,
        MaxRetries = config.MaxRetries,
        Models = config.Models is null ? null : new Dictionary<string, ModelConfig>(config.Models),
        Options = config.Options is null ? null : new Dictionary<string, object>(config.Options),
        Headers = config.Headers is null ? null : new Dictionary<string, string>(config.Headers)
    };

