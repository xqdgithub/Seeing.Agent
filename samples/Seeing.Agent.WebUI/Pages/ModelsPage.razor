    private async Task ConfirmAddModelAsync()
    {
        if (string.IsNullOrEmpty(_selectedProviderId))
        {
            MessageService.Warning("请先选择 Provider");
            return;
        }

        var modelId = (_addModelForm.Id ?? "").Trim();
        if (string.IsNullOrWhiteSpace(modelId))
        {
            MessageService.Warning("请填写模型 ID");
            return;
        }

        var key = ModelRef.Format(_selectedProviderId, modelId);
        var existing = ModelManager.GetModel(key);

        // 从列表选择：模型通常已存在（配置型目录即已配置模型），此时仅确保其启用。
        if (existing is not null)
        {
            if (_addModelMode == AddModelMode.FromList)
            {
                var ids = ModelManager.GetEnabledModelIds(_selectedProviderId).ToList();
                if (!ids.Contains(modelId, StringComparer.OrdinalIgnoreCase))
                {
                    ids.Add(modelId);
                    await ModelManager.SetEnabledModelsAsync(_selectedProviderId, ids);
                }

                _addModelVisible = false;
                RefreshModelRows();
                MessageService.Success($"已启用模型 {key}");
                return;
            }

            MessageService.Warning($"模型已存在: {key}");
            return;
        }

        _addingModel = true;
        try
        {
            var types = _addModelTypes?.ToList() ?? new List<ModelType>();
            if (types.Count == 0)
                types.Add(ModelType.Text);

            var name = string.IsNullOrWhiteSpace(_addModelForm.Name) ? modelId : _addModelForm.Name.Trim();

            // 扩展 Provider 不可写 Providers[*].Models：走用户覆盖层补录（目录中新增条目）。
            if (!CanEditCurrentProvider)
            {
                await ModelManager.UpsertModelOverrideAsync(
                    _selectedProviderId,
                    modelId,
                    new ModelOverride
                    {
                        Name = name,
                        Types = types,
                        ContextLimit = _addModelForm.Context > 0 ? _addModelForm.Context : null,
                        OutputLimit = _addModelForm.Output > 0 ? _addModelForm.Output : null
                    });
            }
            else
            {
                var config = new ModelConfig
                {
                    Id = modelId,
                    Name = name,
                    Provider = _selectedProviderId,
                    Types = types,
                    Limit = new ModelLimits
                    {
                        Context = _addModelForm.Context > 0 ? _addModelForm.Context : ModelLimitDefaults.Context,
                        Output = _addModelForm.Output > 0 ? _addModelForm.Output : ModelLimitDefaults.Output
                    }
                };

                await ModelManager.AddModelAsync(key, config, _saveLevel);
            }

            // 新增模型默认加入启用清单，避免添加后即被隐藏。
            var enabled = ModelManager.GetEnabledModelIds(_selectedProviderId).ToList();
            if (!enabled.Contains(modelId, StringComparer.OrdinalIgnoreCase))
            {
                enabled.Add(modelId);
                await ModelManager.SetEnabledModelsAsync(_selectedProviderId, enabled);
            }

            _addModelVisible = false;
            await SelectProviderAsync(_selectedProviderId);
            MessageService.Success($"已添加模型 {key}");
        }
        catch (Exception ex)
        {
            MessageService.Error($"添加失败: {ex.Message}");
        }
        finally
        {
            _addingModel = false;
        }
    }

    private async Task ConfirmAddProvider()
    {
        if (string.IsNullOrWhiteSpace(_newProviderId)) return;
        var id = _newProviderId.Trim();

        var config = new ProviderConfig { Id = id, Type = _newProviderType, Name = id };
        await ProviderManager.SaveProviderAsync(id, config, _saveLevel);

        _addModalVisible = false;
        await SelectProviderAsync(id);
    }

    private static Dictionary<string, string>? ParseHeaders(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return null;

        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
                throw new InvalidOperationException("Headers 必须是 JSON 对象，例如 {\"Authorization\":\"Bearer ...\"}。");

            var headers = JsonSerializer.Deserialize<Dictionary<string, string>>(json);
            if (headers is null)
                throw new InvalidOperationException("Headers JSON 不能为空。");

            if (headers.Keys.Any(string.IsNullOrWhiteSpace))
                throw new InvalidOperationException("Headers 名称不能为空。");

            return headers;
        }
        catch (JsonException ex)
        {
            throw new InvalidOperationException("Headers 必须是有效的 JSON 对象。", ex);
        }
    }

    private Dictionary<string, string>? ParseHeaders()
        => ParseHeaders(_headersJson);

    private static string SerializeHeaders(IReadOnlyDictionary<string, string>? headers)
        => headers is null
            ? "{}"
            : JsonSerializer.Serialize(headers, new JsonSerializerOptions { WriteIndented = true });

    private static ProviderConfig CloneProviderConfig(ProviderConfig config) => new()
    {
        Id = config.Id,
        Type = config.Type,
        Name = config.Name,
        BaseUrl = config.BaseUrl,
        ApiKey = config.ApiKey,
        Proxy = config.Proxy,
        UseProxy = config.UseProxy,
        // 硬编码字段克隆清单之一（Review Focus #5）：漏 capabilities / listModels 就等于保存一次抹掉配置
        Capabilities = config.Capabilities is null ? null : new List<string>(config.Capabilities),
        ListModels = config.ListModels,
        Timeout = config.Timeout,
        MaxRetries = config.MaxRetries,
        Models = config.Models is null ? null : new Dictionary<string, ModelConfig>(config.Models),
        Options = config.Options is null ? null : new Dictionary<string, object>(config.Options),
        Headers = config.Headers is null ? null : new Dictionary<string, string>(config.Headers)
    };

