    /// <summary>
    /// 快速选择：把已知档位加入表格（已存在则跳过）。
    /// <para>这里只做「填 code + 显示名」，不校验模型是否真的支持——真实可用档位以服务端为准，
    /// 写错会被 400 拒绝，所以不在这里臆断。</para>
    /// </summary>
    private void ApplyWellKnownLevel(ThinkingLevel known)
    {
        if (_editThinkingLevels.Any(row =>
                string.Equals(row.Key?.Trim(), known.Key, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        _editThinkingLevels.Add(new ThinkingLevelEditRow
        {
            RowId = Guid.NewGuid().ToString("N"),
            Key = known.Key,
            Label = known.Label
        });
    }

    /// <summary>
    /// 档位下拉候选：关闭档（若提供）+ 表格里非空 key（去重保序）。
    /// 关闭档排在首位，与 UI 上「关闭档」行在上保持一致。
    /// </summary>
    private IReadOnlyList<string> ThinkingLevelKeys
    {
        get
        {
            var keys = new List<string>();
            if (_editCloseLevelEnabled)
            {
                keys.Add(_editThinkingLevels
                    .Select(row => row.Key?.Trim() ?? "")
                    .FirstOrDefault(ThinkingEffortKeys.IsOff) ?? ThinkingEffortKeys.DisabledKey);
            }

            keys.AddRange(_editThinkingLevels
                .Select(row => row.Key?.Trim() ?? "")
                .Where(key => key.Length > 0 && !ThinkingEffortKeys.IsOff(key))
                .Distinct(StringComparer.OrdinalIgnoreCase));

            return keys;
        }
    }

    /// <summary>
    /// 组装要写入覆盖层的思考补丁。
    /// <para>跟随声明 → null；自定义 → <c>Supported=true</c> + 档位表（关闭档按开关决定是否包含）。
    /// 「模型默认关闭思考」= 关闭档在表内且 <c>Default</c> 指向它，<b>不是</b> <c>Supported=false</c>。</para>
    /// </summary>
    private ModelThinkingOverride? BuildThinkingOverride()
    {
        if (_editThinkingMode == ThinkingEditMode.Inherit)
            return null;

        var levels = new List<ThinkingLevel>();
        if (_editCloseLevelEnabled)
        {
            // 关闭档复用用户可能已改过的同一行（自定义模式下允许改 label），code 恒为 disabled。
            var existingClose = _editThinkingLevels
                .FirstOrDefault(row => ThinkingEffortKeys.IsOff(row.Key?.Trim()));
            levels.Add(new ThinkingLevel
            {
                Key = ThinkingEffortKeys.DisabledKey,
                Label = string.IsNullOrWhiteSpace(existingClose?.Label)
                    ? ThinkingEffortKeys.DisabledLabel
                    : existingClose!.Label!.Trim(),
                BudgetTokens = ResolveBudget(ThinkingEffortKeys.DisabledKey)
            });
        }

        foreach (var row in _editThinkingLevels)
        {
            var key = row.Key?.Trim() ?? "";
            // 关闭档已单独生成；空 key 行丢弃。
            if (key.Length == 0 || ThinkingEffortKeys.IsOff(key))
                continue;

            levels.Add(new ThinkingLevel
            {
                Key = key,
                Label = string.IsNullOrWhiteSpace(row.Label) ? null : row.Label.Trim(),
                BudgetTokens = ResolveBudget(key)
            });
        }

        // 同 key 去重（关闭档已排除，剩下是用户自填项）。
        var deduped = levels
            .GroupBy(level => level.Key, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();

        var defaultKey = _editThinkingDefault?.Trim();
        if (string.IsNullOrEmpty(defaultKey)
            || !deduped.Any(level => string.Equals(level.Key, defaultKey, StringComparison.OrdinalIgnoreCase)))
        {
            defaultKey = null;
        }

        return new ModelThinkingOverride
        {
            Supported = true,
            Default = defaultKey,
            Interleaved = string.IsNullOrWhiteSpace(_editThinkingInterleaved) ? null : _editThinkingInterleaved.Trim(),
            Levels = deduped.Count > 0 ? deduped : null
        };
    }

    /// <summary>
    /// 档位预算按 key 继承：弹窗不暴露 budgetTokens，但不能因为它不在表单里就把它丢掉。
    /// </summary>
    private int? ResolveBudget(string key)
        => _editThinkingBudgets.TryGetValue(key, out var budget) ? budget : null;

    /// <summary>
    /// 保存编辑：写入用户级覆盖层（仅持久化与基线不同的字段），配置型与扩展 Provider 统一路径。
    /// </summary>
    private async Task SaveEditModelAsync()
    {
        var providerId = _selectedProviderId;
        var modelId = ExtractModelId(_editKey, providerId);
        if (string.IsNullOrEmpty(providerId) || string.IsNullOrEmpty(modelId))
        {
            MessageService.Error("模型标识无效");
            return;
        }

        // 声明支持思考但表里一个档位都没有 = 无效声明（UI 上不会出现选择器），挡住不让保存。
        if (_editThinkingMode != ThinkingEditMode.Inherit
            && !_editCloseLevelEnabled
            && _editThinkingLevels.All(row => string.IsNullOrWhiteSpace(row.Key)))
        {
            MessageService.Warning("请至少添加一个档位（或开启关闭档），否则思考声明不会生效");
            return;
        }

        _savingEditModel = true;
        try
        {
            var desired = new ModelOverride
            {
                Name = string.IsNullOrWhiteSpace(_editModelForm.Name) ? null : _editModelForm.Name.Trim(),
                Types = _editTypes?.ToList() ?? new List<ModelType>(),
                ContextLimit = _editModelForm.Context > 0 ? _editModelForm.Context : null,
                OutputLimit = _editModelForm.Output > 0 ? _editModelForm.Output : null,
                InputModalities = _editInputModalities?.ToList(),
                OutputModalities = _editOutputModalities?.ToList(),
                // 免费标记不在编辑弹窗里：它由模型目录/Provider 声明，用户覆盖不该把它当成可编辑项。
                // 这里必须保持 null（= 不参与覆盖），否则会把声明值固化成 false。
                Thinking = BuildThinkingOverride()
            };

            await ModelManager.UpsertModelOverrideAsync(providerId, modelId, desired);
            _editModelVisible = false;
            RefreshModelRows();
            MessageService.Success("模型元数据已保存（用户覆盖）");
        }
        catch (Exception ex)
        {
            MessageService.Error($"保存失败：{ex.Message}");
        }
        finally
        {
            _savingEditModel = false;
        }
    }

    /// <summary>移除用户覆盖，恢复默认元数据。</summary>
