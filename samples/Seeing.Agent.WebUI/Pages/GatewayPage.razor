@using AntDesign
@using Seeing.Agent.Gateway.Configuration
@using Seeing.Agent.Core.Configuration
@using Seeing.Agent.Configuration
@using Seeing.Agent.Gateway.Hosting
@using Seeing.Agent.WebUI.Components
@using Seeing.Agent.WebUI.Services
@inject SeeingConfigService ConfigService
@inject IMessageService MessageService
@inject IGatewayServer GatewayServer

<PageTitle>Gateway · Seeing</PageTitle>

<WorkspacePageShell Loading="@_loading">
    <Breadcrumb>
        <BreadcrumbItem>设置</BreadcrumbItem>
        <BreadcrumbItem>Gateway</BreadcrumbItem>
    </Breadcrumb>
    <Extra>
        <Space>
            <ConfigLevelSelector @bind-Value="_saveLevel" SectionName="Gateway" />
            <Button Icon="@IconType.Outline.Reload" Loading="@_refreshing" OnClick="RefreshAsync">刷新</Button>
            <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Save" OnClick="SaveAsync">保存配置</Button>
        </Space>
    </Extra>
    <Stats>
        <div class="stat-item">
            <div class="stat-icon"><Badge Status="@(_healthy ? BadgeStatus.Success : BadgeStatus.Error)" /></div>
            <div class="stat-content">
                <span class="stat-value">@(_healthy ? "在线" : "离线")</span>
                <span class="stat-label">服务状态</span>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon"><Icon Type="@IconType.Outline.Global" /></div>
            <div class="stat-content">
                <span class="stat-value">@($"{_gateway.BindAddress}:{_gateway.Port}")</span>
                <span class="stat-label">监听地址</span>
            </div>
        </div>
    </Stats>
    <ChildContent>
        <Row Gutter="16">
            <Col Span="12">
                <Card Title="Gateway 配置">
                    @* 六项都是短字段，双列排布让整卡高度减半——下方通联目录才是本页主体，
                       配置区不该占掉首屏。 *@
                    <Form Layout="@FormLayout.Vertical" Model="@_gateway" Context="formContext">
                    <div>
                        <Row Gutter="16">
                            <Col Span="12">
                                <FormItem Label="启用"><Switch @bind-Checked="@_gateway.Enabled" /></FormItem>
                            </Col>
                            <Col Span="12">
                                <FormItem Label="自动启动"><Switch @bind-Checked="@_gateway.AutoStart" /></FormItem>
                            </Col>
                            <Col Span="12">
                                <FormItem Label="端口">
                                    <InputNumber @bind-Value="@_gateway.Port" Min="1" Max="65535" Style="width: 100%;" />
                                </FormItem>
                            </Col>
                            <Col Span="12">
                                <FormItem Label="绑定地址"><Input @bind-Value="@_gateway.BindAddress" /></FormItem>
                            </Col>
                            <Col Span="12">
                                <FormItem Label="启用 WebSocket"><Switch @bind-Checked="@_gateway.EnableWebSocket" /></FormItem>
                            </Col>
                            <Col Span="12">
                                <FormItem Label="WebSocket 路径"><Input @bind-Value="@_gateway.WebSocketPath" /></FormItem>
                            </Col>
                        </Row>
                    </div>
                    </Form>
                    <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 4px; padding: 4px 12px;"
                           Message="Gateway 权限模式请前往「安全」页面配置。" />
                </Card>
            </Col>
            <Col Span="12">
                <Card Title="API 端点">
                    @* 双列：五项压成三行，与左侧配置卡高度接近，避免整行被这一侧撑高。 *@
                    <Descriptions Column="2" Bordered Size="@DescriptionsSize.Small">
                        <DescriptionsItem Title="健康检查">GET /api/gateway/health</DescriptionsItem>
                        <DescriptionsItem Title="流式对话">POST /api/gateway/chat</DescriptionsItem>
                        <DescriptionsItem Title="停止对话">POST /api/gateway/chat/stop</DescriptionsItem>
                        <DescriptionsItem Title="待审批权限">GET /api/gateway/permissions/pending</DescriptionsItem>
                        <DescriptionsItem Title="WebSocket" Span="2">@_gateway.WebSocketPath</DescriptionsItem>
                    </Descriptions>
                    @* 健康检查失败时才展示详情：成功状态已由上方 Stats 表达，重复一遍只是噪音。 *@
                    @if (!_healthy && !string.IsNullOrEmpty(_healthMessage))
                    {
                        <Alert Type="@AlertType.Error" Message="@_healthMessage" ShowIcon="true"
                               Style="margin-top: 8px; padding: 4px 12px;" />
                    }
                    <Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-top: 8px; padding: 4px 12px;"
                           Message="修改端口或绑定地址后可能需要重启应用才能生效。" />
                </Card>
            </Col>
        </Row>

        @* 通联目录：QQ / WeCom 等渠道的对话与用户登记表。
           数据由渠道消息入站时经 IChannelDirectory.AdmitInbound 准入并写入
           {项目}/.seeing/comms/directory.json（工作区未选定时回退 ~/.seeing/comms/directory.json）。
           页面「刷新」按钮通过 RefreshVersion 触发它重读目录。 *@
        <Card Title="通联目录" Style="margin-top: 12px;">
            <ChannelDirectoryManager RefreshVersion="_directoryRefreshVersion" />
        </Card>
    </ChildContent>
</WorkspacePageShell>

@code {
    private GatewayOptions _gateway = new();
    private GatewayOptions _originalGateway = new();
    private ConfigLevel _saveLevel = ConfigLevel.Project;
    private bool _loading;
    private bool _healthy;
    private bool _refreshing;
    private string? _healthMessage;

    /// <summary>通联目录刷新信号：自增即让子组件重读目录。</summary>
    private int _directoryRefreshVersion;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await CheckHealth();
    }

    /// <summary>
    /// 刷新：重读配置 + 重探健康状态 + 让通联目录重读目录。
    /// 用一个按钮覆盖「页面上的数据重新拉一遍」，避免用户猜哪个块该按哪个键。
    /// </summary>
    private async Task RefreshAsync()
    {
        _refreshing = true;
        try
        {
            await LoadAsync();
            await CheckHealth();

            // 让通联目录重读：只靠 RefreshVersion 一个入口，避免同一次点击触发两轮加载。
            _directoryRefreshVersion++;

            MessageService.Success("已刷新");
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _gateway = await ConfigService.LoadGatewayAtLevelAsync(ConfigLevel.Project);
            _originalGateway = new GatewayOptions
            {
                Enabled = _gateway.Enabled,
                AutoStart = _gateway.AutoStart,
                Port = _gateway.Port,
                BindAddress = _gateway.BindAddress,
                PermissionMode = _gateway.PermissionMode,
                EnableWebSocket = _gateway.EnableWebSocket,
                WebSocketPath = _gateway.WebSocketPath
            };
        }
        catch (Exception ex)
        {
            // 配置读取失败（如工作区未选定：Gateway 节是 ProjectOnly）不能让 _loading 永久为 true——
            // 那会让 WorkspacePageShell 只渲染 spinner，整页内容（含下方通联目录）全部不可见。
            MessageService.Warning($"读取 Gateway 配置失败：{ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        await ConfigService.SaveLevelSectionsAsync(_saveLevel, new Dictionary<string, object?> { ["Gateway"] = _gateway });

        if (_gateway.Enabled && !_originalGateway.Enabled)
        {
            try
            {
                await GatewayServer.StartAsync();
                MessageService.Success("Gateway 服务已启动");
            }
            catch (Exception ex)
            {
                MessageService.Error($"启动 Gateway 服务失败：{ex.Message}");
            }
        }
        else if (!_gateway.Enabled && _originalGateway.Enabled)
        {
            try
            {
                await GatewayServer.StopAsync();
                MessageService.Info("Gateway 服务已停止");
            }
            catch (Exception ex)
            {
                MessageService.Error($"停止 Gateway 服务失败：{ex.Message}");
            }
        }

        _originalGateway = new GatewayOptions
        {
            Enabled = _gateway.Enabled,
            AutoStart = _gateway.AutoStart,
            Port = _gateway.Port,
            BindAddress = _gateway.BindAddress,
            PermissionMode = _gateway.PermissionMode,
            EnableWebSocket = _gateway.EnableWebSocket,
            WebSocketPath = _gateway.WebSocketPath
        };

        MessageService.Success("Gateway 配置已保存");
        await CheckHealth();
    }

    private async Task CheckHealth()
    {
        try
        {
            using var client = new HttpClient { Timeout = TimeSpan.FromSeconds(3) };
            var url = $"http://{_gateway.BindAddress}:{_gateway.Port}/api/gateway/health";
            var response = await client.GetAsync(url);
            _healthy = response.IsSuccessStatusCode;
            _healthMessage = _healthy ? $"健康检查成功: {url}" : $"健康检查失败 ({(int)response.StatusCode})";
        }
        catch (Exception ex)
        {
            _healthy = false;
            _healthMessage = $"无法连接: {ex.Message}";
        }
    }
}