@using AntDesign
@using Seeing.Agent.Abstractions.Configuration
@using Seeing.Agent.Reflection.Abstractions
@using Seeing.Agent.Reflection.Core
@using Seeing.Agent.Reflection.Ui
@using Seeing.Agent.WebUI.Services
@using Seeing.Session.Core
@inject ReflectionRunReader Reader
@inject ReflectionRunOperations Operations
@inject IReflectionStatus? Status
@inject ISessionManager? Sessions
@inject IMessageService MessageService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>复盘记录 · Seeing</PageTitle>

<WorkspacePageShell Loading="@_loading" IsEmpty="@(_runs.Count == 0 && !_loading && _active.Count == 0)">
    <Breadcrumb>
        <BreadcrumbItem>工作区</BreadcrumbItem>
        <BreadcrumbItem>复盘记录</BreadcrumbItem>
    </Breadcrumb>
    <Extra>
        <Space>
            <Button Icon="@IconType.Outline.Setting" OnClick="@(() => Navigation.NavigateTo("/settings"))">复盘设置</Button>
            <Button Icon="@IconType.Outline.Reload" OnClick="ReloadAllAsync">刷新</Button>
        </Space>
    </Extra>
    <ChildContent>
        @* ── 正在复盘 / 排队中 ── *@
        @if (_active.Count > 0)
        {
            <Card Title="@($"正在进行（{_active.Count}）")" Size="@CardSize.Small" Style="margin-bottom: 16px;">
                <div class="reflection-hint">
                    复盘在后台隔离子会话中运行，完成后会出现在下方列表；排队中的请求每分钟处理一批。
                </div>
                <table class="items-table">
                    <thead>
                        <tr>
                            <th style="width: 110px;">状态</th>
                            <th>会话</th>
                            <th style="width: 90px;">触发</th>
                            <th style="width: 130px;">等待</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _active)
                        {
                            <tr @key="@($"{item.Request.SessionId}:{item.Request.At:O}")">
                                <td>
                                    <Tag Color="@(item.Running ? "processing" : "default")">
                                        @(item.Running ? "复盘中" : "排队中")
                                    </Tag>
                                </td>
                                <td>@item.DisplayTitle</td>
                                <td>@UiText.ReflectionTriggerText(item.Request.Kind)</td>
                                <td>@FormatWaited(item.Request.At)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Card>
        }

        @if (_runs.Count == 0)
        {
            <Empty Description="@EmptyDescription" />
        }
        else
        {
            @* ── 统计：四个数字排成一行（用既有 page-stats 体系，不再各占一张 Card） ── *@
            <div class="page-stats">
                <div class="stat-item">
                    <div class="stat-icon"><Icon Type="@IconType.Outline.FileText" /></div>
                    <div class="stat-content">
                        <div class="stat-value">@_runs.Count</div>
                        <div class="stat-label">记录总数</div>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon"><Icon Type="@IconType.Outline.CloseCircle" /></div>
                    <div class="stat-content">
                        <div class="stat-value">@_runs.Count(x => x.IsFailure)</div>
                        <div class="stat-label">失败数</div>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon"><Icon Type="@IconType.Outline.Bulb" /></div>
                    <div class="stat-content">
                        <div class="stat-value">@_runs.Sum(x => x.Suggestions.Count)</div>
                        <div class="stat-label">产出建议</div>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon"><Icon Type="@IconType.Outline.Star" /></div>
                    <div class="stat-content">
                        <div class="stat-value">@_runs.Sum(x => x.CreatedSkills.Count)</div>
                        <div class="stat-label">创建技能</div>
                    </div>
                </div>
            </div>

            @* ── 筛选栏 ── *@
            <div class="page-filters">
                <div class="filter-search">
                    <Input @bind-Value="_searchText" Placeholder="搜索会话标题 / ID / 执行 ID……"
                           AllowClear="true"
                           OnChange="@((string _) => OnFilterChanged())" />
                </div>

                <div class="filter-group">
                    <span class="filter-label">触发</span>
                    <Select TItemValue="ReflectionTriggerFilter" TItem="ReflectionTriggerFilter"
                            Value="@_triggerFilter"
                            ValueChanged="@(v => { _triggerFilter = v; OnFilterChanged(); })"
                            Style="width: 120px;">
                        <SelectOption TItemValue="ReflectionTriggerFilter" TItem="ReflectionTriggerFilter" Value="ReflectionTriggerFilter.All" Label="全部" />
                        <SelectOption TItemValue="ReflectionTriggerFilter" TItem="ReflectionTriggerFilter" Value="ReflectionTriggerFilter.TurnNudge" Label="轮次" />
                        <SelectOption TItemValue="ReflectionTriggerFilter" TItem="ReflectionTriggerFilter" Value="ReflectionTriggerFilter.Idle" Label="空闲" />
                        <SelectOption TItemValue="ReflectionTriggerFilter" TItem="ReflectionTriggerFilter" Value="ReflectionTriggerFilter.Manual" Label="手动" />
                    </Select>
                </div>

                <div class="filter-group">
                    <span class="filter-label">结果</span>
                    <Select TItemValue="ReflectionOutcomeFilter" TItem="ReflectionOutcomeFilter"
                            Value="@_outcomeFilter"
                            ValueChanged="@(v => { _outcomeFilter = v; OnFilterChanged(); })"
                            Style="width: 140px;">
                        <SelectOption TItemValue="ReflectionOutcomeFilter" TItem="ReflectionOutcomeFilter" Value="ReflectionOutcomeFilter.All" Label="全部" />
                        <SelectOption TItemValue="ReflectionOutcomeFilter" TItem="ReflectionOutcomeFilter" Value="ReflectionOutcomeFilter.WithSuggestions" Label="有建议" />
                        <SelectOption TItemValue="ReflectionOutcomeFilter" TItem="ReflectionOutcomeFilter" Value="ReflectionOutcomeFilter.CreatedSkills" Label="已建技能" />
                        <SelectOption TItemValue="ReflectionOutcomeFilter" TItem="ReflectionOutcomeFilter" Value="ReflectionOutcomeFilter.FailuresOnly" Label="仅失败" />
                    </Select>
                </div>

                <div class="filter-group">
                    <span class="filter-label">时间</span>
                    <Select TItemValue="ReflectionRangeFilter" TItem="ReflectionRangeFilter"
                            Value="@_rangeFilter"
                            ValueChanged="@(v => { _rangeFilter = v; OnFilterChanged(); })"
                            Style="width: 130px;">
                        <SelectOption TItemValue="ReflectionRangeFilter" TItem="ReflectionRangeFilter" Value="ReflectionRangeFilter.All" Label="全部" />
                        <SelectOption TItemValue="ReflectionRangeFilter" TItem="ReflectionRangeFilter" Value="ReflectionRangeFilter.Today" Label="今天" />
                        <SelectOption TItemValue="ReflectionRangeFilter" TItem="ReflectionRangeFilter" Value="ReflectionRangeFilter.Last7Days" Label="最近 7 天" />
                        <SelectOption TItemValue="ReflectionRangeFilter" TItem="ReflectionRangeFilter" Value="ReflectionRangeFilter.Last30Days" Label="最近 30 天" />
                    </Select>
                </div>

                @if (HasActiveFilters)
                {
                    <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="ResetFilters">清除筛选</Button>
                }

                <span class="filter-count">@Filtered.Count() / @_runs.Count 条</span>
            </div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th class="sortable" @onclick="@(() => SortBy(ReflectionSortKey.Time))">
                            时间 @SortArrow(ReflectionSortKey.Time)
                        </th>
                        <th style="width: 90px;">触发</th>
                        <th style="width: 150px;">结果</th>
                        <th class="sortable" style="width: 80px;" @onclick="@(() => SortBy(ReflectionSortKey.Suggestions))">
                            建议 @SortArrow(ReflectionSortKey.Suggestions)
                        </th>
                        <th class="sortable" style="width: 80px;" @onclick="@(() => SortBy(ReflectionSortKey.Skills))">
                            技能 @SortArrow(ReflectionSortKey.Skills)
                        </th>
                        <th class="sortable" style="width: 110px;" @onclick="@(() => SortBy(ReflectionSortKey.Tokens))">
                            Token 用量 @SortArrow(ReflectionSortKey.Tokens)
                        </th>
                        <th>模型</th>
                        <th style="width: 130px;">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtered.Count() == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: #999; padding: 32px;">
                                没有匹配当前筛选条件的记录。
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var run in Filtered)
                        {
                            <tr @key="run.FilePath">
                                <td>@run.At.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                <td>@UiText.ReflectionTriggerText(run.Kind)</td>
                                <td><Tag Color="@OutcomeColor(run)">@UiText.ReflectionOutcomeText(run.Outcome)</Tag></td>
                                <td>@(run.Suggestions.Count > 0 ? run.Suggestions.Count.ToString() : "-")</td>
                                <td>@(run.CreatedSkills.Count > 0 ? run.CreatedSkills.Count.ToString() : "-")</td>
                                <td>@(run.TotalTokens > 0 ? run.TotalTokens.ToString() : "-")</td>
                                <td>@(run.ModelId ?? "沿用源会话")</td>
                                <td>
                                    <Space Size="@("small")">
                                        <Button Type="@ButtonType.Link" Size="@ButtonSize.Small"
                                                OnClick="@(() => ToggleDetail(run))">
                                            @(ReferenceEquals(_detail, run) ? "收起" : "查看")
                                        </Button>
                                        <Popconfirm Title="@("确定删除这条复盘记录？")"
                                                    OnConfirm="@(() => DeleteAsync(run))"
                                                    OkText="删除" CancelText="取消">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Danger="true">
                                                删除
                                            </Button>
                                        </Popconfirm>
                                    </Space>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            @if (_detail is not null)
            {
                <Divider />
                <Card Title="@($"复盘详情 · {_detail.ExecutionId}")">
                    <Descriptions Bordered Column="2" Size="@DescriptionsSize.Small">
                        <DescriptionsItem Title="源会话">
                            <a href="@($"/session/{_detail.SessionId}")">@SessionTitle(_detail.SessionId)</a>
                        </DescriptionsItem>
                        <DescriptionsItem Title="触发方式">@UiText.ReflectionTriggerText(_detail.Kind)</DescriptionsItem>
                        <DescriptionsItem Title="结果">@UiText.ReflectionOutcomeText(_detail.Outcome)</DescriptionsItem>
                        <DescriptionsItem Title="模型">@(_detail.ModelId ?? "沿用源会话")</DescriptionsItem>
                        <DescriptionsItem Title="Token 用量">
                            @($"{_detail.InputTokens} 输入 / {_detail.OutputTokens} 输出")
                        </DescriptionsItem>
                        <DescriptionsItem Title="记录时间">
                            @_detail.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                        </DescriptionsItem>
                        <DescriptionsItem Title="记录文件" Span="2">@_detail.FilePath</DescriptionsItem>
                    </Descriptions>

                    @if (!string.IsNullOrWhiteSpace(_detail.Detail))
                    {
                        <Divider>失败详情</Divider>
                        <pre style="white-space: pre-wrap; font-size: 12px;">@_detail.Detail</pre>
                    }

                    @if (_detail.Suggestions.Count > 0)
                    {
                        <Divider>建议清单</Divider>
                        <div class="reflection-hint">
                            点「生成 SKILL」会打开编辑弹窗：可改名称、级别、描述与正文后再保存。
                            这是显式动作，<b>不受「运行模式」限制</b>；默认写项目级。
                            技能名须为小写字母、数字与连字符（如 <code>my-skill</code>）。
                        </div>
                        @for (var i = 0; i < _detail.Suggestions.Count; i++)
                        {
                            var index = i;
                            var suggestion = _detail.Suggestions[i];
                            <Card Style="margin-bottom: 12px;" Size="@CardSize.Small">
                                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
                                    <div style="font-weight: 600;">@suggestion.Target</div>
                                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small"
                                            Disabled="@(_creatingIndex is not null || _skillModalVisible)"
                                            OnClick="@(() => OpenCreateSkillModal(index))">
                                        生成 SKILL
                                    </Button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(suggestion.Description))
                                {
                                    <div style="font-size: 12px; color: #666; margin: 4px 0;">
                                        <span style="color: #999;">描述：</span>@suggestion.Description
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(suggestion.Reason))
                                {
                                    <div style="font-size: 12px; color: #999; margin: 4px 0;">
                                        备注：@suggestion.Reason
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(suggestion.SuggestedContent))
                                {
                                    <pre style="white-space: pre-wrap; font-size: 12px; margin: 8px 0 0;">@suggestion.SuggestedContent</pre>
                                }
                                <div style="font-size: 12px; color: #999; margin-top: 8px;">
                                    依据：@string.Join("；", suggestion.Evidence)
                                </div>
                            </Card>
                        }
                    }

                    @if (_detail.CreatedSkills.Count > 0)
                    {
                        <Divider>本次写入的技能</Divider>
                        @foreach (var skill in _detail.CreatedSkills)
                        {
                            <Tag Color="@("blue")">@skill</Tag>
                        }
                    }
                </Card>
            }
        }
    </ChildContent>
</WorkspacePageShell>

<Modal @bind-Visible="_skillModalVisible"
       Title="@("生成 SKILL")"
       Width="720"
       OnOk="ConfirmCreateSkillAsync"
       OkText="@("保存")"
       CancelText="@("取消")"
       ConfirmLoading="@(_creatingIndex is not null)"
       DestroyOnClose="true">
    <div style="margin-bottom: 16px;">
        <label style="font-weight: 500; display: block; margin-bottom: 8px;">技能名称 <span style="color: red;">*</span></label>
        <Input @bind-Value="_draftName"
               Placeholder="如 build-before-edit，仅小写字母、数字与连字符"
               OnChange="@((string _) => ValidateDraftName())" />
        @if (!string.IsNullOrEmpty(_draftNameError))
        {
            <div style="color: #cf1322; font-size: 12px; margin-top: 4px;">@_draftNameError</div>
        }
    </div>
    <div style="margin-bottom: 16px;">
        <label style="font-weight: 500; display: block; margin-bottom: 8px;">存储级别 <span style="color: red;">*</span></label>
        <RadioGroup TValue="string" @bind-Value="_draftLevel" ButtonStyle="@RadioButtonStyle.Solid">
            <Radio Value="@("project")">项目级（.seeing/skills）</Radio>
            <Radio Value="@("user")">用户级（~/.seeing/skills）</Radio>
        </RadioGroup>
    </div>
    <div style="margin-bottom: 16px;">
        <label style="font-weight: 500; display: block; margin-bottom: 8px;">描述 <span style="color: red;">*</span></label>
        <TextArea Rows="2" @bind-Value="_draftDescription"
                  Placeholder="Agent 选型用：何时用 / 做什么（勿写会话回顾）" />
        <div style="font-size: 12px; color: #999; margin-top: 4px;">
            写入 SKILL.md 的 description，供 Agent 决定是否加载；不要写「本会话中…」这类备注。
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_draftNotes))
    {
        <div style="margin-bottom: 16px;">
            <label style="font-weight: 500; display: block; margin-bottom: 8px;">备注</label>
            <div style="font-size: 12px; color: #666; white-space: pre-wrap;">@_draftNotes</div>
        </div>
    }
    <div style="margin-bottom: 8px;">
        <label style="font-weight: 500; display: block; margin-bottom: 8px;">正文 <span style="color: red;">*</span></label>
        <TextArea Rows="10" @bind-Value="_draftContent" Placeholder="步骤化祈使句正文" />
    </div>
</Modal>

@code {
    private const int MaxRuns = 200;

    /// <summary>「在复盘中」的刷新间隔：复盘是分钟级任务，3 秒足够及时又不至于打爆 circuit。</summary>
    private static readonly TimeSpan s_activePollInterval = TimeSpan.FromSeconds(3);

    private IReadOnlyList<ReflectionRunSummary> _runs = Array.Empty<ReflectionRunSummary>();
    private IReadOnlyList<ActiveItem> _active = [];
    private ReflectionRunSummary? _detail;
    private bool _loading = true;
    private int? _creatingIndex;
    private Timer? _activePoll;

    // ── 生成 SKILL 弹窗 ──
    private bool _skillModalVisible;
    private int _draftSuggestionIndex = -1;
    private string _draftName = string.Empty;
    private string _draftDescription = string.Empty;
    private string _draftNotes = string.Empty;
    private string _draftContent = string.Empty;
    private string _draftLevel = "project";
    private string? _draftNameError;

    // ── 筛选状态 ──
    private string _searchText = string.Empty;
    private ReflectionTriggerFilter _triggerFilter = ReflectionTriggerFilter.All;
    private ReflectionOutcomeFilter _outcomeFilter = ReflectionOutcomeFilter.All;
    private ReflectionRangeFilter _rangeFilter = ReflectionRangeFilter.All;

    // ── 排序状态 ──
    private ReflectionSortKey _sortKey = ReflectionSortKey.Time;
    private bool _sortDescending = true;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText)
        || _triggerFilter != ReflectionTriggerFilter.All
        || _outcomeFilter != ReflectionOutcomeFilter.All
        || _rangeFilter != ReflectionRangeFilter.All;

    /// <summary>经过筛选与排序的展示集合（判定逻辑在 <see cref="ReflectionRunFilter"/>，便于单测）。</summary>
    private IReadOnlyList<ReflectionRunSummary> Filtered => ReflectionRunFilter.Apply(
        _runs,
        _searchText,
        _triggerFilter,
        _outcomeFilter,
        _rangeFilter,
        _sortKey,
        _sortDescending,
        SessionTitle);

    private string EmptyDescription =>
        "还没有复盘记录。复盘默认关闭：到「系统设置 → 复盘」开启（或在那里点「立即复盘」手动跑一次），"
        + "之后每逢会话收尾或空闲时会自动复盘，结论记录在这里。";

    protected override async Task OnInitializedAsync()
    {
        RefreshActive();
        await LoadAsync();

        // 只轮询「在复盘中」：它是唯一会自己变化的部分。记录列表是终态产物，靠刷新按钮即可——
        // 全页定时重载会让用户正在展开的详情被反复重置。
        _activePoll = new Timer(_ => _ = InvokeAsync(() =>
        {
            RefreshActive();
            StateHasChanged();
        }), null, s_activePollInterval, s_activePollInterval);
    }

    public void Dispose() => _activePoll?.Dispose();

    /// <summary>
    /// 从运行态端口取「排队 + 执行中」。
    /// <para>失败时清空而不是抛：状态是展示用事实，读不到时页面应照常显示历史记录。</para>
    /// </summary>
    private void RefreshActive()
    {
        try
        {
            if (Status is null)
            {
                _active = [];
                return;
            }

            var items = new List<ActiveItem>(Status.Queued.Count + 1);

            // 顺序刻意「执行中在前」：用户最想知道「现在在跑哪一个」。
            if (Status.Running is { } running)
                items.Add(new ActiveItem(running, true, SessionTitle(running.SessionId)));

            foreach (var queued in Status.Queued)
                items.Add(new ActiveItem(queued, false, SessionTitle(queued.SessionId)));

            _active = items;
        }
        catch
        {
            _active = [];
        }
    }

    /// <summary>
    /// 会话标题：内存里查得到就用标题，查不到退回 ID。
    /// <para>
    /// 不冷加载会话（那会为一次展示付出整盘读）：用户真正关心的是「哪个会话」，
    /// ID 已足够定位，且它本身就能点进会话页。
    /// </para>
    /// </summary>
    private string SessionTitle(string sessionId)
        => Sessions?.Get(sessionId)?.Title is { Length: > 0 } title ? title : sessionId;

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _runs = await Reader.ListAsync(MaxRuns);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAllAsync()
    {
        RefreshActive();
        await LoadAsync();
    }

    private void OnFilterChanged() => _detail = null;

    private void ResetFilters()
    {
        _searchText = string.Empty;
        _triggerFilter = ReflectionTriggerFilter.All;
        _outcomeFilter = ReflectionOutcomeFilter.All;
        _rangeFilter = ReflectionRangeFilter.All;
        _detail = null;
    }

    /// <summary>点同一列表头切换升降序；换列时默认降序（时间/数量都更关心「最大那批」）。</summary>
    private void SortBy(ReflectionSortKey key)
    {
        if (_sortKey == key)
            _sortDescending = !_sortDescending;
        else
        {
            _sortKey = key;
            _sortDescending = true;
        }
    }

    /// <summary>排序指示箭头：只标当前排序列，避免每列表头都挂一个灰箭头造成噪声。</summary>
    private RenderFragment SortArrow(ReflectionSortKey key) => builder =>
    {
        if (_sortKey != key)
            return;

        builder.AddContent(0, _sortDescending ? " ↓" : " ↑");
    };

    /// <summary>再点一次同一行则收起：列表页空间有限，详情是可选的展开层。</summary>
    private void ToggleDetail(ReflectionRunSummary run)
        => _detail = ReferenceEquals(_detail, run) ? null : run;

    private async Task DeleteAsync(ReflectionRunSummary run)
    {
        try
        {
            var result = await Operations.DeleteAsync(run.RunId);
            if (!result.Success)
            {
                MessageService.Error($"删除失败：{result.Error}");
                return;
            }

            if (ReferenceEquals(_detail, run))
                _detail = null;

            MessageService.Success($"已删除（{result.DeletedFiles} 个文件）");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            MessageService.Error($"删除失败：{ex.Message}");
        }
    }

    /// <summary>打开生成弹窗：预填建议字段；不合规名称会立刻标红，保存前须改对。</summary>
    private void OpenCreateSkillModal(int suggestionIndex)
    {
        if (_detail is null || suggestionIndex < 0 || suggestionIndex >= _detail.Suggestions.Count)
            return;

        var suggestion = _detail.Suggestions[suggestionIndex];
        _draftSuggestionIndex = suggestionIndex;
        _draftName = suggestion.Target?.Trim() ?? string.Empty;
        // 描述只取 description：旧记录可能只有 reason（备注），不得再把备注预填成技能描述。
        _draftDescription = suggestion.Description?.Trim() ?? string.Empty;
        _draftNotes = suggestion.Reason?.Trim() ?? string.Empty;
        _draftContent = suggestion.SuggestedContent?.Trim() ?? string.Empty;
        _draftLevel = "project";
        _draftNameError = ReflectionSuggestionsWriter.TryValidateSkillName(_draftName, out var error)
            ? null
            : error;
        _skillModalVisible = true;
    }

    private void ValidateDraftName()
    {
        _draftNameError = ReflectionSuggestionsWriter.TryValidateSkillName(_draftName, out var error)
            ? null
            : error;
    }

    /// <summary>
    /// 确认落盘：本地先校验名称，再经 Operations 写入（级别默认项目级，可改用户级）。
    /// 失败时保持弹窗打开，与 MCP 配置弹窗同一口径。
    /// </summary>
    private async Task ConfirmCreateSkillAsync()
    {
        if (_detail is null || _creatingIndex is not null)
            return;

        if (!ReflectionSuggestionsWriter.TryValidateSkillName(_draftName, out var nameError))
        {
            _draftNameError = nameError;
            _skillModalVisible = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(_draftDescription))
        {
            MessageService.Warning("请填写描述");
            _skillModalVisible = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(_draftContent))
        {
            MessageService.Warning("请填写正文");
            _skillModalVisible = true;
            return;
        }

        var level = string.Equals(_draftLevel, "user", StringComparison.OrdinalIgnoreCase)
            ? ConfigLevel.User
            : ConfigLevel.Project;

        _creatingIndex = _draftSuggestionIndex;
        _draftNameError = null;
        try
        {
            var draft = new ReflectionSkillDraft(
                _draftName.Trim(),
                _draftDescription.Trim(),
                _draftContent.Trim());

            var result = await Operations.CreateSkillAsync(
                _detail.RunId,
                _draftSuggestionIndex,
                level,
                draft);

            if (!result.Success)
            {
                MessageService.Warning(result.Error ?? "生成失败");
                _skillModalVisible = true;
                return;
            }

            var levelLabel = level == ConfigLevel.User ? "用户级" : "项目级";
            MessageService.Success($"技能「{result.SkillName}」已写入{levelLabel}，可在「技能」页查看");
            _skillModalVisible = false;
        }
        catch (Exception ex)
        {
            MessageService.Error($"生成失败：{ex.Message}");
            _skillModalVisible = true;
        }
        finally
        {
            _creatingIndex = null;
        }
    }

    /// <summary>等待时长：只给出粗粒度可读值，不显示毫秒（复盘是分钟级任务）。</summary>
    private static string FormatWaited(DateTimeOffset requestedAt)
    {
        var waited = DateTimeOffset.UtcNow - requestedAt;
        if (waited < TimeSpan.Zero)
            waited = TimeSpan.Zero;

        return waited.TotalMinutes >= 1
            ? $"{(int)waited.TotalMinutes} 分 {waited.Seconds} 秒"
            : $"{waited.Seconds} 秒";
    }

    /// <summary>结果对应的颜色：失败红、成功绿。</summary>
    private static string OutcomeColor(ReflectionRunSummary run)
        => run.IsFailure ? "red" : "green";

    /// <summary>一行「在复盘中」的展示项。</summary>
    private sealed record ActiveItem(ReflectionRequest Request, bool Running, string DisplayTitle);
}
