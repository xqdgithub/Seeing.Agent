@page "/workspaces"
@using AntDesign
@using Seeing.Agent.Configuration
@using Seeing.Agent.Hosting.Execution
@using Seeing.Agent.WebUI.Services
@inject IWorkspaceProvider Workspace
@inject IWorkspaceHistoryStore History
@inject IWorkspaceSwitcher Switcher
@inject NavigationManager Navigation
@inject WorkspaceSwitchProgress Progress
@layout EmptyLayout

<PageTitle>工作区 - Seeing</PageTitle>

@*
    独立布局，不复用控制台的 .hc：
    .hc 是「全高 + overflow:hidden」的控制台骨架，在没有侧栏的空布局里高度链会断，
    内容塌成空白。这里用普通文档流页面，自带滚动。
*@
<div class="ws-page">
    <header class="ws-page-header">
        <img src="seeing-mark-64.png" alt="Seeing" class="ws-page-mark" />
        <div class="ws-page-heading">
            <h1>工作区</h1>
            <p>管理已注册的工作区目录，新增或移除列表项；工作区内容本身不受影响</p>
        </div>
        <div class="ws-page-actions">
            @if (Workspace.IsResolved)
            {
                <Button Type="@ButtonType.Default" OnClick="@(() => Navigation.NavigateTo("/"))">
                    返回控制台
                </Button>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" Closable="true"
               OnClose="@(() => _error = null)" />
    }

    <section class="ws-page-section">
        <div class="ws-page-section-title">
            工作区
            @if (_cards.Count > 0)
            {
                <span class="ws-page-section-hint">@_cards.Count 个</span>
            }
        </div>

        @* 新增工作区入口就是网格里的一个卡片，与已有卡片同尺寸，不再单独放按钮 *@
        <div class="ws-page-grid">
            @foreach (var card in _cards)
            {
                <div class="ws-page-card @(card.IsCurrent ? "is-current" : null)" @key="card.Path">
                    <div class="ws-page-card-main" @onclick="@(() => EnterAsync(card.Path))">
                        <div class="ws-page-card-name">
                            <Icon Type="@IconType.Outline.Folder" />
                            <span>@card.Name</span>
                            @if (card.IsCurrent)
                            {
                                <span class="ws-tag ws-tag-current">使用中</span>
                            }
                            else if (card.IsDefault)
                            {
                                <span class="ws-tag">默认</span>
                            }
                        </div>
                        <div class="ws-page-card-path" title="@card.Path">@card.Path</div>
                        <div class="ws-page-card-meta">
                            @if (!card.Exists)
                            {
                                <span class="ws-missing">目录不存在</span>
                            }
                            else if (!card.IsCurrent)
                            {
                                <span>可切换</span>
                            }
                        </div>
                    </div>
                    <div class="ws-page-card-foot">
                        @if (card.IsCurrent)
                        {
                            <span class="ws-page-card-state">使用中</span>
                        }
                        else
                        {
                            <Button Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Disabled="@_busy"
                                    OnClick="@(() => EnterAsync(card.Path))">
                                切换至此
                            </Button>
                        }
                        <Popconfirm Title="@($"从列表中移除「{card.Name}」？")"
                                    OkText="@("移除")"
                                    CancelText="@("取消")"
                                    OnConfirm="@(() => RemoveAsync(card.Path))">
                            <Button Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Danger="true"
                                    Disabled="@card.IsCurrent"
                                    Icon="@IconType.Outline.Delete" />
                        </Popconfirm>
                    </div>
                </div>
            }

            <button type="button"
                    class="ws-page-card ws-page-add"
                    disabled="@_busy"
                    @onclick="OpenPicker">
                <span class="ws-page-add-plus">+</span>
                <span class="ws-page-add-label">新增工作区</span>
                <span class="ws-page-add-hint">选择一个目录</span>
            </button>
        </div>
    </section>

    <section class="ws-page-section ws-page-section--muted">
        <div class="ws-page-section-title">说明</div>
        <p class="ws-page-note">
            列表仅记录工作区路径，移除条目不删除磁盘上的任何文件；当前使用中的工作区不可移除。
            如需删除目录，请使用文件管理器。
        </p>
    </section>
</div>

<DirectoryPicker @ref="_picker"
                 Title="选择工作区"
                 InitialPath="@(Workspace.IsResolved ? Workspace.ResolvedRoot : _cards.FirstOrDefault(c => c.Exists)?.Path)"
                 OnSelected="EnterAsync" />

@code {
    private sealed record WorkspaceCard(string Name, string Path, bool IsDefault, bool IsCurrent, bool Exists);

    private List<WorkspaceCard> _cards = new();
    private DirectoryPicker? _picker;
    private string? _error;
    private bool _busy;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        var snapshot = History.Read();
        var current = Workspace.ResolvedRoot;

        _cards = snapshot.Recent
            .Select(p => new WorkspaceCard(
                new DirectoryInfo(p).Name,
                p,
                string.Equals(p, snapshot.LastInteractive, StringComparison.OrdinalIgnoreCase),
                current is not null && string.Equals(p, current, StringComparison.OrdinalIgnoreCase),
                Directory.Exists(p)))
            .ToList();
    }

    private void OpenPicker() => _picker?.Show();

    private async Task RemoveAsync(string path)
    {
        History.Remove(path);
        Reload();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task EnterAsync(string path)
    {
        if (_busy)
            return;

        _busy = true;
        _error = null;

        // 先让覆盖层渲染出来，再开始耗时操作：否则整个 await 期间页面没有任何变化
        Progress.Begin("正在切换工作区…");
        StateHasChanged();
        await Task.Yield();

        using (WorkspaceSwitchProgressHub.Use(Progress))
        {
            try
            {
                var result = await Switcher.ApplyAsync(new WorkspaceApplyRequest(path));
                if (!result.Success)
                {
                    _error = result.Error;
                    return;
                }

                // 整页重载：切换到新工作区后必须重建 circuit，避免旧工作区的 scoped 状态残留
                Navigation.NavigateTo("/", forceLoad: true);
            }
            finally
            {
                Progress.End();
                _busy = false;
                StateHasChanged();
            }
        }
    }
}
