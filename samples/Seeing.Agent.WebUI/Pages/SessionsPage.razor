@using AntDesign
@using Seeing.Agent.Core.Configuration
@using Seeing.Agent.Configuration
@using Seeing.Agent.WebUI.Services
@using Seeing.Session.Core
@using Seeing.Agent.Hosting
@inject ISessionDirectory SessionDirectory
@inject ISessionManager SessionManager
@inject IWorkspaceProvider WorkspaceProvider
@inject IMessageService MessageService
@inject NavigationManager NavigationManager

<PageTitle>会话管理 - Seeing</PageTitle>

<div class="workspace-page">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-left">
            <Breadcrumb>
                <BreadcrumbItem>工作区</BreadcrumbItem>
                <BreadcrumbItem>会话</BreadcrumbItem>
            </Breadcrumb>
        </div>
        <div class="page-header-actions">
            <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="CreateSession">
                新建会话
            </Button>
            <Button Icon="@IconType.Outline.Reload" OnClick="@RefreshSessionsAsync">
                刷新
            </Button>
            <Button Type="@(_showArchived ? ButtonType.Primary : ButtonType.Default)"
                    Icon="@IconType.Outline.Inbox"
                    OnClick="@(() => ToggleArchivedAsync(!_showArchived))">
                @(_showArchived ? "返回会话" : "已归档")
            </Button>
        </div>
    </div>
    
    <!-- Statistics Bar -->
    <div class="page-stats">
        <div class="stat-item">
            <div class="stat-icon">
                <Icon Type="@IconType.Outline.Folder" />
            </div>
            <div class="stat-content">
                <div class="stat-value">@_totalCount</div>
                <div class="stat-label">总会话</div>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon">
                <Icon Type="@IconType.Outline.Calendar" />
            </div>
            <div class="stat-content">
                <div class="stat-value">@_todayCount</div>
                <div class="stat-label">今日创建</div>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon">
                <Icon Type="@IconType.Outline.Thunderbolt" />
            </div>
            <div class="stat-content">
                <div class="stat-value">@_activeCount</div>
                <div class="stat-label">活跃 (24h)</div>
            </div>
        </div>
    </div>
    
    <!-- Filters Bar -->
    <div class="page-filters">
        <div class="filter-search">
            <Input @bind-Value="_searchText" Placeholder="搜索会话..." AllowClear="true"
                   OnChange="@((string _) => OnSearchChanged())">
                <Prefix><Icon Type="@IconType.Outline.Search" /></Prefix>
            </Input>
        </div>
    </div>

    @if (_selectedIds.Count > 0)
    {
        <!-- Batch Action Bar -->
        <div class="batch-bar">
            <Space>
                <SpaceItem>
                    <Checkbox Checked="@IsAllSelected()" CheckedChanged="@OnToggleSelectAll">全选</Checkbox>
                </SpaceItem>
                <SpaceItem>
                    <span Class="batch-count">已选 <b>@_selectedIds.Count</b> 项</span>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="@($"确定删除所选 {_selectedIds.Count} 个会话？将同步删除其子会话。")"
                                OnConfirm="@DeleteSelectedAsync">
                        <Button Type="@ButtonType.Primary" Danger Icon="@IconType.Outline.Delete">
                            批量删除
                        </Button>
                    </Popconfirm>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Text" Size="@ButtonSize.Small" OnClick="@ClearSelection">
                        清除选择
                    </Button>
                </SpaceItem>
            </Space>
        </div>
    }
    
    <!-- Session List -->
    <div class="page-content">
        @if (_showArchived)
        {
            @if (_archivedSessions.Count == 0)
            {
                <Empty Description="@("暂无已归档会话")" />
            }
            else
            {
                <div class="session-list">
                    @foreach (var session in _archivedSessions)
                    {
                        <div Class="session-card-wrapper">
                            <Card Size="@CardSize.Small" Class="session-card">
                                <div Class="session-card-content">
                                    <div Class="session-card-header">
                                        <Tooltip Title="@session.Title">
                                            <span Class="session-title">@session.Title</span>
                                        </Tooltip>
                                        <Tag Color="@TagColor.Default">已归档</Tag>
                                    </div>
                                    <div Class="session-card-meta">
                                        <span Class="meta-item">
                                            <Icon Type="@IconType.Outline.ClockCircle" /> @GetRelativeTime(session.LastActiveAt)
                                        </span>
                                        <span class="meta-item">
                                            <Icon Type="@IconType.Outline.Message" /> @session.MessageCount 条消息
                                        </span>
                                    </div>
                                    <div class="session-card-actions">
                                        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small"
                                                Icon="@IconType.Outline.Rollback"
                                                OnClick="@(() => RestoreSession(session.Id))">
                                            恢复
                                        </Button>
                                    </div>
                                </div>
                            </Card>
                        </div>
                    }
                </div>
            }
        }
        else if (_filteredSessions == null || _filteredSessions.Count == 0)
        {
            <Empty />
        }
        else
        {
            <div class="session-list">
                @foreach (var session in _filteredSessions)
                {
                    var workspace = !string.IsNullOrEmpty(session.WorkingDirectory) 
                        ? session.WorkingDirectory 
                        : WorkspaceProvider.GetProjectRoot();
                    
                    <div Class="session-card-wrapper @(IsSelected(session.Id) ? "session-card-selected" : "")"
                         @onclick="@(() => ViewSession(session.Id))">
                        <Card Size="@CardSize.Small" Hoverable="true" Class="session-card">
                            <div Class="session-card-content">
                                <div Class="session-card-header">
                                    <Tooltip Title="@session.Title">
                                        <span Class="session-title">@session.Title</span>
                                    </Tooltip>
                                    <Tag Color="@TagColor.Blue">@session.SelectedAgent</Tag>
                                </div>
                                <div Class="session-card-meta">
                                    <span Class="meta-item">
                                        <Icon Type="@IconType.Outline.ClockCircle" /> @GetRelativeTime(session.UpdatedAt)
                                    </span>
                                    <Tooltip Title="@workspace">
                                        <span Class="meta-item">
                                            <Icon Type="@IconType.Outline.Folder" /> @TruncatePath(workspace)
                                        </span>
                                    </Tooltip>
                                    <span Class="meta-item">
                                        <Icon Type="@IconType.Outline.Message" /> @session.MessageCount 条消息
                                    </span>
                                    <span Class="meta-item">
                                        Channel: @FormatOutbound(session.ChannelId)
                                    </span>
                                </div>
                                <div Class="session-card-actions" @onclick:stopPropagation>
                                    <Checkbox Checked="@IsSelected(session.Id)"
                                              CheckedChanged="@((bool value) => ToggleSelect(session.Id, value))" />
                                    <div Class="session-card-action-buttons">
                                        <Button Type="@ButtonType.Text" Size="@ButtonSize.Small"
                                                Icon="@IconType.Outline.Edit"
                                                OnClick="@(() => OpenOutboundEditor(session))">
                                            出站
                                        </Button>
                                        <Button Type="@ButtonType.Text" Size="@ButtonSize.Small" 
                                                Icon="@IconType.Outline.Fork" 
                                                OnClick="@(() => BranchSession(session.Id))">
                                            分支
                                        </Button>
                                        <Popconfirm Title="确定归档此会话？将同步归档其所在组。" OnConfirm="@(() => ArchiveSession(session.Id))">
                                            <Button Type="@ButtonType.Text" Size="@ButtonSize.Small"
                                                    Icon="@IconType.Outline.Inbox">
                                                归档
                                            </Button>
                                        </Popconfirm>
                                        <Popconfirm Title="确定删除此会话？将同步删除其子会话。" OnConfirm="@(() => DeleteSession(session.Id))">
                                            <Button Type="@ButtonType.Text" Size="@ButtonSize.Small" 
                                                    Danger Icon="@IconType.Outline.Delete">
                                                删除
                                            </Button>
                                        </Popconfirm>
                                    </div>
                                </div>
                            </div>
                        </Card>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (_outboundModalVisible)
{
    <Modal Title="编辑出站绑定"
           Visible="true"
           OnOk="@SaveOutboundAsync"
           OnCancel="@CloseOutboundEditor"
           OkText="@("确定")"
           CancelText="@("取消")">
        <Form Model="@_outboundForm" Layout="@FormLayout.Horizontal">
            <FormItem Label="ChannelId">
                <Input @bind-Value="@_outboundForm.ChannelId"
                       Placeholder="如 qq / wecom，全部留空则清除绑定" />
            </FormItem>
            <FormItem Label="Kind">
                <Select TItemValue="string"
                        TItem="KindOption"
                        @bind-Value="@_outboundForm.Kind"
                        DataSource="@_kindOptions"
                        ValueName="@nameof(KindOption.Value)"
                        LabelName="@nameof(KindOption.Label)"
                        Placeholder="direct / group / guild"
                        AllowClear="true"
                        Style="width: 100%;" />
            </FormItem>
            <FormItem Label="ExternalId">
                <Input @bind-Value="@_outboundForm.ExternalId"
                       Placeholder="对话 ExternalId" />
            </FormItem>
            <FormItem Label="Title">
                <Input @bind-Value="@_outboundForm.Title"
                       Placeholder="可选标题" />
            </FormItem>
        </Form>
    </Modal>
}

<style>
.batch-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 16px;
    margin-bottom: 16px;
    background: #e6f4ff;
    border: 1px solid #91caff;
    border-radius: 8px;
}

.batch-count {
    font-size: 14px;
    color: #595959;
}

.session-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
}

.session-card-wrapper {
    cursor: pointer;
    border-radius: 8px;
    transition: box-shadow 0.2s, border-color 0.2s;
}

.session-card-wrapper.session-card-selected {
    box-shadow: 0 0 0 1px #d9d9d9;
}

.session-card {
    margin-bottom: 0 !important;
}

.session-card .ant-card-body {
    padding: 16px !important;
}

.session-card-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.session-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}

.session-card-header .session-title {
    font-size: 15px;
    font-weight: 600;
    color: #262626;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
}

.session-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.session-card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: space-between;
    padding-top: 8px;
    border-top: 1px solid #f0f0f0;
}

.session-card-actions .ant-btn {
    flex-shrink: 0;
}

.session-card-action-buttons {
    display: flex;
    gap: 8px;
}
</style>

@code {
    private List<SessionSummary> _filteredSessions = new();
    private string _searchText = "";
    private int _totalCount;
    private int _todayCount;
    private int _activeCount;

    private bool _showArchived;
    private List<SessionSummary> _archivedSessions = new();

    private readonly HashSet<string> _selectedIds = new(StringComparer.Ordinal);

    private bool _outboundModalVisible;
    private string? _editingSessionId;
    private OutboundEditForm _outboundForm = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshSessionsAsync();
    }

    static string FormatOutbound(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "未绑定" : value;

    async Task OpenOutboundEditor(SessionSummary session)
    {
        var loaded = await SessionDirectory.GetAsync(session.Id);
        if (loaded == null)
        {
            MessageService.Error("会话不存在");
            return;
        }

        var route = loaded.ChannelRoute;
        _editingSessionId = session.Id;
        _outboundForm = new OutboundEditForm
        {
            ChannelId = route?.ChannelId ?? "",
            Kind = route?.Kind ?? "",
            ExternalId = route?.ExternalId ?? "",
            Title = route?.Title ?? ""
        };
        _outboundModalVisible = true;
    }

    void CloseOutboundEditor()
    {
        _outboundModalVisible = false;
        _editingSessionId = null;
    }

    async Task SaveOutboundAsync()
    {
        if (string.IsNullOrEmpty(_editingSessionId))
        {
            CloseOutboundEditor();
            return;
        }

        try
        {
            var session = await SessionDirectory.GetAsync(_editingSessionId);
            if (session == null)
            {
                MessageService.Error("会话不存在");
                CloseOutboundEditor();
                return;
            }

            if (!TryBuildRoute(_outboundForm, out var route, out var error))
            {
                MessageService.Warning(error!);
                return;
            }

            session.ChannelRoute = route;
            session.UpdatedAt = DateTime.Now;
            await SessionManager.SaveAsync(session.Id);

            MessageService.Success("出站绑定已保存");
            CloseOutboundEditor();
            await RefreshSessionsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MessageService.Error(string.Format("保存失败: {0}", ex.Message));
        }
    }

    static readonly KindOption[] _kindOptions =
    [
        new("direct", "direct"),
        new("group", "group"),
        new("guild", "guild"),
    ];

    static string? NormalizeOutbound(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    static bool TryBuildRoute(OutboundEditForm form, out SessionChannelRoute? route, out string? error)
    {
        var channelId = NormalizeOutbound(form.ChannelId);
        var kind = NormalizeOutbound(form.Kind)?.ToLowerInvariant();
        var externalId = NormalizeOutbound(form.ExternalId);
        var title = NormalizeOutbound(form.Title);
        route = null;
        error = null;

        if (channelId == null && kind == null && externalId == null && title == null)
            return true;

        if (channelId == null || externalId == null || kind is not ("direct" or "group" or "guild"))
        {
            error = "出站绑定需要 ChannelId、Kind（direct/group/guild）和 ExternalId；全部留空则清除绑定";
            return false;
        }

        route = new SessionChannelRoute
        {
            ChannelId = channelId,
            Kind = kind,
            ExternalId = externalId,
            Title = title
        };
        return true;
    }

    private sealed class OutboundEditForm
    {
        public string ChannelId { get; set; } = "";
        public string Kind { get; set; } = "";
        public string ExternalId { get; set; } = "";
        public string Title { get; set; } = "";
    }

    private sealed record KindOption(string Value, string Label);

    async Task RefreshSessionsAsync()
    {
        try
        {
            var sessions = await SessionDirectory.ListSummariesAsync();

            _filteredSessions = sessions
                .Where(s => string.IsNullOrEmpty(_searchText) || 
                            (s.Title?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (s.SelectedAgent?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false))
                .OrderByDescending(s => s.UpdatedAt)
                .ToList();

            _totalCount = sessions.Count;
            var today = DateTime.Today;
            _todayCount = sessions.Count(s => s.CreatedAt.Date == today);
            var yesterday = DateTime.Now.AddHours(-24);
            _activeCount = sessions.Count(s => s.UpdatedAt >= yesterday);

            if (_showArchived)
                _archivedSessions = (await SessionDirectory.ListArchivedAsync()).ToList();

            // 刷新后清空勾选，避免残留对已不存在会话的选择
            ClearSelection();
        }
        catch
        {
            _filteredSessions = new List<SessionSummary>();
        }
    }

    async Task ToggleArchivedAsync(bool value)
    {
        _showArchived = value;
        await RefreshSessionsAsync();
    }

    async Task ArchiveSession(string id)
    {
        try
        {
            await SessionDirectory.ArchiveAsync(id);
            MessageService.Success("会话已归档");
            await RefreshSessionsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MessageService.Error(string.Format("归档失败: {0}", ex.Message));
        }
    }

    async Task RestoreSession(string id)
    {
        try
        {
            await SessionDirectory.RestoreAsync(id);
            MessageService.Success("会话已恢复");
            await RefreshSessionsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MessageService.Error(string.Format("恢复失败: {0}", ex.Message));
        }
    }

    // ---- 批量选择 ----

    bool IsSelected(string id) => _selectedIds.Contains(id);

    void ToggleSelect(string id, bool value)
    {
        if (value) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
        StateHasChanged();
    }

    bool IsAllSelected() =>
        _filteredSessions.Count > 0 && _filteredSessions.All(s => _selectedIds.Contains(s.Id));

    void OnToggleSelectAll(bool value)
    {
        if (value)
        {
            foreach (var s in _filteredSessions)
                _selectedIds.Add(s.Id);
        }
        else
        {
            foreach (var s in _filteredSessions)
                _selectedIds.Remove(s.Id);
        }
        StateHasChanged();
    }

    void ClearSelection()
    {
        if (_selectedIds.Count == 0) return;
        _selectedIds.Clear();
        StateHasChanged();
    }

    /// <summary>搜索词变化即清空勾选（筛选结果改变，旧的勾选无意义）</summary>
    void OnSearchChanged()
    {
        ClearSelection();
    }

    async Task DeleteSelectedAsync()
    {
        var ids = _selectedIds.ToList();
        var (deleted, failed) = await DeleteSessionsCoreAsync(ids);
        if (failed > 0)
            MessageService.Error(string.Format("批量删除部分失败：成功 {0}，失败 {1}", deleted, failed));
        else
            MessageService.Success(string.Format("已删除 {0} 个会话", deleted));
    }

    /// <summary>批量删除核心：逐个调用级联删除，统计成败，并刷新列表</summary>
    async Task<(int Deleted, int Failed)> DeleteSessionsCoreAsync(IEnumerable<string> ids)
    {
        var deleted = 0;
        var failed = 0;
        foreach (var id in ids)
        {
            try
            {
                await SessionDirectory.DeleteAsync(id);
                _selectedIds.Remove(id);
                deleted++;
            }
            catch
            {
                failed++;
            }
        }

        await RefreshSessionsAsync();
        StateHasChanged();
        return (deleted, failed);
    }
    
    async Task CreateSession()
    {
        try
        {
            var session = await SessionDirectory.CreateAsync(
                workingDirectory: WorkspaceProvider.GetProjectRoot());
            MessageService.Success("会话已创建");
            NavigationManager.NavigateTo(string.Format("/session/{0}", session.Id));
        }
        catch (Exception ex)
        {
            MessageService.Error(string.Format("创建失败: {0}", ex.Message));
        }
    }
    
    async Task DeleteSession(string id)
    {
        try
        {
            await SessionDirectory.DeleteAsync(id);
            MessageService.Success("会话已删除");
            await RefreshSessionsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MessageService.Error(string.Format("删除失败: {0}", ex.Message));
        }
    }

    void ViewSession(string id) => NavigationManager.NavigateTo(string.Format("/session/{0}", id));
    
    async Task BranchSession(string id)
    {
        try
        {
            var session = await SessionDirectory.BranchAsync(id);
            MessageService.Success("会话已分支");
            NavigationManager.NavigateTo(string.Format("/session/{0}", session.Id));
        }
        catch (Exception ex)
        {
            MessageService.Error(string.Format("分支失败: {0}", ex.Message));
        }
    }
    
    string GetRelativeTime(DateTime time)
    {
        var diff = DateTime.Now - time;
        
        if (diff.TotalMinutes < 1)
            return "刚刚";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes}分钟前";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours}小时前";
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays}天前";
        
        return time.ToString("MM-dd");
    }
    
    static string TruncatePath(string? path)
    {
        if (string.IsNullOrEmpty(path)) return path ?? string.Empty;
        if (path.Length <= 30) return path;
        
        var parts = path.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        if (parts.Length <= 2) return path;
        
        return ".../" + string.Join("/", parts.TakeLast(2));
    }
}
