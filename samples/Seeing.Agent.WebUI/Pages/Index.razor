@using AntDesign
@using Seeing.Agent.Abstractions.Agents
@using Seeing.Agent.Abstractions.Runtime
@using Seeing.Agent.Configuration
@using Seeing.Agent.Core.Llm
@using Seeing.Agent.Llm
@using Seeing.Agent.Scheduler.Abstractions
@using Seeing.Agent.Scheduler.Models
@using Seeing.Agent.WebUI.Components.Home
@using Seeing.Agent.WebUI.Services
@using Seeing.Session.Core
@inject ISessionDirectory SessionDirectory
@inject IWorkspaceProvider WorkspaceProvider
@inject IAgentRegistry AgentRegistry
@inject IAgentRuntimeManager RuntimeManager
@inject ILlmService LlmService
@inject IScheduleManager ScheduleManager
@inject SchedulerStatusService SchedulerStatus
@inject PermissionInbox PermissionInboxService
@inject QuestionInbox QuestionInboxService
@inject UiOverlayService Overlays
@inject NavigationManager Navigation

<PageTitle>总览 - Seeing</PageTitle>

<div class="home-dashboard">
    <section class="home-hero">
        <img src="ai.svg" alt="Seeing" class="home-hero-logo" />
        <h1 class="home-hero-title">Seeing</h1>
        <p class="home-hero-tagline">行到水穷处，坐看云起时</p>
        <p class="home-hero-desc">会话、定时任务与待办审批一屏总览；点卡片进入对应页面。</p>
        <Space Size="@("middle")">
            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large"
                    Icon="@IconType.Outline.Message" OnClick="ContinueLastSession">开始对话</Button>
            <Button Size="@ButtonSize.Large"
                    Icon="@IconType.Outline.Plus" OnClick="CreateNewSession">新建会话</Button>
        </Space>
    </section>

    <div class="home-section-head">
        <span class="home-section-title">总览</span>
        <Button Type="@ButtonType.Link" Icon="@IconType.Outline.Reload"
                Loading="@_loading" OnClick="@(() => LoadAsync(showSkeleton: true))">刷新</Button>
    </div>

    @if (_error is not null)
    {
        <Alert Type="@AlertType.Warning" ShowIcon="true" Message="@_error" Style="margin-bottom:16px;" />
    }

    @if (_loading && _sessions.Count == 0)
    {
        <Skeleton Active="true" />
    }
    else
    {
        @* 等尺寸卡片网格：卡片同高，排列规整；窄屏自动降列 *@
        <div class="home-board">

            <DashboardCard Title="最近会话" LinkText="全部 →"
                           OnLink="@(() => Navigation.NavigateTo("/sessions"))">
                @if (_sessions.Count == 0)
                {
                    <div class="home-empty">
                        <span class="home-muted">还没有会话，开始第一个对话</span>
                        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="CreateNewSession">新建会话</Button>
                    </div>
                }
                else
                {
                    @foreach (var session in _sessions)
                    {
                        var sessionId = session.Id;
                        <div class="home-dash-row is-actionable"
                             role="button"
                             tabindex="0"
                             @onclick="@(() => Navigation.NavigateTo($"/session/{sessionId}"))"
                             @onkeydown="@(args => HandleRowKeyDown(args, sessionId))"
                             @onclick:stopPropagation="true">
                            <span class="title">@HomeDashboardView.SessionTitle(session.Title)</span>
                            <span class="meta">@HomeDashboardView.RelativeTime(session.LastActiveAt, _now)</span>
                        </div>
                    }
                }
            </DashboardCard>

            @if (HomeDashboardView.HasActionItems(_pendingApprovals, _pendingQuestions, _recentFailures))
            {
                <DashboardCard Title="待我处理" OnClick="@(() => Overlays.RequestPermissionCenter())">
                    @if (_pendingApprovals > 0)
                    {
                        <div class="home-dash-row">
                            <span class="title">待审批</span>
                            <span class="meta home-meta-strong">@_pendingApprovals 项</span>
                        </div>
                    }
                    @if (_pendingQuestions > 0)
                    {
                        <div class="home-dash-row">
                            <span class="title">待回答</span>
                            <span class="meta home-meta-strong">@_pendingQuestions 项</span>
                        </div>
                    }
                    @if (_recentFailures > 0)
                    {
                        <div class="home-dash-row">
                            <span class="title">最近失败</span>
                            <span class="meta home-meta-strong">@_recentFailures 次</span>
                        </div>
                    }
                </DashboardCard>
            }

            @* 大卡：今日日程时间轴（00:00–24:00），跨 2 列 2 行 *@
            <DashboardCard Class="card-schedule" Title="定时任务 · 今日" LinkText="全部 →"
                           OnLink="@(() => Navigation.NavigateTo("/cron-jobs"))"
                           OnClick="@(() => Navigation.NavigateTo("/cron-jobs"))">
                @* 24 小时格子：有任务的时段整格高亮，已过时段压暗，当前小时描红 *@
                <div class="sched-strip" title="今日 00:00–24:00">
                    @for (var hour = 0; hour < 24; hour++)
                    {
                        var count = _hourLoads[hour];
                        var barClass = "sched-bar"
                            + (count > 0 ? " has-task" : string.Empty)
                            + (hour < _now.Hour ? " is-past" : string.Empty)
                            + (hour == _now.Hour ? " is-now" : string.Empty);
                        <div class="sched-cell" title="@($"{hour:00}:00 · {count} 个任务")">
                            <span class="@barClass"></span>
                            @if (hour % 6 == 0)
                            {
                                <span class="sched-tick">@hour.ToString("00")</span>
                            }
                        </div>
                    }
                </div>

                @{
                    var remaining = _todayRuns.Where(r => r.When >= _now).Take(6).ToList();
                }
                <div class="sched-list">
                    @if (_todayRuns.Count == 0)
                    {
                        <div class="home-dash-row">
                            <span class="home-muted">今天没有定时任务</span>
                        </div>
                        @if (_nextRun is not null)
                        {
                            <div class="home-dash-row">
                                <span class="title">下次：@_nextRun.Title</span>
                                <span class="meta">@_nextRun.When.ToString("MM-dd HH:mm")</span>
                            </div>
                        }
                    }
                    else if (remaining.Count == 0)
                    {
                        <div class="home-dash-row">
                            <span class="home-muted">今天的任务都已触发</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var run in remaining)
                        {
                            <div class="home-dash-row">
                                <span class="title">@run.Title</span>
                                <span class="meta">@run.When.ToString("HH:mm")</span>
                            </div>
                        }
                    }
                </div>
                @if (_expiredCount > 0)
                {
                    <div class="home-card-foot">已过期 @_expiredCount 个</div>
                }
            </DashboardCard>

            <DashboardCard Title="会话" OnClick="@(() => Navigation.NavigateTo("/sessions"))">
                <div class="home-dash-number">@_sessionCount</div>
                <div class="home-dash-label">全部会话</div>
            </DashboardCard>

            <DashboardCard Title="智能体" OnClick="@(() => Navigation.NavigateTo("/agents"))">
                <div class="home-dash-number">@_agentCount</div>
                <div class="home-dash-label">主智能体</div>
            </DashboardCard>

            <DashboardCard Title="模型" OnClick="@(() => Navigation.NavigateTo("/models"))">
                <div class="home-dash-number">@_modelCount</div>
                <div class="home-dash-label">可用模型</div>
            </DashboardCard>
        </div>
    }
</div>

<style>
    /* 卡片外壳（DashboardCard）：样式放页面级，避免在组件内重复输出样式块 */
    .dash-card {
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        padding: 16px;
        /* 等尺寸卡片：高度由网格行高决定，内容超出裁切，保证排列规整 */
        height: 100%;
        overflow: hidden;
        box-sizing: border-box;
        transition: border-color .15s, transform .15s;
    }

        .dash-card.is-clickable {
            cursor: pointer;
        }

            .dash-card.is-clickable:hover {
                border-color: #1890ff;
                transform: translateY(-1px);
            }

            .dash-card.is-clickable:focus-visible {
                outline: 2px solid #1890ff;
                outline-offset: 2px;
            }

    .dash-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .dash-card-title {
        font-size: 13px;
        font-weight: 600;
        color: #262626;
    }

    .dash-card-link {
        font-size: 12px;
        color: #1890ff;
        text-decoration: none;
        white-space: nowrap;
    }

        .dash-card-link:hover {
            text-decoration: underline;
        }

    @@media (prefers-reduced-motion: reduce) {
        .dash-card {
            transition: none;
        }
    }

    .home-dashboard {
        padding: 24px 32px;
    }

    .home-hero {
        text-align: center;
        padding: 24px 0 28px;
    }

    .home-hero-logo {
        width: 56px;
        height: 56px;
        display: inline-block;
    }

    .home-hero-title {
        margin: 10px 0 6px;
        font-size: 28px;
        font-weight: 600;
        color: #1890ff;
        letter-spacing: .5px;
    }

    .home-hero-tagline {
        margin: 0;
        font-size: 14px;
        color: #8c8c8c;
    }

    .home-hero-desc {
        margin: 10px 0 18px;
        font-size: 13px;
        color: #bfbfbf;
    }

    .home-section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .home-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #262626;
    }

    /* 等尺寸卡片网格：最多 3 列，宽屏也不散开 */
    .home-board {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-auto-rows: 168px;
        grid-auto-flow: dense;
        gap: 16px;
    }

    /* 定时任务大卡：跨 2 列 2 行（尺寸仍固定） */
    .home-board .card-schedule {
        grid-column: span 2;
        grid-row: span 2;
    }

    /* 24 小时格子：有任务的时段整格高亮 */
    .sched-strip {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 56px;
        margin: 6px 0 20px;
    }

    .sched-cell {
        position: relative;
        flex: 1;
        height: 100%;
        display: flex;
        align-items: flex-end;
    }

    .sched-bar {
        width: 100%;
        height: 8px;
        border-radius: 3px;
        background: #f0f0f0;
    }

        .sched-bar.has-task {
            height: 100%;
            background: #1890ff;
        }

            .sched-bar.has-task.is-past {
                background: #d9d9d9;
            }

        .sched-bar.is-now {
            outline: 2px solid #ffccc7;
            outline-offset: 1px;
        }

    .sched-tick {
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 10px;
        color: #bfbfbf;
    }

    .sched-list {
        margin-top: 8px;
    }

    .home-dash-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 6px 8px;
        border-radius: 6px;
        font-size: 13px;
    }

        /* 只有真正可点的行（最近会话）才暗示可交互 */
        .home-dash-row.is-actionable {
            cursor: pointer;
        }

            .home-dash-row.is-actionable:hover {
                background: #f5f5f5;
            }

            .home-dash-row.is-actionable:focus-visible {
                outline: 2px solid #1890ff;
                outline-offset: 1px;
            }

        .home-dash-row .title {
            color: #262626;
            /* flex item 默认 min-width:auto 不会收缩，长英文/URL 标题会撑破卡片 */
            flex: 1 1 auto;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .home-dash-row .meta {
            color: #8c8c8c;
            font-size: 12px;
            flex-shrink: 0;
        }

    .home-meta-strong {
        color: #fa8c16 !important;
        font-weight: 500;
    }

    .home-dash-number {
        font-size: 26px;
        font-weight: 600;
        color: #1890ff;
        line-height: 1.1;
    }

    .home-dash-label {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 4px;
    }

    .home-empty {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 4px 8px;
    }

    .home-muted {
        font-size: 13px;
        color: #8c8c8c;
    }

    .home-card-foot {
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px dashed #f0f0f0;
        font-size: 12px;
        color: #fa8c16;
    }

    @@media (max-width: 1200px) {
        .home-board {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 800px) {
        .home-board {
            grid-template-columns: 1fr;
            grid-auto-rows: auto;
        }

        .home-board .card-schedule {
            grid-column: span 1;
            grid-row: span 1;
        }

        .dash-card {
            height: auto;
            min-height: 140px;
        }

        .home-dashboard {
            padding: 16px;
        }
    }
</style>

@code {
    private const int RecentSessionCount = 3;

    private List<SessionSummary> _sessions = new();
    private IReadOnlyList<TodayRun> _todayRuns = Array.Empty<TodayRun>();
    private IReadOnlyList<int> _hourLoads = new int[24];
    private TodayRun? _nextRun;
    private int _sessionCount;
    private int _agentCount;
    private int _modelCount;
    private int _expiredCount;
    private int _pendingApprovals;
    private int _pendingQuestions;
    private int _recentFailures;
    private bool _loading = true;
    private string? _error;
    private DateTime _now = DateTime.Now;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// 首屏/刷新加载：一次性取快照，不做轮询（spec §2 非目标）。
    /// </summary>
    private async Task LoadAsync(bool showSkeleton = false)
    {
        if (showSkeleton)
            _loading = true;

        try
        {
            _now = DateTime.Now;

            var sessions = await SessionDirectory.ListSummariesAsync();
            var visible = sessions
                .Where(s => !s.IsArchived)
                .OrderByDescending(s => s.LastActiveAt)
                .ToList();

            _sessionCount = visible.Count;
            _sessions = visible.Take(RecentSessionCount).ToList();

            _agentCount = (await AgentRegistry.GetPrimaryAgentsAsync()).Count;
            _modelCount = LlmService.GetAvailableModels().Count;

            var status = await SchedulerStatus.GetStatusAsync();
            var jobStatuses = new Dictionary<string, JobStatus>();
            foreach (var jobStatus in await SchedulerStatus.GetAllJobStatusesAsync())
                jobStatuses[jobStatus.JobId] = jobStatus;

            var jobs = await ScheduleManager.ListJobsAsync();
            _todayRuns = HomeDashboardView.TodayRuns(jobs, jobStatuses, _now);
            _hourLoads = HomeDashboardView.HourLoads(_todayRuns);
            _nextRun = HomeDashboardView.NextRunAfter(jobs, jobStatuses, _now);
            _expiredCount = HomeDashboardView.CountExpired(jobs, jobStatuses, _now, status.IsStarted);

            _pendingApprovals = PermissionInboxService.TotalCount;
            _pendingQuestions = QuestionInboxService.TotalCount;

            // 首版固定 0：暂无失败历史查询接口（spec §9.4 的已知取舍）
            _recentFailures = 0;

            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"加载仪表盘数据失败：{ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>行的键盘可达性：Enter / Space 等价于点击（与整卡交互一致）。</summary>
    private void HandleRowKeyDown(KeyboardEventArgs args, string sessionId)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
            Navigation.NavigateTo($"/session/{sessionId}");
    }

    /// <summary>英雄区主操作：有最近会话就续聊，否则去会话列表。</summary>
    private void ContinueLastSession()
    {
        var last = _sessions.FirstOrDefault();
        Navigation.NavigateTo(last is null ? "/sessions" : $"/session/{last.Id}");
    }

    private async Task CreateNewSession()
    {
        try
        {
            var defaultAgent = await RuntimeManager.GetDefaultAgentNameAsync();
            var session = await SessionDirectory.CreateAsync(
                "新会话",
                defaultAgent,
                WorkspaceProvider.GetProjectRoot());

            Navigation.NavigateTo($"/session/{session.Id}");
        }
        catch (Exception ex)
        {
            _error = $"创建会话失败：{ex.Message}";
        }
    }
}
