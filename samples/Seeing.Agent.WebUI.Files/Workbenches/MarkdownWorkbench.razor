@using Seeing.Agent.Abstractions.Files
@using Seeing.Agent.Abstractions.Ui.Workbench
@using Seeing.Agent.WebUI.Files.Services
@using Seeing.Agent.WebUI.Files.Workbenches
@using Seeing.Agent.WebUI.Workbench
@inject IFileWorkspaceFactory WorkspaceFactory
@inject IServiceProvider Services
@implements IDisposable

@*
    Markdown 预览工作台：按路径渲染 Markdown 文档。
    打开载荷 { path: string, anchor?: string }；ViewState["path"] 保存上次查看的文件（刷新后恢复）。
*@
<div class="md-workbench">
    @if (string.IsNullOrEmpty(_path))
    {
        <div class="md-workbench-empty">
            <div class="md-workbench-empty-title">Markdown 预览</div>
            <div class="md-workbench-empty-hint">由 agent 打开：<code>open_workbench</code>（workbenchId=markdown, payload={"path":"docs/a.md"}）</div>
        </div>
    }
    else if (_error is not null)
    {
        <div class="md-workbench-error" role="alert">
            <div class="md-workbench-error-title">@_path</div>
            <div class="md-workbench-error-text">@_error</div>
            <button type="button" class="md-workbench-retry" @onclick="ReloadAsync">重试</button>
        </div>
    }
    else if (_loading)
    {
        <div class="md-workbench-loading">加载中…</div>
    }
    else
    {
        <div class="md-workbench-header">
            <span class="md-workbench-path" title="@_path">@_path</span>
            <span class="md-workbench-actions">
                <button type="button" class="md-workbench-reload" title="从磁盘重新读取" @onclick="ReloadAsync">⟳</button>
            </span>
        </div>
        <article class="md-workbench-body markdown-body">
            @((MarkupString)_html)
        </article>
    }
</div>

@code {
    /// <summary>工作台视图上下文（平台注入）。</summary>
    [Parameter, EditorRequired] public WorkbenchViewContext Context { get; set; } = default!;

    private string? _path;
    private string _html = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        // 打开载荷优先；否则用上次的 ViewState（刷新恢复）
        _path = ReadString(Context.OpenPayload, "path");

        if (string.IsNullOrEmpty(_path)
            && Context.ViewState is { } state
            && state.TryGetValue("path", out var saved))
        {
            _path = saved;
        }

        _initialized = true;

        if (!string.IsNullOrEmpty(_path))
            await LoadAsync();
    }

    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(_path))
            return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_path is null)
            return;

        _loading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        IFileWorkspace? workspace = null;
        try
        {
            workspace = await WorkspaceFactory.ResolveAsync(Context.SessionId);

            var result = await workspace.ReadAsync(
                workspace.GetAbsolutePath(workspace.GetResourceId(_path)),
                FileReadMode.Display);

            if (result.Kind is not (FileContentKind.Text or FileContentKind.Markdown))
            {
                _error = $"该文件不是可预览的文本/Markdown（类型：{result.Kind}）";
                _html = string.Empty;
                return;
            }

            _html = MarkdownRenderer.Render(result.Content ?? string.Empty);
            ReportState();
        }
        catch (Exception ex)
        {
            _error = FileErrorPresenter.Describe(ex);
            _html = string.Empty;
        }
        finally
        {
            if (workspace is not null)
                WorkspaceFactory.Release(Context.SessionId);

            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>上报可恢复状态与上下文摘要（让 agent 知道用户在看哪个文档）。</summary>
    private void ReportState()
    {
        if (string.IsNullOrEmpty(_path))
            return;

        Context.Report(new WorkbenchViewReport
        {
            ViewState = new Dictionary<string, string>(StringComparer.Ordinal) { ["path"] = _path },
            ContextSummary = $"正在预览 {_path}"
        });
    }

    private static string? ReadString(System.Text.Json.JsonElement? payload, string name)
        => payload is { ValueKind: System.Text.Json.JsonValueKind.Object } element
           && element.TryGetProperty(name, out var value)
           && value.ValueKind == System.Text.Json.JsonValueKind.String
            ? value.GetString()
            : null;

    public void Dispose()
    {
        _ = _initialized;
    }
}
