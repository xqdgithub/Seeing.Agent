  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\abstractions\Seeing.Agent.Abstractions\Seeing.Agent.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Seeing.Agent.WebUI.Files.Tests" />
  </ItemGroup>
</Project>
