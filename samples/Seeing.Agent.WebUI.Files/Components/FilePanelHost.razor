@using Seeing.Agent.Abstractions.Files
@using Seeing.Agent.WebUI.Files.Services
@using Seeing.Session.Core
@inject IFileWorkspaceFactory WorkspaceFactory
@inject FilePanelState PanelState
@inject FileTreeState TreeState
@inject ISessionEventPublisher SessionEvents
@implements IDisposable

<div class="file-panel-host">
    @if (string.IsNullOrEmpty(SessionId))
    {
        <div class="file-panel-empty">无会话</div>
    }
    else if (_workspaces is null)
    {
        @if (_error is not null)
        {
            <div class="file-panel-header">
                <span class="file-panel-title">文件</span>
                <button type="button" class="file-panel-close" title="关闭" @onclick="ClosePanel">×</button>
            </div>
            <div class="file-panel-error" role="alert">
                <div class="file-panel-error-text">@_error</div>
                <button type="button" class="file-panel-error-retry" @onclick="RetryAsync">重试</button>
            </div>
        }
        else
        {
            <div class="file-panel-loading">加载中…</div>
        }
    }
    else
    {
        @if (_error is not null)
        {
            <div class="file-panel-error file-panel-error--banner" role="alert">
                <div class="file-panel-error-text">@_error</div>
                <button type="button" class="file-panel-error-dismiss" title="关闭提示" @onclick="DismissError">×</button>
            </div>
        }
        <div class="file-panel-body @(PanelState.TreeVisible ? "" : "file-panel-body--no-tree")">
            @if (PanelState.TreeVisible)
            {
                <div class="file-tree-wrap">
                    <button type="button" class="file-tree-collapse" title="隐藏目录树" @onclick="HideTree">
                        <span>◀</span>
                    </button>
                    <FileTree Roots="_roots" OnOpen="OnOpenFileAsync" />
                </div>
                <ResizeHandle CssVariable="--file-tree-width" Vertical="true" Min="140" Max="600"
                              Default="220" StorageKey="seeing-files-tree-width" />
            }
            else
            {
                <button type="button" class="file-tree-expand" title="显示目录树" @onclick="ShowTree">
                    <span>▶</span>
                </button>
            }
            <div class="file-panel-main">
                <FileTabs Tabs="_tabs" OnSave="SaveActiveAsync" />
                <FileEditor Tabs="_tabs" Workspaces="_workspaces" @ref="_editor" />
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "SessionId")] private string? SessionId { get; set; }

    /// <summary>请求关闭整个工作台（由工作台视图提供，转发到平台的 Close）。</summary>
    [Parameter] public EventCallback OnRequestClose { get; set; }

    private FileWorkspaceSet? _workspaces;
    private IReadOnlyList<IFileWorkspace> _roots = Array.Empty<IFileWorkspace>();
    private readonly List<FileViewerCoordinator> _coordinators = [];
    private FileTabsState _tabs = null!;
    private FileEditor? _editor;
    private string? _error;
    private IDisposable? _sessionEventSubscription;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(SessionId)) return;
        // 协同目录增删 → 重载根列表（会话层写入后发布，避免定时轮询）
        _sessionEventSubscription = SessionEvents.Events.Subscribe(new SessionEventObserver(OnSessionEvent));
        // 标签状态按会话缓存在 Scoped 的 PanelState 上，页面导航往返不丢失
        _tabs = PanelState.GetTabs(SessionId);
        _tabs.Changed += OnTabsChanged;
        PanelState.Changed += OnPanelChanged;
        // 树重建时（页面往返/重新展开）节点初始化会读取该值沿路径展开定位
        SyncTreeSelection();
        await TryInitWorkspaceAsync();
    }

    private void OnSessionEvent(SessionEvent evt)
    {
        if (evt.Type != SessionEventType.CollaborationDirectoriesChanged)
            return;
        if (!string.Equals(evt.SessionId, SessionId, StringComparison.Ordinal))
            return;

        _ = InvokeAsync(RefreshRootsAsync);
    }

    /// <summary>协同目录变更后重载根集合：移除已删根的标签、重建协调器。</summary>
    private async Task RefreshRootsAsync()
    {
        if (string.IsNullOrEmpty(SessionId) || _workspaces is null)
            return;

        try
        {
            var roots = await WorkspaceFactory.ListAsync(SessionId);
            var next = new FileWorkspaceSet(roots);

            // 根被移除：属于它的标签立即失效（继续编辑会写不回任何根）
            foreach (var tab in _tabs.OpenFiles.Where(f => next.Find(f.Id) is null).ToArray())
                _tabs.Close(tab.Id);

            _roots = roots;
            _workspaces = next;
            WireCoordinators();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            SetError(FileErrorPresenter.Describe(ex));
        }
    }

    /// <summary>解析会话的全部文件根并接线变更订阅；失败时展示错误条而非冒泡崩溃。</summary>
    private async Task TryInitWorkspaceAsync()
    {
        if (string.IsNullOrEmpty(SessionId) || _workspaces is not null) return;
        try
        {
            // 多根：项目根 + 会话协同目录；根集合由 ISessionRootSet 投影（只读）。
            _roots = await WorkspaceFactory.ListAsync(SessionId);
            _workspaces = new FileWorkspaceSet(_roots);
        }
        catch (Exception ex)
        {
            _workspaces = null;
            _roots = Array.Empty<IFileWorkspace>();
            _error = FileErrorPresenter.Describe(ex);
            return;
        }

        WireCoordinators();
    }

    /// <summary>为每个根建立一条磁盘变更订阅；事件按根应用并广播给树。</summary>
    private void WireCoordinators()
    {
        DisposeCoordinators();
        if (_workspaces is null)
            return;

        foreach (var root in _workspaces.Roots)
        {
            var coordinator = new FileViewerCoordinator(root, _tabs);
            _coordinators.Add(coordinator);
            coordinator.Start(async evt => await InvokeAsync(async () =>
            {
                await coordinator.ApplyAsync(evt);
                // 通知文件树刷新受影响的目录
                TreeState.Notify(evt);
                StateHasChanged();
            }));
        }
    }

    private void DisposeCoordinators()
    {
        foreach (var coordinator in _coordinators)
            coordinator.Dispose();
        _coordinators.Clear();
    }

    /// <summary>重试初始化（工作区解析失败后的恢复入口）。</summary>
    private async Task RetryAsync()
    {
        _error = null;
        await TryInitWorkspaceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void DismissError()
    {
        _error = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetError(string? message)
    {
        if (_error == message) return;
        _error = message;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>读取文件；失败时返回错误文案（不抛出，避免冒泡到渲染器）。</summary>
    private async Task<(FileReadResult? File, string? Error)> TryReadAsync(FileResourceId id)
    {
        var workspace = _workspaces?.Find(id);
        if (workspace is null)
            return (null, "文件所属目录已不在本会话中");
        try
        {
            var file = await workspace.ReadAsync(workspace.GetAbsolutePath(id), FileReadMode.Display);
            return (file, null);
        }
        catch (Exception ex)
        {
            return (null, FileErrorPresenter.Describe(ex));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 消费 agent 待处理打开请求（面板刚打开时宿主尚未就绪，故在渲染后处理）
        await ConsumePendingOpenAsync();
        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnPanelChanged() => _ = InvokeAsync(async () =>
    {
        await ConsumePendingOpenAsync();
        StateHasChanged();
    });

    private async Task ConsumePendingOpenAsync()
    {
        if (_workspaces is null || PanelState.PendingOpen is not { } pending) return;
        PanelState.ConsumePendingOpen();
        await OpenOrActivateAsync(pending.Id, refreshIfActive: true, pending.Line, pending.Column, pending.Preview);
    }

    private void OnTabsChanged() => _ = InvokeAsync(() =>
    {
        // 树与右侧激活标签联动：高亮对应文件并展开祖先目录
        SyncTreeSelection();
        // 工作台视图据此上报「正在看哪个文件」，无需反查 FileTabsState
        PanelState.SetActiveFile(_tabs.OpenFiles.FirstOrDefault(x => x.Id.ToString() == _tabs.ActiveKey));
        // 无打开文件且目录树收起时，连同文件面板一起关闭；否则保持「无打开文件」状态
        ClosePanelIfEmpty();
        StateHasChanged();
    });

    /// <summary>把当前激活标签同步给目录树（高亮 + 展开定位）。</summary>
    private void SyncTreeSelection()
    {
        var active = _tabs.OpenFiles.FirstOrDefault(x => x.Id.ToString() == _tabs.ActiveKey);
        TreeState.SetSelected(active?.Id);
    }

    private void HideTree()
    {
        PanelState.SetTreeVisible(false);
        ClosePanelIfEmpty();
    }

    private void ShowTree() => PanelState.SetTreeVisible(true);

    /// <summary>
    /// 关闭请求：目录树隐藏且无标签时由本组件自行收起；
    /// 面板级关闭（关掉整个工作台）由工作台平台的标签条负责。
    /// </summary>
    private void ClosePanel() => OnRequestClose.InvokeAsync();

    /// <summary>无打开文件且目录树不可见时请求关闭工作台。</summary>
    private void ClosePanelIfEmpty()
    {
        if (_tabs.OpenFiles.Count == 0 && !PanelState.TreeVisible)
            _ = OnRequestClose.InvokeAsync();
    }

    private async Task SaveActiveAsync()
    {
        if (_editor is null)
        {
            _tabs.SetNotice("保存失败：编辑器还没准备好", isError: true);
            return;
        }
        try
        {
            await _editor.SaveActiveAsync();
        }
        catch (Exception ex)
        {
            _tabs.SetNotice("保存失败：" + ex.Message, isError: true);
        }
    }

    private async Task OnOpenFileAsync(FileResourceId id)
    {
        if (_workspaces is null) return;
        await OpenOrActivateAsync(id, refreshIfActive: false);
    }

    /// <summary>宿主桥接入口：agent 改动某文件。</summary>
    public async Task NotifyAgentChangeAsync(FileResourceId id, FileDiffData? diff)
    {
        if (_workspaces is null) return;
        var (file, error) = await TryReadAsync(id);
        if (file is null)
        {
            SetError(error);
            return;
        }
        var binary = await ReadBinaryIfNeededAsync(file);
        _tabs.Open(file, binary);
        _tabs.SetPendingDiff(id, diff);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 打开/切换/刷新：已是当前标签则按需从磁盘刷新；已在其他标签则切换；否则新开标签。
    /// 若指定 line/column，则定位到该位置（1-based）。
    /// </summary>
    public async Task OpenOrActivateAsync(
        FileResourceId id, bool refreshIfActive, int? line = null, int? column = null, bool? preview = null)
    {
        if (_workspaces is null) return;

        var key = id.ToString();
        var existing = _tabs.OpenFiles.FirstOrDefault(x => x.Id.ToString() == key);
        if (existing is not null)
        {
            if (string.Equals(_tabs.ActiveKey, key, StringComparison.Ordinal))
            {
                if (refreshIfActive)
                    await RefreshAsync(id);
            }
            else
            {
                _tabs.Activate(id);
            }
        }
        else
        {
            var (file, error) = await TryReadAsync(id);
            if (file is null)
            {
                SetError(error);
                return;
            }
            var binary = await ReadBinaryIfNeededAsync(file);
            _tabs.Open(file, binary);
        }

        // 显式 preview 覆盖标签默认值（agent 可要求以编辑态打开 .md）
        if (preview is { } wantPreview)
            _tabs.SetPreview(id, wantPreview);

        SetError(null);
        if (line is not null)
            await NavigateToAsync(line.Value, column);
    }

    /// <summary>导航到当前激活文件的行/列（1-based）；委托给已渲染的编辑器。</summary>
    public async Task NavigateToAsync(int line, int? column = null)
    {
        // 编辑器随标签激活重建，需在渲染完成后调用
        await InvokeAsync(StateHasChanged);
        if (_editor is not null)
            await _editor.NavigateToAsync(line, column);
    }

    /// <summary>宿主请求入口：执行编辑器命令。</summary>
    public async Task<HostResponsePayload> ExecuteEditorCommandAsync(string commandId, System.Text.Json.JsonElement? args, string? path)
    {
        if (_workspaces is null) return HostResponsePayload.Unavailable;
        if (!string.IsNullOrEmpty(path) && !await EnsureActiveAsync(path))
            return HostResponsePayload.Unavailable;
        var f = _tabs.OpenFiles.FirstOrDefault(x => x.Id.ToString() == _tabs.ActiveKey);
        if (f is null || f.IsReadOnly || f.IsDeleted || f.Kind is FileContentKind.Image or FileContentKind.Binary)
            return HostResponsePayload.Unavailable;
        if (_editor is null) return HostResponsePayload.Unavailable;
        var outcome = await _editor.ExecuteCommandAsync(commandId, args);
        return outcome == CommandOutcome.Ok ? HostResponsePayload.Ok() : HostResponsePayload.Unavailable;
    }

    /// <summary>宿主请求入口：查询编辑器状态。</summary>
    public async Task<HostResponsePayload> QueryEditorAsync(string kind, string? path)
    {
        if (_workspaces is null) return HostResponsePayload.Unavailable;
        if (!string.IsNullOrEmpty(path) && !await EnsureActiveAsync(path))
            return HostResponsePayload.Unavailable;
        if (_editor is null) return HostResponsePayload.Unavailable;
        var json = await _editor.QueryAsync(kind);
        return json is null ? HostResponsePayload.Unavailable : HostResponsePayload.Ok(json);
    }

    /// <summary>宿主请求入口：列举命令。</summary>
    public async Task<HostResponsePayload> ListEditorCommandsAsync()
    {
        if (_editor is null) return HostResponsePayload.Unavailable;
        var json = await _editor.ListCommandsAsync();
        return json is null ? HostResponsePayload.Unavailable : HostResponsePayload.Ok(json);
    }

    /// <summary>
    /// 确保指定文件成为当前激活标签；打开/切换失败返回 false（不落到旧文件上执行）。
    /// </summary>
    private async Task<bool> EnsureActiveAsync(string path)
    {
        var id = await ResolveIdAsync(path);
        if (id is null) return false;
        await OpenOrActivateAsync(id.Value, refreshIfActive: false);
        return string.Equals(_tabs.ActiveKey, id.Value.ToString(), StringComparison.Ordinal);
    }

    /// <summary>把路径路由到所属根并转成资源标识；不属于任何根时返回 null。</summary>
    private async Task<FileResourceId?> ResolveIdAsync(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return null;

        var absolute = path;
        if (!Path.IsPathFullyQualified(absolute))
        {
            // 相对路径按项目根解析（不使用进程 CWD）
            var projectRoot = _workspaces?.Roots
                .FirstOrDefault(r => r.Root.Kind == FileWorkspaceRootKind.Project)?.RootPath;
            if (projectRoot is null) return null;
            absolute = Path.GetFullPath(absolute, projectRoot);
        }

        // 先用已加载的根做纯计算；未命中再问工厂（可处理尚未预热的会话）
        var workspace = _workspaces?.FindByPath(absolute)
            ?? await WorkspaceFactory.ResolveAsync(SessionId!, absolute);
        return workspace?.GetResourceId(absolute);
    }

    /// <summary>把 <see cref="IObservable{T}"/> 的 OnNext 转成回调（不引入 System.Reactive）。</summary>
    private sealed class SessionEventObserver(Action<SessionEvent> onNext) : IObserver<SessionEvent>
    {
        public void OnCompleted() { }
        public void OnError(Exception error) { }
        public void OnNext(SessionEvent value) => onNext(value);
    }

    /// <summary>
    /// 宿主桥接入口：按路径打开（工作台打开载荷用）。
    /// <para>路径先路由到所属根，再到该根的资源标识。</para>
    /// </summary>
    /// <param name="path">文件路径（绝对或相对工作目录）。</param>
    /// <param name="line">跳转行号（1-based，可空）。</param>
    /// <param name="column">跳转列号（1-based，可空）。</param>
    /// <param name="preview">是否预览（null = 用标签默认值）。</param>
    public async Task OpenPathAsync(string path, int? line = null, int? column = null, bool? preview = null)
    {
        if (string.IsNullOrWhiteSpace(path))
            return;

        // 打开载荷可能在根列表就绪前到达（工作台挂载与首帧渲染竞争）
        if (_workspaces is null)
            await TryInitWorkspaceAsync();

        if (_workspaces is null)
        {
            SetError("文件工作区尚未就绪");
            return;
        }

        var id = await ResolveIdAsync(path);
        if (id is null)
        {
            SetError("路径不属于本会话的任何根");
            return;
        }

        await OpenOrActivateAsync(id.Value, refreshIfActive: false, line, column, preview);
    }

    private async Task RefreshAsync(FileResourceId id)
    {
        var (file, error) = await TryReadAsync(id);
        if (file is null)
        {
            SetError(error);
            return;
        }
        var binary = await ReadBinaryIfNeededAsync(file);
        _tabs.ApplyDiskUpdate(file, binary);
        SetError(null);
    }

    private async Task<byte[]?> ReadBinaryIfNeededAsync(FileReadResult file)
    {
        if (file.Kind is not (FileContentKind.Image or FileContentKind.Binary)) return null;
        var workspace = _workspaces?.Find(file.Id);
        if (workspace is null) return null;
        try { return await workspace.ReadBytesAsync(workspace.GetAbsolutePath(file.Id)); }
        catch { return null; }
    }

    public void Dispose()
    {
        _sessionEventSubscription?.Dispose();
        _tabs.Changed -= OnTabsChanged;
        PanelState.Changed -= OnPanelChanged;
        DisposeCoordinators();
        // 幂等全清会话缓存（不做引用计数）
        if (_workspaces is not null && !string.IsNullOrEmpty(SessionId))
            WorkspaceFactory.Release(SessionId);
    }
}
