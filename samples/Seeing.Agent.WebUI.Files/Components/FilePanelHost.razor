@using Seeing.Agent.Abstractions.Files
@using Seeing.Agent.WebUI.Files.Services
@inject IFileWorkspaceFactory WorkspaceFactory
@inject FilePanelState PanelState
@inject FileTreeState TreeState
@implements IDisposable

<div class="file-panel-host">
    @if (string.IsNullOrEmpty(SessionId))
    {
        <div class="file-panel-empty">无会话</div>
    }
    else if (_workspace is null)
    {
        @if (_error is not null)
        {
            <div class="file-panel-header">
                <span class="file-panel-title">文件</span>
                <button type="button" class="file-panel-close" title="关闭文件面板" @onclick="ClosePanel">×</button>
            </div>
            <div class="file-panel-error" role="alert">
                <div class="file-panel-error-text">@_error</div>
                <button type="button" class="file-panel-error-retry" @onclick="RetryAsync">重试</button>
            </div>
        }
        else
        {
            <div class="file-panel-loading">加载中…</div>
        }
    }
    else
    {
        <div class="file-panel-header">
            <span class="file-panel-title">文件</span>
            <span class="file-panel-header-actions">
                <button type="button" class="file-panel-side" title="切换文件面板左/右位置" @onclick="ToggleSide">
                    <span aria-hidden="true">⇄</span>
                </button>
                <button type="button" class="file-panel-close" title="关闭文件面板" @onclick="ClosePanel">×</button>
            </span>
        </div>
        @if (_error is not null)
        {
            <div class="file-panel-error file-panel-error--banner" role="alert">
                <div class="file-panel-error-text">@_error</div>
                <button type="button" class="file-panel-error-dismiss" title="关闭提示" @onclick="DismissError">×</button>
            </div>
        }
        <div class="file-panel-body @(PanelState.TreeVisible ? "" : "file-panel-body--no-tree")">
            @if (PanelState.TreeVisible)
            {
                <div class="file-tree-wrap">
                    <button type="button" class="file-tree-collapse" title="隐藏目录树" @onclick="HideTree">
                        <span>◀</span>
                    </button>
                    <FileTree Workspace="_workspace" OnOpen="OnOpenFileAsync" />
                </div>
                <ResizeHandle CssVariable="--file-tree-width" Vertical="true" Min="140" Max="600"
                              Default="220" StorageKey="seeing-files-tree-width" />
            }
            else
            {
                <button type="button" class="file-tree-expand" title="显示目录树" @onclick="ShowTree">
                    <span>▶</span>
                </button>
            }
            <div class="file-panel-main">
                <FileTabs Tabs="_tabs" OnSave="SaveActiveAsync" />
                <FileEditor Tabs="_tabs" Workspace="_workspace" @ref="_editor" />
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "SessionId")] private string? SessionId { get; set; }

    private IFileWorkspace? _workspace;
    private FileTabsState _tabs = null!;
    private FileViewerCoordinator? _coordinator;
    private FileEditor? _editor;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(SessionId)) return;
        // 标签状态按会话缓存在 Scoped 的 PanelState 上，页面导航往返不丢失
        _tabs = PanelState.GetTabs(SessionId);
        _tabs.Changed += OnTabsChanged;
        PanelState.Changed += OnPanelChanged;
        await TryInitWorkspaceAsync();
    }

    /// <summary>解析会话工作区并接线变更订阅；失败时展示错误条而非冒泡崩溃。</summary>
    private async Task TryInitWorkspaceAsync()
    {
        if (string.IsNullOrEmpty(SessionId) || _workspace is not null) return;
        try
        {
            _workspace = await WorkspaceFactory.ResolveAsync(SessionId);
        }
        catch (Exception ex)
        {
            _workspace = null;
            _error = FileErrorPresenter.Describe(ex);
            return;
        }

        _coordinator?.Dispose();
        _coordinator = new FileViewerCoordinator(_workspace, _tabs);
        _coordinator.Start(async evt => await InvokeAsync(async () =>
        {
            await _coordinator!.ApplyAsync(evt);
            // 通知文件树刷新受影响的目录
            TreeState.Notify(evt);
            StateHasChanged();
        }));
    }

    /// <summary>重试初始化（工作区解析失败后的恢复入口）。</summary>
    private async Task RetryAsync()
    {
        _error = null;
        await TryInitWorkspaceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void DismissError()
    {
        _error = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetError(string? message)
    {
        if (_error == message) return;
        _error = message;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>读取文件；失败时返回错误文案（不抛出，避免冒泡到渲染器）。</summary>
    private async Task<(FileReadResult? File, string? Error)> TryReadAsync(FileResourceId id)
    {
        if (_workspace is null) return (null, null);
        try
        {
            var file = await _workspace.ReadAsync(_workspace.GetAbsolutePath(id), FileReadMode.Display);
            return (file, null);
        }
        catch (Exception ex)
        {
            return (null, FileErrorPresenter.Describe(ex));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 消费 agent 待处理打开请求（面板刚打开时宿主尚未就绪，故在渲染后处理）
        await ConsumePendingOpenAsync();
        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnPanelChanged() => _ = InvokeAsync(async () =>
    {
        await ConsumePendingOpenAsync();
        StateHasChanged();
    });

    private async Task ConsumePendingOpenAsync()
    {
        if (_workspace is null || PanelState.PendingOpen is not { } pending) return;
        PanelState.ConsumePendingOpen();
        await OpenOrActivateAsync(pending.Id, refreshIfActive: true, pending.Line, pending.Column);
    }

    private void OnTabsChanged() => _ = InvokeAsync(() =>
    {
        // 无打开文件且目录树收起时，连同文件面板一起关闭；否则保持「无打开文件」状态
        ClosePanelIfEmpty();
        StateHasChanged();
    });

    private void HideTree()
    {
        PanelState.SetTreeVisible(false);
        ClosePanelIfEmpty();
    }

    private void ShowTree() => PanelState.SetTreeVisible(true);

    private void ToggleSide() => PanelState.ToggleSide();

    private void ClosePanel() => PanelState.Close();

    /// <summary>无打开文件且目录树不可见时关闭面板。</summary>
    private void ClosePanelIfEmpty()
    {
        if (_tabs.OpenFiles.Count == 0 && !PanelState.TreeVisible)
            PanelState.Close();
    }

    private Task SaveActiveAsync() =>
        _editor is null ? Task.CompletedTask : _editor.SaveActiveAsync();

    private async Task OnOpenFileAsync(FileResourceId id)
    {
        if (_workspace is null) return;
        await OpenOrActivateAsync(id, refreshIfActive: false);
    }

    /// <summary>宿主桥接入口：agent 改动某文件。</summary>
    public async Task NotifyAgentChangeAsync(FileResourceId id, FileDiffData? diff)
    {
        if (_workspace is null) return;
        var (file, error) = await TryReadAsync(id);
        if (file is null)
        {
            SetError(error);
            return;
        }
        var binary = await ReadBinaryIfNeededAsync(file);
        _tabs.Open(file, binary);
        _tabs.SetPendingDiff(id, diff);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 打开/切换/刷新：已是当前标签则按需从磁盘刷新；已在其他标签则切换；否则新开标签。
    /// 若指定 line/column，则定位到该位置（1-based）。
    /// </summary>
    public async Task OpenOrActivateAsync(FileResourceId id, bool refreshIfActive, int? line = null, int? column = null)
    {
        if (_workspace is null) return;

        var key = id.ToString();
        var existing = _tabs.OpenFiles.FirstOrDefault(x => x.Id.ToString() == key);
        if (existing is not null)
        {
            if (string.Equals(_tabs.ActiveKey, key, StringComparison.Ordinal))
            {
                if (refreshIfActive)
                    await RefreshAsync(id);
            }
            else
            {
                _tabs.Activate(id);
            }
        }
        else
        {
            var (file, error) = await TryReadAsync(id);
            if (file is null)
            {
                SetError(error);
                return;
            }
            var binary = await ReadBinaryIfNeededAsync(file);
            _tabs.Open(file, binary);
        }

        SetError(null);
        if (line is not null)
            await NavigateToAsync(line.Value, column);
    }

    /// <summary>导航到当前激活文件的行/列（1-based）；委托给已渲染的编辑器。</summary>
    public async Task NavigateToAsync(int line, int? column = null)
    {
        // 编辑器随标签激活重建，需在渲染完成后调用
        await InvokeAsync(StateHasChanged);
        if (_editor is not null)
            await _editor.NavigateToAsync(line, column);
    }

    /// <summary>宿主请求入口：执行编辑器命令。</summary>
    public async Task<HostResponsePayload> ExecuteEditorCommandAsync(string commandId, System.Text.Json.JsonElement? args, string? path)
    {
        if (_workspace is null) return HostResponsePayload.Unavailable;
        if (!string.IsNullOrEmpty(path))
            await OpenOrActivateAsync(_workspace.GetResourceId(path), refreshIfActive: false);
        var f = _tabs.OpenFiles.FirstOrDefault(x => x.Id.ToString() == _tabs.ActiveKey);
        if (f is null || f.IsReadOnly || f.IsDeleted || f.Kind is FileContentKind.Image or FileContentKind.Binary)
            return HostResponsePayload.Unavailable;
        if (_editor is null) return HostResponsePayload.Unavailable;
        var outcome = await _editor.ExecuteCommandAsync(commandId, args);
        return outcome == CommandOutcome.Ok ? HostResponsePayload.Ok() : HostResponsePayload.Unavailable;
    }

    /// <summary>宿主请求入口：查询编辑器状态。</summary>
    public async Task<HostResponsePayload> QueryEditorAsync(string kind, string? path)
    {
        if (_workspace is null) return HostResponsePayload.Unavailable;
        if (!string.IsNullOrEmpty(path))
            await OpenOrActivateAsync(_workspace.GetResourceId(path), refreshIfActive: false);
        if (_editor is null) return HostResponsePayload.Unavailable;
        var json = await _editor.QueryAsync(kind);
        return json is null ? HostResponsePayload.Unavailable : HostResponsePayload.Ok(json);
    }

    /// <summary>宿主请求入口：列举命令。</summary>
    public async Task<HostResponsePayload> ListEditorCommandsAsync()
    {
        if (_editor is null) return HostResponsePayload.Unavailable;
        return HostResponsePayload.Ok(await _editor.ListCommandsAsync());
    }

    private async Task RefreshAsync(FileResourceId id)
    {
        if (_workspace is null) return;
        var (file, error) = await TryReadAsync(id);
        if (file is null)
        {
            SetError(error);
            return;
        }
        var binary = await ReadBinaryIfNeededAsync(file);
        _tabs.ApplyDiskUpdate(file, binary);
        SetError(null);
    }

    private async Task<byte[]?> ReadBinaryIfNeededAsync(FileReadResult file)
    {
        if (_workspace is null) return null;
        if (file.Kind is not (FileContentKind.Image or FileContentKind.Binary)) return null;
        try { return await _workspace.ReadBytesAsync(_workspace.GetAbsolutePath(file.Id)); }
        catch { return null; }
    }

    public void Dispose()
    {
        _tabs.Changed -= OnTabsChanged;
        PanelState.Changed -= OnPanelChanged;
        _coordinator?.Dispose();
        // 仅在实际解析成功（持有引用计数）时释放；解析失败从未获取引用
        if (_workspace is not null && !string.IsNullOrEmpty(SessionId))
            WorkspaceFactory.Release(SessionId);
    }
}
