@using Seeing.Agent.Abstractions.Files
@using Seeing.Agent.WebUI.Files.Services

<div class="file-tree">
    @if (Roots.Count == 0)
    {
        <div class="file-tree-empty">空目录</div>
    }
    else
    {
        <ul class="file-tree-list">
            @foreach (var root in Roots)
            {
                <FileTreeNode Entry="FileTreeRoots.Entry(root)"
                              Workspace="root"
                              OnOpen="OnOpen"
                              Depth="0"
                              Badge="FileTreeRoots.Badge(root.Root.Kind)"
                              BadgeClass="FileTreeRoots.BadgeClass(root.Root.Kind)"
                              Title="root.RootPath"
                              DefaultExpanded="true" />
            }
        </ul>
    }
</div>

@code {
    /// <summary>全部文件根（项目根在前，协同目录随后）。</summary>
    [Parameter, EditorRequired] public IReadOnlyList<IFileWorkspace> Roots { get; set; } = Array.Empty<IFileWorkspace>();

    /// <summary>点击文件回调。</summary>
    [Parameter] public EventCallback<FileResourceId> OnOpen { get; set; }
}
