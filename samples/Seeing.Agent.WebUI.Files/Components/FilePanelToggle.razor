@using Seeing.Agent.WebUI.Files.Services
@inject FilePanelState PanelState
@implements IDisposable

<button type="button" class="file-panel-toggle @(IsActive ? "active" : "")" @onclick="Toggle">
    <span>文件</span>
</button>

@code {
    [CascadingParameter(Name = "SessionId")] private string? SessionId { get; set; }

    private bool IsActive =>
        PanelState.IsOpen && string.Equals(PanelState.SessionId, SessionId, StringComparison.Ordinal);

    protected override void OnInitialized() => PanelState.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Toggle() => PanelState.Toggle(SessionId ?? "");

    public void Dispose() => PanelState.Changed -= OnChanged;
}
