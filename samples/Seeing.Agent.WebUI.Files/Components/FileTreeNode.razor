@using Seeing.Agent.Abstractions.Files
@using Seeing.Agent.WebUI.Files.Services
@using Microsoft.JSInterop
@inject FileTreeState TreeState
@inject IJSRuntime JS
@implements IDisposable

<li class="file-tree-node">
    @if (Entry.IsDirectory)
    {
        <div class="file-tree-dir" style="@($"padding-left:{Depth * 12}px")" @onclick="ToggleAsync">
            <span class="file-tree-arrow">@(_expanded ? "▾" : "▸")</span>
            <svg class="file-tree-icon file-tree-icon--dir" viewBox="0 0 1024 1024" width="14" height="14" aria-hidden="true">
                <path fill="currentColor" d="M880 298.4H521L403.7 186.2a8.15 8.15 0 0 0-5.5-2.2H144c-17.7 0-32 14.3-32 32v592c0 17.7 14.3 32 32 32h736c17.7 0 32-14.3 32-32V330.4c0-17.7-14.3-32-32-32zM840 768H184V256h188.5l119.6 114.4H840V768z" />
            </svg>
            <span class="file-tree-name">@Entry.Name</span>
        </div>
        @if (_expanded)
        {
            <ul class="file-tree-list">
                @if (_loading)
                {
                    <li class="file-tree-loading">加载中…</li>
                }
                else
                {
                    @foreach (var child in _children)
                    {
                        <FileTreeNode Entry="child" Workspace="Workspace" OnOpen="OnOpen" Depth="Depth + 1" />
                    }
                }
            </ul>
        }
    }
    else
    {
        <div class="file-tree-file @(IsSelected ? "selected" : "")" style="@($"padding-left:{Depth * 12 + 12}px")" @ref="_fileEl" @onclick="() => OnOpen.InvokeAsync(Entry.Id)">
            <svg class="file-tree-icon file-tree-icon--file @FileIconClass(Entry.Name)" viewBox="0 0 1024 1024" width="14" height="14" aria-hidden="true">
                <path fill="currentColor" d="M854.6 288.6L639.4 73.4c-6-6-14.1-9.4-22.6-9.4H192c-17.7 0-32 14.3-32 32v832c0 17.7 14.3 32 32 32h640c17.7 0 32-14.3 32-32V311.3c0-8.5-3.4-16.7-9.4-22.7zM790.2 326H602V137.8L790.2 326zm1.8 562H232V136h302v216a42 42 0 0 0 42 42h216v494z" />
            </svg>
            <span class="file-tree-name">@Entry.Name</span>
        </div>
    }
</li>

@code {
    /// <summary>当前目录项。</summary>
    [Parameter, EditorRequired] public FileEntry Entry { get; set; } = default!;

    /// <summary>目标文件工作区。</summary>
    [Parameter, EditorRequired] public IFileWorkspace Workspace { get; set; } = default!;

    /// <summary>点击文件回调。</summary>
    [Parameter] public EventCallback<FileResourceId> OnOpen { get; set; }

    /// <summary>缩进层级。</summary>
    [Parameter] public int Depth { get; set; }

    private bool _expanded;
    private bool _loading;
    private List<FileEntry> _children = [];
    private ElementReference _fileEl;
    private int _lastScrollVersion = -1;

    /// <summary>本目录的相对路径（正斜杠；根为 ""）。</summary>
    private string DirRelative => Entry.Id.RelativePath.Replace('\\', '/');

    /// <summary>本文件的相对路径（正斜杠）。</summary>
    private string RelPath => Entry.Id.RelativePath.Replace('\\', '/');

    /// <summary>本节点是否为当前激活文件（选中高亮）。</summary>
    private bool IsSelected => !Entry.IsDirectory
        && string.Equals(TreeState.SelectedFile, RelPath, StringComparison.OrdinalIgnoreCase);

    /// <summary>选中文件是否位于本目录之下（驱动祖先目录自动展开）。</summary>
    private bool SelectionInDir => Entry.IsDirectory
        && TreeState.SelectedFile is { } sel
        && sel.Length > DirRelative.Length + 1
        && sel.StartsWith(DirRelative + "/", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        TreeState.Changed += OnTreeChanged;
        TreeState.SelectionChanged += OnSelectionChanged;
        // 树（重新）构建时选中路径已存在（如树收起后再展开/页面往返）：初始化即沿路径展开
        if (SelectionInDir)
            await ExpandAsync();
    }

    private void OnSelectionChanged()
    {
        if (!Entry.IsDirectory)
        {
            // 文件节点：刷新高亮
            _ = InvokeAsync(StateHasChanged);
            return;
        }
        // 目录节点：选中文件位于本目录之下且未展开 → 展开以定位
        if (!_expanded && SelectionInDir)
            _ = InvokeAsync(async () => { await ExpandAsync(); StateHasChanged(); });
    }

    private void OnTreeChanged(FileChangeEvent evt)
    {
        if (!_expanded) return;

        // 变更项是本目录直接子级 → 重列；或改名涉及本目录下条目
        var affected = FileTreeState.IsDirectChildOf(evt.Id, DirRelative);
        if (!affected && evt.Kind == FileChangeKind.Renamed && evt.OldPath is { } old)
            affected = FileTreeState.IsDirectChildOf(Workspace.GetResourceId(old), DirRelative);

        if (affected)
            _ = InvokeAsync(ReloadAndRenderAsync);
    }

    private async Task ReloadAndRenderAsync()
    {
        await LoadChildrenAsync();
        StateHasChanged();
    }

    /// <summary>从磁盘重列本目录子项（失败时保留现有子项，等待父级刷新）。</summary>
    private async Task LoadChildrenAsync()
    {
        try
        {
            var entries = await Workspace.ListAsync(Workspace.GetAbsolutePath(Entry.Id));
            _children = entries
                .OrderByDescending(e => e.IsDirectory)
                .ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            // 目录被删除等竞态：保留现有子项，等待父级刷新
        }
    }

    /// <summary>展开本目录；子项未加载时先加载（已有缓存则直接复用）。</summary>
    private async Task ExpandAsync()
    {
        if (_expanded) return;
        _expanded = true;
        if (_children.Count > 0) return;

        _loading = true;
        try
        {
            await LoadChildrenAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 选中文件渲染为可见后滚动定位；同一选中版本只滚一次（预渲染阶段无 ElementReference）
        if (_fileEl.Context is null || !IsSelected) return;
        var version = TreeState.SelectionVersion;
        if (version == _lastScrollVersion) return;
        _lastScrollVersion = version;
        try
        {
            await JS.InvokeVoidAsync("seeingFilesPanel.scrollTreeNodeIntoView", _fileEl);
        }
        catch (JSDisconnectedException) { /* circuit 已断开：忽略 */ }
        catch (ObjectDisposedException) { /* 组件已销毁：忽略 */ }
    }

    public void Dispose()
    {
        TreeState.Changed -= OnTreeChanged;
        TreeState.SelectionChanged -= OnSelectionChanged;
    }

    /// <summary>按扩展名返回图标着色类（仅视觉区分，未知扩展名返回空）。</summary>
    private static string FileIconClass(string name)
    {
        var ext = Path.GetExtension(name).TrimStart('.').ToLowerInvariant();
        return ext switch
        {
            "cs" or "js" or "ts" or "jsx" or "tsx" or "py" or "go" or "rs" or "java" or "c" or "cpp" or "h" => "file-tree-icon--code",
            "md" or "markdown" or "txt" or "rst" => "file-tree-icon--doc",
            "json" or "xml" or "yml" or "yaml" or "toml" or "ini" or "config" or "csproj" or "props" or "targets" or "slnx" => "file-tree-icon--config",
            "png" or "jpg" or "jpeg" or "gif" or "svg" or "webp" or "bmp" or "ico" => "file-tree-icon--image",
            "html" or "htm" or "css" or "scss" or "razor" => "file-tree-icon--web",
            "sh" or "bash" or "ps1" or "bat" or "cmd" => "file-tree-icon--script",
            _ => "",
        };
    }

    private async Task ToggleAsync()
    {
        if (_expanded)
        {
            _expanded = false;
            return;
        }
        await ExpandAsync();
    }
}
