@using Seeing.Agent.Abstractions.Files
@using Seeing.Agent.WebUI.Files.Services
@using BlazorMonaco
@using BlazorMonaco.Editor
@inject IJSRuntime JS
@implements IDisposable

<div class="file-editor">
    @{ var f = Tabs.OpenFiles.FirstOrDefault(x => x.Id.ToString() == Tabs.ActiveKey); }
    @if (f is null)
    {
        <div class="file-viewer-empty">选择文件</div>
    }
    else if (f.IsDeleted)
    {
        <div class="file-viewer-deleted">文件已删除</div>
    }
    else if (f.Kind is FileContentKind.Image or FileContentKind.Binary)
    {
        <FileViewer Tabs="Tabs" />
    }
    else if (f.IsReadOnly)
    {
        <div class="file-editor-toolbar">
            <span class="file-editor-readonly">只读（截断 / 非 UTF-8 / 超大文件）</span>
        </div>
        <FileViewer Tabs="Tabs" />
    }
    else
    {
        @if (f.PendingDiff is { } diff)
        {
            if (diff.HasFullContent)
            {
                <FileDiffEditor Diff="diff" OnCloseRequested="() => CloseDiff(f.Id)" />
            }
            else if (!string.IsNullOrEmpty(diff.Unified))
            {
                <div class="file-diff-fallback">
                    <div class="file-diff-editor-toolbar">
                        <span class="file-diff-editor-label">变更预览</span>
                        <button type="button" class="file-diff-editor-close" title="关闭预览" @onclick="() => CloseDiff(f.Id)">×</button>
                    </div>
                    <pre class="file-diff">@diff.Unified</pre>
                </div>
            }
        }
        <div class="file-editor-monaco">
            @* @key 含 DiskVersion：磁盘/agent 更新（ApplyDiskUpdate/Reload 使 DiskVersion 前进）时重建编辑器
               以刷新内容，避免 JS 编辑器残留旧文本导致保存覆盖外部改动；用户本地编辑不改 DiskVersion，不会重建 *@
            <StandaloneCodeEditor @key="EditorKey(f)"
                                  @ref="_editor"
                                  Id="@CurrentEditorId"
                                  ConstructionOptions="(editor => EditorOptions(f))"
                                  OnDidChangeModelContent="OnContentChanged" />
        </div>
        @if (_saveError is not null)
        {
            <div class="file-editor-error" role="alert">
                <span class="file-editor-error-text">@_saveError</span>
                <button type="button" class="file-editor-error-dismiss" title="关闭提示" @onclick="DismissSaveError">×</button>
            </div>
        }
    }
</div>

@if (_conflictOpen && _active is not null)
{
    <div class="file-conflict-overlay">
        <div class="file-conflict-dialog">
            <div class="file-conflict-title">文件已被外部修改</div>
            <div class="file-conflict-body">
                磁盘上的 <code>@_active.Id.RelativePath</code> 已被 agent 或外部程序修改，而你有未保存的编辑。
            </div>
            @if (!string.IsNullOrEmpty(_conflictDiff))
            {
                <pre class="file-diff file-conflict-diff">@_conflictDiff</pre>
            }
            <div class="file-conflict-actions">
                <button type="button" class="file-conflict-reload" @onclick="ReloadFromDiskAsync">重新加载（丢弃我的修改）</button>
                <button type="button" class="file-conflict-keep" @onclick="KeepLocal">保留我的修改</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>标签状态。</summary>
    [Parameter, EditorRequired] public FileTabsState Tabs { get; set; } = default!;

    /// <summary>目标文件工作区。</summary>
    [Parameter, EditorRequired] public IFileWorkspace Workspace { get; set; } = default!;

    private StandaloneCodeEditor? _editor;
    private OpenFile? _active;
    private bool _conflictOpen;
    private string? _conflictDiff;
    private string? _saveError;
    private long _saveToken;
    private DotNetObjectReference<FileEditor>? _selfRef;

    private OpenFile? ActiveFile => Tabs.OpenFiles.FirstOrDefault(x => x.Id.ToString() == Tabs.ActiveKey);

    private static string Sanitize(string rel) =>
        string.Concat(rel.Select(c => char.IsLetterOrDigit(c) ? c : '_'));

    // key 含磁盘版本号：仅当磁盘内容被应用时重建编辑器，用户编辑（MarkDirty）不重建
    private static string EditorKey(OpenFile f) =>
        $"{f.Id}|{f.DiskVersion}";

    private static StandaloneEditorConstructionOptions EditorOptions(OpenFile f) => new()
    {
        Language = LanguageFor(f),
        Value = f.Content,
        AutomaticLayout = true,
        ReadOnly = f.IsReadOnly,
        Minimap = new EditorMinimapOptions { Enabled = false },
        ScrollBeyondLastLine = false,
        FontSize = 13,
    };

    private static string LanguageFor(OpenFile f)
    {
        var ext = Path.GetExtension(f.Id.RelativePath).TrimStart('.').ToLowerInvariant();
        return ext switch
        {
            "cs" => "csharp",
            "js" => "javascript",
            "ts" => "typescript",
            "json" => "json",
            "md" => "markdown",
            "xml" or "csproj" or "props" or "targets" or "slnx" => "xml",
            "html" => "html",
            "css" => "css",
            "py" => "python",
            "yml" or "yaml" => "yaml",
            "sh" or "bash" => "shell",
            "ps1" => "powershell",
            "sql" => "sql",
            _ => "plaintext",
        };
    }

    private void OnContentChanged(ModelContentChangedEvent e)
    {
        var f = ActiveFile;
        if (f is null || f.IsReadOnly) return;
        _ = SyncFromEditorAsync(f);
    }

    private async Task SyncFromEditorAsync(OpenFile f)
    {
        if (_editor is null) return;
        var value = await _editor.GetValue();
        if (value != f.Content)
            Tabs.MarkDirty(f.Id, value);
    }

    /// <summary>Ctrl+S 保存（宿主标签栏保存按钮亦调用此入口）。</summary>
    [JSInvokable]
    public Task OnSaveShortcut() => SaveActiveAsync();

    /// <summary>关闭当前文件的 diff 预览。</summary>
    private void CloseDiff(FileResourceId id) => Tabs.ClearPendingDiff(id);

    private void DismissSaveError()
    {
        _saveError = null;
        StateHasChanged();
    }

    /// <summary>
    /// 导航到指定行/列（1-based）。仅对当前激活的文本编辑器生效；非文本/只读/未打开时静默忽略。
    /// 需在目标文件已激活并完成渲染后调用。
    /// </summary>
    public async Task NavigateToAsync(int line, int? column = null)
    {
        var f = ActiveFile;
        if (f is null || _editor is null) return;
        if (f.Kind is FileContentKind.Image or FileContentKind.Binary) return;

        var ln = Math.Max(1, line);
        var col = Math.Max(1, column ?? 1);
        try
        {
            await _editor.RevealLineInCenter(ln);
            await _editor.SetPosition(new Position { LineNumber = ln, Column = col }, "seeing-navigate");
            await _editor.Focus();
        }
        catch
        {
            // 编辑器尚未就绪（JS 未挂载）时忽略
        }
    }

    /// <summary>保存当前标签（供宿主标签栏按钮调用）。</summary>
    public async Task SaveActiveAsync()
    {
        var f = ActiveFile;
        if (f is null || f.IsReadOnly || f.IsDeleted) return;
        if (_editor is not null)
            f.Content = await _editor.GetValue();

        FileWriteResult result;
        try
        {
            result = await Workspace.WriteAsync(Workspace.GetAbsolutePath(f.Id), f.Content, f.OpenedRevision);
        }
        catch (Exception ex)
        {
            _saveError = FileErrorPresenter.Describe(ex);
            StateHasChanged();
            return;
        }

        if (result.Conflict)
        {
            Tabs.MarkExternalConflict(f.Id);
            _active = f;
            _conflictOpen = true;
            _conflictDiff = await TryGetConflictDiffAsync(f);
            StateHasChanged();
            return;
        }

        f.HasUnsavedChanges = false;
        f.OpenedRevision = result.Revision;
        f.PendingDiff = null;
        _saveError = null;
        try
        {
            Tabs.Open(await Workspace.ReadAsync(Workspace.GetAbsolutePath(f.Id), FileReadMode.Display));
        }
        catch (Exception ex)
        {
            // 保存已成功；回读失败不应冒泡，仅提示
            _saveError = FileErrorPresenter.Describe(ex);
        }
        StateHasChanged();
    }

    /// <summary>执行 Monaco 命令（透传 commandId/payload）。</summary>
    public async Task<CommandOutcome> ExecuteCommandAsync(string commandId, System.Text.Json.JsonElement? args)
    {
        if (_editor is null) return CommandOutcome.NoEditor;
        try
        {
            await _editor.Trigger("seeing-agent", commandId, args);
            return CommandOutcome.Ok;
        }
        catch { return CommandOutcome.Failed; }
    }

    /// <summary>查询编辑器状态；返回结构化 JSON 载荷，无法查询时返回 null。</summary>
    public async Task<System.Text.Json.JsonElement?> QueryAsync(string kind)
    {
        if (_editor is null) return null;
        try
        {
            switch (kind)
            {
                case "selection":
                    var sel = await _editor.GetSelection();
                    return sel is null ? null : System.Text.Json.JsonSerializer.SerializeToElement(
                        new { sel.StartLineNumber, sel.StartColumn, sel.EndLineNumber, sel.EndColumn });
                case "cursor":
                    var pos = await _editor.GetPosition();
                    return pos is null ? null : System.Text.Json.JsonSerializer.SerializeToElement(
                        new { pos.LineNumber, pos.Column });
                case "value":
                    var text = await _editor.GetValue();
                    var truncated = text.Length > MaxQueryValueLength;
                    return System.Text.Json.JsonSerializer.SerializeToElement(new
                    {
                        value = truncated ? text[..MaxQueryValueLength] : text,
                        length = text.Length,
                        truncated
                    });
                case "visibleRanges":
                    return System.Text.Json.JsonSerializer.SerializeToElement(await _editor.GetVisibleRanges());
                case "diagnostics":
                    var markers = await BlazorMonaco.Editor.Global.GetModelMarkers(JS, null);
                    return System.Text.Json.JsonSerializer.SerializeToElement(markers);
                default:
                    return null;
            }
        }
        catch { return null; }
    }

    private const int MaxQueryValueLength = 50_000;

    /// <summary>列举当前编辑器支持的命令（JSON 数组载荷）。</summary>
    public async Task<System.Text.Json.JsonElement?> ListCommandsAsync()
    {
        var json = await JS.InvokeAsync<string>("seeingEditor.getActions", CurrentEditorId);
        if (string.IsNullOrEmpty(json)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return doc.RootElement.Clone();
        }
        catch { return null; }
    }

    private string CurrentEditorId =>
        $"file-editor-{Sanitize(ActiveFile?.Id.RelativePath ?? "")}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _saveToken = await JS.InvokeAsync<long>("seeingFilesPanel.attachSaveShortcut", _selfRef);
        }

        // 外部（agent/磁盘）冲突标记出现时弹出对话框
        var f = ActiveFile;
        if (f is not null && f.HasExternalConflict && !_conflictOpen)
        {
            _active = f;
            _conflictOpen = true;
            _conflictDiff = await TryGetConflictDiffAsync(f);
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
        if (_saveToken != 0)
        {
            try { _ = JS.InvokeVoidAsync("seeingFilesPanel.detachSaveShortcut", _saveToken); }
            catch { /* circuit 已断开 */ }
        }
        _selfRef?.Dispose();
    }

    private async Task<string?> TryGetConflictDiffAsync(OpenFile f)
    {
        try
        {
            var disk = await Workspace.ReadAsync(Workspace.GetAbsolutePath(f.Id), FileReadMode.Display);
            if (disk.Content is null) return null;
            return await Workspace.GetDiffAsync(Workspace.GetAbsolutePath(f.Id), f.Content);
        }
        catch { return null; }
    }

    private async Task ReloadFromDiskAsync()
    {
        var f = _active;
        if (f is null) return;
        FileReadResult disk;
        try
        {
            disk = await Workspace.ReadAsync(Workspace.GetAbsolutePath(f.Id), FileReadMode.Display);
        }
        catch (Exception ex)
        {
            _saveError = FileErrorPresenter.Describe(ex);
            _conflictOpen = false; _conflictDiff = null; _active = null;
            StateHasChanged();
            return;
        }
        Tabs.ResolveConflictReload(f.Id, disk);
        _conflictOpen = false; _conflictDiff = null; _active = null;
        if (_editor is not null)
            await _editor.SetValue(disk.Content ?? "");
        StateHasChanged();
    }

    private void KeepLocal()
    {
        var f = _active;
        if (f is null) return;
        _ = KeepLocalAsync(f);
    }

    private async Task KeepLocalAsync(OpenFile f)
    {
        // 保留本地修改，但把基准 revision 前进到当前磁盘版本，避免后续保存无条件覆盖
        FileRevision? diskRev = null;
        try
        {
            var disk = await Workspace.ReadAsync(Workspace.GetAbsolutePath(f.Id), FileReadMode.Display);
            diskRev = disk.Revision;
        }
        catch { /* 读取失败则保持原基准 */ }

        Tabs.ResolveConflictKeepLocal(f.Id, diskRev);
        _conflictOpen = false; _conflictDiff = null; _active = null;
        StateHasChanged();
    }
}
