<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      WinExe 而不是 Exe：Exe 会生成「控制台子系统」程序，双击时额外弹出一个
      cmd 窗口承载 stdout/stderr，桌面应用会同时出现黑框 + 应用窗口两个窗口。
      WinExe 挂到 GUI 子系统，不分配控制台。

      代价：没有 stdout/stderr。日志改由 DesktopFileLoggerProvider 落盘到
      ~/.seeing/logs/seeing-desktop-yyyyMMdd.log（见 Program.cs）。
    -->
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Seeing.Agent.Desktop</RootNamespace>
    <!-- 面向用户的产品名是 Seeing（不是 Seeing.Agent）；产出 seeing.exe / Seeing.app -->
    <AssemblyName>Seeing</AssemblyName>
    <!-- 不参与 CPM，使用显式版本（与 WebUI 一致） -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- 桌面端不注册为可打包库 -->
    <IsPackable>false</IsPackable>
    <!--
      固定为框架依赖（Framework-dependent），不要改成自包含。

      原因：WebUI 是 OutputType=Exe（CLI 的 `seeing web` 需要独立启动
      Seeing.Agent.WebUI.dll），SDK 规则 NETSDK1150 禁止自包含的可执行文件
      引用非自包含的可执行文件。命令行发布时不报错只是因为 -p:SelfContained=true
      是全局属性、会广播给所有项目；Visual Studio 的发布配置不会广播，
      于是必然失败。

      显式声明在此，让两条发布路径（CLI / VS 发布配置）行为一致，
      避免用户在不同入口得到不同结果。
      代价：目标机器需预装 .NET 10 运行时（见 README 的平台依赖表）。
    -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PhotinoX" Version="5.4.1" />
  </ItemGroup>

  <!--
    应用图标：由 tools/generate-icon.ps1 从 WebUI 的 wwwroot/seeing-mark.png（首字母 S）生成。
    ApplicationIcon 让 seeing-desktop.exe 本身带图标（任务栏/资源管理器），
    作为 Content 复制让窗口标题栏与 Photino 的 SetIconFile 能读到同一份文件。
  -->
  <PropertyGroup>
    <ApplicationIcon>Assets\seeing.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link 让文件落在输出根目录（与 SetIconFile 的 AppContext.BaseDirectory 查找一致） -->
    <Content Include="Assets\seeing.ico" Link="seeing.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\seeing.png" Link="seeing.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      复用 WebUI 宿主组装（WebUiHost.BuildAsync）与其全部 wwwroot 静态资源。
      ReferenceOutputAssembly=true 是必需的：外壳要直接调用 WebUiHost。
      静态资源基路径由 WebUI 项目自己声明（见其 csproj 的 StaticWebAssetBasePath），
      这里不能用 AdditionalProperties 覆盖它 —— 那会让被引用项目以另一套全局属性
      重复构建，压缩资源指纹对不上，发布时报 MSB3030 "找不到 .gz 文件"。

      GlobalPropertiesToRemove：PublishProfile / PublishUrl 是**全局属性**，会随
      ProjectReference 传播给被引用项目。两个项目恰好都有名为 FolderProfile 的
      发布配置（各自在 Properties/PublishProfiles 下），但目标 RID 不同：
      桌面是 win-x64，WebUI 是 linux-x64。于是从 VS 发布桌面时，WebUI 会套用
      **自己**那份 linux-x64 的 profile，被按 linux-x64 构建/发布 ——
      表现为 UpdateExternallyDefinedStaticWebAssets 任务意外失败、
      或发布产物里混进 linux-x64 的静态资源清单。
      发布配置只属于声明它的那个项目，不应下传给引用项目。
    -->
    <ProjectReference Include="..\Seeing.Agent.WebUI\Seeing.Agent.WebUI.csproj">
      <GlobalPropertiesToRemove>PublishProfile;PublishUrl;WebPublishMethod</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Seeing.Publish.targets" />

  <!--
    Desktop 用 Photino + WebView2，只能在 Windows 运行。
    对非 Windows RID 发布时必须明确报错，而不是产出一个跑不起来的包。
  -->
  <Target Name="_ValidateDesktopRuntimeIdentifier" BeforeTargets="Build">
    <Error Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))"
           Text="Seeing.Agent.Desktop 仅支持 Windows（当前 RuntimeIdentifier=$(RuntimeIdentifier)）。请使用 -r win-x64。" />
  </Target>

  <!--
    ChannelHost 产物补全。

    为什么需要：WebUI 以 ReferenceOutputAssembly="false" 引用 ChannelHost，
    SDK 只会复制 apphost / deps.json / runtimeconfig.json 这类「半套」文件，
    **不复制 .dll**。WebUI 自己的 csproj 用嵌套 Publish 补齐了这些文件，
    但 Desktop 把被引用项目的输出复制到 publish 时又按同一套规则走了一遍，
    结果 publish 目录里同样只剩「半套」文件。
    运行期 ChannelHostManager.ResolveChannelHost 要求 .dll 存在，
    缺了会抛「找不到可运行的 Seeing.Gateway.ChannelHost」。

    这里在发布后把 WebUI 输出目录中已齐备的 ChannelHost 文件带过来。
    ChannelHost 现在是 RID 无关产物（UseAppHost=false），会落在
    bin/<Config>/<tfm>/ 下；但历史上也出现过落在 bin/<Config>/<tfm>/<rid>/
    的情况（外层带 RID 构建时）。两处都找，避免换发布方式就丢文件。
  -->
  <Target Name="CopyChannelHostToPublish"
          AfterTargets="Publish"
          Condition="Exists('$(PublishDir)')">
    <ItemGroup>
      <!-- 主来源：ChannelHost 是 RID 无关产物，落在 bin/<Config>/<tfm>/ -->
      <_ChannelHostArtifact Include="$(MSBuildThisFileDirectory)..\Seeing.Agent.WebUI\bin\$(Configuration)\$(TargetFramework)\Seeing.Gateway.ChannelHost.*" />
      <!-- 兜底：历史遗留的 RID 子目录（外层带 RID 构建时才会产生），
           只补主来源里没有的文件，避免同名覆盖 -->
      <_ChannelHostArtifactFallback Include="$(MSBuildThisFileDirectory)..\Seeing.Agent.WebUI\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Seeing.Gateway.ChannelHost.*"
                                   Condition="'$(RuntimeIdentifier)' != ''" />
      <_ChannelHostArtifactFallback Remove="@(_ChannelHostArtifactFallback)"
                                    MatchOnMetadata="Filename"
                                    MatchOnMetadataOptions="CaseInsensitive"
                                    Condition="'@(_ChannelHostArtifact)' != ''" />
      <_ChannelHostArtifact Include="@(_ChannelHostArtifactFallback)" />
    </ItemGroup>

    <Copy SourceFiles="@(_ChannelHostArtifact)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_ChannelHostArtifact)' != ''" />
  </Target>
</Project>
